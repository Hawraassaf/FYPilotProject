@page
@using System
@using System.Linq
@using System.Security.Claims
@model FYPilot.Web.Pages.Student.DashboardModel

@{
    ViewData["Title"] = "Project Command Center";
    ViewData["Subtitle"] = "Your intelligent final-year project workspace";

    var completedFoundations =
        (Model.HasSkills ? 1 : 0) +
        (Model.HasSelectedIdea ? 1 : 0) +
        (Model.HasRoadmaps ? 1 : 0);

    var readiness = (int)Math.Round(completedFoundations / 3.0 * 100);

    var activityPreview = Model.RecentActivities.Take(7).ToList();

    var innovation = Model.SelectedIdea?.InnovationScore ?? 0;
    var feasibility = Model.SelectedIdea?.FeasibilityScore ?? 0;
    var marketFit = Model.SelectedIdea?.MarketDemandScore ?? 0;


    var activeJourney = !Model.HasSkills
        ? "skills"
        : !Model.HasSelectedIdea
            ? "idea"
            : !Model.HasRoadmaps
                ? "roadmap"
                : "execution";

    var nextActionPage = activeJourney switch
    {
        "skills" => "/Student/SkillAssessment",
        "idea" => "/Student/IdeaGenerator",
        "roadmap" => "/Student/Roadmap",
        _ => "/Student/DocumentationGenerator"
    };

    var nextActionLabel = activeJourney switch
    {
        "skills" => "Complete Skill Assessment",
        "idea" => "Select Project Idea",
        "roadmap" => "Create Project Roadmap",
        _ => "Generate SE Documentation"
    };

    var nextActionIcon = activeJourney switch
    {
        "skills" => "bar-chart-line",
        "idea" => "lightbulb",
        "roadmap" => "map",
        _ => "journal-code"
    };

    var nextActionReason = activeJourney switch
    {
        "skills" =>
            "Your skills profile is missing, so personalization cannot start yet.",

        "idea" =>
            "Your skills are ready, but this project still has no official selected idea.",

        "roadmap" =>
            "The project idea is selected, but no implementation roadmap exists yet.",

        _ =>
            "Skills, idea, and roadmap are ready; engineering documentation is the next planned stage."
    };
}

<div class="nova-dashboard"
     data-tour-user-id="@(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "anonymous")"
     data-tour-version="1">

    <section class="nova-top-deck nova-glass" data-tilt-card data-tour="project-command">
        <div class="nova-mesh"></div>
        <div class="nova-orb nova-orb-a"></div>
        <div class="nova-orb nova-orb-b"></div>
        <div class="nova-orb nova-orb-c"></div>

       

        <div class="nova-hero-grid">
            <div class="nova-project-identity">
                <div class="nova-project-chip">
                    <i class="bi bi-folder2-open"></i>
                    Active workspace
                </div>

                <h1>@Model.ProjectTitle</h1>

                <div class="nova-project-meta">
                    <span><i class="bi bi-person-badge"></i>@Model.AccessRoleLabel</span>
                    <span><i class="bi bi-activity"></i>@Model.ProjectStatus</span>
                    <span><i class="bi bi-people"></i>@Model.ActiveMembersCount/@Model.MaximumMembers collaborators</span>
                </div>

                <p>
                    One connected workspace for project intelligence, planning, engineering,
                    collaboration, and defense preparation.
                </p>

                <div class="nova-hero-actions">
                    <a asp-page="@nextActionPage"
                       asp-route-projectId="@Model.ProjectId"
                       class="nova-main-action" data-tour="next-action">
                        <span class="nova-main-action-icon">
                            <i class="bi bi-@nextActionIcon"></i>
                        </span>

                        <span class="nova-main-action-copy">
                            <small>
                                Next step based on the current project state
                            </small>

                            <strong>@nextActionLabel</strong>

                            <em>@nextActionReason</em>
                        </span>

                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                    <a asp-page="/Student/MyProjects"
                       class="nova-ghost-action">
                        <i class="bi bi-arrow-left-right"></i>
                        Switch project
                    </a>
                </div>
            </div>

            <aside class="nova-project-summary" aria-label="Project readiness summary">
                <div class="nova-summary-heading">
                    <div>
                        <span>Project readiness</span>
                        <strong>@readiness%</strong>
                    </div>

                    <div class="nova-summary-ring" style="--summary-progress:@readiness">
                        <span>@completedFoundations/3</span>
                    </div>
                </div>

                <div class="nova-summary-progress">
                    <div class="nova-summary-progress-label">
                        <span>Foundation progress</span>
                        <strong>@completedFoundations completed</strong>
                    </div>

                    <div class="nova-summary-progress-track">
                        <span style="width:@readiness%"></span>
                    </div>
                </div>

                <div class="nova-summary-checklist">
                    <div class="@(Model.HasSkills ? "is-complete" : "is-pending")">
                        <i class="bi @(Model.HasSkills ? "bi-check2" : "bi-circle")"></i>
                        <span>Skills assessment</span>
                    </div>

                    <div class="@(Model.HasSelectedIdea ? "is-complete" : "is-pending")">
                        <i class="bi @(Model.HasSelectedIdea ? "bi-check2" : "bi-circle")"></i>
                        <span>Selected idea</span>
                    </div>

                    <div class="@(Model.HasRoadmaps ? "is-complete" : "is-pending")">
                        <i class="bi @(Model.HasRoadmaps ? "bi-check2" : "bi-circle")"></i>
                        <span>Project roadmap</span>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <section class="nova-metric-ribbon"
             data-tour="project-stats"
             aria-label="Live project statistics">
        @foreach (var stat in Model.Stats)
        {
            <article class="nova-metric-card"
                     data-float-card>
                <div class="nova-metric-icon">
                    <i class="bi bi-@stat.Icon"></i>
                </div>

                <div class="nova-metric-copy">
                    <span>@stat.Label</span>
                    <strong>@stat.Value</strong>
                    <small>@stat.Note</small>
                </div>

                <div class="nova-metric-spark">
                    <i class="bi bi-arrow-up-right"></i>
                </div>
            </article>
        }
    </section>

    <section class="nova-journey-board nova-surface" data-tour="project-journey">
        <header class="nova-section-header">
            <div>
                <span class="nova-section-kicker">Interactive project journey</span>
                <h2>Navigate the full FYP lifecycle</h2>
                <p>Choose a stage to see its purpose, current state, and recommended action.</p>
            </div>

            <div class="nova-progress-pill">
                <span>@readiness%</span>
                planning ready
            </div>
        </header>

        <div class="nova-journey-map">
            <div class="nova-journey-line">
                <span style="width:@readiness%"></span>
            </div>

            <div class="nova-journey-nodes" role="tablist" aria-label="Project stages">
                <button type="button"
                        class="nova-journey-node @(Model.HasSkills ? "is-complete" : (activeJourney == "skills" ? "is-active" : ""))"
                        data-journey-select="skills"
                        role="tab"
                        aria-selected="@(activeJourney == "skills" ? "true" : "false")">
                    <span class="nova-node-icon">
                        <i class="bi @(Model.HasSkills ? "bi-check2" : "bi-bar-chart-line")"></i>
                    </span>
                    <strong>Skills</strong>
                    <small>@(Model.HasSkills ? "Mapped" : "Pending")</small>
                </button>

                <button type="button"
                        class="nova-journey-node @(Model.HasSelectedIdea ? "is-complete" : (activeJourney == "idea" ? "is-active" : ""))"
                        data-journey-select="idea"
                        role="tab"
                        aria-selected="@(activeJourney == "idea" ? "true" : "false")">
                    <span class="nova-node-icon">
                        <i class="bi @(Model.HasSelectedIdea ? "bi-check2" : "bi-lightbulb")"></i>
                    </span>
                    <strong>Idea</strong>
                    <small>@(Model.HasSelectedIdea ? "Selected" : "Pending")</small>
                </button>

                <button type="button"
                        class="nova-journey-node @(Model.HasRoadmaps ? "is-complete" : (activeJourney == "roadmap" ? "is-active" : ""))"
                        data-journey-select="roadmap"
                        role="tab"
                        aria-selected="@(activeJourney == "roadmap" ? "true" : "false")">
                    <span class="nova-node-icon">
                        <i class="bi @(Model.HasRoadmaps ? "bi-check2" : "bi-map")"></i>
                    </span>
                    <strong>Plan</strong>
                    <small>@(Model.HasRoadmaps ? "Created" : "Pending")</small>
                </button>

                <button type="button"
                        class="nova-journey-node @(activeJourney == "execution" ? "is-active" : "")"
                        data-journey-select="execution"
                        role="tab"
                        aria-selected="@(activeJourney == "execution" ? "true" : "false")">
                    <span class="nova-node-icon">
                        <i class="bi bi-code-slash"></i>
                    </span>
                    <strong>Execute</strong>
                    <small>Build &amp; test</small>
                </button>

                <button type="button"
                        class="nova-journey-node"
                        data-journey-select="defense"
                        role="tab"
                        aria-selected="false">
                    <span class="nova-node-icon">
                        <i class="bi bi-mortarboard"></i>
                    </span>
                    <strong>Defend</strong>
                    <small>Prepare</small>
                </button>
            </div>
        </div>

        <div class="nova-journey-details">
            <article class="nova-journey-detail @(activeJourney == "skills" ? "is-active" : "")"
                     data-journey-panel="skills">
                <div class="nova-detail-icon skill-detail">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <div>
                    <span>Stage 01</span>
                    <h3>Skills Foundation</h3>
                    <p>Assess current capabilities and identify the technical foundation available to the project.</p>
                </div>

                <a asp-page="/Student/SkillAssessment">
                    @(Model.HasSkills ? "Review assessment" : "Complete assessment")
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="nova-journey-detail @(activeJourney == "idea" ? "is-active" : "")"
                     data-journey-panel="idea">
                <div class="nova-detail-icon idea-detail">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <div>
                    <span>Stage 02</span>
                    <h3>Project Direction</h3>
                    <p>Generate, compare, and select the idea that will become the shared source of truth.</p>
                </div>

                <a asp-page="/Student/IdeaGenerator" asp-route-projectId="@Model.ProjectId">
                    @(Model.HasSelectedIdea ? "Explore ideas" : "Generate ideas")
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="nova-journey-detail @(activeJourney == "roadmap" ? "is-active" : "")"
                     data-journey-panel="roadmap">
                <div class="nova-detail-icon roadmap-detail">
                    <i class="bi bi-map"></i>
                </div>

                <div>
                    <span>Stage 03</span>
                    <h3>Roadmap Planning</h3>
                    <p>Build project-specific phases, tasks, hours, workload allocation, and delivery logic.</p>
                </div>

                <a asp-page="/Student/Roadmap" asp-route-projectId="@Model.ProjectId">
                    @(Model.HasRoadmaps ? "Open roadmap" : "Generate roadmap")
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="nova-journey-detail @(activeJourney == "execution" ? "is-active" : "")"
                     data-journey-panel="execution">
                <div class="nova-detail-icon execution-detail">
                    <i class="bi bi-code-square"></i>
                </div>

                <div>
                    <span>Stage 04</span>
                    <h3>Engineering Execution</h3>
                    <p>Implement the system, generate SE documentation, collaborate, test, and refine the solution.</p>
                </div>

                <a asp-page="/Student/DocumentationGenerator" asp-route-projectId="@Model.ProjectId">
                    Open engineering tools
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="nova-journey-detail"
                     data-journey-panel="defense">
                <div class="nova-detail-icon defense-detail">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <span>Stage 05</span>
                    <h3>Defense Readiness</h3>
                    <p>Practice project-specific questions, improve answers, and prepare to explain every design decision.</p>
                </div>

                <a asp-page="/Student/DefenseSimulator" asp-route-projectId="@Model.ProjectId">
                    Start defense practice
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        </div>
    </section>

    <section class="nova-bento-grid">
        <article class="nova-core-card nova-surface" data-float-card data-tour="selected-idea">
            <div class="nova-core-top">
                <div>
                    <span class="nova-section-kicker">Project core</span>
                    <h2>Selected idea intelligence</h2>
                </div>

                <a asp-page="/Student/IdeaGenerator"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-small-link">
                    @(Model.HasSelectedIdea ? "Replace idea" : "Choose idea")
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            @if (Model.SelectedIdea == null)
            {
                <div class="nova-no-idea">
                    <div class="nova-no-idea-visual">
                        <i class="bi bi-lightbulb"></i>
                        <span></span>
                        <span></span>
                    </div>

                    <h3>No project intelligence yet</h3>
                    <p>Select a shared project idea to unlock the full FYPilot analysis system.</p>

                    <a asp-page="@(Model.HasSkills ? "/Student/IdeaGenerator" : "/Student/SkillAssessment")"
                       asp-route-projectId="@Model.ProjectId">
                        @(Model.HasSkills ? "Generate ideas" : "Complete skills first")
                    </a>
                </div>
            }
            else
            {
                <div class="nova-core-content">
                    <div class="nova-core-copy">
                        <div class="nova-domain-chip">
                            <i class="bi bi-shield-shaded"></i>
                            @Model.SelectedIdea.Domain
                        </div>

                        <h3>@Model.SelectedIdea.Title</h3>
                        <p>@Model.SelectedIdea.ProblemStatement</p>

                        <div class="nova-core-actions">
                            <a asp-page="/Student/ProjectDetails"
                               asp-route-id="@Model.SelectedIdea.Id"
                               class="nova-solid-btn">
                                <i class="bi bi-eye"></i>
                                View details
                            </a>

                            <a asp-page="/Student/ProjectDNA"
                               asp-route-projectId="@Model.ProjectId"
                               class="nova-outline-btn">
                                <i class="bi bi-diagram-3"></i>
                                Project DNA
                            </a>
                        </div>
                    </div>

                    <div class="nova-score-columns">
                        <div style="--score:@innovation">
                            <span>Innovation</span>
                            <strong>@innovation%</strong>
                            <div><i></i></div>
                        </div>

                        <div style="--score:@feasibility">
                            <span>Feasibility</span>
                            <strong>@feasibility%</strong>
                            <div><i></i></div>
                        </div>

                        <div style="--score:@marketFit">
                            <span>Market fit</span>
                            <strong>@marketFit%</strong>
                            <div><i></i></div>
                        </div>
                    </div>
                </div>
            }
        </article>

        <article class="nova-trust-card" data-tilt-card data-tour="trust-layer">
            <div class="nova-trust-beam"></div>

            <div class="nova-trust-header">
                <span><i class="bi bi-shield-lock"></i>AI TrustLayer</span>
                <strong>Safe by architecture</strong>
            </div>

            <div class="nova-trust-core">
                <div class="trust-core-center">
                    <i class="bi bi-cpu"></i>
                    <strong>Reviewed AI</strong>
                    <small>Every critical output</small>
                </div>

                <span class="trust-orbit trust-orbit-one"></span>
                <span class="trust-orbit trust-orbit-two"></span>
                <span class="trust-orbit-node node-a">Firewall</span>
                <span class="trust-orbit-node node-b">Schema</span>
                <span class="trust-orbit-node node-c">Reviewer</span>
                <span class="trust-orbit-node node-d">Passport</span>
            </div>

            <p>
                Generated content is filtered, validated, reviewed, and assigned a traceable quality decision.
            </p>

            <button type="button" class="nova-trust-more" id="openTrustDetails">
                View TrustLayer flow
                <i class="bi bi-arrow-right"></i>
            </button>
        </article>

        <article class="nova-activity-card nova-surface nova-activity-wide">
            <header class="nova-section-header nova-section-header-small">
                <div>
                    <span class="nova-section-kicker">Live stream</span>
                    <h2>Recent project activity</h2>
                </div>

                <span class="nova-live-status">
                    <i></i>
                    Live
                </span>
            </header>

            @if (activityPreview.Count == 0)
            {
                <div class="nova-mini-empty">
                    <i class="bi bi-clock-history"></i>
                    <strong>No activity yet</strong>
                    <span>Project events will appear here.</span>
                </div>
            }
            else
            {
                <div class="nova-activity-list">
                    @foreach (var activity in activityPreview)
                    {
                        <div class="nova-activity-item">
                            <span class="nova-activity-line"></span>

                            <div class="nova-activity-dot"></div>

                            <div class="nova-activity-copy">
                                <strong>@activity.Description</strong>
                                <time>@activity.CreatedAtUtc.ToLocalTime().ToString("MMM d · h:mm tt")</time>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>

    </section>

    <section class="nova-capability-universe nova-surface" data-tour="capability-universe">
        <header class="nova-section-header">
            <div>
                <span class="nova-section-kicker">FYPilot intelligence universe</span>
                <h2>The complete project ecosystem</h2>
                <p>Explore the connected AI and project-management capabilities around your active project.</p>
            </div>

            <div class="nova-capability-filter" role="group" aria-label="Filter capabilities">
                <button type="button" class="is-active" data-capability-filter="all">All</button>
                <button type="button" data-capability-filter="plan">Plan</button>
                <button type="button" data-capability-filter="build">Build</button>
                <button type="button" data-capability-filter="support">Support</button>
            </div>
        </header>

        <div class="nova-universe-map">
            <div class="nova-connector connector-one"></div>
            <div class="nova-connector connector-two"></div>
            <div class="nova-connector connector-three"></div>
            <div class="nova-connector connector-four"></div>

            <div class="nova-universe-column">
                <a asp-page="/Student/IdeaGenerator"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-blue"
                   data-capability-group="plan"
                   data-float-card>
                    <span><i class="bi bi-lightbulb"></i></span>
                    <div>
                        <strong>Idea Generator</strong>
                        <small>Project-specific ideas</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/IdeaComparison"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-violet"
                   data-capability-group="plan"
                   data-float-card>
                    <span><i class="bi bi-columns-gap"></i></span>
                    <div>
                        <strong>Idea Comparison</strong>
                        <small>Rank and compare choices</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/MarketDemand"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-cyan"
                   data-capability-group="plan"
                   data-float-card>
                    <span><i class="bi bi-graph-up-arrow"></i></span>
                    <div>
                        <strong>Market Intelligence</strong>
                        <small>Evidence and opportunity</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/ProjectDNA"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-indigo"
                   data-capability-group="plan"
                   data-float-card>
                    <span><i class="bi bi-diagram-3"></i></span>
                    <div>
                        <strong>Project DNA</strong>
                        <small>Technical identity</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <div class="nova-universe-core">
                <div class="nova-core-rings ring-a"></div>
                <div class="nova-core-rings ring-b"></div>
                <div class="nova-core-rings ring-c"></div>

                <div class="nova-core-emblem">
                    <img src="/image/FYPilot_logo.png" alt="" />
                    <strong>FYPilot</strong>
                    <span>AI Project OS</span>
                </div>

                <div class="nova-core-signal signal-a"></div>
                <div class="nova-core-signal signal-b"></div>
                <div class="nova-core-signal signal-c"></div>
            </div>

            <div class="nova-universe-column">
                <a asp-page="/Student/Roadmap"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-green"
                   data-capability-group="build"
                   data-float-card>
                    <span><i class="bi bi-map"></i></span>
                    <div>
                        <strong>Project Roadmap</strong>
                        <small>Schedule and workload</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/DocumentationGenerator"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-orange"
                   data-capability-group="build"
                   data-float-card>
                    <span><i class="bi bi-journal-code"></i></span>
                    <div>
                        <strong>SE Documentation</strong>
                        <small>SRS, design, and tests</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/MentorChat"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-pink"
                   data-capability-group="support"
                   data-float-card>
                    <span><i class="bi bi-chat-dots"></i></span>
                    <div>
                        <strong>AI Mentor</strong>
                        <small>Contextual guidance</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>

                <a asp-page="/Student/DefenseSimulator"
                   asp-route-projectId="@Model.ProjectId"
                   class="nova-feature-node feature-red"
                   data-capability-group="support"
                   data-float-card>
                    <span><i class="bi bi-shield-check"></i></span>
                    <div>
                        <strong>Defense Simulator</strong>
                        <small>Practice and evaluation</small>
                    </div>
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </section>

    <div class="nova-floating-dock no-motion">
        <button type="button"
                class="nova-dock-trigger"
                id="novaDockTrigger"
                data-tour="quick-actions"
                aria-expanded="false"
                aria-controls="novaQuickDock">
            <i class="bi bi-grid"></i>
            <span>Quick actions</span>
        </button>

        <div class="nova-quick-dock" id="novaQuickDock">
            <a asp-page="/Student/Roadmap" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-map"></i>
                <span>Roadmap</span>
            </a>

            <a asp-page="/Student/DocumentationGenerator" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-journal-code"></i>
                <span>SE Docs</span>
            </a>

            <a asp-page="/Student/MentorChat" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-chat-dots"></i>
                <span>Mentor</span>
            </a>

            <a asp-page="/Student/DefenseSimulator" asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-shield-check"></i>
                <span>Defense</span>
            </a>
        </div>
    </div>

    <div class="nova-modal-backdrop"
         id="trustLayerModal"
         aria-hidden="true">
        <section class="nova-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="trustLayerTitle">
            <button type="button"
                    class="nova-modal-close"
                    id="closeTrustDetails"
