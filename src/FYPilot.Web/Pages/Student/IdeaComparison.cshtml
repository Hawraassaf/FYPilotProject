@page
@model FYPilot.Web.Pages.Student.IdeaComparisonModel
@using FYPilot.Application.Common
@using FYPilot.Domain.Entities
@{
    ViewData["Title"] = "Idea Comparison";
    ViewData["Subtitle"] = "Compare ideas clearly and choose the one that fits you best";

    var ideas = Model.Ideas;
    var selectedIdeaId = Model.CurrentProject?.ProjectIdeaId;
    var selectedIdea = ideas.FirstOrDefault(idea => idea.Id == selectedIdeaId);

    var latestIdeas = ideas
        .Where(idea => Model.LatestBatchIdeaIds.Contains(idea.Id))
        .ToList();

    var olderIdeas = ideas
        .Where(idea => !Model.LatestBatchIdeaIds.Contains(idea.Id))
        .ToList();


    var scorecardsByIdea = Model.Scorecards.ToDictionary(card => card.IdeaId);

}

@if (!ideas.Any())
{
    <main class="idea-empty-shell">
        <section class="idea-empty-card">
            <div class="idea-empty-orb">
                <i class="bi bi-intersect"></i>
            </div>

            <span class="ui-eyebrow">Idea Comparison</span>
            <h1>Your comparison workspace is waiting</h1>
            <p>
                Generate at least two project ideas first. FYPilot will then help you
                compare their strengths, risks and saved evaluation scores.
            </p>

            <a class="ui-btn ui-btn-primary"
               asp-page="/Student/IdeaGenerator"
               asp-route-projectId="@Model.ProjectId">
                <i class="bi bi-stars"></i>
                Generate project ideas
            </a>
        </section>
    </main>
}
else
{
    <main class="idea-page-shell">
        <header class="idea-hero">
            <div class="idea-hero-copy">
                <div class="idea-breadcrumb">
                    <span>Project planning</span>
                    <i class="bi bi-chevron-right"></i>
                    <strong>Idea comparison</strong>
                </div>

                <h1>Choose the idea worth building.</h1>
                <p>
                    Compare official saved scores, ask AI for a qualitative ranking,
                    and make the final project decision from one focused workspace.
                </p>

                <div class="idea-hero-meta">
                    <span>
                        <i class="bi bi-collection"></i>
                        <strong>@ideas.Count</strong> saved ideas
                    </span>

                    <span>
                        <i class="bi bi-clock-history"></i>
                        <strong>@latestIdeas.Count</strong> in latest batch
                    </span>

                    <span class="@(selectedIdea == null ? "is-muted" : "is-selected")">
                        <i class="bi @(selectedIdea == null ? "bi-circle" : "bi-check-circle-fill")"></i>
                        @(selectedIdea == null ? "No official idea selected" : $"Selected: {selectedIdea.Title}")
                    </span>
                </div>
            </div>

            <div class="idea-hero-actions">
                <a class="ui-btn ui-btn-secondary"
                   asp-page="/Student/IdeaGenerator"
                   asp-route-projectId="@Model.ProjectId">
                    <i class="bi bi-plus-lg"></i>
                    Generate more ideas
                </a>
            </div>
        </header>

        <section class="ui-panel selection-panel">
            <div class="ui-panel-heading">
                <div class="step-heading">
                    <span class="step-number">1</span>
                    <div>
                        <span class="ui-eyebrow">Select ideas</span>
                        <h2>What should the AI compare?</h2>
                        <p>
                            Your latest generation batch is selected automatically.
                            Choose between
                            @FYPilot.Web.Pages.Student.IdeaComparisonModel.MinimumIdeasToCompare
                            and
                            @FYPilot.Web.Pages.Student.IdeaComparisonModel.HardMaximumIdeasToCompare
                            ideas.
                        </p>
                    </div>
                </div>

                <div class="selection-status">
                    <span class="selection-count" id="ic3SelectCount"></span>
                    <span class="selection-speed">
                        <i class="bi bi-lightning-charge-fill"></i>
                        4 or fewer is fastest
                    </span>
                </div>
            </div>

            <form method="post"
                  id="ic3CompareForm"
                  data-project-id="@Model.ProjectId"
                  data-active-job-id="@Model.ActiveJobId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.ProjectId" />

                <div class="selection-group">
                    <div class="selection-group-title">
                        <div>
                            <strong>Latest batch</strong>
                            <span>Recommended starting point</span>
                        </div>
                        <span class="selection-group-count">@latestIdeas.Count ideas</span>
                    </div>

                    <div class="idea-choice-grid">
                        @foreach (var idea in latestIdeas)
                        {
                            var checkboxId = $"ideaChoice{idea.Id}";
                            scorecardsByIdea.TryGetValue(idea.Id, out var scorecard);

                            <div class="idea-choice-card">
                                <input type="checkbox"
                                       name="SelectedIdeaIds"
                                       value="@idea.Id"
                                       id="@checkboxId"
                                       checked="checked" />

                                <label for="@checkboxId">
                                    <div class="choice-check">
                                        <i class="bi bi-check-lg"></i>
                                    </div>

                                    <div class="choice-content">
                                        <div class="choice-badges">
                                            <span class="choice-badge choice-badge-latest">Latest</span>

                                            @if (!string.IsNullOrWhiteSpace(idea.DifficultyLevel))
                                            {
                                                <span class="choice-badge">@idea.DifficultyLevel</span>
                                            }
                                        </div>

                                        <h3>@idea.Title</h3>
                                        <p>@(string.IsNullOrWhiteSpace(idea.Domain) ? "General project" : idea.Domain)</p>

                                        <div class="choice-score">
                                            <span>Saved overall</span>
                                            <strong>
                                                @(scorecard?.OverallScore.HasValue == true
                                                    ? $"{scorecard.OverallScore}%"
                                                    : "Not evaluated")
                                            </strong>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @if (olderIdeas.Any())
                {
                    <details class="older-ideas">
                        <summary>
                            <span>
                                <i class="bi bi-archive"></i>
                                Browse older ideas
                            </span>
                            <small>@olderIdeas.Count available</small>
                        </summary>

                        <div class="idea-choice-grid older-choice-grid">
                            @foreach (var idea in olderIdeas)
                            {
                                var checkboxId = $"ideaChoice{idea.Id}";
                                scorecardsByIdea.TryGetValue(idea.Id, out var scorecard);

                                <div class="idea-choice-card">
                                    <input type="checkbox"
                                           name="SelectedIdeaIds"
                                           value="@idea.Id"
                                           id="@checkboxId" />

                                    <label for="@checkboxId">
                                        <div class="choice-check">
                                            <i class="bi bi-check-lg"></i>
                                        </div>

                                        <div class="choice-content">
                                            <div class="choice-badges">
                                                <span class="choice-badge">Previous batch</span>

                                                @if (!string.IsNullOrWhiteSpace(idea.DifficultyLevel))
                                                {
                                                    <span class="choice-badge">@idea.DifficultyLevel</span>
                                                }
                                            </div>

                                            <h3>@idea.Title</h3>
                                            <p>@(string.IsNullOrWhiteSpace(idea.Domain) ? "General project" : idea.Domain)</p>

                                            <div class="choice-score">
                                                <span>Saved overall</span>
                                                <strong>
                                                    @(scorecard?.OverallScore.HasValue == true
                                                        ? $"{scorecard.OverallScore}%"
                                                        : "Not evaluated")
                                                </strong>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    </details>
                }

                <div class="selection-footer">
                    <div class="selection-hint" id="ic3SelectHint">
                        Select the ideas you want to compare.
                    </div>

                    <div class="ui-alert ui-alert-danger" id="ic3StartError" role="alert" hidden></div>

                    <button type="submit"
                            class="ui-btn ui-btn-primary compare-submit"
                            id="ic3CompareBtn">
                        <span class="button-icon">
                            <i class="bi bi-stars"></i>
                        </span>
                        <span>
                            <strong>Generate recommendation</strong>
                            <small>AI ranking using your saved scores</small>
                        </span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </form>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="ui-alert ui-alert-warning">
                <div class="ui-alert-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <strong>Recommendation unavailable</strong>
                    <p>@Model.ErrorMessage</p>
                </div>
            </div>
        }

        @if (Model.Comparison != null)
        {
            var comparison = Model.Comparison;
            var winner = Model.Scorecards.FirstOrDefault(s => s.AiRank == 1);
            var others = Model.Scorecards
                .Where(s => s.AiRank.HasValue && s.AiRank != 1)
                .OrderBy(s => s.AiRank)
                .ToList();

            var winnerIdea = winner == null
                ? null
                : Model.Ideas.FirstOrDefault(i => i.Id == winner.IdeaId);

            // The AI ranks by fit for THIS student (skills, team size, hours,
            // Lebanese context) -- not by re-sorting the saved Overall%, which
            // is a separate, generic score from Idea Generator (see
            // project_idea_comparison.py's prompt). That's by design, but a
            // reader skimming percentages before reading the reasoning can
            // otherwise mistake a lower-scored #1 for a bug -- so call it out
            // explicitly whenever it happens, rather than only implying it.
            var higherScoredOther = winner?.OverallScore is int winnerScore
                ? others
                    .Where(o => o.OverallScore.HasValue && o.OverallScore.Value > winnerScore)
                    .OrderByDescending(o => o.OverallScore)
                    .FirstOrDefault()
                : null;

            <section class="ui-panel ai-result-panel" id="aiRecommendationResult">
                <div class="ui-panel-heading ai-result-heading">
                    <div class="step-heading">
                        <span class="step-number step-number-ai">
                            <i class="bi bi-stars"></i>
                        </span>
                        <div>
                            <span class="ui-eyebrow">AI recommendation</span>
                            <h2>Your ranked shortlist</h2>
                            <p>
                                The AI explains the ranking but never replaces the percentages
                                saved by Idea Generator.
                            </p>
                        </div>
                    </div>

                    @if (Model.LatestReview != null)
                    {
                        var (badgeClass, badgeLabel) = Model.DescribeReview(Model.LatestReview);

                        var reviewTitle = Model.LatestReview.Status switch
                        {
                            "automated_checks_passed" =>
                                "The response passed structural, authorization, score-consistency and firewall checks.",
                            "review_unavailable" =>
                                "The recommendation was generated, but semantic review was unavailable.",
                            "reviewed" or "approved" or "approved_with_minor_warnings" =>
                                Model.LatestReview.DecisionReason,
                            _ => Model.LatestReview.DecisionReason
                        };

                        <span class="quality-badge @badgeClass"
                              title="@reviewTitle">
                            <i class="bi bi-shield-check"></i>
                            @badgeLabel
                        </span>
                    }
                </div>

                @if (!comparison.Available || winner == null || winnerIdea == null)
                {
                    <div class="ui-alert ui-alert-warning airec-unavailable">
                        <div class="ui-alert-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <div>
                            <strong>Use the saved comparison below</strong>
                            <p>@comparison.Summary</p>
                        </div>
                    </div>
                }
                else
                {
                    <article class="winner-card">
                        <div class="winner-main">
                            <div class="winner-topline">
                                <span class="winner-rank">
                                    <i class="bi bi-trophy-fill"></i>
                                    Best fit · Rank #1
                                </span>

                                <span class="winner-domain">
                                    @(string.IsNullOrWhiteSpace(winnerIdea.Domain)
                                        ? "General project"
                                        : winnerIdea.Domain)
                                </span>
                            </div>

                            <h2 class="winner-title">@winner.Title</h2>

                            <div class="winner-reason">
                                <span>Why it wins</span>
                                <p>@winner.AiWhyThisRank</p>
                            </div>

                            @if (higherScoredOther != null)
                            {
                                <div class="winner-score-note">
                                    <i class="bi bi-info-circle"></i>
                                    <span>
                                        Ranked #1 even though its saved Overall score
                                        (@winner.OverallScore%) is lower than
                                        <strong>@higherScoredOther.Title</strong>'s
                                        (@higherScoredOther.OverallScore%) &mdash; the AI weighs this
                                        student's skill fit and project-specific factors above, not
                                        just the saved percentages.
                                    </span>
                                </div>
                            }

                            <div class="winner-insight-grid">
                                <div class="winner-insight">
                                    <span class="insight-icon insight-icon-good">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </span>
                                    <div>
                                        <small>Main strength</small>
                                        <p>@winner.AiMainStrength</p>
                                    </div>
                                </div>

                                <div class="winner-insight">
                                    <span class="insight-icon insight-icon-risk">
                                        <i class="bi bi-exclamation-diamond"></i>
                                    </span>
                                    <div>
                                        <small>Main risk</small>
                                        <p>@winner.AiMainRisk</p>
                                    </div>
                                </div>

                                <div class="winner-insight">
                                    <span class="insight-icon insight-icon-check">
                                        <i class="bi bi-clipboard2-check"></i>
                                    </span>
                                    <div>
                                        <small>Validate first</small>
                                        <p>@winner.AiRequiredValidation</p>
                                    </div>
                                </div>
                            </div>

                            <div class="winner-actions">
                                @{
                                    var winnerSelected = Model.CurrentProject?.ProjectIdeaId == winner.IdeaId;
                                }

                                <form method="post"
                                      asp-page-handler="Select"
                                      class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                    <input type="hidden" name="ideaId" value="@winner.IdeaId" />

                                    <button type="submit"
                                            class="ui-btn ui-btn-primary"
                                            disabled="@(winnerSelected ? "disabled" : null)">
                                        @if (winnerSelected)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Official idea selected</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check2-circle"></i>
                                            <span>Select this idea</span>
                                        }
                                    </button>
                                </form>

                                <button type="button"
                                        class="ui-btn ui-btn-ghost"
                                        data-details-toggle
                                        aria-expanded="false"
                                        aria-controls="winnerDetails">
                                    <i class="bi bi-layout-text-sidebar-reverse"></i>
                                    Full analysis
                                </button>
                            </div>

                            <div class="analysis-drawer"
                                 id="winnerDetails"
                                 hidden>
                                <div>
                                    <small>Best for</small>
                                    <p>@winner.AiBestFor</p>
                                </div>

                                <div>
                                    <small>Comparison advantage</small>
                                    <p>@winner.AiComparisonAdvantage</p>
                                </div>

                                <div>
                                    <small>Recommendation</small>
                                    <p>@winner.AiRecommendation</p>
                                </div>

                                @foreach (var card in winner.Cards)
                                {
                                    <div>
                                        <small>Saved @card.Name reason</small>
                                        <p>@card.Reason</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <aside class="winner-scoreboard">
                            <div class="overall-ring"
                                 style="--score:@(winner.OverallScore ?? 0)">
                                <div>
                                    <strong>
                                        @(winner.OverallScore.HasValue
                                            ? $"{winner.OverallScore}%"
                                            : "—")
                                    </strong>
                                    <span>Overall</span>
                                </div>
                            </div>

                            <div class="winner-metrics">
                                @foreach (var card in winner.Cards)
                                {
                                    <div class="winner-metric">
                                        <div>
                                            <span>
                                                <i class="bi @card.Icon"></i>
                                                @card.Name
                                            </span>
                                            <strong>
                                                @(card.Score.HasValue ? $"{card.Score}%" : "N/E")
                                            </strong>
                                        </div>

                                        <div class="metric-track">
                                            <span style="width:@(card.Score ?? 0)%"></span>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(winner.OverallPartialNote))
                            {
                                <p class="partial-note">
                                    <i class="bi bi-info-circle"></i>
                                    @winner.OverallPartialNote
                                </p>
                            }
                        </aside>
                    </article>

                    @if (others.Any())
                    {
                        <div class="ranking-heading">
                            <div>
                                <span class="ui-eyebrow">Remaining ideas</span>
                                <h3>Why they ranked lower</h3>
                            </div>
                            <span>@others.Count alternatives</span>
                        </div>

                        <div class="ranking-list">
                            @foreach (var card in others)
                            {
                                var rankedIdea = Model.Ideas.FirstOrDefault(i => i.Id == card.IdeaId);
                                var riskClass = (card.AiRiskLevel ?? "medium").ToLowerInvariant();

                                <article class="ranking-row">
                                    <div class="ranking-position">#@card.AiRank</div>

                                    <div class="ranking-copy">
                                        <div class="ranking-title-line">
                                            <div>
                                                <h4>@card.Title</h4>
                                                <span>
                                                    @(string.IsNullOrWhiteSpace(rankedIdea?.Domain)
                                                        ? "General project"
                                                        : rankedIdea.Domain)
                                                </span>
                                            </div>

                                            <span class="risk-pill risk-@riskClass">
                                                @card.AiRiskLevel risk
                                            </span>
                                        </div>

                                        <p class="ranking-summary">@card.AiContextSummary</p>

                                        <div class="ranking-signals">
                                            <span>
                                                <i class="bi bi-plus-circle"></i>
                                                <strong>Strength:</strong> @card.AiMainStrength
                                            </span>
                                            <span>
                                                <i class="bi bi-exclamation-circle"></i>
                                                <strong>Risk:</strong> @card.AiMainRisk
                                            </span>
                                        </div>

                                        <div class="ranking-actions">
                                            <button type="button"
                                                    class="text-action"
                                                    data-details-toggle
                                                    aria-expanded="false"
                                                    aria-controls="rankDetails-@card.IdeaId">
                                                View detailed reasoning
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        </div>

                                        <div class="analysis-drawer compact-drawer"
                                             id="rankDetails-@card.IdeaId"
                                             hidden>
                                            <div>
                                                <small>Why this rank</small>
                                                <p>@card.AiWhyThisRank</p>
                                            </div>
                                            <div>
                                                <small>Best for</small>
                                                <p>@card.AiBestFor</p>
                                            </div>
                                            <div>
                                                <small>Comparison advantage</small>
                                                <p>@card.AiComparisonAdvantage</p>
                                            </div>
                                            <div>
                                                <small>Required validation</small>
                                                <p>@card.AiRequiredValidation</p>
                                            </div>
                                            <div>
                                                <small>Recommendation</small>
                                                <p>@card.AiRecommendation</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="ranking-score">
                                        <strong>
                                            @(card.OverallScore.HasValue
                                                ? $"{card.OverallScore}%"
                                                : "—")
                                        </strong>
                                        <span>Overall</span>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    <div class="final-recommendation">
                        <span>
                            <i class="bi bi-lightbulb-fill"></i>
                        </span>
                        <div>
                            <small>Final recommendation</small>
                            <p>@comparison.FinalRecommendation</p>
                        </div>
                    </div>

                    @if (Model.ComparisonResponse?.LlmUsed == true)
                    {
                        <p class="provider-note">
                            <i class="bi bi-cpu"></i>
                            Generated using
                            @(Model.ComparisonResponse.Provider ?? "AI")
                            @(string.IsNullOrWhiteSpace(Model.ComparisonResponse.ModelUsed)
                                ? ""
                                : $" · {Model.ComparisonResponse.ModelUsed}")
                        </p>
                    }
                }
            </section>
        }

    </main>
}

@section Head {
    <style>
        :root {
            /* FYPilot project theme */
            --idea-navy: #28385E;
            --idea-navy-2: #304163;
            --idea-blue: #516C8D;
            --idea-blue-soft: #EEF2F6;
            --idea-gold: #B9954F;
            --idea-gold-soft: #F7F1E4;
            --idea-green: #39725A;
            --idea-green-soft: #EDF5F1;
            --idea-red: #A84A4A;
            --idea-red-soft: #F8ECEC;
            --idea-amber: #8A6418;
            --idea-amber-soft: #FFF7DF;
            --idea-ink: #111827;
            --idea-muted: #64748B;
            --idea-border: #E8ECF2;
            --idea-surface: #FFFFFF;
            --idea-surface-soft: #F8FAFC;
            --idea-shadow: 0 16px 38px rgba(40, 56, 94, .08);
            --idea-radius-xl: 24px;
            --idea-radius-lg: 18px;
            --idea-radius-md: 14px;
        }

        .idea-page-shell,
        .idea-empty-shell {
            width: min(1480px, calc(100% - 2rem));
            margin: 0 auto;
            padding: 1.4rem 0 3rem;
            color: var(--idea-ink);
        }

        .idea-empty-shell {
            min-height: calc(100vh - 160px);
            display: grid;
            place-items: center;
        }

        .idea-empty-card {
            width: min(720px, 100%);
            padding: clamp(2rem, 6vw, 4.5rem);
            text-align: center;
            border: 1px solid var(--idea-border);
            border-radius: 30px;
            background:
                radial-gradient(circle at top, rgba(88, 120, 159, .12), transparent 42%),
                var(--idea-surface);
            box-shadow: var(--idea-shadow);
        }

        .idea-empty-orb {
            width: 82px;
            height: 82px;
            display: grid;
            place-items: center;
            margin: 0 auto 1.25rem;
            color: var(--idea-navy);
            font-size: 2rem;
            border: 1px solid #d8e1ec;
            border-radius: 24px;
            background: var(--idea-blue-soft);
        }

        .idea-empty-card h1 {
            max-width: 560px;
            margin: .45rem auto .8rem;
            color: var(--idea-ink);
            font-size: clamp(2rem, 4vw, 3rem);
            line-height: 1.05;
            letter-spacing: -.05em;
            font-weight: 850;
        }

        .idea-empty-card p {
            max-width: 590px;
            margin: 0 auto 1.5rem;
            color: var(--idea-muted);
            line-height: 1.7;
        }

        .idea-hero {
            position: relative;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1.25rem;
            padding: clamp(1.5rem, 3vw, 2.25rem);
            overflow: hidden;
            border: 1px solid #dce5ef;
            border-radius: var(--idea-radius-xl);
            background:
                radial-gradient(circle at 85% 10%, rgba(197, 154, 69, .16), transparent 28%),
                linear-gradient(135deg, #f8fbff 0%, #eef4fa 100%);
        }

        .idea-hero::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -105px;
            width: 260px;
            height: 260px;
            border: 45px solid rgba(88, 120, 159, .08);
            border-radius: 50%;
            pointer-events: none;
        }

        .idea-hero-copy {
            position: relative;
            z-index: 1;
            max-width: 900px;
        }

        .idea-breadcrumb {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            margin-bottom: .65rem;
            color: #75849a;
            font-size: .75rem;
            font-weight: 700;
        }

        .idea-breadcrumb strong {
            color: var(--idea-navy);
        }

        .idea-hero h1 {
            max-width: 760px;
            margin: 0;
            color: var(--idea-ink);
            font-size: clamp(2rem, 4vw, 3.6rem);
            line-height: 1;
            letter-spacing: -.055em;
            font-weight: 850;
        }

        .idea-hero p {
            max-width: 800px;
            margin: .9rem 0 0;
            color: var(--idea-muted);
            font-size: 1rem;
            line-height: 1.65;
        }

        .idea-hero-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .55rem;
            margin-top: 1.2rem;
        }

        .idea-hero-meta > span {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            min-height: 34px;
            padding: .4rem .7rem;
            color: #56667c;
            font-size: .72rem;
            font-weight: 650;
            border: 1px solid rgba(88, 120, 159, .16);
            border-radius: 999px;
            background: rgba(255, 255, 255, .72);
        }

        .idea-hero-meta > span.is-selected {
            color: #25694c;
            border-color: #cfe8db;
            background: #f0faf5;
        }

        .idea-hero-meta > span.is-muted {
            color: #7c899a;
        }

        .idea-hero-actions {
            position: relative;
            z-index: 1;
            flex: 0 0 auto;
        }

        .ui-panel {
            margin-bottom: 1.25rem;
            padding: clamp(1.1rem, 2.4vw, 1.6rem);
            border: 1px solid var(--idea-border);
            border-radius: var(--idea-radius-xl);
            background: var(--idea-surface);
            box-shadow: 0 10px 32px rgba(24, 42, 72, .045);
        }

        .ui-panel-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.15rem;
        }

        .step-heading {
            display: flex;
            align-items: flex-start;
            gap: .85rem;
        }

        .step-number {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            color: #ffffff;
            font-size: .82rem;
            font-weight: 800;
            border-radius: 12px;
            background: var(--idea-navy);
            box-shadow: 0 8px 18px rgba(31, 47, 79, .18);
        }

        .step-number-ai {
            color: #7e5b16;
            background: var(--idea-gold-soft);
            box-shadow: none;
        }

        .ui-eyebrow {
            display: block;
            margin-bottom: .22rem;
            color: var(--idea-blue);
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .ui-panel-heading h2,
        .ranking-heading h3 {
            margin: 0;
            color: var(--idea-ink);
            font-size: clamp(1.25rem, 2vw, 1.65rem);
            letter-spacing: -.025em;
            font-weight: 800;
        }

        .ui-panel-heading p {
            max-width: 760px;
            margin: .35rem 0 0;
            color: var(--idea-muted);
            font-size: .82rem;
            line-height: 1.55;
        }

        .ui-btn {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem .95rem;
            font-size: .78rem;
            font-weight: 750;
            line-height: 1;
            text-decoration: none;
            border: 1px solid transparent;
            border-radius: 12px;
            transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
        }

        .ui-btn:hover {
            transform: translateY(-1px);
        }

        .ui-btn-primary {
            color: #ffffff !important;
            border-color: var(--idea-navy) !important;
            background: var(--idea-navy) !important;
            box-shadow: 0 8px 18px rgba(31, 47, 79, .15);
        }

        .ui-btn-primary:hover:not(:disabled) {
            color: #ffffff !important;
            background: var(--idea-navy-2) !important;
        }

        .ui-btn-primary:disabled {
            opacity: .72;
            cursor: default;
            transform: none;
        }

        .ui-btn-secondary {
            color: var(--idea-navy) !important;
            border-color: #d4dfeb !important;
            background: rgba(255, 255, 255, .88) !important;
        }

        .ui-btn-secondary:hover {
            color: var(--idea-navy) !important;
            background: #ffffff !important;
            box-shadow: 0 8px 18px rgba(31, 47, 79, .08);
        }

        .ui-btn-ghost {
            color: var(--idea-navy) !important;
            border-color: #dce4ed !important;
            background: #ffffff !important;
        }

        .selection-status {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .45rem;
            justify-content: flex-end;
        }

        .selection-count,
        .selection-speed {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            min-height: 32px;
            padding: .34rem .65rem;
            font-size: .68rem;
            font-weight: 750;
            border-radius: 999px;
        }

        .selection-count {
            color: var(--idea-navy);
            border: 1px solid #d9e3ee;
            background: var(--idea-blue-soft);
        }

        .selection-count.is-invalid {
            color: var(--idea-red);
            border-color: #efd3d3;
            background: var(--idea-red-soft);
        }

        .selection-count.is-caution {
            color: var(--idea-amber);
            border-color: #f0dfb9;
            background: var(--idea-amber-soft);
        }

        .selection-speed {
            color: #875f17;
            border: 1px solid #ead7aa;
            background: var(--idea-gold-soft);
        }

        .selection-group {
            padding: .9rem;
            border: 1px solid #e5ebf2;
            border-radius: var(--idea-radius-lg);
            background: var(--idea-surface-soft);
        }

        .selection-group-title,
        .older-ideas summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

        .selection-group-title {
            margin-bottom: .75rem;
        }

        .selection-group-title > div {
            display: flex;
            flex-direction: column;
            gap: .1rem;
        }

        .selection-group-title strong {
            color: var(--idea-ink);
            font-size: .82rem;
        }

        .selection-group-title span {
            color: var(--idea-muted);
            font-size: .68rem;
        }

        .selection-group-count {
            padding: .24rem .55rem;
            color: var(--idea-blue) !important;
            font-weight: 750;
            border-radius: 999px;
            background: var(--idea-blue-soft);
        }

        .idea-choice-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
            gap: .7rem;
        }

        .idea-choice-card {
            position: relative;
            min-width: 0;
        }

        .idea-choice-card input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .idea-choice-card label {
            position: relative;
            min-height: 174px;
            display: block;
            padding: .9rem;
            overflow: hidden;
            cursor: pointer;
            border: 1px solid #dfe6ee;
            border-radius: 15px;
            background: #ffffff;
            transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
        }

        .idea-choice-card label:hover {
            transform: translateY(-2px);
            border-color: #becddd;
            box-shadow: 0 10px 22px rgba(31, 47, 79, .07);
        }

        .idea-choice-card input:checked + label {
            border-color: var(--idea-blue);
            box-shadow: inset 0 0 0 1px var(--idea-blue), 0 10px 24px rgba(88, 120, 159, .12);
            background:
                linear-gradient(180deg, rgba(238, 244, 250, .8), #ffffff 75%);
        }

        .idea-choice-card input:focus-visible + label {
            outline: 3px solid rgba(88, 120, 159, .25);
            outline-offset: 2px;
        }

        .choice-check {
            position: absolute;
            top: .7rem;
            right: .7rem;
            width: 25px;
            height: 25px;
            display: grid;
            place-items: center;
            color: transparent;
            font-size: .72rem;
            border: 1px solid #cdd8e4;
            border-radius: 8px;
            background: #ffffff;
            transition: all .16s ease;
        }

        .idea-choice-card input:checked + label .choice-check {
            color: #ffffff;
            border-color: var(--idea-navy);
            background: var(--idea-navy);
        }

        .choice-content {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .choice-badges {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .35rem;
            padding-right: 2rem;
        }

        .choice-badge {
            display: inline-flex;
            align-items: center;
            padding: .2rem .42rem;
            color: #75849a;
            font-size: .56rem;
            font-weight: 800;
            letter-spacing: .035em;
            text-transform: uppercase;
            border: 1px solid #e0e6ed;
            border-radius: 999px;
            background: #f8fafc;
        }

        .choice-badge-latest {
            color: var(--idea-blue);
            border-color: #d4e2ef;
            background: var(--idea-blue-soft);
        }

        .choice-content h3 {
            margin: .65rem 0 .3rem;
            color: var(--idea-ink);
            font-size: .9rem;
            line-height: 1.35;
            font-weight: 780;
        }

        .choice-content p {
            margin: 0;
            color: var(--idea-muted);
            font-size: .68rem;
        }

        .choice-score {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: .5rem;
            margin-top: auto;
            padding-top: .8rem;
        }

        .choice-score span {
            color: #8794a5;
            font-size: .62rem;
            font-weight: 700;
        }

        .choice-score strong {
            color: var(--idea-navy);
            font-size: .92rem;
        }

        .older-ideas {
            margin-top: .75rem;
            border: 1px solid #e3e9f0;
            border-radius: var(--idea-radius-lg);
            background: #ffffff;
        }

        .older-ideas summary {
            padding: .85rem 1rem;
            color: var(--idea-navy);
            font-size: .76rem;
            font-weight: 750;
            cursor: pointer;
            list-style: none;
        }

        .older-ideas summary::-webkit-details-marker {
            display: none;
        }

        .older-ideas summary span {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
        }

        .older-ideas summary small {
            color: var(--idea-muted);
            font-size: .64rem;
        }

        .older-choice-grid {
            padding: 0 .8rem .8rem;
        }

        .selection-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 1rem;
        }

        .selection-hint {
            color: var(--idea-muted);
            font-size: .75rem;
        }

        .compare-submit {
            min-width: 250px;
            justify-content: flex-start;
            padding: .62rem .75rem;
        }

        .compare-submit .button-icon {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 9px;
            background: rgba(255, 255, 255, .13);
        }

        .compare-submit > span:nth-child(2) {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: .12rem;
            margin-right: auto;
        }

        .compare-submit strong {
            font-size: .76rem;
        }

        .compare-submit small {
            color: rgba(255, 255, 255, .68);
            font-size: .57rem;
            font-weight: 600;
        }

        .ui-alert {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            margin-bottom: 1.25rem;
            padding: .9rem 1rem;
            border: 1px solid;
            border-radius: var(--idea-radius-lg);
        }

        .ui-alert-warning {
            color: #6f5117;
            border-color: #ecd9aa;
            background: var(--idea-amber-soft);
        }

        .ui-alert-danger {
            color: #7a2f2f;
            border-color: #f0d3d3;
            background: #fbebeb;
        }

        .ui-alert-icon {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 10px;
            background: rgba(255, 255, 255, .65);
        }

        .ui-alert strong {
            display: block;
            margin-bottom: .12rem;
            font-size: .78rem;
        }

        .ui-alert p {
            margin: 0;
            font-size: .72rem;
            line-height: 1.45;
        }

        .ai-result-panel {
            overflow: hidden;
        }

        .quality-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            min-height: 32px;
            padding: .35rem .65rem;
            color: #40516a !important;
            font-size: .65rem;
            font-weight: 800;
            border: 1px solid #d5dee8;
            border-radius: 999px;
            background: #f3f6f9 !important;
        }

        .quality-badge.bg-success {
            color: #25694c !important;
            border-color: #cfe8db;
            background: var(--idea-green-soft) !important;
        }

        .quality-badge.bg-danger {
            color: #984242 !important;
            border-color: #efd0d0;
            background: var(--idea-red-soft) !important;
        }

        .quality-badge.bg-info {
            color: #3d5d80 !important;
            border-color: #d4e2ef;
            background: var(--idea-blue-soft) !important;
        }

        .winner-card {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(260px, .7fr);
            overflow: hidden;
            border: 1px solid #dbe4ee;
            border-radius: 22px;
            background:
                radial-gradient(circle at 8% 0%, rgba(197, 154, 69, .12), transparent 28%),
                #ffffff;
            box-shadow: 0 18px 38px rgba(31, 47, 79, .08);
        }

        .winner-main {
            padding: clamp(1.1rem, 2.5vw, 1.7rem);
        }

        .winner-scoreboard {
            padding: 1.35rem;
            color: #ffffff;
            background:
                radial-gradient(circle at 80% 10%, rgba(197, 154, 69, .22), transparent 26%),
                linear-gradient(160deg, var(--idea-navy) 0%, #2b4267 100%);
        }

        .winner-topline,
        .ranking-title-line,
        .score-cell-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .65rem;
        }

        .winner-rank {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: #8a651b;
            font-size: .67rem;
            font-weight: 850;
            letter-spacing: .055em;
            text-transform: uppercase;
        }

        .winner-domain {
            padding: .26rem .55rem;
            color: var(--idea-blue);
            font-size: .61rem;
            font-weight: 750;
            border-radius: 999px;
            background: var(--idea-blue-soft);
        }

        .winner-title {
            max-width: 850px;
            margin: .75rem 0 1rem;
            color: var(--idea-ink);
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            line-height: 1.12;
            letter-spacing: -.04em;
            font-weight: 850;
        }

        .winner-reason {
            padding: .8rem .9rem;
            border-left: 3px solid var(--idea-gold);
            border-radius: 0 12px 12px 0;
            background: var(--idea-gold-soft);
        }

        .winner-reason span,
        .winner-insight small,
        .analysis-drawer small,
        .final-recommendation small {
            color: #8b661f;
            font-size: .61rem;
            font-weight: 850;
            letter-spacing: .055em;
            text-transform: uppercase;
        }

        .winner-reason p {
            margin: .25rem 0 0;
            color: #4d4128;
            font-size: .82rem;
            line-height: 1.55;
        }

        .winner-score-note {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            margin-top: .6rem;
            padding: .65rem .8rem;
            color: var(--idea-blue);
            font-size: .78rem;
            line-height: 1.5;
            border-radius: 10px;
            background: var(--idea-blue-soft);
        }

        .winner-score-note i {
            margin-top: .15rem;
            font-size: .85rem;
        }

        .winner-insight-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .7rem;
            margin-top: .9rem;
        }

        .winner-insight {
            display: flex;
            align-items: flex-start;
            gap: .6rem;
            padding: .75rem;
            border: 1px solid #e3e9ef;
            border-radius: 14px;
            background: #fbfcfe;
        }

        .insight-icon {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            font-size: .78rem;
            border-radius: 10px;
        }

        .insight-icon-good {
            color: #2b7d5a;
            background: var(--idea-green-soft);
        }

        .insight-icon-risk {
            color: #9a4444;
            background: var(--idea-red-soft);
        }

        .insight-icon-check {
            color: #4f6f96;
            background: var(--idea-blue-soft);
        }

        .winner-insight small {
            color: #748296;
        }

        .winner-insight p {
            margin: .2rem 0 0;
            color: #4d5b6e;
            font-size: .69rem;
            line-height: 1.45;
        }

        .winner-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .55rem;
            margin-top: 1rem;
        }

        .analysis-drawer {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .65rem;
            margin-top: .9rem;
            padding: .8rem;
            border: 1px solid #dde5ee;
            border-radius: 14px;
            background: #f7f9fc;
        }

        .analysis-drawer[hidden] {
            display: none !important;
        }

        .analysis-drawer > div {
            padding: .65rem;
            border-radius: 11px;
            background: #ffffff;
        }

        .analysis-drawer small {
            color: var(--idea-blue);
        }

        .analysis-drawer p {
            margin: .2rem 0 0;
            color: #526176;
            font-size: .69rem;
            line-height: 1.45;
        }

        .overall-ring {
            --score: 0;
            width: 140px;
            height: 140px;
            display: grid;
            place-items: center;
            margin: 0 auto 1.1rem;
            border-radius: 50%;
            background:
                radial-gradient(circle, var(--idea-navy) 57%, transparent 58%),
                conic-gradient(var(--idea-gold) calc(var(--score) * 1%), rgba(255, 255, 255, .15) 0);
        }

        .overall-ring > div {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .08rem;
        }

        .overall-ring strong {
            color: #ffffff;
            font-size: 1.7rem;
            line-height: 1;
        }

        .overall-ring span {
            color: #afbdd0;
            font-size: .64rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .winner-metrics {
            display: flex;
            flex-direction: column;
            gap: .8rem;
        }

        .winner-metric > div:first-child {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .6rem;
            margin-bottom: .35rem;
        }

        .winner-metric span {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: #c5d0df;
            font-size: .68rem;
            font-weight: 700;
        }

        .winner-metric strong {
            color: #ffffff;
            font-size: .75rem;
        }

        .metric-track {
            height: 6px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(255, 255, 255, .13);
        }

        .metric-track span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #c59a45, #e3c984);
        }

        .partial-note {
            display: flex;
            align-items: flex-start;
            gap: .35rem;
            margin: 1rem 0 0;
            color: #aebcd0;
            font-size: .61rem;
            line-height: 1.4;
        }

        .ranking-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin: 1.35rem 0 .7rem;
        }

        .ranking-heading > span {
            color: var(--idea-muted);
            font-size: .68rem;
            font-weight: 700;
        }

        .ranking-list {
            overflow: hidden;
            border: 1px solid var(--idea-border);
            border-radius: var(--idea-radius-lg);
        }

        .ranking-row {
            display: grid;
            grid-template-columns: 58px minmax(0, 1fr) 90px;
            gap: .85rem;
            padding: 1rem;
            border-bottom: 1px solid var(--idea-border);
            background: #ffffff;
        }

        .ranking-row:last-child {
            border-bottom: 0;
        }

        .ranking-row:hover {
            background: #fbfcfe;
        }

        .ranking-position {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            color: var(--idea-navy);
            font-size: .85rem;
            font-weight: 850;
            border-radius: 13px;
            background: var(--idea-blue-soft);
        }

        .ranking-title-line {
            align-items: flex-start;
        }

        .ranking-title-line h4 {
            margin: 0;
            color: var(--idea-ink);
            font-size: .9rem;
            font-weight: 790;
        }

        .ranking-title-line > div > span {
            display: block;
            margin-top: .15rem;
            color: var(--idea-muted);
            font-size: .63rem;
        }

        .risk-pill {
            flex: 0 0 auto;
            padding: .22rem .48rem;
            font-size: .57rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase;
            border-radius: 999px;
        }

        .risk-low {
            color: #277452;
            background: var(--idea-green-soft);
        }

        .risk-medium {
            color: #8a6018;
            background: var(--idea-gold-soft);
        }

        .risk-high {
            color: #9e4343;
            background: var(--idea-red-soft);
        }

        .ranking-summary {
            margin: .55rem 0;
            color: #566579;
            font-size: .73rem;
            line-height: 1.5;
        }

        .ranking-signals {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }

        .ranking-signals span {
            color: #657489;
            font-size: .66rem;
            line-height: 1.45;
        }

        .ranking-signals i {
            margin-right: .2rem;
            color: var(--idea-blue);
        }

        .ranking-actions {
            margin-top: .6rem;
        }

        .text-action {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: 0;
            color: var(--idea-blue);
            font-size: .66rem;
            font-weight: 800;
            border: 0;
            background: transparent;
        }

        .text-action:hover {
            color: var(--idea-navy);
        }

        .compact-drawer {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ranking-score {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
        }

        .ranking-score strong {
            color: var(--idea-navy);
            font-size: 1.1rem;
        }

        .ranking-score span {
            color: var(--idea-muted);
            font-size: .58rem;
            font-weight: 750;
            text-transform: uppercase;
        }

        .final-recommendation {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            margin-top: .9rem;
            padding: .9rem 1rem;
            border: 1px solid #ead9b4;
            border-radius: 15px;
            background: var(--idea-gold-soft);
        }

        .final-recommendation > span {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            color: #8a6418;
            border-radius: 11px;
            background: rgba(255, 255, 255, .72);
        }

        .final-recommendation p {
            margin: .2rem 0 0;
            color: #5f4d29;
            font-size: .76rem;
            line-height: 1.5;
        }

        .provider-note {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: .35rem;
            margin: .65rem 0 0;
            color: #8a96a7;
            font-size: .59rem;
        }

        .matrix-heading {
            align-items: center;
        }

        .reset-action {
            flex: 0 0 auto;
        }

        .metric-toolbar {
            position: sticky;
            top: 0;
            z-index: 4;
            margin: 0 -1px .85rem;
            padding: .75rem;
            border: 1px solid var(--idea-border);
            border-radius: var(--idea-radius-lg);
            background: rgba(255, 255, 255, .96);
            backdrop-filter: blur(10px);
        }

        .metric-tabs {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .55rem;
        }

        .metric-tab {
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .55rem .65rem;
            color: #68778b;
            text-align: left;
            border: 1px solid #dfe6ee;
            border-radius: 12px;
            background: #ffffff;
            transition: border-color .15s ease, background .15s ease, color .15s ease;
        }

        .metric-tab > span {
            width: 29px;
            height: 29px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 9px;
            background: #f2f5f8;
        }

        .metric-tab strong {
            margin-right: auto;
            font-size: .7rem;
        }

        .metric-tab .metric-check {
            color: transparent;
        }

        .metric-tab.active {
            color: var(--idea-navy);
            border-color: var(--idea-blue);
            background: var(--idea-blue-soft);
        }

        .metric-tab.active > span {
            color: #ffffff;
            background: var(--idea-blue);
        }

        .metric-tab.active .metric-check {
            color: var(--idea-blue);
        }

        .selected-metrics {
            margin-top: .6rem;
            color: var(--idea-muted);
            font-size: .66rem;
        }

        .score-matrix-shell {
            overflow-x: auto;
            border: 1px solid var(--idea-border);
            border-radius: var(--idea-radius-lg);
        }

        .score-matrix {
            width: 100%;
            min-width: 920px;
            border-collapse: separate;
            border-spacing: 0;
            background: #ffffff;
        }

        .score-matrix th {
            padding: .75rem;
            color: #718096;
            font-size: .61rem;
            font-weight: 850;
            letter-spacing: .045em;
            text-align: left;
            text-transform: uppercase;
            border-bottom: 1px solid var(--idea-border);
            background: #f7f9fc;
        }

        .score-matrix th i {
            margin-right: .25rem;
        }

        .idea-column {
            min-width: 330px;
        }

        .metric-column {
            min-width: 165px;
        }

        .action-column {
            width: 115px;
            text-align: center !important;
        }

        .idea-matrix-row {
            transition: background .15s ease;
        }

        .idea-matrix-row:hover {
            background: #fbfcfe;
        }

        .idea-matrix-row.best-match {
            background: #f2f7fc;
        }

        .idea-matrix-row.best-match .idea-cell {
            box-shadow: inset 3px 0 0 var(--idea-blue);
        }

        .idea-matrix-row.selected {
            background: #f3faf6;
        }

        .score-matrix td {
            padding: .72rem;
            vertical-align: top;
            border-bottom: 1px solid #edf1f5;
        }

        .score-matrix tr:last-child td {
            border-bottom: 0;
        }

        .idea-cell {
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            min-width: 330px;
        }

        .idea-index {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            color: var(--idea-navy);
            font-size: .68rem;
            font-weight: 850;
            border-radius: 9px;
            background: var(--idea-blue-soft);
        }

        .idea-cell-title {
            display: flex;
            align-items: flex-start;
            gap: .45rem;
        }

        .idea-cell-title h3 {
            margin: 0;
            color: var(--idea-ink);
            font-size: .78rem;
            line-height: 1.35;
            font-weight: 780;
        }

        .official-pill,
        .legacy-pill {
            display: inline-flex;
            align-items: center;
            gap: .25rem;
            flex: 0 0 auto;
            padding: .17rem .4rem;
            font-size: .52rem;
            font-weight: 850;
            border-radius: 999px;
        }

        .official-pill {
            color: #287151;
            background: var(--idea-green-soft);
        }

        .legacy-pill {
            color: #86601d;
            background: var(--idea-gold-soft);
        }

        .idea-cell-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .35rem .7rem;
            margin-top: .4rem;
            color: var(--idea-muted);
            font-size: .59rem;
        }

        .idea-cell-meta span {
            display: inline-flex;
            align-items: center;
            gap: .25rem;
        }

        .score-cell {
            min-width: 165px;
        }

        .score-cell-card {
            min-height: 106px;
            padding: .65rem;
            border: 1px solid #e3e9ef;
            border-radius: 13px;
            background: #ffffff;
        }

        .score-cell-top strong {
            color: var(--idea-navy);
            font-size: .95rem;
        }

        .score-cell-top span {
            color: var(--idea-muted);
            font-size: .58rem;
            font-weight: 750;
        }

        .metric-track-light {
            height: 5px;
            margin: .45rem 0;
            background: #edf1f5;
        }

        .metric-track-light span {
            background: linear-gradient(90deg, var(--idea-blue), #89a5c4);
        }

        .score-explainer summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .4rem;
            color: var(--idea-blue);
            font-size: .58rem;
            font-weight: 800;
            cursor: pointer;
            list-style: none;
        }

        .score-explainer summary::-webkit-details-marker {
            display: none;
        }

        .score-explainer[open] summary i {
            transform: rotate(180deg);
        }

        .score-explainer > div {
            margin-top: .55rem;
            padding-top: .55rem;
            border-top: 1px solid #edf1f5;
        }

        .score-explainer small {
            display: block;
            color: #8a97a7;
            font-size: .5rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .score-explainer strong {
            display: block;
            margin-top: .1rem;
            color: var(--idea-navy);
            font-size: .56rem;
        }

        .score-explainer p {
            margin: .35rem 0 0;
            color: #607085;
            font-size: .56rem;
            line-height: 1.4;
        }

        .decision-cell {
            text-align: center;
        }

        .decision-btn {
            min-width: 88px;
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            color: var(--idea-navy);
            font-size: .66rem;
            font-weight: 800;
            border: 1px solid #d5dfe9;
            border-radius: 10px;
            background: #ffffff;
        }

        .decision-btn:hover:not(:disabled) {
            border-color: var(--idea-blue);
            background: var(--idea-blue-soft);
        }

        .decision-btn.selected {
            color: #287151;
            border-color: #cce5d8;
            background: var(--idea-green-soft);
        }

        .decision-btn:disabled {
            opacity: 1;
            cursor: default;
        }

        .metric-recommendation {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .8rem;
            margin-top: .85rem;
            padding: 1rem;
            color: #ffffff;
            border-radius: var(--idea-radius-lg);
            background:
                radial-gradient(circle at 90% 10%, rgba(197, 154, 69, .23), transparent 28%),
                linear-gradient(135deg, var(--idea-navy) 0%, #314a70 100%);
        }

        .metric-recommendation-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            color: #e6c97d;
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 13px;
            background: rgba(255, 255, 255, .08);
        }

        .metric-recommendation .ui-eyebrow {
            color: #b8c6d9;
        }

        .metric-recommendation h3 {
            margin: 0;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
        }

        .metric-recommendation p {
            margin: .2rem 0 0;
            color: #c3cfdf;
            font-size: .67rem;
        }

        .metric-recommendation .ui-btn-primary {
            color: var(--idea-navy) !important;
            border-color: #e3c576 !important;
            background: #e3c576 !important;
            box-shadow: none;
        }

        .metric-recommendation .ui-btn-primary:hover:not(:disabled) {
            color: var(--idea-navy) !important;
            background: #ecd58f !important;
        }

        .rotate-180 {
            transform: rotate(180deg);
        }

        .ic-hidden {
            display: none !important;
        }

        @@media (max-width: 1100px) {
            .winner-card {
                grid-template-columns: 1fr;
            }

            .winner-scoreboard {
                display: grid;
                grid-template-columns: 160px minmax(0, 1fr);
                align-items: center;
                gap: 1.2rem;
            }

            .overall-ring {
                margin-bottom: 0;
            }

            .winner-insight-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 900px) {
            .idea-hero {
                align-items: flex-start;
                flex-direction: column;
            }

            .idea-hero-actions {
                width: 100%;
            }

            .idea-hero-actions .ui-btn {
                width: 100%;
            }

            .metric-tabs {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .ranking-signals {
                grid-template-columns: 1fr;
            }

            .metric-recommendation {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .metric-recommendation-action {
                grid-column: 1 / -1;
            }

            .metric-recommendation-action .ui-btn {
                width: 100%;
            }
        }

        @@media (max-width: 720px) {
            .idea-page-shell,
            .idea-empty-shell {
                width: min(100% - 1rem, 1480px);
                padding-top: .6rem;
            }

            .idea-hero,
            .ui-panel {
                border-radius: 18px;
            }

            .ui-panel-heading,
            .selection-footer,
            .ranking-heading {
                align-items: stretch;
                flex-direction: column;
            }

            .selection-status {
                justify-content: flex-start;
            }

            .compare-submit {
                width: 100%;
            }

            .winner-scoreboard {
                grid-template-columns: 1fr;
            }

            .overall-ring {
                margin: 0 auto 1rem;
            }

            .analysis-drawer,
            .compact-drawer {
                grid-template-columns: 1fr;
            }

            .ranking-row {
                grid-template-columns: 44px minmax(0, 1fr);
            }

            .ranking-score {
                grid-column: 2;
                align-items: flex-start;
            }

            .idea-choice-grid {
                grid-template-columns: 1fr;
            }

            .metric-tabs {
                grid-template-columns: 1fr;
            }

            .metric-toolbar {
                position: static;
            }
        }

