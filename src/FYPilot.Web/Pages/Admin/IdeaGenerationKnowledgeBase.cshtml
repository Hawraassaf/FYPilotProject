@page
@model FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel
@{
    ViewData["Title"] = "Idea Generation Knowledge Base";
    ViewData["Subtitle"] = "Simple institutional guidance for better project ideas.";

    var guidanceActive = Model.ActiveTab == "guidance";
    var projectsActive = Model.ActiveTab == "projects";
    var opportunitiesActive = Model.ActiveTab == "opportunities";
}

<section class="ikb-page" data-active-tab="@Model.ActiveTab">

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="ikb-alert is-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Changes saved</strong>
                <span>@Model.SuccessMessage</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="ikb-alert is-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Action could not be completed</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <header class="ikb-hero">
        <div>
            <span class="ikb-kicker">FYPILOT ADMIN</span>
            <h1>Idea Generation Knowledge Base</h1>
            <p>
                Add simple institutional context so FYPilot can generate more relevant,
                original and practical Computer Science project ideas.
            </p>

            <div class="ikb-hero-tags">
                <span><i class="bi bi-lightbulb"></i> Guide ideas</span>
                <span><i class="bi bi-shield-check"></i> Prevent repetition</span>
                <span><i class="bi bi-stars"></i> Preserve opportunities</span>
            </div>
        </div>

        <div class="ikb-coverage">
            <span>Active knowledge</span>
            <strong>
                @(Model.ActiveGuidanceCount
                  + Model.HistoricalProjectsCount
                  + Model.ActiveFutureOpportunitiesCount)
            </strong>
            <small>Total records available</small>
        </div>
    </header>

    <section class="ikb-metrics">
        <article>
            <span class="metric-icon blue"><i class="bi bi-lightbulb"></i></span>
            <div>
                <small>Active Guidance</small>
                <strong>@Model.ActiveGuidanceCount</strong>
            </div>
        </article>

        <article>
            <span class="metric-icon violet"><i class="bi bi-archive"></i></span>
            <div>
                <small>Previous Projects</small>
                <strong>@Model.HistoricalProjectsCount</strong>
            </div>
        </article>

        <article>
            <span class="metric-icon red"><i class="bi bi-slash-circle"></i></span>
            <div>
                <small>Excluded Projects</small>
                <strong>@Model.ExcludedProjectsCount</strong>
            </div>
        </article>

        <article>
            <span class="metric-icon green"><i class="bi bi-signpost-split"></i></span>
            <div>
                <small>Future Opportunities</small>
                <strong>@Model.ActiveFutureOpportunitiesCount</strong>
            </div>
        </article>
    </section>

    <section class="ikb-workspace">
        <nav class="ikb-tabs">
            <ul class="nav" id="ikbTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(guidanceActive ? "active" : "")"
                            id="guidance-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#guidance-pane"
                            type="button"
                            role="tab"
                            aria-selected="@(guidanceActive.ToString().ToLowerInvariant())">
                        <i class="bi bi-lightbulb"></i>
                        <span>
                            <strong>Guidance</strong>
                            <small>Tell the AI what to prefer or avoid</small>
                        </span>
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link @(projectsActive ? "active" : "")"
                            id="projects-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#projects-pane"
                            type="button"
                            role="tab"
                            aria-selected="@(projectsActive.ToString().ToLowerInvariant())">
                        <i class="bi bi-archive"></i>
                        <span>
                            <strong>Previous Projects</strong>
                            <small>Save history and prevent duplicates</small>
                        </span>
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link @(opportunitiesActive ? "active" : "")"
                            id="opportunities-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#opportunities-pane"
                            type="button"
                            role="tab"
                            aria-selected="@(opportunitiesActive.ToString().ToLowerInvariant())">
                        <i class="bi bi-stars"></i>
                        <span>
                            <strong>Future Opportunities</strong>
                            <small>Save useful next-step ideas</small>
                        </span>
                    </button>
                </li>
            </ul>
        </nav>

        <div class="tab-content ikb-content" id="ikbTabsContent">

            @* ========================================================
               Guidance
               ======================================================== *@

            <div class="tab-pane fade @(guidanceActive ? "show active" : "")"
                 id="guidance-pane"
                 role="tabpanel"
                 aria-labelledby="guidance-tab">

                <div class="ikb-section-heading">
                    <div>
                        <span>GUIDANCE</span>
                        <h2>What should FYPilot consider?</h2>
                        <p>Add one clear rule. Keep it short and direct.</p>
                    </div>
                    <strong>@Model.GuidanceItems.Count total</strong>
                </div>

                <div class="ikb-layout">
                    <aside class="ikb-form-card">
                        <header>
                            <span><i class="bi bi-lightbulb"></i></span>
                            <div>
                                <small>@(Model.NewGuidance.Id > 0 ? "EDIT GUIDANCE" : "NEW GUIDANCE")</small>
                                <h3>@(Model.NewGuidance.Id > 0 ? "Update the rule" : "Add one simple rule")</h3>
                            </div>
                        </header>

                        <form method="post"
                              asp-page-handler="CreateGuidance"
                              class="ikb-form">

                            <input type="hidden" asp-for="NewGuidance.Id" />

                            <div class="ikb-field">
                                <label asp-for="NewGuidance.Title">Rule title</label>
                                <input asp-for="NewGuidance.Title"
                                       class="form-control"
                                       maxlength="200"
                                       placeholder="Example: Prefer Lebanese problems" />
                                <span asp-validation-for="NewGuidance.Title" class="text-danger"></span>
                            </div>

                            <div class="ikb-field">
                                <label asp-for="NewGuidance.Content">What should the AI do?</label>
                                <textarea asp-for="NewGuidance.Content"
                                          class="form-control"
                                          rows="4"
                                          maxlength="4000"
                                          placeholder="Example: Prefer ideas that solve real problems faced by Lebanese students or businesses."></textarea>
                                <span asp-validation-for="NewGuidance.Content" class="text-danger"></span>
                            </div>

                            <div class="ikb-grid">
                                <div class="ikb-field">
                                    <label asp-for="NewGuidance.GuidanceType">Rule type</label>
                                    <select asp-for="NewGuidance.GuidanceType" class="form-select">
                                        @foreach (var type in FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel.GuidanceTypes)
                                        {
                                            <option value="@type">@FormatLabel(type)</option>
                                        }
                                    </select>
                                </div>

                                <div class="ikb-field">
                                    <label asp-for="NewGuidance.Domain">Domain</label>
                                    <select asp-for="NewGuidance.Domain" class="form-select">
                                        <option value="">All CS domains</option>
                                        @foreach (var domain in FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel.PreferredDomains)
                                        {
                                            <option value="@domain">@domain</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewGuidance.Domain" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="ikb-field compact-field">
                                <label asp-for="NewGuidance.Priority">Importance</label>
                                <select asp-for="NewGuidance.Priority" class="form-select">
                                    <option value="1">Low</option>
                                    <option value="2">Normal</option>
                                    <option value="3">Important</option>
                                    <option value="4">High</option>
                                    <option value="5">Critical</option>
                                </select>
                                <span asp-validation-for="NewGuidance.Priority" class="text-danger"></span>
                            </div>

                            <div class="ikb-actions">
                                <button type="submit" class="ikb-primary-btn">
                                    <i class="bi @(Model.NewGuidance.Id > 0 ? "bi-check2" : "bi-plus-lg")"></i>
                                    @(Model.NewGuidance.Id > 0 ? "Save changes" : "Add guidance")
                                </button>

                                @if (Model.NewGuidance.Id > 0)
                                {
                                    <a asp-page="./IdeaGenerationKnowledgeBase"
                                       asp-route-activeTab="guidance"
                                       class="ikb-secondary-btn">
                                        Cancel
                                    </a>
                                }
                            </div>
                        </form>
                    </aside>

                    <section class="ikb-library">
                        <header>
                            <div>
                                <small>GUIDANCE LIBRARY</small>
                                <h3>Saved rules</h3>
                            </div>
                            <strong>@Model.GuidanceItems.Count</strong>
                        </header>

                        @if (!Model.GuidanceItems.Any())
                        {
                            <div class="ikb-empty">
                                <span><i class="bi bi-lightbulb"></i></span>
                                <h3>No guidance yet</h3>
                                <p>Add one short rule using the form.</p>
                            </div>
                        }
                        else
                        {
                            <div class="ikb-records">
                                @foreach (var item in Model.GuidanceItems)
                                {
                                    <article class="ikb-record @(item.IsActive ? "" : "is-inactive")">
                                        <div class="record-top">
                                            <div class="record-title">
                                                <span><i class="bi bi-lightbulb"></i></span>
                                                <div>
                                                    <div class="record-badges">
                                                        <em>@FormatLabel(item.GuidanceType)</em>
                                                        <em class="@(item.IsActive ? "active" : "inactive")">
                                                            @(item.IsActive ? "Active" : "Inactive")
                                                        </em>
                                                    </div>
                                                    <h4>@item.Title</h4>
                                                </div>
                                            </div>

                                            <div class="record-actions">
                                                <a asp-page="./IdeaGenerationKnowledgeBase"
                                                   asp-route-editGuidanceId="@item.Id">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit
                                                </a>

                                                <form method="post"
                                                      asp-page-handler="ToggleGuidanceActive"
                                                      asp-route-id="@item.Id"
                                                      onsubmit="return confirm('@(item.IsActive ? "Deactivate" : "Activate") this guidance item?');">
                                                    <button type="submit" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <p>@Truncate(item.Content, 180)</p>

                                        <footer>
                                            <span><i class="bi bi-grid"></i> @(item.Domain ?? "All CS domains")</span>
                                            <span><i class="bi bi-flag"></i> Priority @item.Priority</span>
                                        </footer>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>

            @* ========================================================
               Previous Projects
               ======================================================== *@

            <div class="tab-pane fade @(projectsActive ? "show active" : "")"
                 id="projects-pane"
                 role="tabpanel"
                 aria-labelledby="projects-tab">

                <div class="ikb-section-heading">
                    <div>
                        <span>PROJECT HISTORY</span>
                        <h2>Which projects already exist?</h2>
                        <p>Add only the main details needed to recognize the project.</p>
                    </div>
                    <strong>@Model.HistoricalProjects.Count total</strong>
                </div>

                <div class="ikb-layout">
                    <aside class="ikb-form-card">
                        <header>
                            <span><i class="bi bi-archive"></i></span>
                            <div>
                                <small>@(Model.NewProject.Id > 0 ? "EDIT PROJECT" : "NEW PROJECT")</small>
                                <h3>@(Model.NewProject.Id > 0 ? "Update the project" : "Register a previous project")</h3>
                            </div>
                        </header>

                        <form method="post"
                              asp-page-handler="CreateProject"
                              class="ikb-form">

                            <input type="hidden" asp-for="NewProject.Id" />

                            <div class="ikb-field">
                                <label asp-for="NewProject.Title">Project title</label>
                                <input asp-for="NewProject.Title"
                                       class="form-control"
                                       maxlength="200"
                                       placeholder="Example: AI Student Advising Chatbot" />
                                <span asp-validation-for="NewProject.Title" class="text-danger"></span>
                            </div>

                            <div class="ikb-field">
                                <label asp-for="NewProject.ProblemStatement">What did the project do?</label>
                                <textarea asp-for="NewProject.ProblemStatement"
                                          class="form-control"
                                          rows="4"
                                          maxlength="4000"
                                          placeholder="Write one short description of the problem and solution."></textarea>
                                <span asp-validation-for="NewProject.ProblemStatement" class="text-danger"></span>
                            </div>

                            <div class="ikb-grid">
                                <div class="ikb-field">
                                    <label asp-for="NewProject.Domain">Domain</label>
                                    <select asp-for="NewProject.Domain" class="form-select">
                                        <option value="">General Software System</option>
                                        @foreach (var domain in FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel.PreferredDomains)
                                        {
                                            <option value="@domain">@domain</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewProject.Domain" class="text-danger"></span>
                                </div>

                                <div class="ikb-field">
                                    <label asp-for="NewProject.ProjectStatus">Status</label>
                                    <select asp-for="NewProject.ProjectStatus" class="form-select">
                                        @foreach (var status in FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel.ProjectStatuses)
                                        {
                                            <option value="@status">@FormatLabel(status)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="ikb-field compact-field">
                                <label asp-for="NewProject.CompletionYear">Year</label>
                                <input asp-for="NewProject.CompletionYear"
                                       type="number"
                                       class="form-control"
                                       min="2000"
                                       max="2100"
                                       placeholder="@DateTime.UtcNow.Year" />
                                <span asp-validation-for="NewProject.CompletionYear" class="text-danger"></span>
                            </div>

                            <div class="ikb-choice-list">
                                <label class="ikb-choice">
                                    <input asp-for="NewProject.ExcludeSimilarIdeas"
                                           class="form-check-input"
                                           type="checkbox" />
                                    <span class="choice-icon danger">
                                        <i class="bi bi-slash-circle"></i>
                                    </span>
                                    <span>
                                        <strong>Prevent similar ideas</strong>
                                        <small>Do not generate projects that are too similar.</small>
                                    </span>
                                </label>

                                <label class="ikb-choice">
                                    <input asp-for="NewProject.AllowAsInspiration"
                                           class="form-check-input"
                                           type="checkbox" />
                                    <span class="choice-icon success">
                                        <i class="bi bi-stars"></i>
                                    </span>
                                    <span>
                                        <strong>Allow as inspiration</strong>
                                        <small>Use it only to inspire a meaningfully different idea.</small>
                                    </span>
                                </label>
                            </div>

                            <div class="ikb-actions">
                                <button type="submit" class="ikb-primary-btn">
                                    <i class="bi @(Model.NewProject.Id > 0 ? "bi-check2" : "bi-plus-lg")"></i>
                                    @(Model.NewProject.Id > 0 ? "Save changes" : "Register project")
                                </button>

                                @if (Model.NewProject.Id > 0)
                                {
                                    <a asp-page="./IdeaGenerationKnowledgeBase"
                                       asp-route-activeTab="projects"
                                       class="ikb-secondary-btn">
                                        Cancel
                                    </a>
                                }
                            </div>
                        </form>
                    </aside>

                    <section class="ikb-library">
                        <header>
                            <div>
                                <small>PROJECT LIBRARY</small>
                                <h3>Previous FYP projects</h3>
                            </div>
                            <strong>@Model.HistoricalProjects.Count</strong>
                        </header>

                        @if (!Model.HistoricalProjects.Any())
                        {
                            <div class="ikb-empty">
                                <span><i class="bi bi-archive"></i></span>
                                <h3>No previous projects</h3>
                                <p>Add the first project using the simple form.</p>
                            </div>
                        }
                        else
                        {
                            <div class="ikb-records">
                                @foreach (var project in Model.HistoricalProjects)
                                {
                                    <article class="ikb-record @(project.IsActive ? "" : "is-inactive")">
                                        <div class="record-top">
                                            <div class="record-title">
                                                <span><i class="bi bi-folder2-open"></i></span>
                                                <div>
                                                    <div class="record-badges">
                                                        <em>@FormatLabel(project.ProjectStatus)</em>

                                                        @if (project.ExcludeSimilarIdeas)
                                                        {
                                                            <em class="danger">Excluded</em>
                                                        }

                                                        @if (project.AllowAsInspiration)
                                                        {
                                                            <em class="opportunity">Inspiration</em>
                                                        }
                                                    </div>
                                                    <h4>@project.Title</h4>
                                                </div>
                                            </div>

                                            <div class="record-actions">
                                                <a asp-page="./IdeaGenerationKnowledgeBase"
                                                   asp-route-editProjectId="@project.Id">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit
                                                </a>

                                                <form method="post"
                                                      asp-page-handler="ToggleProjectActive"
                                                      asp-route-id="@project.Id"
                                                      onsubmit="return confirm('@(project.IsActive ? "Deactivate" : "Activate") this project?');">
                                                    <button type="submit" title="@(project.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="bi @(project.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <p>@Truncate(project.ProblemStatement, 190)</p>

                                        <footer>
                                            <span><i class="bi bi-grid"></i> @(project.Domain ?? "General Software System")</span>
                                            <span><i class="bi bi-calendar3"></i> @(project.CompletionYear?.ToString() ?? "Year not set")</span>
                                            <span><i class="bi bi-signpost-split"></i> @project.FutureOpportunities.Count opportunities</span>
                                        </footer>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>

            @* ========================================================
               Future Opportunities
               ======================================================== *@

            <div class="tab-pane fade @(opportunitiesActive ? "show active" : "")"
                 id="opportunities-pane"
                 role="tabpanel"
                 aria-labelledby="opportunities-tab">

                <div class="ikb-section-heading">
                    <div>
                        <span>FUTURE OPPORTUNITIES</span>
                        <h2>What could be built next?</h2>
                        <p>Save one clear extension connected to a previous project.</p>
                    </div>
                    <strong>@Model.FutureOpportunities.Count total</strong>
                </div>

                <div class="ikb-layout">
                    <aside class="ikb-form-card">
                        <header>
                            <span><i class="bi bi-stars"></i></span>
                            <div>
                                <small>@(Model.NewOpportunity.Id > 0 ? "EDIT OPPORTUNITY" : "NEW OPPORTUNITY")</small>
                                <h3>@(Model.NewOpportunity.Id > 0 ? "Update the opportunity" : "Add a future direction")</h3>
                            </div>
                        </header>

                        @if (!Model.HistoricalProjects.Any())
                        {
                            <div class="ikb-form-empty">
                                <span><i class="bi bi-folder-plus"></i></span>
                                <h3>Add a previous project first</h3>
                                <p>Every future opportunity must be linked to one project.</p>
                                <button type="button"
                                        class="ikb-primary-btn"
                                        data-open-tab="projects-tab">
                                    Open Previous Projects
                                </button>
                            </div>
                        }
                        else
                        {
                            <form method="post"
                                  asp-page-handler="CreateOpportunity"
                                  class="ikb-form">

                                <input type="hidden" asp-for="NewOpportunity.Id" />

                                <div class="ikb-field">
                                    <label asp-for="NewOpportunity.HistoricalFypProjectId">Previous project</label>
                                    <select asp-for="NewOpportunity.HistoricalFypProjectId" class="form-select">
                                        <option value="0">Choose a project</option>
                                        @foreach (var project in Model.HistoricalProjects)
                                        {
                                            <option value="@project.Id">@project.Title</option>
                                        }
                                    </select>
                                    <span asp-validation-for="NewOpportunity.HistoricalFypProjectId" class="text-danger"></span>
                                </div>

                                <div class="ikb-field">
                                    <label asp-for="NewOpportunity.Title">Opportunity title</label>
                                    <input asp-for="NewOpportunity.Title"
                                           class="form-control"
                                           maxlength="200"
                                           placeholder="Example: Add Lebanese Arabic voice support" />
                                    <span asp-validation-for="NewOpportunity.Title" class="text-danger"></span>
                                </div>

                                <div class="ikb-field">
                                    <label asp-for="NewOpportunity.Description">What could be added next?</label>
                                    <textarea asp-for="NewOpportunity.Description"
                                              class="form-control"
                                              rows="4"
                                              maxlength="4000"
                                              placeholder="Write one short description of the future extension."></textarea>
                                    <span asp-validation-for="NewOpportunity.Description" class="text-danger"></span>
                                </div>

                                <div class="ikb-grid">
                                    <div class="ikb-field">
                                        <label asp-for="NewOpportunity.SuggestedDomain">Domain</label>
                                        <select asp-for="NewOpportunity.SuggestedDomain" class="form-select">
                                            <option value="">Any CS domain</option>
                                            @foreach (var domain in FYPilot.Web.Pages.Admin.IdeaGenerationKnowledgeBaseModel.PreferredDomains)
                                            {
                                                <option value="@domain">@domain</option>
                                            }
                                        </select>
                                        <span asp-validation-for="NewOpportunity.SuggestedDomain" class="text-danger"></span>
                                    </div>

                                    <div class="ikb-field">
                                        <label asp-for="NewOpportunity.Priority">Importance</label>
                                        <select asp-for="NewOpportunity.Priority" class="form-select">
                                            <option value="1">Low</option>
                                            <option value="2">Normal</option>
                                            <option value="3">Important</option>
                                            <option value="4">High</option>
                                            <option value="5">Critical</option>
                                        </select>
                                        <span asp-validation-for="NewOpportunity.Priority" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="ikb-actions">
                                    <button type="submit" class="ikb-primary-btn">
                                        <i class="bi @(Model.NewOpportunity.Id > 0 ? "bi-check2" : "bi-plus-lg")"></i>
                                        @(Model.NewOpportunity.Id > 0 ? "Save changes" : "Add opportunity")
                                    </button>

                                    @if (Model.NewOpportunity.Id > 0)
                                    {
                                        <a asp-page="./IdeaGenerationKnowledgeBase"
                                           asp-route-activeTab="opportunities"
                                           class="ikb-secondary-btn">
                                            Cancel
                                        </a>
                                    }
                                </div>
                            </form>
                        }
                    </aside>

                    <section class="ikb-library">
                        <header>
                            <div>
                                <small>OPPORTUNITY LIBRARY</small>
                                <h3>Saved future directions</h3>
                            </div>
                            <strong>@Model.FutureOpportunities.Count</strong>
                        </header>

                        @if (!Model.FutureOpportunities.Any())
                        {
                            <div class="ikb-empty">
                                <span><i class="bi bi-stars"></i></span>
                                <h3>No future opportunities</h3>
                                <p>Add the first future direction using the form.</p>
                            </div>
                        }
                        else
                        {
                            <div class="ikb-records">
                                @foreach (var opportunity in Model.FutureOpportunities)
                                {
                                    <article class="ikb-record @(opportunity.IsActive ? "" : "is-inactive")">
                                        <div class="record-top">
                                            <div class="record-title">
                                                <span><i class="bi bi-stars"></i></span>
                                                <div>
                                                    <div class="record-badges">
                                                        <em class="opportunity">Future direction</em>
                                                        <em class="@(opportunity.IsActive ? "active" : "inactive")">
                                                            @(opportunity.IsActive ? "Active" : "Inactive")
                                                        </em>
                                                    </div>
                                                    <h4>@opportunity.Title</h4>
                                                </div>
                                            </div>

                                            <div class="record-actions">
                                                <a asp-page="./IdeaGenerationKnowledgeBase"
                                                   asp-route-editOpportunityId="@opportunity.Id">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit
                                                </a>

                                                <form method="post"
                                                      asp-page-handler="ToggleOpportunityActive"
                                                      asp-route-id="@opportunity.Id"
                                                      onsubmit="return confirm('@(opportunity.IsActive ? "Deactivate" : "Activate") this future opportunity?');">
                                                    <button type="submit" title="@(opportunity.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="bi @(opportunity.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <p>@Truncate(opportunity.Description, 185)</p>

                                        <div class="parent-project">
                                            <i class="bi bi-diagram-3"></i>
                                            <span>From:</span>
                                            <strong>@opportunity.HistoricalFypProject.Title</strong>
                                        </div>

                                        <footer>
                                            <span><i class="bi bi-grid"></i> @(opportunity.SuggestedDomain ?? "Any CS domain")</span>
                                            <span><i class="bi bi-flag"></i> Priority @opportunity.Priority</span>
                                        </footer>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>
        </div>
    </section>
</section>

@functions {
    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length <= maxLength
            ? value
            : value[..maxLength] + "...";
    }

    private static string FormatLabel(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var result = new System.Text.StringBuilder();

        for (var index = 0; index < value.Length; index++)
        {
            var current = value[index];

            if (index > 0
                && char.IsUpper(current)
                && !char.IsWhiteSpace(value[index - 1]))
            {
                result.Append(' ');
            }

            result.Append(current);
        }

        return result.ToString();
    }
}

