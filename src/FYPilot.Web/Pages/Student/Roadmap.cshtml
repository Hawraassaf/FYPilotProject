@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>

    <script>
        (function () {
            const phaseButtons = document.querySelectorAll("[data-phase-select]");
            const phasePanels = document.querySelectorAll("[data-phase-panel]");

            function selectPhase(phaseId, moveFocus) {
                phasePanels.forEach(function (panel) {
                    const isActive = panel.getAttribute("data-phase-panel") === phaseId;
                    panel.classList.toggle("is-active", isActive);
                    panel.setAttribute("aria-hidden", isActive ? "false" : "true");
                });

                phaseButtons.forEach(function (button) {
                    const isActive = button.getAttribute("data-phase-select") === phaseId;

                    if (button.getAttribute("role") === "tab") {
                        button.classList.toggle("is-selected", isActive);
                        button.setAttribute("aria-selected", isActive ? "true" : "false");
                    }
                });

                if (moveFocus) {
                    const selector = `[data-phase-panel="${phaseId.replace(/"/g, '\\"')}"]`;
                    const panel = document.querySelector(selector);

                    if (panel) {
                        panel.scrollIntoView({
                            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                                ? "auto"
                                : "smooth",
                            block: "start"
                        });
                    }
                }
            }

            phaseButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const phaseId = button.getAttribute("data-phase-select");

                    if (phaseId) {
                        selectPhase(phaseId, button.getAttribute("role") !== "tab");
                    }
                });

                if (button.getAttribute("role") === "tab") {
                    button.addEventListener("keydown", function (event) {
                        const tabs = Array.from(document.querySelectorAll('[role="tab"][data-phase-select]'));
                        const index = tabs.indexOf(button);
                        let nextIndex = -1;

                        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
                            nextIndex = (index + 1) % tabs.length;
                        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
                            nextIndex = (index - 1 + tabs.length) % tabs.length;
                        } else if (event.key === "Home") {
                            nextIndex = 0;
                        } else if (event.key === "End") {
                            nextIndex = tabs.length - 1;
                        }

                        if (nextIndex >= 0) {
                            event.preventDefault();
                            tabs[nextIndex].focus();

                            const phaseId = tabs[nextIndex].getAttribute("data-phase-select");

                            if (phaseId) {
                                selectPhase(phaseId, false);
                            }
                        }
                    });
                }
            });
        })();

        (function () {
            const overlay =
                document.getElementById("rmLoadingOverlay");

            const form =
                document.getElementById("rmGenerateForm");

            if (!overlay || !form) {
                return;
            }

            const submitButton =
                form.querySelector('button[type="submit"]');

            const reduceMotion =
                window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;

            const steps = Array.from(
                overlay.querySelectorAll(
                    ".roadmap-loading-steps li")
            );

            let timerId = null;
            let isSubmitting = false;

            form.addEventListener(
                "submit",
                function (event) {
                    if (isSubmitting) {
                        event.preventDefault();
                        return;
                    }

                    isSubmitting = true;
                    overlay.classList.remove("d-none");

                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.setAttribute(
                            "aria-disabled",
                            "true");
                    }

                    if (reduceMotion || steps.length === 0) {
                        return;
                    }

                    let currentIndex = 0;

                    timerId = window.setInterval(
                        function () {
                            steps.forEach(
                                function (step, index) {
                                    step.classList.toggle(
                                        "is-active",
                                        index === currentIndex);
                                });

                            currentIndex =
                                (currentIndex + 1)
                                % steps.length;
                        },
                        1300);
                });

            window.addEventListener(
                "pageshow",
                function () {
                    overlay.classList.add("d-none");
                    isSubmitting = false;

                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.removeAttribute(
                            "aria-disabled");
                    }

                    if (timerId) {
                        window.clearInterval(timerId);
                        timerId = null;
                    }
                });
        })();

        (function () {
            const button = document.getElementById("rmDownloadPdfButton");
            const root = document.getElementById("roadmap-print-root");

            if (!button || !root) {
                return;
            }

            const label = button.querySelector("span");
            const defaultLabel = label ? label.textContent : "Export PDF";

            function cleanupPdfUi(stage, cover) {
                if (stage && stage.parentNode) {
                    stage.parentNode.removeChild(stage);
                }

                if (cover && cover.parentNode) {
                    cover.parentNode.removeChild(cover);
                }

                document.body.classList.remove("roadmap-pdf-exporting");
                button.disabled = false;

                if (label) {
                    label.textContent = defaultLabel;
                }
            }

            button.addEventListener("click", async function () {
                if (button.disabled) {
                    return;
                }

                if (typeof html2pdf === "undefined") {
                    window.alert(
                        "PDF export could not start because the PDF library did not load. " +
                        "Please refresh the page and try again."
                    );
                    return;
                }

                button.disabled = true;

                if (label) {
                    label.textContent = "Preparing PDF...";
                }

                document.body.classList.add("roadmap-pdf-exporting");

                const cover = document.createElement("div");
                cover.className = "roadmap-pdf-screen-cover";
                cover.innerHTML =
                    '<div>' +
                        '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>' +
                        '<span>Preparing your roadmap PDF...</span>' +
                    '</div>';

                const stage = document.createElement("div");
                stage.className = "roadmap-pdf-stage";
                stage.setAttribute("aria-hidden", "true");

                const exportRoot = root.cloneNode(true);
                exportRoot.removeAttribute("id");
                exportRoot.classList.add("roadmap-pdf-document");

                /* Duplicate IDs are unnecessary inside the static PDF clone. */
                exportRoot.querySelectorAll("[id]").forEach(function (element) {
                    element.removeAttribute("id");
                });

                /* Remove controls that make no sense in a document. */
                exportRoot.querySelectorAll(
                    ".no-print, .rm-hero-actions, .rm-detail-action form, " +
                    ".rm-primary-wide, .roadmap-loading-overlay, .rm-detail-hint"
                ).forEach(function (element) {
                    element.remove();
                });

                /* Every phase must be present in the exported document. */
                exportRoot.querySelectorAll(".rm-detail-panel").forEach(function (panel) {
                    panel.classList.add("is-active");
                    panel.setAttribute("aria-hidden", "false");
                });

                /* Timeline buttons are visual content only in the PDF. */
                exportRoot.querySelectorAll("button").forEach(function (element) {
                    element.disabled = true;
                    element.setAttribute("tabindex", "-1");
                });

                stage.appendChild(exportRoot);
                document.body.appendChild(stage);
                document.body.appendChild(cover);

                /*
                 * Wait for the browser to fully lay out the mounted A4 stage.
                 * This is important: capturing a detached clone can cause
                 * html2pdf to fall back to the live page's layout context.
                 */
                await new Promise(function (resolve) {
                    requestAnimationFrame(function () {
                        requestAnimationFrame(resolve);
                    });
                });

                const filename =
                    button.getAttribute("data-pdf-filename")
                    || "Roadmap.pdf";

                const options = {
                    /*
                     * LEFT/RIGHT margin is zero ON PURPOSE.
                     * The export document itself owns a permanent 28px
                     * horizontal inner margin. This avoids the old
                     * html2pdf page-inner-width vs source-width mismatch.
                     *
                     * Top/bottom margins are still repeated on every page.
                     */
                    margin: [6, 0, 6, 0],

                    filename: filename,

                    image: {
                        type: "jpeg",
                        quality: 0.98
                    },

                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: "#ffffff",
                        logging: false,
                        scrollX: 0,
                        scrollY: 0
                    },

                    jsPDF: {
                        unit: "mm",
                        format: "a4",
                        orientation: "portrait",
                        compress: true
                    },

                    pagebreak: {
                        mode: ["css", "legacy"],
                        before: [".rm-detail-section"],
                        avoid: [
                            ".rm-overview-grid",
                            ".rm-detail-header",
                            ".rm-detail-facts",
                            ".rm-info-card",
                            ".rm-alert-row",
                            ".rm-beyond-item"
                        ]
                    }
                };

                try {
                    /*
                     * Capture the MOUNTED standalone clone - never the live
                     * Roadmap. Because the source is 793px (A4 at 96dpi)
                     * and jsPDF has zero horizontal margin, the canvas and
                     * PDF page share one horizontal coordinate system.
                     */
                    await html2pdf()
                        .set(options)
                        .from(exportRoot)
                        .save();
                }
                catch (error) {
                    console.error("Roadmap PDF export failed.", error);

                    /*
                     * Do NOT silently fall back to browser print.
                     * That old fallback was able to generate a visibly
                     * clipped PDF and made failures look like successes.
                     */
                    window.alert(
                        "The PDF could not be generated correctly. " +
                        "No incomplete PDF was downloaded. Please try again."
                    );
                }
                finally {
                    cleanupPdfUi(stage, cover);
                }
            });
        })();
    </script>
}
