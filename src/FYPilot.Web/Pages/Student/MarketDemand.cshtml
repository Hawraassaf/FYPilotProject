        padding: 16px 18px 18px;
    }

    .md-item-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .md-item {
        padding: 15px;
        border: 1px solid var(--md-navy-150);
        border-radius: 14px;
        background: var(--md-navy-50);
        transition: transform var(--md-transition), border-color var(--md-transition), box-shadow var(--md-transition);
    }

    .md-item:hover {
        transform: translateY(-3px);
        border-color: var(--md-navy-300);
        box-shadow: 0 13px 28px rgba(8,20,38,.07);
    }

    .md-item-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .md-item h4 {
        margin: 0;
        color: var(--md-navy-950);
        font-size: .88rem;
        font-weight: 900;
        line-height: 1.4;
    }

    .md-item p {
        margin: 0;
        color: var(--md-muted);
        font-size: .79rem;
        line-height: 1.58;
    }

    .md-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 12px;
        margin-top: 10px;
        color: var(--md-navy-500);
        font-size: .69rem;
        font-weight: 800;
    }

    .md-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 11px;
        color: var(--md-navy-700);
        font-size: .75rem;
        font-weight: 900;
        text-decoration: none;
    }

    .md-link:hover {
        color: var(--md-navy-950);
        text-decoration: underline;
    }

    .md-step-list {
        display: grid;
        gap: 9px;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: md-step;
    }

    .md-step-list li {
        counter-increment: md-step;
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr);
        gap: 11px;
        align-items: center;
        padding: 12px;
        border: 1px solid var(--md-navy-150);
        border-radius: 13px;
        color: var(--md-muted);
        background: var(--md-navy-50);
        font-size: .82rem;
        line-height: 1.5;
    }

    .md-step-list li::before {
        content: counter(md-step);
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border-radius: 11px;
        color: #fff;
        background: linear-gradient(145deg, var(--md-navy-900), var(--md-navy-600));
        font-size: .76rem;
        font-weight: 900;
    }

    .md-empty {
        padding: 54px 24px;
        text-align: center;
    }

    .md-empty-icon {
        display: grid;
        width: 68px;
        height: 68px;
        place-items: center;
        margin: 0 auto;
        border-radius: 20px;
        color: #fff;
        background: linear-gradient(145deg, var(--md-navy-900), var(--md-navy-600));
        box-shadow: 0 16px 36px rgba(16,35,63,.19);
        font-size: 1.45rem;
    }

    .md-empty h2 {
        margin: 16px 0 8px;
        color: var(--md-navy-950);
        font-size: 1.3rem;
        font-weight: 900;
    }

    .md-empty p {
        max-width: 640px;
        margin: 0 auto 18px;
        color: var(--md-muted);
        line-height: 1.6;
    }

    .md-empty-inline {
        padding: 16px;
        border: 1px dashed var(--md-navy-300);
        border-radius: 13px;
        color: var(--md-muted);
        background: var(--md-navy-50);
        text-align: center;
        font-size: .8rem;
    }

    @@media (max-width: 1180px) {
        .md-hero {
            grid-template-columns: 1fr;
        }

        .md-hero-score {
            padding: 0 22px 24px;
        }

        .md-control-dock {
            margin: 12px 0 16px;
            grid-template-columns: 1fr 1fr;
        }

        .md-control-dock .md-button {
            grid-column: 1 / -1;
        }

        .md-overview-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .md-content-grid,
        .md-chart-layout {
            grid-template-columns: 1fr;
        }

        .md-focus-card {
            min-height: 210px;
        }
    }

    @@media (max-width: 760px) {
        .md-page {
            padding: 10px;
            border-radius: 18px;
        }

        .md-hero {
            border-radius: 21px;
        }

        .md-hero-content {
            padding: 23px 20px 19px;
        }

        .md-hero h1 {
            font-size: 1.7rem;
        }

        .md-hero-copy {
            font-size: .83rem;
        }

        .md-hero-score {
            padding: 0 20px 22px;
        }

        .md-score-orbit {
            width: 132px;
            height: 132px;
        }

        .md-control-dock,
        .md-overview-grid,
        .md-dual-grid,
        .md-item-grid {
            grid-template-columns: 1fr;
        }

        .md-control-dock {
            margin: 10px 0 14px;
        }

        .md-control-dock .md-button {
            grid-column: auto;
        }

        .md-decision {
            grid-template-columns: 48px minmax(0, 1fr);
        }

        .md-decision .md-pill {
            grid-column: 1 / -1;
            justify-self: start;
        }

        .md-chart-wrap {
            min-height: 340px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .md-page *,
        .md-page *::before,
        .md-page *::after {
            scroll-behavior: auto !important;
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<div class="md-page">
    <div class="md-shell">
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="md-alert" role="status">
                <i class="bi bi-check-circle"></i>
                <span>@Model.SuccessMessage</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="md-alert" role="alert">
                <i class="bi bi-exclamation-circle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <section class="md-hero">
            <div class="md-hero-content">
                <div class="md-kicker">
                    <i class="bi bi-activity"></i>
                    FYPilot Intelligence Workspace
                </div>

                <h1>Market Demand Analysis</h1>

                <p class="md-hero-copy">
                    Turn your official project idea into a structured market argument.
                    Review real problem evidence, market fit, competition, confidence,
                    academic value, and the next actions required before development.
                </p>

                <div class="md-context-row">
                    <span class="md-context-chip">
                        <i class="bi bi-geo-alt"></i>
                        @(analysis?.CountryContext ?? Model.CountryContext)
                    </span>

                    <span class="md-context-chip">
                        <i class="bi bi-database-check"></i>
                        Evidence-backed
                    </span>

                    @if (Model.LatestReview != null)
                    {
                        var (_, reviewLabel) = Model.DescribeReview(Model.LatestReview);

                        <span class="md-context-chip" title="@Model.LatestReview.DecisionReason">
                            <i class="bi bi-patch-check"></i>
                            @reviewLabel
                        </span>
                    }
                </div>
            </div>

            <div class="md-hero-score">
                <div class="md-score-orbit"
                     style="--score:@(analysis?.DemandScore ?? 0);"
                     aria-label="Demand score @(analysis?.DemandScore ?? 0) out of 100">
                    <div class="md-score-core">
                        <strong>@(analysis?.DemandScore ?? 0)</strong>
                        <span>Demand score</span>
                    </div>
                </div>
            </div>
        </section>

        @if (Model.UserIdeas.Any())
        {
            <form method="post"
                  asp-page-handler="Analyze"
                  id="marketAnalysisForm"
                  class="md-control-dock">
                @Html.AntiForgeryToken()

                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                <input type="hidden" asp-for="IdeaId" />

                <div class="md-field">
                    <label>Official project idea</label>
                    <div class="md-readonly">
                        <i class="bi bi-lightbulb"></i>
                        <span>@Model.UserIdeas.First().Title</span>
                    </div>
                </div>

                <div class="md-field">
                    <label asp-for="CountryContext">Market scope</label>
                    <select asp-for="CountryContext"
                            class="form-select md-select"
                            aria-label="Market scope">
                        <option value="Lebanon">Lebanon</option>
                        <option value="MENA">MENA</option>
                        <option value="Global">Global</option>
                    </select>
                </div>

                <button type="submit"
                        class="md-button"
                        id="analyzeButton">
                    <i class="bi bi-stars" id="analyzeButtonIcon"></i>
                    <span id="analyzeButtonText">
                        @(analysis == null ? "Run analysis" : "Refresh analysis")
                    </span>
                </button>
            </form>
        }

        @if (!Model.UserIdeas.Any())
        {
            <section class="md-card md-empty">
                <div class="md-empty-icon">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <h2>No official idea selected</h2>

                <p>
                    Select the official idea for the active project, then return to this
                    workspace to validate its market demand.
                </p>

                <a asp-page="/Student/IdeaGenerator"
                   asp-route-projectId="@Model.ProjectId"
                   class="md-button">
                    Open Idea Generator
                </a>
            </section>
        }
        else if (analysis == null)
        {
            <section class="md-card md-empty">
                <div class="md-empty-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <h2>Your analysis workspace is ready</h2>

                <p>
                    Choose the market scope and run the analysis to generate demand,
                    confidence, competition, evidence, risks, sources, and an action plan.
                </p>
            </section>
        }
        else
        {
            <section class="md-overview-grid">
                <article class="md-stat">
                    <div class="md-stat-head">
                        <span class="md-stat-icon"><i class="bi bi-graph-up"></i></span>
                        <span class="md-pill">Demand</span>
                    </div>
                    <div class="md-stat-value">@analysis.DemandScore<small>/100</small></div>
                    <div class="md-stat-label">@demandLabel</div>
                </article>

                <article class="md-stat">
                    <div class="md-stat-head">
                        <span class="md-stat-icon"><i class="bi bi-shield-check"></i></span>
                        <span class="md-pill">Confidence</span>
                    </div>
                    <div class="md-stat-value">@analysis.ConfidenceScore<small>/100</small></div>
                    <div class="md-stat-label">@confidenceLabel</div>
                </article>

                <article class="md-stat">
                    <div class="md-stat-head">
                        <span class="md-stat-icon"><i class="bi bi-journals"></i></span>
                        <span class="md-pill">Coverage</span>
                    </div>
                    <div class="md-stat-value">@sourceCount<small> sources</small></div>
                    <div class="md-stat-label">@coverageLabel</div>
                </article>

                <article class="md-stat">
                    <div class="md-stat-head">
                        <span class="md-stat-icon"><i class="bi bi-bullseye"></i></span>
                        <span class="md-pill">Competition</span>
                    </div>
                    <div class="md-stat-value">@analysis.CompetitionOpportunityScore<small>/100</small></div>
                    <div class="md-stat-label">@competitionLabel</div>
                </article>
            </section>

            <section class="md-card md-decision @decisionTone">
                <div class="md-decision-icon">
                    <i class="bi @(decisionTone == "strong" ? "bi-check2" : decisionTone == "weak" ? "bi-arrow-counterclockwise" : "bi-compass")"></i>
                </div>

                <div>
                    <h2>@decisionTitle</h2>
                    <p>@decisionDescription</p>
                </div>

                <span class="md-pill">@decisionLabel</span>
            </section>

            <section class="md-content-grid">
                <article class="md-card md-panel">
                    <div class="md-panel-head">
                        <div>
                            <h3>Executive market narrative</h3>
                            <p>The three explanations that matter most in your project defense.</p>
                        </div>
                        <span class="md-pill">@analysis.CountryContext</span>
                    </div>

                    <div class="md-story">
                        <div class="md-story-block">
                            <div class="md-story-label">
                                <i class="bi bi-geo-alt"></i>
                                Market fit
                            </div>
                            <h4>Why this idea belongs in the selected market</h4>
                            <p>@analysis.LebaneseMarketFit</p>
                        </div>

                        <div class="md-story-block">
                            <div class="md-story-label">
                                <i class="bi bi-mortarboard"></i>
                                Academic value
                            </div>
                            <h4>Why the project is defendable as an FYP</h4>
                            <p>@analysis.UniversityValue</p>
                        </div>

                        <div class="md-story-block">
                            <div class="md-story-label">
                                <i class="bi bi-signpost-split"></i>
                                Direction
                            </div>
                            <h4>What should happen next</h4>
                            <p>@analysis.Recommendation</p>
                        </div>
                    </div>
                </article>

                <aside class="md-card md-panel">
                    <div class="md-panel-head">
                        <div>
                            <h3>Evidence readiness</h3>
                            <p>How ready the result is for academic use.</p>
                        </div>
                    </div>

                    <div class="md-readiness">
                        <div class="md-readiness-row">
                            <div class="md-readiness-top">
                                <div class="md-readiness-name">
                                    <span><i class="bi bi-shield"></i></span>
                                    Confidence quality
                                </div>
                                <div class="md-readiness-value">@analysis.ConfidenceScore/100</div>
                            </div>
                            <div class="md-meter">
                                <span style="width:@analysis.ConfidenceScore%"></span>
                            </div>
                            <div class="md-readiness-foot">
                                <span>@confidenceLabel</span>
                                <span>@analysis.ConfidenceLevel</span>
                            </div>
                        </div>

                        <div class="md-readiness-row">
                            <div class="md-readiness-top">
                                <div class="md-readiness-name">
                                    <span><i class="bi bi-globe2"></i></span>
                                    Source coverage
                                </div>
                                <div class="md-readiness-value">@sourceCount</div>
                            </div>
                            <div class="md-meter">
                                <span style="width:@Math.Min(sourceCount * 15, 100)%"></span>
                            </div>
                            <div class="md-readiness-foot">
                                <span>@coverageLabel</span>
                                <span>@(analysis.GroundedInLiveData ? "Live search used" : "No live search")</span>
                            </div>
                        </div>

                        <div class="md-readiness-row">
                            <div class="md-readiness-top">
                                <div class="md-readiness-name">
                                    <span><i class="bi bi-diagram-3"></i></span>
                                    Competition opportunity
                                </div>
                                <div class="md-readiness-value">@analysis.CompetitionOpportunityScore/100</div>
                            </div>
                            <div class="md-meter">
                                <span style="width:@analysis.CompetitionOpportunityScore%"></span>
                            </div>
                            <div class="md-readiness-foot">
                                <span>@competitionLabel</span>
                                <span>Higher is better</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </section>

            <section class="md-card md-chart-section">
                <div class="md-panel-head">
                    <div>
                        <h3>Market score architecture</h3>
                        <p>Five dimensions explain the final market-demand score.</p>
                    </div>
                    <span class="md-pill">Target 70</span>
                </div>

                <div class="md-chart-layout">
                    <div class="md-chart-wrap">
                        <canvas id="breakdownChart"
                                role="img"
                                aria-label="Horizontal market score breakdown chart"></canvas>
                    </div>

                    <aside class="md-focus-card">
                        <div>
                            <i class="bi bi-crosshair"></i>
                            <small>Priority focus</small>
                            <h4>@weakestFactor</h4>
                            <div class="md-focus-score">@weakestScore<span>/100</span></div>
                        </div>
                        <p>
                            Improve this dimension first. It currently has the largest
                            negative effect on the overall market recommendation.
                        </p>
                    </aside>
                </div>
            </section>

            <section class="md-dual-grid">
                <article class="md-card md-list-card">
                    <div class="md-panel-head">
                        <div>
                            <h3>Problem evidence</h3>
                            <p>Signals supporting the existence of the target problem.</p>
                        </div>
                        <span class="md-pill">@Model.ProblemEvidence.Count items</span>
                    </div>

                    @if (Model.ProblemEvidence.Any())
                    {
                        <ul class="md-list">
                            @foreach (var item in Model.ProblemEvidence.Take(6))
                            {
                                <li>
                                    <span class="md-list-icon"><i class="bi bi-check2"></i></span>
                                    <span>@item</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="md-empty-inline">No problem-evidence statements were returned.</div>
                    }
                </article>

                <article class="md-card md-list-card">
                    <div class="md-panel-head">
                        <div>
                            <h3>Critical risks</h3>
                            <p>Evidence, adoption, safety, and competitive concerns.</p>
                        </div>
                        <span class="md-pill">@Model.Risks.Count items</span>
                    </div>

                    @if (Model.Risks.Any())
                    {
                        <ul class="md-list">
                            @foreach (var item in Model.Risks.Take(6))
                            {
                                <li>
                                    <span class="md-list-icon"><i class="bi bi-exclamation"></i></span>
                                    <span>@item</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="md-empty-inline">No risks were returned.</div>
                    }
                </article>
            </section>

            @if (analysis.SimilarSolutions.Any())
            {
                <details class="md-card md-accordion" open>
                    <summary>
                        <span class="md-summary-title">
                            <span class="md-summary-icon"><i class="bi bi-diagram-3"></i></span>
                            Similar solutions
                        </span>
                        <span class="md-pill">@analysis.SimilarSolutions.Count solutions</span>
                    </summary>

                    <div class="md-accordion-body">
                        <div class="md-item-grid">
                            @foreach (var solution in analysis.SimilarSolutions)
                            {
                                <article class="md-item">
                                    <div class="md-item-head">
                                        <h4>@solution.Name</h4>
                                        <span class="md-pill">@solution.Similarity similarity</span>
                                    </div>
                                    <p>@solution.Description</p>
                                </article>
                            }
                        </div>
                    </div>
                </details>
            }

            <details class="md-card md-accordion" open>
                <summary>
                    <span class="md-summary-title">
                        <span class="md-summary-icon"><i class="bi bi-list-check"></i></span>
                        Next-step action plan
                    </span>
                    <span class="md-pill">@Model.NextSteps.Count actions</span>
                </summary>

                <div class="md-accordion-body">
                    @if (Model.NextSteps.Any())
                    {
                        <ol class="md-step-list">
                            @foreach (var item in Model.NextSteps)
                            {
                                <li><span>@item</span></li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="md-empty-inline">No next steps were returned.</div>
                    }
                </div>
            </details>

            <details class="md-card md-accordion">
                <summary>
                    <span class="md-summary-title">
                        <span class="md-summary-icon"><i class="bi bi-journals"></i></span>
                        Research sources
                    </span>
                    <span class="md-pill">@sourceCount sources</span>
                </summary>

                <div class="md-accordion-body">
                    @if (analysis.Sources.Any())
                    {
                        <div class="md-item-grid">
                            @foreach (var source in analysis.Sources
                                .OrderByDescending(item => item.IsVerified)
                                .ThenByDescending(item => item.RelevanceScore))
                            {
                                <article class="md-item">
                                    <div class="md-item-head">
                                        <h4>@source.Title</h4>
                                        <span class="md-pill">
                                            @(source.IsVerified ? "Recognized" : source.SourceType)
                                        </span>
                                    </div>

                                    <p>@source.Relevance</p>

                                    <div class="md-item-meta">
                                        @if (!string.IsNullOrWhiteSpace(source.Publisher))
                                        {
                                            <span><i class="bi bi-building"></i> @source.Publisher</span>
                                        }
                                        <span><i class="bi bi-bullseye"></i> @source.RelevanceScore/100 relevance</span>
                                    </div>

                                    <a class="md-link"
                                       href="@source.Url"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Open source
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="md-empty-inline">No usable research sources were saved.</div>
                    }
                </div>
            </details>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

    <script>
        (() => {
            const form = document.getElementById("marketAnalysisForm");
            const button = document.getElementById("analyzeButton");
            const buttonText = document.getElementById("analyzeButtonText");
            const buttonIcon = document.getElementById("analyzeButtonIcon");

            if (form && button && buttonText && buttonIcon) {
                form.addEventListener("submit", () => {
                    button.disabled = true;
                    buttonText.textContent = "Analyzing market...";
                    buttonIcon.className = "bi bi-arrow-repeat";
                });
            }

            const breakdown = @Html.Raw(Model.BreakdownJson);
            const canvas = document.getElementById("breakdownChart");

            if (!canvas || typeof Chart === "undefined" || !Array.isArray(breakdown)) {
                return;
            }

            const target = 70;

            const targetPlugin = {
                id: "navyTargetLine",
                beforeDatasetsDraw(chart) {
                    const xScale = chart.scales.x;
                    const area = chart.chartArea;

                    if (!xScale || !area) {
                        return;
                    }

                    const x = xScale.getPixelForValue(target);
                    const context = chart.ctx;

                    context.save();
                    context.beginPath();
                    context.setLineDash([5, 5]);
                    context.strokeStyle = "#9aacc2";
                    context.lineWidth = 1;
                    context.moveTo(x, area.top);
                    context.lineTo(x, area.bottom);
                    context.stroke();
                    context.setLineDash([]);
                    context.fillStyle = "#61758d";
                    context.font = "700 11px system-ui, -apple-system, sans-serif";
                    context.fillText("Target 70", x + 5, area.top + 11);
                    context.restore();
                }
            };

            const valuePlugin = {
                id: "navyValueLabels",
                afterDatasetsDraw(chart) {
                    const context = chart.ctx;
                    const meta = chart.getDatasetMeta(0);
                    const values = chart.data.datasets[0].data;

                    context.save();
                    context.fillStyle = "#10233f";
                    context.font = "800 12px system-ui, -apple-system, sans-serif";
                    context.textBaseline = "middle";

                    meta.data.forEach((bar, index) => {
                        const value = values[index];
                        const x = Math.min(bar.x + 8, chart.chartArea.right - 25);
                        context.fillText(value, x, bar.y);
                    });

                    context.restore();
                }
            };

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: breakdown.map(item => item.label),
                    datasets: [{
                        data: breakdown.map(item => item.value),
                        backgroundColor: breakdown.map(item => {
                            if (item.value >= 75) return "#10233f";
                            if (item.value >= 55) return "#315b8d";
                            return "#6f89aa";
                        }),
                        hoverBackgroundColor: "#0c1b31",
                        borderRadius: 9,
                        borderSkipped: false,
                        barThickness: 28
                    }]
                },
                plugins: [targetPlugin, valuePlugin],
                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 500
                    },
                    layout: {
                        padding: {
                            right: 34
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: "#0c1b31",
                            titleColor: "#ffffff",
                            bodyColor: "#dfe6ef",
                            displayColors: false,
                            callbacks: {
                                label(context) {
                                    return `Score: ${context.raw}/100`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                stepSize: 10,
                                color: "#6f89aa",
                                font: {
                                    size: 11
                                }
                            },
                            grid: {
                                color: "rgba(154, 172, 194, .18)"
                            },
                            border: {
                                display: false
                            }
                        },
                        y: {
                            ticks: {
                                color: "#315b8d",
                                font: {
                                    size: 12,
                                    weight: "700"
                                }
                            },
                            grid: {
                                display: false
                            },
                            border: {
                                display: false
                            }
                        }
                    }
                }
            });
        })();
    </script>
}
