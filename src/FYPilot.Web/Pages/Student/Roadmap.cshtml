    .rm-detail-hint { color:var(--rm-muted); font-size:.66rem; }
    .rm-detail-panel { display:none; padding:1rem; }
    .rm-detail-panel.is-active { display:block; }

    .rm-detail-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding-bottom:.9rem; border-bottom:1px solid var(--rm-line); }
    .rm-detail-kicker { display:flex; flex-wrap:wrap; gap:.35rem; }
    .rm-detail-kicker span { padding:.22rem .45rem; color:var(--rm-blue-600); background:var(--rm-blue-050); border-radius:999px; font-size:.6rem; font-weight:800; text-transform:uppercase; }
    .rm-detail-header h3 { margin:.35rem 0 .25rem; color:var(--rm-navy-950); font-size:1.25rem; font-weight:850; letter-spacing:-.025em; }
    .rm-detail-header p { max-width:760px; margin:0; color:var(--rm-muted); font-size:.75rem; line-height:1.55; }

    .rm-detail-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.55rem; margin:.85rem 0; }
    .rm-detail-facts div { padding:.65rem .7rem; background:#f8fafc; border:1px solid var(--rm-line); border-radius:10px; }
    .rm-detail-facts span { display:block; color:var(--rm-blue-600); font-size:.58rem; font-weight:850; text-transform:uppercase; }
    .rm-detail-facts strong { display:block; margin-top:.18rem; font-size:.72rem; overflow-wrap:anywhere; }

    .rm-task-table-wrap { overflow-x:auto; border:1px solid var(--rm-line); border-radius:11px; }
    .rm-task-table { width:100%; min-width:620px; border-collapse:collapse; }
    .rm-task-table th, .rm-task-table td { padding:.68rem .72rem; text-align:left; vertical-align:top; border-bottom:1px solid var(--rm-line); }
    .rm-task-table th { color:#607187; background:#f7f9fc; font-size:.61rem; font-weight:850; text-transform:uppercase; }
    .rm-task-table td { font-size:.7rem; line-height:1.45; }
    .rm-task-table tr:last-child td { border-bottom:0; }

    .rm-task-title { display:flex; align-items:flex-start; gap:.45rem; }
    .rm-task-title > span { flex:0 0 auto; width:23px; height:23px; display:grid; place-items:center; color:var(--rm-navy-800); background:var(--rm-blue-100); border-radius:7px; font-size:.61rem; font-weight:850; }
    .rm-owner-list { display:grid; gap:.15rem; color:var(--rm-muted); font-size:.65rem; }
    .rm-muted { color:var(--rm-muted); }

    .rm-detail-info-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.6rem; margin-top:.8rem; }
    .rm-info-card { display:flex; align-items:flex-start; gap:.6rem; padding:.72rem; background:#f8fafc; border:1px solid var(--rm-line); border-radius:10px; }
    .rm-info-icon { flex:0 0 auto; width:30px; height:30px; display:grid; place-items:center; color:var(--rm-blue-600); background:var(--rm-blue-100); border-radius:8px; }
    .rm-info-card > div > span { display:block; margin-bottom:.18rem; color:var(--rm-blue-600); font-size:.58rem; font-weight:850; text-transform:uppercase; }
    .rm-info-card p { margin:0; color:var(--rm-muted); font-size:.68rem; line-height:1.5; }
    .rm-info-risk { background:#f7f8fc; border-color:#dce2ef; }
    .rm-info-risk .rm-info-icon { color:var(--rm-indigo); background:#eef0f8; }

    .rm-deferred-card { overflow:hidden; }
    .rm-deferred-card summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.9rem 1rem; cursor:pointer; list-style:none; }
    .rm-deferred-card summary::-webkit-details-marker { display:none; }
    .rm-deferred-card summary > span:first-child { display:flex; align-items:center; flex-wrap:wrap; gap:.45rem; }
    .rm-deferred-card summary i { color:var(--rm-blue-600); }
    .rm-deferred-card summary strong { color:var(--rm-navy-950); font-size:.82rem; }
    .rm-deferred-card summary small { color:var(--rm-muted); font-size:.65rem; }
    .rm-deferred-card summary > span:last-child { color:var(--rm-navy-800); background:var(--rm-blue-100); border-radius:999px; padding:.25rem .5rem; font-size:.63rem; font-weight:800; }
    .rm-task-table-wrap.deferred { margin:0 .9rem .9rem; }


    .roadmap-loading-overlay {
        position:fixed;
        inset:0;
        z-index:2000;
        display:grid;
        place-items:center;
        padding:1rem;
        background:rgba(7,26,56,.48);
        backdrop-filter:blur(6px);
    }

    .roadmap-loading-panel {
        width:min(620px,100%);
        padding:1.2rem;
        background:#fff;
        border:1px solid var(--rm-line);
        border-radius:18px;
        box-shadow:0 26px 70px rgba(7,26,56,.25);
    }

    .roadmap-loading-top { display:flex; align-items:flex-start; gap:.8rem; }
    .roadmap-loading-spinner { flex:0 0 auto; width:38px; height:38px; border:4px solid #e3eaf3; border-top-color:var(--rm-blue-600); border-radius:50%; animation:roadmapSpin .8s linear infinite; }
    .roadmap-loading-panel h2 { margin:.12rem 0 .25rem; color:var(--rm-navy-950); font-size:1.15rem; }
    .roadmap-loading-panel p { margin:0; color:var(--rm-muted); font-size:.75rem; line-height:1.5; }
    .roadmap-loading-progress { height:6px; margin:1rem 0; overflow:hidden; background:#eaf0f6; border-radius:999px; }
    .roadmap-loading-progress div { width:38%; height:100%; background:linear-gradient(90deg,var(--rm-navy-900),var(--rm-blue-500)); border-radius:inherit; animation:roadmapLoading 1.5s ease-in-out infinite; }
    .roadmap-loading-steps { display:grid; gap:.35rem; margin:0; padding:0; list-style:none; }
    .roadmap-loading-steps li { display:flex; align-items:center; gap:.5rem; padding:.52rem .62rem; color:var(--rm-muted); background:#f8fafc; border:1px solid transparent; border-radius:9px; font-size:.7rem; }
    .roadmap-loading-steps li.is-active { color:var(--rm-navy-900); background:var(--rm-blue-100); border-color:#d6e3f1; font-weight:800; }

    @@keyframes roadmapSpin { to { transform:rotate(360deg); } }
    @@keyframes roadmapLoading { 0% { transform:translateX(-105%); } 100% { transform:translateX(270%); } }

    button:focus-visible,
    a:focus-visible,
    summary:focus-visible {
        outline:3px solid rgba(78,130,193,.35);
        outline-offset:2px;
    }

    @@media (max-width: 1180px) {
        .rm-metrics-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
        .rm-overview-grid {
            grid-template-columns: 1fr;
            grid-template-areas:
                "current"
                "alerts"
                "workload"
                "beyond";
        }
    }

    @@media (max-width: 820px) {
        .roadmap-control { padding-inline:.1rem; }
        .rm-project-hero { grid-template-columns:auto minmax(0,1fr); }
        .rm-hero-actions { grid-column:1 / -1; justify-content:flex-start; padding-top:.25rem; }
        .rm-project-icon { width:58px; height:58px; border-radius:15px; }
        .rm-metrics-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .rm-detail-info-grid { grid-template-columns:1fr; }
    }

    @@media (max-width: 600px) {
        .rm-project-hero { grid-template-columns:1fr; }
        .rm-hero-actions { display:grid; grid-template-columns:1fr; width:100%; }
        .rm-hero-actions form, .rm-hero-actions .btn { width:100%; }
        .rm-metrics-grid { grid-template-columns:1fr; }
        .rm-metric-card { min-height:136px; }
        .rm-current-facts, .rm-detail-facts { grid-template-columns:1fr; gap:.4rem; }
        .rm-current-facts div { padding:.45rem 0; border-right:0; border-bottom:1px solid var(--rm-line); }
        .rm-current-facts div:last-child { border-bottom:0; }
        .rm-detail-header { display:grid; }
        .rm-workload-copy { align-items:flex-start; }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior:auto !important; }
        .rm-metric-card, .rm-phase-bar, .roadmap-btn-primary, .roadmap-btn-secondary { transition:none !important; }
        .roadmap-loading-spinner, .roadmap-loading-progress div { animation:none !important; }
    }

    @@media print {
        @@page { size:A4; margin:12mm; }
        html, body { height:auto !important; min-height:0 !important; }
        body * { visibility:hidden; }
        #roadmap-print-root, #roadmap-print-root * { visibility:visible; }
        #roadmap-print-root { position:absolute; inset:0 auto auto 0; width:100%; background:#fff; }
        .no-print, .rm-hero-actions, .rm-detail-action form { display:none !important; }
        .roadmap-control { gap:.65rem; background:#fff; }
        .rm-project-hero, .rm-timeline-card, .rm-current-card, .rm-alert-card, .rm-beyond-card, .rm-workload-card, .rm-detail-section { box-shadow:none !important; break-inside:avoid; }
        .rm-metrics-grid { grid-template-columns:repeat(5,minmax(0,1fr)); gap:.4rem; }
        .rm-metric-card { min-height:120px; padding:.6rem; }
        .rm-timeline-scroll { overflow:visible; padding:.45rem; }
        .rm-timeline { min-width:0 !important; width:100% !important; grid-template-columns:220px minmax(0,1fr); }
        .rm-week-heads, .rm-week-track { grid-template-columns:repeat(var(--week-count), minmax(0,1fr)); }
        .rm-overview-grid {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .rm-detail-section {
            break-before: page;
            page-break-before: always;
        }

        .rm-detail-panel {
            display:block !important;
            break-inside:auto;
            page-break-inside:auto;
            page-break-after:auto;
        }

        .rm-detail-panel + .rm-detail-panel {
            border-top:1px solid var(--rm-line);
        }

        .rm-detail-header,
        .rm-detail-facts,
        .rm-task-table tr,
        .rm-info-card,
        .rm-alert-row,
        .rm-beyond-item {
            break-inside:avoid;
            page-break-inside:avoid;
        }

        /* Confirmed live defect: .rm-task-table-wrap's on-screen horizontal
           scrollbar (needed because .rm-task-table has min-width:620px for
           5 columns -- Task/Effort/Ownership/Allocation/Sequence) clips
           everything past whatever fits without scrolling. html2canvas
           (the PDF export engine, see the "Download PDF" script below)
           cannot capture content hidden by a scrollable container's own
           clip region -- it only renders what's visible without scrolling,
           so every exported PDF showed the Task column only, with Effort/
           Ownership/Allocation/Sequence silently missing. Forcing the
           table to its natural (unclipped) width here is what the Gantt's
           own .rm-timeline-scroll override above already does for the
           identical reason. */
        .rm-task-table-wrap { overflow-x:visible !important; }
        .rm-task-table { min-width:0 !important; max-width:700px; width:100%; table-layout:fixed; }
    }


    /* ================================================================
       DIRECT PDF EXPORT - ISOLATED A4 STAGE
       ================================================================
       The live Roadmap is never captured.

       When Export PDF is clicked, JavaScript:
       1) clones #roadmap-print-root,
       2) mounts that clone directly under  inside a 793px A4 stage,
       3) keeps a full-screen "Preparing PDF" cover above the stage,
       4) captures ONLY the isolated clone,
       5) removes the stage.

       This prevents sidebar/content-wrapper offsets and eliminates the
       repeated right-edge clipping from previous exports.
       ================================================================ */

    body.roadmap-pdf-exporting {
        overflow: hidden !important;
    }

    .roadmap-pdf-screen-cover {
        position: fixed;
        inset: 0;
        z-index: 2147483646;
        display: grid;
        place-items: center;
        padding: 1rem;
        color: #fff;
        background: rgba(7, 26, 56, .84);
        backdrop-filter: blur(6px);
    }

    .roadmap-pdf-screen-cover > div {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .9rem 1.05rem;
        background: rgba(10, 40, 84, .96);
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 12px;
        box-shadow: 0 20px 55px rgba(0,0,0,.22);
        font-size: .82rem;
        font-weight: 750;
    }

    .roadmap-pdf-screen-cover .spinner-border {
        width: 1.15rem;
        height: 1.15rem;
        border-width: .14rem;
    }

    .roadmap-pdf-stage {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 2147483645;
        width: 793px;
        max-width: 793px;
        min-width: 793px;
        height: auto;
        margin: 0;
        padding: 0;
        overflow: visible;
        pointer-events: none;
        background: #fff;
    }

    .roadmap-pdf-document {
        width: 793px !important;
        max-width: 793px !important;
        min-width: 793px !important;
        margin: 0 !important;
        padding: 0 28px !important;
        display: grid !important;
        gap: 7px !important;
        color: var(--rm-ink) !important;
        background: #fff !important;
        box-sizing: border-box !important;
        overflow: visible !important;
    }

    .roadmap-pdf-document,
    .roadmap-pdf-document *,
    .roadmap-pdf-document *::before,
    .roadmap-pdf-document *::after {
        box-sizing: border-box !important;
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }

    /* Remove everything interactive/useless in a document. */
    .roadmap-pdf-document .no-print,
    .roadmap-pdf-document .rm-hero-actions,
    .roadmap-pdf-document .rm-detail-action form,
    .roadmap-pdf-document .rm-primary-wide,
    .roadmap-pdf-document .roadmap-loading-overlay,
    .roadmap-pdf-document .rm-detail-hint {
        display: none !important;
    }

    .roadmap-pdf-document .rm-project-hero,
    .roadmap-pdf-document .rm-timeline-card,
    .roadmap-pdf-document .rm-current-card,
    .roadmap-pdf-document .rm-alert-card,
    .roadmap-pdf-document .rm-beyond-card,
    .roadmap-pdf-document .rm-workload-card,
    .roadmap-pdf-document .rm-detail-section,
    .roadmap-pdf-document .rm-deferred-card {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
        transform: none !important;
    }

    /* ---------- HERO ---------- */

    .roadmap-pdf-document .rm-project-hero {
        grid-template-columns: 50px minmax(0, 1fr) !important;
        gap: 7px 10px !important;
        padding: 10px 12px 9px !important;
        overflow: hidden !important;
        border-radius: 11px !important;
    }

    .roadmap-pdf-document .rm-project-hero::after {
        width: 135px !important;
        height: 90px !important;
    }

    .roadmap-pdf-document .rm-project-icon {
        width: 50px !important;
        height: 50px !important;
        border-radius: 12px !important;
        font-size: 1.12rem !important;
        box-shadow: none !important;
    }

    .roadmap-pdf-document .rm-project-main {
        min-width: 0 !important;
        padding-top: 0 !important;
    }

    .roadmap-pdf-document .roadmap-eyebrow {
        font-size: 7px !important;
        letter-spacing: .1em !important;
    }

