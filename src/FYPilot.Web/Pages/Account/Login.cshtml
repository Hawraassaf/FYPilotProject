@page
@model FYPilot.Web.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sign In — FYPilot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --navy: #0f172a;
            --navy-medium: #17345f;
            --navy-light: #245a9b;
            --cream-light: #fffaf3;
            --page-background: linear-gradient(135deg, #0f172a 0%, #17345f 55%, #245a9b 100%);
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            background: var(--page-background);
        }

        .auth-card {
            width: min(100%, 650px);
            padding: 2.5rem;
            border-radius: 26px;
            background: #F8FAFC;
            border: 1px solid rgba(255,255,255,0.22);
            box-shadow: 0 30px 85px rgba(2,6,23,0.36);
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .auth-brand-logo {
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
            border-radius: 17px;
            background: var(--page-background);
            box-shadow: 0 10px 24px rgba(15,23,42,0.18);
        }

        .auth-brand-logo img {
            width: 44px;
            height: 44px;
            object-fit: contain;
        }

        .auth-logo {
            color: var(--navy);
            font-size: 1.8rem;
            font-weight: 850;
            line-height: 1;
        }

        .form-label {
            color: var(--navy);
        }

        .form-control {
            min-height: 48px;
            border-radius: 13px;
            border-color: #d8dee8;
        }

        .form-control:focus {
            border-color: var(--navy-medium);
            box-shadow: 0 0 0 0.2rem rgba(23,52,95,0.14);
        }

        .auth-link {
            color: var(--navy-medium);
            text-decoration: none;
            font-weight: 700;
            transition: color 0.18s ease;
        }

        .auth-link:hover {
            color: var(--navy);
            text-decoration: underline;
        }

        .btn-sign-in {
            min-height: 50px;
            color: #ffffff;
            border: 0;
            border-radius: 14px;
            background: var(--page-background);
            box-shadow: 0 14px 30px rgba(23,52,95,0.22);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .btn-sign-in:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 18px 36px rgba(23,52,95,0.28);
        }

        .demo-panel {
            padding: 1rem;
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
        }

        .demo-button {
            border-radius: 10px;
        }

        @@media (max-width: 575px) {
            .auth-card {
                padding: 1.5rem;
                border-radius: 20px;
            }

            .auth-brand-logo {
                width: 48px;
                height: 48px;
            }

            .auth-brand-logo img {
                width: 39px;
                height: 39px;
            }

            .auth-logo {
                font-size: 1.55rem;
            }
        }
            .auth-card {
                width: 100% !important;
                max-width: 500px !important;
                padding: 2.75rem 3rem;
            }

            .login-back-button {
                position: absolute;
                top: 1.25rem;
                left: 1.25rem;
                z-index: 10;
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                min-height: 42px;
                padding: .58rem .78rem;
                border: 1px solid #E2E8F0;
                border-radius: 12px;
                color: #28385E;
                background: rgba(255, 255, 255, .94);
                font-size: .72rem;
                font-weight: 800;
                text-decoration: none;
                box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
                backdrop-filter: blur(10px);
                transition: transform .16s ease, background .16s ease, border-color .16s ease;
            }

                .login-back-button:hover {
                    color: #173463;
                    background: #FFFFFF;
                    border-color: #BFCADA;
                    transform: translateX(-2px);
                }

                .login-back-button i {
                    font-size: .9rem;
                }

            @@media (max-width: 600px) {
                .login-back-button {
                    top: .8rem;
                    left: .8rem;
                }

                    .login-back-button span {
                        display: none;
                    }
            }

            .password-field-wrapper {
                position: relative;
            }

                .password-field-wrapper .form-control {
                    padding-right: 3.25rem;
                }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 0.65rem;
                width: 38px;
                height: 38px;
                display: grid;
                place-items: center;
                padding: 0;
                color: #64748b;
                border: 0;
                border-radius: 10px;
                background: transparent;
                transform: translateY(-50%);
                transition: color 0.18s ease, background-color 0.18s ease;
            }

                .password-toggle:hover {
                    color: var(--navy);
                    background: rgba(23, 52, 95, 0.08);
                }

                .password-toggle:focus-visible {
                    outline: 3px solid rgba(23, 52, 95, 0.18);
                    outline-offset: 1px;
                }

                .password-toggle i {
                    font-size: 1.05rem;
                    pointer-events: none;
                }
    </style>
</head>

<body>
    <a asp-page="/Index"
       class="login-back-button"
       aria-label="Back to home"
       title="Back to home">
        <i class="bi bi-arrow-left"></i>
    </a>

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="text-center mb-4">
                <div class="auth-brand mb-2">
                    <div class="auth-brand-logo">
                        <img src="/image/FYPilot_logo.png" alt="FYPilot Logo" />
                    </div>

                    <div class="auth-logo">FYPilot</div>
                </div>

                <p class="text-muted small mb-0">Academic Intelligence System</p>
            </div>
            <partial name="/Pages/Shared/_FlashMessages.cshtml" />
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @Model.ErrorMessage
                </div>
            }

            <form method="post"
                  asp-page="/Account/Login">
                @Html.AntiForgeryToken()
                @if (TempData["PasswordResetMessage"] is string passwordResetMessage)
                {
                    <div id="passwordResetAlert" class="alert alert-success small mb-3">
                        <i class="bi bi-check-circle me-1"></i>
                        @passwordResetMessage
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email address</label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           type="email"
                           placeholder="you@example.com"
                           autofocus />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Password</label>

                    <div class="password-field-wrapper">
                        <input asp-for="Input.Password"
                               class="form-control"
                               type="password"
                               autocomplete="current-password"
                               placeholder="••••••••" />

                        <button type="button"
                                class="password-toggle"
                                data-password-toggle
                                data-password-target="Input_Password"
                                aria-label="Show password"
                                aria-pressed="false"
                                title="Show password">
                            <i class="bi bi-eye"
                               aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="text-end mt-2">
                        <a asp-page="/Account/ForgotPassword" class="auth-link small">
                            Forgot your password?
                        </a>
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-sign-in btn-lg fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Sign In
                    </button>
                </div>
            </form>

            <hr class="my-4" />

            <div class="text-center small text-muted">
                Don't have an account?

                <a asp-page="/Account/Register" class="auth-link">
                    Create one
                </a>
            </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true">
    </script>
    <script>
        function fillDemo(email) {
            document.querySelector('[name="Input.Email"]').value = email;
            document.querySelector('[name="Input.Password"]').value = 'password123';
        }

        setTimeout(function () {
            const alertBox = document.getElementById("passwordResetAlert");

            if (alertBox) {
                alertBox.style.transition = "opacity 0.5s ease";
                alertBox.style.opacity = "0";

                setTimeout(function () {
                    alertBox.remove();
                }, 500);
            }
        }, 3000);
    </script>
    <script>
        document
        .querySelectorAll("[data-password-toggle]")
        .forEach(function (toggleButton) {
        toggleButton.addEventListener(
        "click",
        function () {
        const targetId =
        toggleButton.getAttribute(
        "data-password-target");

        if (!targetId) {
        return;
        }

        const passwordInput =
        document.getElementById(targetId);

        if (!passwordInput) {
        return;
        }

        const passwordIsVisible =
        passwordInput.type === "text";

        passwordInput.type =
        passwordIsVisible
        ? "password"
        : "text";

        const newLabel =
        passwordIsVisible
        ? "Show password"
        : "Hide password";

        toggleButton.setAttribute(
        "aria-label",
        newLabel);

        toggleButton.setAttribute(
        "title",
        newLabel);

        toggleButton.setAttribute(
        "aria-pressed",
        passwordIsVisible
        ? "false"
        : "true");

        const icon =
        toggleButton.querySelector("i");

        if (icon) {
        icon.className =
        passwordIsVisible
        ? "bi bi-eye"
        : "bi bi-eye-slash";
        }

        passwordInput.focus();
        });
        });
    </script>
</body>
</html>
