@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const query = new URLSearchParams(window.location.search);
            const activeTab = query.get("activeTab");

            const tabMap = {
                guidance: "guidance-tab",
                projects: "projects-tab",
                opportunities: "opportunities-tab"
            };

            let targetTabId = tabMap[activeTab] || null;

            if (query.has("editGuidanceId")) {
                targetTabId = "guidance-tab";
            } else if (query.has("editProjectId")) {
                targetTabId = "projects-tab";
            } else if (query.has("editOpportunityId")) {
                targetTabId = "opportunities-tab";
            }

            if (targetTabId && window.bootstrap?.Tab) {
                const tab = document.getElementById(targetTabId);

                if (tab) {
                    bootstrap.Tab.getOrCreateInstance(tab).show();
                }
            }

            document
                .querySelectorAll("[data-open-tab]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const tab = document.getElementById(
                            button.getAttribute("data-open-tab")
                        );

                        if (tab && window.bootstrap?.Tab) {
                            bootstrap.Tab.getOrCreateInstance(tab).show();
                        }
                    });
                });
        });
    </script>
}
