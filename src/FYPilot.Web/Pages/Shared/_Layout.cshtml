                            <li>@Html.Raw(NavLink("/Student/Dashboard", "grid", "Dashboard", "dashboard-link", activeProjectId))</li>
                            <li>  @Html.Raw( NavLink( "/Student/MyProjects",  "folder2-open", "My Projects", "my-projects")) </li>
                            <li>@Html.Raw(NavLink("/Student/SkillAssessment", "bar-chart-line", "Skill Assessment", "skill-assessment"))</li>

                            <li><span class="side-nav-label">AI Planning</span></li>
