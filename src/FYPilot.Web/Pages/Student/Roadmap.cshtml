@page
@model FYPilot.Web.Pages.Student.RoadmapModel
@{
    ViewData["Title"] = "Project Roadmap";
    ViewData["Subtitle"] = "Plan, schedule, and execute your FYP with confidence";

    var orderedPhases = Model.Phases.OrderBy(p => p.PhaseNumber).ToList();
    var done = orderedPhases.Count(p => p.IsCompleted);
    var total = orderedPhases.Count;
    var pct = total > 0 ? (int)Math.Round(done * 100.0 / total) : 0;
    var currentPhase = orderedPhases.FirstOrDefault(p => !p.IsCompleted);

    var fallbackWeeks = Model.Idea?.ExpectedDurationWeeks
        ?? Math.Max(orderedPhases.Sum(p => Math.Max(1, p.EstimatedWeeks)), 1);

    // Target duration the student actually asked for -- the Gantt's domain
    // stays fixed to this (never widened) in this containment fix. Phases
    // that don't fit are classified, not force-fitted -- see
    // RoadmapModel.ClassifyPhaseTimeline.
    var totalWeeks = Model.WorkloadSummary?.TotalWeeks > 0
        ? Model.WorkloadSummary.TotalWeeks
        : Math.Max(fallbackWeeks, 1);

    var timeline = FYPilot.Web.Pages.Student.RoadmapModel.ClassifyPhaseTimeline(orderedPhases, totalWeeks);

    // Rendered in the main Gantt/phase-nav/details -- a PartiallyBeyondTarget
    // phase still appears here (up to the target boundary, with a "continues
    // beyond target" badge) but a BeyondTarget or NeedsReview phase does not:
    // it would otherwise render at/after the last target week, which is
    // exactly the misleading "every overflow phase shows Week N" behavior
    // this replaces.
    var mainTimeline = timeline
        .Where(t => t.Status is FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.WithinTarget
            or FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.PartiallyBeyondTarget)
        .ToList();

    // Shown in the "Beyond target duration" section below the Gantt --
    // includes the overflow portion of a PartiallyBeyondTarget phase too,
    // per the required display behavior.
    var overflowTimeline = timeline
        .Where(t => t.Status is FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.PartiallyBeyondTarget
            or FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.BeyondTarget
            or FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.NeedsReview)
        .ToList();

    var selectedPhase =
        mainTimeline.Select(t => t.Phase).FirstOrDefault(p => !p.IsCompleted)
        ?? mainTimeline.Select(t => t.Phase).FirstOrDefault()
        ?? currentPhase;

    // Estimate only -- targetWeeks + the existing authoritative
    // RecommendedAdditionalWeeks figure (unchanged capacity-based
    // computation, see RoadmapModel.ComputeWorkloadSummary). Never a
    // confirmed scheduled horizon; labeled as an estimate wherever shown.
    var estimatedTotalWeeks = totalWeeks + (Model.WorkloadSummary?.RecommendedAdditionalWeeks ?? 0);

    string FeasibilityLabel(string? value) => value switch
    {
        "feasible" => "Feasible",
        "feasible_after_scope_reduction" => "Feasible after scope reduction",
        "over_capacity" => "Over capacity",
        _ => string.IsNullOrWhiteSpace(value) ? "Not evaluated" : value.Replace("_", " ")
    };

    string FeasibilityClass(string? value) => value switch
    {
        "feasible" => "is-feasible",
        "feasible_after_scope_reduction" => "is-adjusted",
        "over_capacity" => "is-over",
        _ => "is-neutral"
    };

    string ShortText(string? value, int maxLength = 100)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No additional details.";
        }

        var clean = value.Trim();
        return clean.Length <= maxLength
            ? clean
            : clean[..Math.Max(0, maxLength - 1)].TrimEnd() + "…";
    }
}

@if (Model.Idea == null)
{
    <main class="roadmap-empty-page">
        <section class="roadmap-empty-card" aria-labelledby="roadmap-empty-title">
            <div class="roadmap-empty-icon" aria-hidden="true">
                <i class="bi bi-signpost-split"></i>
            </div>
            <div class="roadmap-eyebrow">Project planning</div>
            <h1 id="roadmap-empty-title">Choose a project idea first</h1>
            <p>Your roadmap is generated from your selected idea, target duration, team size, and weekly capacity.</p>
            <div class="roadmap-empty-actions">
                <a class="btn roadmap-btn-primary" asp-page="/Student/IdeaComparison" asp-route-projectId="@Model.ProjectId">
                    <i class="bi bi-check2-circle"></i> Choose an Idea
                </a>
                <a class="btn roadmap-btn-secondary" asp-page="/Student/IdeaGenerator" asp-route-projectId="@Model.ProjectId">
                    <i class="bi bi-stars"></i> Generate Ideas
                </a>
            </div>
        </section>
    </main>
}
else
{
    <main class="roadmap-control" id="roadmap-print-root">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="roadmap-alert roadmap-alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @{
            var roadmapOutcome = Model.LatestReview != null
                ? FYPilot.Web.Pages.Student.RoadmapModel.ClassifyRoadmapOutcome(Model.LatestReview)
                : null;
        }

        @if (roadmapOutcome != null && roadmapOutcome.IsFallbackDisplayed)
        {
            <div class="roadmap-alert roadmap-alert-fallback" role="status" aria-live="polite">
                <i class="bi bi-cpu" aria-hidden="true"></i>
                <div>
                    <strong>@roadmapOutcome.Title &mdash; not AI-generated</strong>
                    <span>@roadmapOutcome.Message Regenerate once the AI service is available.</span>
                </div>
            </div>
        }

        <section class="rm-project-hero @(Model.Phases.Any() ? "" : "is-launch-state")">
            <div class="rm-project-icon" aria-hidden="true">
                <i class="bi bi-diagram-3"></i>
            </div>

            <div class="rm-project-main">
                <div class="roadmap-eyebrow">Project roadmap</div>
                <h1>@Model.Idea.Title</h1>

                <div class="rm-project-chips">
                    <span><i class="bi bi-grid"></i>@Model.Idea.Domain</span>
                    <span><i class="bi bi-people"></i>Team of @(Model.WorkloadSummary?.TeamSize ?? 1)</span>
                    <span><i class="bi bi-calendar3"></i>@totalWeeks weeks</span>
                    @if (estimatedTotalWeeks > totalWeeks)
                    {
                        <span class="is-estimate"><i class="bi bi-clock-history"></i>~@estimatedTotalWeeks wk est.</span>
                    }
                    @if (Model.LatestReview != null)
                    {
                        var (badgeClass, badgeLabel) = Model.DescribeReview(Model.LatestReview);
                        <span class="rm-review-chip @badgeClass" title="@Model.LatestReview.DecisionReason">
                            <i class="bi bi-shield-check"></i>@badgeLabel
                        </span>
                    }
                </div>
            </div>

            <div class="rm-hero-actions no-print">
                @if (Model.Phases.Any())
                {
                    <button type="button"
                            id="rmDownloadPdfButton"
                            class="btn roadmap-btn-secondary"
                            data-pdf-filename="@(Model.Idea.Title) Roadmap.pdf">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        <span>Export PDF</span>
                    </button>
                }

                <a href="/Student/ProjectDNA?projectId=@Model.ProjectId&amp;ideaId=@Model.Idea.Id"
                   class="btn roadmap-btn-secondary">
                    <i class="bi bi-fingerprint"></i>
                    Project DNA
                </a>

                @if (Model.Phases.Any())
                {
                    <form method="post" asp-page-handler="Generate" id="rmGenerateForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.Idea.Id" />
                        <button type="submit" class="btn roadmap-btn-primary">
                            <i class="bi bi-arrow-clockwise"></i>
                            Regenerate Roadmap
                        </button>
                    </form>
                }
            </div>

            @if (Model.Phases.Any())
            {
                <div class="rm-project-progress">
                    <div class="rm-progress-copy">
                        <span><strong>@done</strong> of <strong>@total</strong> phases completed</span>
                        <strong>@pct%</strong>
                    </div>
                    <div class="rm-progress-track" aria-label="@pct percent complete">
                        <div style="width:@pct%"></div>
                    </div>
                </div>
            }
            else
            {
                <div class="rm-launch-box">
                    <div>
                        <strong>Ready to build your execution plan</strong>
                        <span>Generate phases, effort estimates, workload allocation, capacity checks, and AI review.</span>
                    </div>
                    <form method="post" asp-page-handler="Generate" id="rmGenerateForm" class="rm-launch-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.Idea.Id" />
                        <button type="submit" class="btn roadmap-btn-primary roadmap-btn-large">
                            <i class="bi bi-magic"></i> Generate AI Roadmap
                        </button>
                    </form>
                </div>
            }
        </section>

        @if (Model.Phases.Any())
        {
            var summary = Model.WorkloadSummary;

            @if (summary != null)
            {
                <section class="rm-metrics-grid" aria-label="Project capacity summary">
                    <article class="rm-metric-card rm-metric-emphasis @FeasibilityClass(summary.ScheduleFeasibility)">
                        <div class="rm-metric-icon"><i class="bi bi-speedometer2"></i></div>
                        <span class="rm-metric-label">Utilization</span>
                        <strong class="rm-metric-value">@summary.UtilizationPercentage%</strong>
                        <span class="rm-metric-pill @FeasibilityClass(summary.ScheduleFeasibility)">@FeasibilityLabel(summary.ScheduleFeasibility)</span>
                        <div class="rm-mini-meter"><div style="width:@Math.Min(Math.Max(summary.UtilizationPercentage, 0), 100)%"></div></div>
                    </article>

                    <article class="rm-metric-card">
                        <div class="rm-metric-icon"><i class="bi bi-clock"></i></div>
                        <span class="rm-metric-label">Adjusted plan</span>
                        <strong class="rm-metric-value">@summary.AdjustedPlannedHours <small>h</small></strong>
                        <span class="rm-metric-caption">Total workload</span>
                    </article>

                    <article class="rm-metric-card">
                        <div class="rm-metric-icon is-bright"><i class="bi bi-bar-chart-line"></i></div>
                        <span class="rm-metric-label">Available capacity</span>
                        <strong class="rm-metric-value rm-value-accent">@summary.TotalCapacityHours <small>h</small></strong>
                        <span class="rm-metric-caption">Total capacity</span>
                    </article>

                    <article class="rm-metric-card">
                        <div class="rm-metric-icon"><i class="bi bi-people"></i></div>
                        <span class="rm-metric-label">Team size</span>
                        <strong class="rm-metric-value">@summary.TeamSize</strong>
                        <span class="rm-metric-caption">Member@(summary.TeamSize == 1 ? "" : "s")</span>
                    </article>

                    <article class="rm-metric-card">
                        <div class="rm-metric-icon"><i class="bi bi-calendar-week"></i></div>
                        <span class="rm-metric-label">Weekly capacity</span>
                        <strong class="rm-metric-value rm-value-accent">@summary.HoursPerWeekPerMember <small>h</small></strong>
                        <span class="rm-metric-caption">Per member</span>
                    </article>
                </section>
            }

            <section class="rm-timeline-card" aria-labelledby="gantt-title">
                <div class="rm-section-head">
                    <div class="rm-section-title">
                        <span class="rm-section-icon"><i class="bi bi-calendar3"></i></span>
                        <div>
                            <span class="roadmap-eyebrow">Roadmap timeline</span>
                            <h2 id="gantt-title">Weekly execution plan</h2>
                        </div>
                    </div>

                    <div class="rm-timeline-legend" aria-label="Timeline legend">
                        <span><i class="legend-dot current"></i>Current</span>
                        <span><i class="legend-dot completed"></i>Completed</span>
                        <span><i class="legend-dot upcoming"></i>Pending</span>
                    </div>
                </div>

                <div class="rm-timeline-scroll">
                    <div class="rm-timeline" style="--week-count:@totalWeeks;">
                        <div class="rm-timeline-head rm-phase-head"># &nbsp;&nbsp; Phase</div>
                        <div class="rm-week-heads" style="--week-count:@totalWeeks;">
                            @for (var week = 1; week <= totalWeeks; week++)
                            {
                                <span>W@(week)</span>
                            }
                        </div>

                        @foreach (var entry in mainTimeline)
                        {
                            var phase = entry.Phase;
                            var phaseKey = Convert.ToString(phase.Id) ?? phase.PhaseNumber.ToString();
                            var duration = entry.WithinTargetEndWeek - entry.DisplayStartWeek + 1;
                            var tasks = FYPilot.Web.Pages.Student.RoadmapModel.ParseTasks(phase.TasksJson);
                            var stateClass = phase.IsCompleted
                                ? "is-completed"
                                : (currentPhase != null && Convert.ToString(currentPhase.Id) == phaseKey ? "is-current" : "is-upcoming");

                            <button type="button"
                                    class="rm-phase-label @stateClass"
                                    data-phase-select="@phaseKey"
                                    aria-label="View details for @phase.Name">
                                <span class="rm-phase-number">
                                    @if (phase.IsCompleted)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else
                                    {
                                        @phase.PhaseNumber
                                    }
                                </span>
                                <strong>@phase.Name</strong>
                            </button>

                            <div class="rm-week-track" style="--week-count:@totalWeeks;">
                                <button type="button"
                                        class="rm-phase-bar @stateClass @(entry.Status == FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.PartiallyBeyondTarget ? "is-overflowing" : "")"
                                        style="grid-column:@entry.DisplayStartWeek / span @duration;"
                                        data-phase-select="@phaseKey"
                                        title="@phase.Name: week @entry.DisplayStartWeek to @entry.WithinTargetEndWeek">
                                    <span>@duration wk@(duration > 1 ? "s" : "")</span>
                                    @if (tasks.Count > 0)
                                    {
                                        <small>· @tasks.Count task@(tasks.Count == 1 ? "" : "s")</small>
                                    }
                                </button>
                            </div>
                        }

                        @if (overflowTimeline.Any())
                        {
                            <div class="rm-overflow-timeline-label">
                                <span class="rm-phase-number"><i class="bi bi-signpost-split"></i></span>
                                <strong>@overflowTimeline.Count phase@(overflowTimeline.Count == 1 ? "" : "s") beyond target</strong>
                            </div>
                            <div class="rm-overflow-timeline-track">
                                <span><i class="bi bi-arrow-right"></i> Continues after week @totalWeeks</span>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="rm-overview-grid">
                <article class="rm-current-card">
                    <div class="rm-card-title-line">
                        <div class="rm-section-title compact">
                            <span class="rm-section-icon"><i class="bi bi-flag"></i></span>
                            <div>
                                <span class="roadmap-eyebrow">Current phase</span>
                            </div>
                        </div>
                        @if (currentPhase != null)
                        {
                            <span class="rm-status-chip">In progress</span>
                        }
                        else
                        {
                            <span class="rm-status-chip">Completed</span>
                        }
                    </div>

                    @if (currentPhase != null)
                    {
                        var currentEntry = timeline.FirstOrDefault(t => Convert.ToString(t.Phase.Id) == Convert.ToString(currentPhase.Id));
                        var currentTasks = FYPilot.Web.Pages.Student.RoadmapModel.ParseTasks(currentPhase.TasksJson);
                        var currentPhaseKey = Convert.ToString(currentPhase.Id) ?? currentPhase.PhaseNumber.ToString();

                        <div class="rm-current-heading">
                            <span class="rm-current-number">@currentPhase.PhaseNumber</span>
                            <h3>@currentPhase.Name</h3>
                        </div>

                        <p>@currentPhase.Objective</p>

                        <div class="rm-current-facts">
                            <div>
                                <span>Duration</span>
                                <strong>@(currentEntry != null ? currentEntry.DisplayEndWeek - currentEntry.DisplayStartWeek + 1 : Math.Max(1, currentPhase.EstimatedWeeks)) week(s)</strong>
                            </div>
                            <div>
                                <span>Tasks</span>
                                <strong>@currentTasks.Count</strong>
                            </div>
                            <div>
                                <span>Dependencies</span>
                                <strong>@(string.IsNullOrWhiteSpace(currentPhase.Dependencies) ? "—" : currentPhase.Dependencies)</strong>
                            </div>
                        </div>

                        <div class="rm-phase-progress-block">
                            <div class="rm-phase-progress-copy">
                                <span>Roadmap progress</span>
                                <strong>@pct%</strong>
                            </div>
                            <div class="rm-progress-track"><div style="width:@pct%"></div></div>
                        </div>

                        <button type="button" class="rm-primary-wide" data-phase-select="@currentPhaseKey">
                            <span>View phase details</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    }
                    else
                    {
                        <div class="rm-complete-state">
                            <i class="bi bi-check2-circle"></i>
                            <h3>Roadmap completed</h3>
                            <p>Every scheduled phase has been marked as complete.</p>
                        </div>
                    }
                </article>

                <article class="rm-alert-card">
                    <div class="rm-card-title-line">
                        <div class="rm-section-title compact">
                            <span class="rm-section-icon"><i class="bi bi-exclamation-triangle"></i></span>
                            <div>
                                <span class="roadmap-eyebrow">Project alerts</span>
                            </div>
                        </div>
                        @{
                            var alertCount = (summary?.Warnings.Count ?? 0)
                                + ((summary != null && summary.ScheduleFeasibility == "over_capacity" && summary.RecommendedAdditionalWeeks > 0) ? 1 : 0);
                        }
                        @if (alertCount > 0)
                        {
                            <span class="rm-alert-count">@alertCount</span>
                        }
                    </div>

                    <div class="rm-alert-list">
                        @if (summary != null && summary.ScheduleFeasibility == "over_capacity" && summary.RecommendedAdditionalWeeks > 0)
                        {
                            <div class="rm-alert-row">
                                <span class="rm-alert-icon"><i class="bi bi-info-circle"></i></span>
                                <div>
                                    <strong>Capacity needs attention</strong>
                                    <p>Add approximately @summary.RecommendedAdditionalWeeks more week(s) or reduce mandatory scope.</p>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </div>
                        }

                        @if (summary != null)
                        {
                            @foreach (var warning in summary.Warnings.Take(3))
                            {
                                <div class="rm-alert-row">
                                    <span class="rm-alert-icon"><i class="bi bi-exclamation-triangle"></i></span>
                                    <div>
                                        <strong>Schedule risk</strong>
                                        <p title="@warning">@ShortText(warning, 125)</p>
                                    </div>
                                    <i class="bi bi-chevron-right"></i>
                                </div>
                            }
                        }

                        @if (alertCount == 0)
                        {
                            <div class="rm-alert-empty">
                                <i class="bi bi-check2-circle"></i>
                                <span>No schedule alerts right now.</span>
                            </div>
                        }
                    </div>
                </article>

                <article class="rm-workload-card rm-workload-compact">
                    <div class="rm-card-title-line">
                        <div class="rm-section-title compact">
                            <span class="rm-section-icon"><i class="bi bi-people"></i></span>
                            <div>
                                <span class="roadmap-eyebrow">Team workload</span>
                            </div>
                        </div>
                    </div>

                    @if (summary != null && summary.WorkloadByMember.Any())
                    {
                        <div class="rm-workload-list">
                            @foreach (var member in summary.WorkloadByMember)
                            {
                                var memberWidth = Math.Min(Math.Max(member.UtilizationPercentage, 0), 100);
                                <div class="rm-workload-row">
                                    <div class="rm-workload-copy">
                                        <strong>@member.Member</strong>
                                        <span><b>@member.AssignedHours h</b> · @member.UtilizationPercentage%</span>
                                    </div>
                                    <div class="rm-workload-track"><div style="width:@memberWidth%"></div></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rm-workload-empty">
                            <i class="bi bi-people"></i>
                            <span>No workload allocation available.</span>
                        </div>
                    }
                </article>

                <article class="rm-beyond-card">
                    <div class="rm-card-title-line">
                        <div class="rm-section-title compact">
                            <span class="rm-section-icon"><i class="bi bi-signpost-split"></i></span>
                            <div>
                                <span class="roadmap-eyebrow">Beyond target duration</span>
                            </div>
                        </div>
                    </div>

                    @if (overflowTimeline.Any())
                    {
                        <div class="rm-beyond-list">
                            @foreach (var entry in overflowTimeline)
                            {
                                var phase = entry.Phase;
                                var phaseHours = FYPilot.Web.Pages.Student.RoadmapModel.ParseTasks(phase.TasksJson).Sum(t => t.EstimatedHours ?? 0);
                                <div class="rm-beyond-item">
                                    <span class="rm-beyond-number">@phase.PhaseNumber</span>
                                    <div class="rm-beyond-content">
                                        <div class="rm-beyond-title">
                                            <strong>@phase.Name</strong>
                                            <span>Beyond target</span>
                                        </div>
                                        <p>@ShortText(phase.Objective, 130)</p>
                                        <div class="rm-beyond-meta">
                                            @if (entry.Status != FYPilot.Web.Pages.Student.RoadmapPhaseTimelineStatus.NeedsReview)
                                            {
                                                <span><i class="bi bi-clock"></i>Week @entry.DisplayStartWeek@(entry.DisplayEndWeek > entry.DisplayStartWeek ? $"–{entry.DisplayEndWeek}" : "")</span>
                                            }
                                            @if (phaseHours > 0)
                                            {
                                                <span><i class="bi bi-hourglass-split"></i>@phaseHours h planned</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(phase.ExpectedOutput))
                                            {
                                                <span title="@phase.ExpectedOutput"><i class="bi bi-folder2"></i>@ShortText(phase.ExpectedOutput, 34)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rm-beyond-empty">
                            <i class="bi bi-check2-circle"></i>
                            <span>All scheduled phases fit within the selected target duration.</span>
                        </div>
                    }
                </article>
            </section>

            <section class="rm-detail-section" aria-labelledby="phase-details-title">
                <div class="rm-section-head">
                    <div class="rm-section-title">
                        <span class="rm-section-icon"><i class="bi bi-list-check"></i></span>
                        <div>
                            <span class="roadmap-eyebrow">Execution details</span>
                            <h2 id="phase-details-title">Phase plan</h2>
                        </div>
                    </div>
                    <span class="rm-detail-hint">Select any phase from the timeline</span>
                </div>

                @foreach (var entry in mainTimeline)
                {
                    var phase = entry.Phase;
                    var phaseKey = Convert.ToString(phase.Id) ?? phase.PhaseNumber.ToString();
                    var isSelected = selectedPhase != null && Convert.ToString(selectedPhase.Id) == phaseKey;
                    var tasks = FYPilot.Web.Pages.Student.RoadmapModel.ParseTasks(phase.TasksJson);
                    var isLocked = !phase.IsCompleted && orderedPhases.Any(p => p.PhaseNumber < phase.PhaseNumber && !p.IsCompleted);

                    <article id="phase-panel-@phaseKey"
                             class="rm-detail-panel @(isSelected ? "is-active" : "")"
                             data-phase-panel="@phaseKey"
                             role="tabpanel"
                             aria-hidden="@(isSelected ? "false" : "true")">
                        <div class="rm-detail-header">
                            <div>
                                <div class="rm-detail-kicker">
                                    <span>Phase @phase.PhaseNumber</span>
                                    <span>Week @entry.DisplayStartWeek@(entry.WithinTargetEndWeek > entry.DisplayStartWeek ? $"–{entry.WithinTargetEndWeek}" : "")</span>
                                </div>
                                <h3>@phase.Name</h3>
                                <p>@phase.Objective</p>
                            </div>

                            <div class="rm-detail-action">
                                @if (phase.IsCompleted)
                                {
                                    <span class="rm-status-chip"><i class="bi bi-check2"></i>Completed</span>
                                }
                                else if (isLocked)
                                {
                                    <span class="rm-status-chip"><i class="bi bi-lock"></i>Finish earlier phases first</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Complete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="phaseId" value="@phase.Id" />
                                        <input type="hidden" name="ideaId" value="@Model.Idea.Id" />
                                        <button type="submit" class="btn roadmap-btn-primary">
                                            <i class="bi bi-check2"></i> Mark phase done
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        <div class="rm-detail-facts">
                            <div><span>Duration</span><strong>@(entry.WithinTargetEndWeek - entry.DisplayStartWeek + 1) week(s)</strong></div>
                            <div><span>Tasks</span><strong>@tasks.Count</strong></div>
                            <div><span>Dependencies</span><strong>@(string.IsNullOrWhiteSpace(phase.Dependencies) ? "None" : phase.Dependencies)</strong></div>
                        </div>

                        @if (tasks.Any())
                        {
                            <div class="rm-task-table-wrap">
                                <table class="rm-task-table">
                                    <thead>
                                        <tr><th>Task</th><th>Effort</th><th>Owner</th></tr>
                                    </thead>
                                    <tbody>
                                    @{ var taskNumber = 0; }
                                    @foreach (var task in tasks)
                                    {
                                        taskNumber++;
                                        <tr>
                                            <td>
                                                <div class="rm-task-title"><span>@taskNumber</span><strong>@task.Title</strong></div>
                                            </td>
                                            <td>@(task.EstimatedHours.HasValue ? $"{task.EstimatedHours}h" : "—")</td>
                                            <td>
                                                @if (task.MemberAllocations.Count > 0)
                                                {
                                                    <div class="rm-owner-list">
                                                        @foreach (var allocation in task.MemberAllocations)
                                                        {
                                                            <span><strong>@allocation.MemberId</strong> @allocation.AllocationPercentage% · @allocation.AllocatedHours h</span>
                                                        }
                                                    </div>
                                                }
                                                else if (task.AssignedMembers.Count > 0)
                                                {
                                                    <div class="rm-owner-list">
                                                        @foreach (var member in task.AssignedMembers) { <span>@member</span> }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="rm-muted">Unassigned</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="rm-detail-info-grid">
                            @if (!string.IsNullOrWhiteSpace(phase.ExpectedOutput))
                            {
                                <div class="rm-info-card">
                                    <span class="rm-info-icon"><i class="bi bi-box-arrow-in-down"></i></span>
                                    <div><span>Expected output</span><p>@phase.ExpectedOutput</p></div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(phase.SuccessCriteria))
                            {
                                <div class="rm-info-card">
                                    <span class="rm-info-icon"><i class="bi bi-bullseye"></i></span>
                                    <div><span>Success criteria</span><p>@phase.SuccessCriteria</p></div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(phase.Risks))
                            {
                                <div class="rm-info-card rm-info-risk">
                                    <span class="rm-info-icon"><i class="bi bi-exclamation-triangle"></i></span>
                                    <div><span>Risk warning</span><p>@phase.Risks</p></div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </section>

            @if (Model.DeferredTasks.Any())
            {
                <section class="rm-deferred-card" aria-labelledby="deferred-title">
                    <details>
                        <summary>
                            <span><i class="bi bi-archive"></i><strong id="deferred-title">Future enhancements</strong><small>Excluded from the current delivery plan</small></span>
                            <span>@Model.DeferredTasks.Count task(s)</span>
                        </summary>
                        <div class="rm-task-table-wrap deferred">
                            <table class="rm-task-table">
                                <thead><tr><th>Task</th><th>Original phase</th><th>Effort</th><th>Priority</th><th>Reason deferred</th></tr></thead>
                                <tbody>
                                @foreach (var task in Model.DeferredTasks)
                                {
                                    <tr>
                                        <td><strong>@task.Title</strong></td>
                                        <td>@task.OriginalPhase</td>
                                        <td>@task.EstimatedHours h</td>
                                        <td>@task.Priority</td>
                                        <td>@task.ReasonDeferred</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </section>
            }


        }

        <div class="roadmap-loading-overlay d-none"
             id="rmLoadingOverlay"
             role="status"
             aria-live="polite"
             aria-label="Generating project roadmap">
            <div class="roadmap-loading-panel">
                <div class="roadmap-loading-top">
                    <div class="roadmap-loading-spinner" aria-hidden="true"></div>
                    <div>
                        <div class="roadmap-eyebrow">AI processing</div>
                        <h2>Building your project roadmap</h2>
                        <p>Keep this page open while FYPilot generates, schedules, validates, and reviews the plan.</p>
                    </div>
                </div>
                <div class="roadmap-loading-progress"><div></div></div>
                <ol class="roadmap-loading-steps">
                    <li class="is-active"><i class="bi bi-folder2-open"></i>Reading project context</li>
                    <li><i class="bi bi-diagram-3"></i>Generating project-specific phases</li>
                    <li><i class="bi bi-hourglass-split"></i>Estimating tasks and effort</li>
                    <li><i class="bi bi-people"></i>Allocating team workload</li>
                    <li><i class="bi bi-shield-check"></i>Reviewing roadmap quality</li>
                </ol>
            </div>
        </div>
    </main>
}

<partial name="_AiDisclaimerFooter" />

