            .ring-c {
                width: 285px;
                height: 285px;
            }
        }

        @@media (max-width: 1080px) {
            .nova-universe-map {
                grid-template-columns: 1fr;
            }

            .nova-universe-core {
                height: 300px;
            }

            .nova-universe-column {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 780px) {
            .nova-main-action-copy em {
                white-space: normal;
            }

            .nova-activity-wide .nova-section-header h2 {
                font-size: 1.18rem;
            }

            .nova-capability-universe .nova-section-header h2 {
                font-size: 1.28rem;
            }

            .nova-capability-universe .nova-section-header p {
                font-size: .76rem;
            }
        }

        @@media (max-width: 560px) {
            .nova-universe-column {
                grid-template-columns: 1fr;
            }

            .nova-feature-node {
                min-height: 76px;
            }
        }

        /* =========================================================
                   DASHBOARD TOP HERO ONLY
                   - Compact height
                   - FYPilot navy/steel palette
                   - No bright electric blue
                   - No square/grid background
                   - All dashboard sections below remain unchanged
                   ========================================================= */

        .nova-dashboard {
            --theme-hero: radial-gradient( circle at 88% 10%, rgba(255,255,255,.08), transparent 30% ), radial-gradient( circle at 42% 115%, rgba(81,108,141,.20), transparent 34% ), linear-gradient( 128deg, #17233F 0%, #28385E 58%, #405577 100% );
        }

        .nova-top-deck {
            background: var(--theme-hero) !important;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 22px;
            box-shadow: 0 16px 38px rgba(23,35,63,.18);
        }

            /* Remove the square/grid pattern completely. */
            .nova-top-deck .nova-mesh {
                display: none !important;
                background: none !important;
                background-image: none !important;
            }

            /* Remove the bright decorative blue/cyan/violet orbs. */
            .nova-top-deck .nova-orb {
                display: none !important;
                animation: none !important;
            }

        .nova-topbar {
            min-height: 0;
            padding: .5rem .9rem;
            border-bottom-color: rgba(255,255,255,.08);
        }

        .nova-live-label {
            color: rgba(255,255,255,.68);
            font-size: .64rem;
        }

        .nova-live-pulse {
            background: #8ED6B2;
            box-shadow: 0 0 0 4px rgba(142,214,178,.10);
        }

            .nova-live-pulse::after {
                border-color: rgba(142,214,178,.34);
            }

        .nova-hero-grid {
            grid-template-columns: minmax(0,1.6fr) minmax(245px,.4fr);
            gap: 1rem;
            padding: .85rem 1.05rem 1rem;
        }

        .nova-project-chip {
            padding: .3rem .5rem;
            color: #DCE6F1;
            background: rgba(255,255,255,.07);
            border-color: rgba(255,255,255,.14);
        }

        .nova-project-identity h1 {
            max-width: 880px;
            margin-top: .55rem;
            font-size: clamp(1.55rem,2.65vw,2.2rem);
            line-height: 1.04;
        }

        .nova-project-meta {
            margin-top: .52rem;
            gap: .38rem .75rem;
            color: rgba(255,255,255,.68);
            font-size: .69rem;
        }

        .nova-project-identity > p {
            max-width: 800px;
            margin-top: .48rem;
            color: rgba(255,255,255,.66);
            font-size: .76rem;
            line-height: 1.48;
        }

        .nova-hero-actions {
            gap: .52rem;
            margin-top: .65rem;
        }

        .nova-main-action {
            min-width: min(100%,390px);
            gap: .58rem;
            padding: .5rem .62rem;
            border-radius: 12px;
            box-shadow: 0 10px 24px rgba(8,18,38,.18);
        }

            .nova-main-action:hover {
                box-shadow: 0 14px 30px rgba(8,18,38,.23);
            }

        .nova-main-action-icon {
            width: 31px;
            height: 31px;
            background: linear-gradient(135deg,#28385E,#516C8D);
            border-radius: 9px;
        }

        .nova-main-action-copy small {
            font-size: .56rem;
        }

        .nova-main-action-copy strong {
            font-size: .74rem;
        }

        .nova-main-action-copy em {
            max-width: 470px;
            margin-top: .08rem;
            font-size: .57rem;
        }

        .nova-ghost-action {
            min-height: 42px;
            padding-inline: .72rem;
            color: #F5F7FA;
            background: rgba(255,255,255,.06);
            border-color: rgba(255,255,255,.16);
            border-radius: 11px;
            font-size: .64rem;
        }

            .nova-ghost-action:hover {
                color: #17233F;
                background: #FFFFFF;
            }

        .nova-project-summary {
            gap: .5rem;
            padding: .7rem;
            background: rgba(255,255,255,.065);
            border-color: rgba(255,255,255,.12);
            border-radius: 15px;
        }

        .nova-summary-heading > div:first-child strong {
            font-size: 1.36rem;
        }

        .nova-summary-ring {
            width: 50px;
            height: 50px;
            background: conic-gradient( #8ED6B2 calc(var(--summary-progress) * 1%), rgba(255,255,255,.12) 0 );
            box-shadow: 0 0 16px rgba(142,214,178,.18);
        }

            .nova-summary-ring::before {
                inset: 5px;
                background: #28385E;
            }

        .nova-summary-progress {
            padding: .48rem;
            background: rgba(255,255,255,.045);
        }

        .nova-summary-progress-track span {
            background: linear-gradient(90deg,#8ED6B2,#A8BDD1);
        }

        .nova-summary-checklist {
            gap: .25rem;
        }

            .nova-summary-checklist > div {
                padding: .34rem .42rem;
                background: rgba(255,255,255,.035);
                border-radius: 8px;
                font-size: .57rem;
            }

                .nova-summary-checklist > div.is-complete {
                    color: #D8F3E5;
                }

                    .nova-summary-checklist > div.is-complete i {
                        color: #8ED6B2;
                    }

        @@media (max-width: 1080px) {
            .nova-hero-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 780px) {
            .nova-topbar {
                padding: .48rem .75rem;
            }

            .nova-hero-grid {
                padding: .78rem;
            }

            .nova-project-identity h1 {
                font-size: clamp(1.45rem,7vw,1.95rem);
            }
        }

    </style>
}

@section Scripts {
    <script>

        (function () {
            const buttons = document.querySelectorAll("[data-journey-select]");
            const panels = document.querySelectorAll("[data-journey-panel]");

            function selectJourney(stage) {
                buttons.forEach(function (button) {
                    const active = button.getAttribute("data-journey-select") === stage;
                    button.classList.toggle("is-active", active);
                    button.setAttribute("aria-selected", active ? "true" : "false");
                });

                panels.forEach(function (panel) {
                    panel.classList.toggle(
                        "is-active",
                        panel.getAttribute("data-journey-panel") === stage
                    );
                });
            }

            buttons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const stage = button.getAttribute("data-journey-select");

                    if (stage) {
                        selectJourney(stage);
                    }
                });
            });
        })();

        (function () {
            const filterButtons = document.querySelectorAll("[data-capability-filter]");
            const nodes = document.querySelectorAll("[data-capability-group]");

            filterButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const filter = button.getAttribute("data-capability-filter");

                    filterButtons.forEach(function (item) {
                        item.classList.toggle("is-active", item === button);
                    });

                    nodes.forEach(function (node) {
                        const group = node.getAttribute("data-capability-group");
                        node.classList.toggle(
                            "is-filtered",
                            filter !== "all" && group !== filter
                        );
                    });
                });
            });
        })();

        (function () {
            const trigger = document.getElementById("novaDockTrigger");
            const dock = document.getElementById("novaQuickDock");

            if (!trigger || !dock) {
                return;
            }

            trigger.addEventListener("click", function () {
                const open = dock.classList.toggle("is-open");
                trigger.setAttribute("aria-expanded", open ? "true" : "false");
            });

            document.addEventListener("click", function (event) {
                if (!dock.contains(event.target) && !trigger.contains(event.target)) {
                    dock.classList.remove("is-open");
                    trigger.setAttribute("aria-expanded", "false");
                }
            });
        })();

        (function () {
            const openButton = document.getElementById("openTrustDetails");
            const closeButton = document.getElementById("closeTrustDetails");
            const modal = document.getElementById("trustLayerModal");

            if (!openButton || !closeButton || !modal) {
                return;
            }

            function setOpen(open) {
                modal.classList.toggle("is-open", open);
                modal.setAttribute("aria-hidden", open ? "false" : "true");
                document.body.style.overflow = open ? "hidden" : "";
            }

            openButton.addEventListener("click", function () {
                setOpen(true);
            });

            closeButton.addEventListener("click", function () {
                setOpen(false);
            });

            modal.addEventListener("click", function (event) {
                if (event.target === modal) {
                    setOpen(false);
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    setOpen(false);
                }
            });
        })();

        (function () {
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            if (reduceMotion || window.matchMedia("(pointer: coarse)").matches) {
                return;
            }

            document.querySelectorAll("[data-float-card]").forEach(function (card) {
                card.addEventListener("pointermove", function (event) {
                    const rect = card.getBoundingClientRect();
                    const x = (event.clientX - rect.left) / rect.width - .5;
                    const y = (event.clientY - rect.top) / rect.height - .5;

                    card.style.transform =
                        `perspective(1000px) rotateX(${(-y * .55).toFixed(2)}deg) ` +
                        `rotateY(${(x * .7).toFixed(2)}deg)`;
                });

                card.addEventListener("pointerleave", function () {
                    card.style.transform = "";
                });
            });

            document.querySelectorAll("[data-tilt-card]").forEach(function (card) {
                card.addEventListener("pointermove", function (event) {
                    const rect = card.getBoundingClientRect();
                    const x = (event.clientX - rect.left) / rect.width - .5;
                    const y = (event.clientY - rect.top) / rect.height - .5;

                    card.style.transform =
                        `perspective(1200px) rotateX(${(-y * .28).toFixed(2)}deg) ` +
                        `rotateY(${(x * .36).toFixed(2)}deg)`;
                });

                card.addEventListener("pointerleave", function () {
                    card.style.transform = "";
                });
            });
        })();

        (function () {
            const dashboard = document.querySelector(".nova-dashboard");
            const overlay = document.getElementById("studentTourOverlay");
            const spotlight = document.getElementById("studentTourSpotlight");
            const card = document.getElementById("studentTourCard");
            const title = document.getElementById("studentTourTitle");
            const description = document.getElementById("studentTourDescription");
            const kicker = document.getElementById("studentTourKicker");
            const tip = document.getElementById("studentTourTip");
            const icon = document.getElementById("studentTourStepIcon");
            const progress = document.getElementById("studentTourProgress");
            const progressBar = document.getElementById("studentTourProgressBar");
            const backButton = document.getElementById("studentTourBack");
            const nextButton = document.getElementById("studentTourNext");
            const skipButton = document.getElementById("studentTourSkip");
            const closeButton = document.getElementById("studentTourClose");
            const openNextButton = document.getElementById("studentTourOpenNext");
            const restartButton = document.getElementById("startStudentTourButton");

            if (!dashboard || !overlay || !spotlight || !card) return;

            const userId = dashboard.dataset.tourUserId || "anonymous";
            const version = dashboard.dataset.tourVersion || "1";
            const storageKey = `fypilot.student-onboarding.v${version}.${userId}`;
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            const steps = [
                {
                    type: "welcome", icon: "bi-stars", kicker: "Welcome to FYPilot",
                    title: "Your project journey starts here",
                    description: "FYPilot guides your final-year project from skills and idea selection to planning, engineering, supervision, and defense.",
                    tip: "This tour can be skipped and restarted later from the Tour button in the top bar."
                },
                {
                    selector: "[data-tour='project-command']", icon: "bi-grid-1x2",
                    kicker: "Project Command Center", title: "Everything begins with the active project",
                    description: "This area shows the project you are currently working on, your role, team, readiness, and current status.",
                    tip: "Use Switch Project before working on another personal or shared project."
                },
                {
                    selector: "[data-tour='next-action']", icon: "bi-signpost-split",
                    kicker: "Recommended workflow", title: "FYPilot tells you what to do next",
                    description: "The recommended action changes according to your progress, so you always know the next useful step.",
                    tip: "The normal order is Skills → Idea → Plan → Execute → Defend."
                },
                {
                    selector: "[data-tour='project-stats']", icon: "bi-bar-chart-line",
                    kicker: "Project pulse", title: "Understand the project at a glance",
                    description: "These indicators show the current stage, planning readiness, team capacity, and available planning assets.",
                    tip: "The recommended action is calculated from missing project foundations, not selected randomly."
                },
                {
                    selector: "[data-tour='project-journey']", icon: "bi-diagram-3",
                    kicker: "Interactive lifecycle", title: "Move through the full FYP journey",
                    description: "Select Skills, Idea, Plan, Execute, or Defend to understand the stage and open its correct feature.",
                    tip: "Green means completed; blue marks the current recommended stage."
                },
                {
                    selector: "[data-tour='skill-assessment']", icon: "bi-bar-chart-line",
                    kicker: "Step 1 — Skills", title: "Start with Skill Assessment",
                    description: "Your private skill profile helps FYPilot match ideas and guidance to your actual technical level.",
                    tip: "Complete this before relying on generated project recommendations."
                },
                {
                    selector: "[data-tour='idea-generator']", icon: "bi-lightbulb",
                    kicker: "Step 2 — Direction", title: "Generate and validate project ideas",
                    description: "Use Idea Generator, Idea Comparison, Market Demand, and Project DNA to select a strong project direction.",
                    tip: "The selected shared idea becomes the source of truth for later features."
                },
                {
                    selector: "[data-tour='roadmap']", icon: "bi-map",
                    kicker: "Step 3 — Planning", title: "Build a realistic project roadmap",
                    description: "Roadmap converts the selected idea into phases, tasks, durations, hours, dependencies, and team allocations.",
                    tip: "Finish planning before beginning heavy project implementation."
                },
                {
                    selector: "[data-tour='se-documentation']", icon: "bi-journal-code",
                    kicker: "Step 4 — Engineering", title: "Generate Software Engineering documentation",
                    description: "Create requirements, use cases, architecture, database design, UI specifications, tests, diagrams, and traceability.",
                    tip: "Check assumptions and the Quality Passport before downloading."
                },
                {
                    selector: "[data-tour='mentor-chat']", icon: "bi-chat-dots",
                    kicker: "Project support", title: "Get support throughout the project",
                    description: "Mentor Chat provides contextual guidance. Defense Simulator prepares questions, while Supervisor Feedback keeps human guidance visible.",
                    tip: "AI guidance supports the project; your supervisor remains the academic authority."
                },
                {
                    selector: "[data-tour='trust-layer']", icon: "bi-shield-lock",
                    kicker: "AI TrustLayer", title: "Critical AI output is reviewed",
                    description: "Important results pass through the LLM Firewall, schema validation, AI Reviewer, and Quality Passport.",
                    tip: "Open the TrustLayer flow to see the complete review architecture."
                },
                {
                    selector: "[data-tour='capability-universe']", icon: "bi-stars",
                    kicker: "Complete ecosystem", title: "Every FYPilot capability is connected",
                    description: "This map gives direct access to planning, engineering, support, and defense tools around the active project.",
                    tip: "Use the filters to focus on Plan, Build, or Support features."
                },
                {
                    type: "finish", icon: "bi-check2-circle", kicker: "Tour completed",
                    title: "You are ready to use FYPilot",
                    description: "Follow the recommended next move and progress through the lifecycle one stage at a time.",
                    tip: "Restart the tour whenever needed from the top bar."
                }
            ];

            let index = 0;
            let target = null;
            let previousFocus = null;

            function seen() {
                try { return Boolean(localStorage.getItem(storageKey)); }
                catch { return false; }
            }

            function save(status) {
                try {
                    localStorage.setItem(storageKey, JSON.stringify({
                        status, version, updatedAt: new Date().toISOString()
                    }));
                } catch { }
            }

            function delay(ms) {
                return new Promise(resolve => window.setTimeout(resolve, ms));
            }

            function clearTarget() {
                if (target) target.classList.remove("student-tour-target-emphasis");
                target = null;
            }

            async function reveal(element) {
                element.scrollIntoView({
                    behavior: reduceMotion ? "auto" : "smooth",
                    block: "center",
                    inline: "nearest"
                });
                await delay(reduceMotion ? 20 : 330);
            }

            function placeCard(rect) {
                const gap = 18;
                const vw = window.innerWidth;
                const vh = window.innerHeight;
                const cardRect = card.getBoundingClientRect();
                let left = (vw - cardRect.width) / 2;
                let top = (vh - cardRect.height) / 2;

                if (vw - rect.right >= cardRect.width + gap) {
                    left = rect.right + gap;
                    top = rect.top + (rect.height - cardRect.height) / 2;
                } else if (rect.left >= cardRect.width + gap) {
                    left = rect.left - cardRect.width - gap;
                    top = rect.top + (rect.height - cardRect.height) / 2;
                } else if (vh - rect.bottom >= cardRect.height + gap) {
                    left = rect.left + (rect.width - cardRect.width) / 2;
                    top = rect.bottom + gap;
                } else {
                    left = rect.left + (rect.width - cardRect.width) / 2;
                    top = rect.top - cardRect.height - gap;
                }

                left = Math.max(12, Math.min(left, vw - cardRect.width - 12));
                top = Math.max(12, Math.min(top, vh - cardRect.height - 12));
                card.style.left = `${left}px`;
                card.style.top = `${top}px`;
            }

            function positionTarget(element) {
                const rect = element.getBoundingClientRect();
                const pad = 9;
                const top = Math.max(6, rect.top - pad);
                const left = Math.max(6, rect.left - pad);
                const right = Math.min(window.innerWidth - 6, rect.right + pad);
                const bottom = Math.min(window.innerHeight - 6, rect.bottom + pad);

                spotlight.style.top = `${top}px`;
                spotlight.style.left = `${left}px`;
                spotlight.style.width = `${Math.max(24, right - left)}px`;
                spotlight.style.height = `${Math.max(24, bottom - top)}px`;
                spotlight.style.borderRadius =
                    window.getComputedStyle(element).borderRadius || "14px";

                placeCard({
                    top, left, right, bottom,
                    width: right - left,
                    height: bottom - top
                });
            }

            async function render() {
                const step = steps[index];
                clearTarget();
                overlay.classList.remove("has-target", "is-centered", "is-finished");

                icon.innerHTML = `<i class="bi ${step.icon}"></i>`;
                kicker.textContent = step.kicker;
                title.textContent = step.title;
                description.textContent = step.description;
                tip.querySelector("span").textContent = step.tip;

                progress.textContent =
                    step.type === "welcome" ? "Welcome" :
                    step.type === "finish" ? "Tour complete" :
                    `Step ${index} of ${steps.length - 2}`;

                progressBar.style.width =
                    step.type === "welcome" ? "4%" :
                    step.type === "finish" ? "100%" :
                    `${Math.round((index / (steps.length - 1)) * 100)}%`;

                backButton.disabled = index === 0;
                nextButton.innerHTML =
                    step.type === "welcome"
                        ? 'Start tour <i class="bi bi-arrow-right"></i>'
                        : step.type === "finish"
                            ? 'Finish <i class="bi bi-check2"></i>'
                            : 'Next <i class="bi bi-arrow-right"></i>';

                if (step.type === "welcome" || step.type === "finish") {
                    overlay.classList.add("is-centered");
                    if (step.type === "finish") overlay.classList.add("is-finished");
                    card.style.left = "";
                    card.style.top = "";
                    return;
                }

                target = document.querySelector(step.selector);

                if (!target) {
                    index += 1;
                    await render();
                    return;
                }

                await reveal(target);
                target.classList.add("student-tour-target-emphasis");
                overlay.classList.add("has-target");
                positionTarget(target);
            }

            async function start(force) {
                if (!force && seen()) return;
                previousFocus = document.activeElement;
                index = 0;
                overlay.classList.add("is-open");
                overlay.setAttribute("aria-hidden", "false");
                await render();
                nextButton.focus();
            }

            function close(status) {
                clearTarget();
                save(status);
                overlay.classList.remove("is-open", "has-target", "is-centered", "is-finished");
                overlay.setAttribute("aria-hidden", "true");
                if (previousFocus instanceof HTMLElement) previousFocus.focus();
            }

            nextButton.addEventListener("click", async () => {
                if (index >= steps.length - 1) {
                    close("completed");
                    return;
                }
                index += 1;
                await render();
            });

            backButton.addEventListener("click", async () => {
                if (index <= 0) return;
                index -= 1;
                await render();
            });

            skipButton.addEventListener("click", () =>
                close(index >= steps.length - 1 ? "completed" : "dismissed"));

            closeButton.addEventListener("click", () => close("dismissed"));

            openNextButton.addEventListener("click", () => {
                const link = document.querySelector("[data-tour='next-action']");
                const href = link instanceof HTMLAnchorElement ? link.href : null;
                close("completed");
                if (href) window.location.href = href;
            });

            if (restartButton) {
                restartButton.addEventListener("click", () => start(true));
            }

            window.addEventListener("resize", () => {
                if (overlay.classList.contains("is-open") && target) positionTarget(target);
            });

            document.addEventListener("scroll", () => {
                if (overlay.classList.contains("is-open") && target) positionTarget(target);
            }, true);

            document.addEventListener("keydown", event => {
                if (!overlay.classList.contains("is-open")) return;
                if (event.key === "Escape") close("dismissed");
                if (event.key === "ArrowRight") nextButton.click();
                if (event.key === "ArrowLeft" && !backButton.disabled) backButton.click();
            });

            const force = new URLSearchParams(window.location.search).get("tour") === "1";
            window.setTimeout(() => start(force), 450);
        })();

    </script>
}
