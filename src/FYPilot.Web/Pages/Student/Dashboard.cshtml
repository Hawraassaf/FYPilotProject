            place-items: center;
            color: #fff;
            background: linear-gradient(135deg,var(--nova-primary),var(--nova-primary-2));
            border-radius: 14px;
            font-size: 1.1rem;
        }

        .nova-modal h2 {
            margin: .25rem 0 0;
            color: #17223a;
            font-size: 1.15rem;
            font-weight: 900;
        }

        .nova-modal-flow {
            display: grid;
            grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
            gap: .5rem;
            align-items: center;
            margin-top: 1rem;
        }

            .nova-modal-flow > div {
                min-height: 155px;
                padding: .75rem;
