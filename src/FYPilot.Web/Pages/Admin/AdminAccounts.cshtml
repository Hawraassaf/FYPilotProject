@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document
            .querySelectorAll(
                ".admin-alert[data-auto-dismiss='true']")
            .forEach(function (alertElement) {
                window.setTimeout(function () {
                    alertElement.classList.add(
                        "admin-alert-hiding");

                    window.setTimeout(function () {
                        alertElement.remove();
                    }, 320);
                }, 3000);
            });

        document.querySelectorAll(".password-toggle").forEach(function (button) {
            button.addEventListener("click", function () {
                const input = document.getElementById(button.dataset.target);
                const icon = button.querySelector("i");

                if (!input) return;

                const show = input.type === "password";
                input.type = show ? "text" : "password";

                if (icon) {
                    icon.className = show ? "bi bi-eye-slash" : "bi bi-eye";
                }
            });
        });

        const searchInput = document.getElementById("adminSearch");
        const rows = Array.from(document.querySelectorAll(".admin-row"));
        const emptyState = document.getElementById("adminSearchEmpty");

        searchInput?.addEventListener("input", function () {
            const value = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const matches = !value || (row.dataset.search || "").includes(value);
                row.style.display = matches ? "grid" : "none";

                if (matches) visibleCount++;
            });

            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? "grid" : "none";
            }
        });

        const deleteModal =
            document.getElementById("deleteAdminModal");

        const deleteAdminId =
            document.getElementById("deleteAdminId");

        const deleteAdminName =
            document.getElementById("deleteAdminName");

        const deleteAdminEmailText =
            document.getElementById("deleteAdminEmailText");

        const deleteConfirmationEmail =
            document.getElementById("deleteConfirmationEmail");

        const deleteCurrentPassword =
            document.getElementById("deleteCurrentPassword");

        const deletePermanentCheck =
            document.getElementById("deletePermanentCheck");

        const confirmDeleteButton =
            document.getElementById("confirmDeleteAdminButton");

        let expectedDeleteEmail = "";

        function updateDeleteButtonState() {
            if (!confirmDeleteButton) {
                return;
            }

            const emailMatches =
                (deleteConfirmationEmail?.value || "")
                    .trim()
                    .toLowerCase() ===
                expectedDeleteEmail.toLowerCase();

            const passwordProvided =
                (deleteCurrentPassword?.value || "")
                    .trim()
                    .length > 0;

            const confirmed =
                deletePermanentCheck?.checked === true;

            confirmDeleteButton.disabled =
                !(emailMatches &&
                  passwordProvided &&
                  confirmed);
        }

        deleteModal?.addEventListener(
            "show.bs.modal",
            function (event) {
                const trigger =
                    event.relatedTarget;

                expectedDeleteEmail =
                    trigger?.dataset.adminEmail || "";

                if (deleteAdminId) {
                    deleteAdminId.value =
                        trigger?.dataset.adminId || "";
                }

                if (deleteAdminName) {
                    deleteAdminName.textContent =
                        trigger?.dataset.adminName ||
                        "this administrator";
                }

                if (deleteAdminEmailText) {
                    deleteAdminEmailText.textContent =
                        expectedDeleteEmail;
                }

                if (deleteConfirmationEmail) {
                    deleteConfirmationEmail.value = "";
                }

                if (deleteCurrentPassword) {
                    deleteCurrentPassword.value = "";
                    deleteCurrentPassword.type = "password";
                }

                if (deletePermanentCheck) {
                    deletePermanentCheck.checked = false;
                }

                updateDeleteButtonState();
            });

        [
            deleteConfirmationEmail,
            deleteCurrentPassword,
            deletePermanentCheck
        ].forEach(function (element) {
            element?.addEventListener(
                "input",
                updateDeleteButtonState);

            element?.addEventListener(
                "change",
                updateDeleteButtonState);
        });

        const form = document.getElementById("createAdminForm");
        const submitButton = document.getElementById("createAdminButton");

        form?.addEventListener("submit", function () {
            if (!form.checkValidity() || !submitButton) return;

            submitButton.disabled = true;
            submitButton.innerHTML =
                '<span class="spinner-border spinner-border-sm"></span>' +
                '<span>Creating...</span>';
        });
    </script>
}

@functions {
    private static string Initials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "AD";
        }

        var parts = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .ToList();

        return parts.Count == 0
            ? "AD"
            : string.Join("", parts.Select(p => p[0])).ToUpperInvariant();
    }
}
