        /* First-time student onboarding tour */
        .topbar-tour-launch {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            min-height: 38px;
            padding: .45rem .65rem;
            color: #315fae;
            background: #eef4ff;
            border: 1px solid #d5e2fb;
            border-radius: 10px;
            font-size: .72rem;
            font-weight: 800;
            transition: .16s ease;
        }

            .topbar-tour-launch:hover {
                background: #e4edff;
                transform: translateY(-1px);
            }

        .student-tour-overlay {
            position: fixed;
            z-index: 5000;
            inset: 0;
            opacity: 0;
            pointer-events: none;
            transition: opacity .2s ease;
        }

            .student-tour-overlay.is-open {
                opacity: 1;
                pointer-events: auto;
            }

            .student-tour-overlay:not(.has-target)::before {
                content: "";
                position: fixed;
                z-index: 0;
                inset: 0;
                background: rgba(5,14,31,.76);
                backdrop-filter: blur(5px);
            }

        .student-tour-spotlight {
            position: fixed;
            z-index: 1;
            display: none;
            pointer-events: none;
            border: 2px solid rgba(111,191,255,.98);
            border-radius: 16px;
            box-shadow: 0 0 0 9999px rgba(5,14,31,.70), 0 0 0 7px rgba(70,145,255,.16), 0 18px 52px rgba(4,22,56,.28);
            transition: top .22s ease,left .22s ease,width .22s ease,height .22s ease;
        }

        .student-tour-overlay.has-target .student-tour-spotlight {
            display: block;
        }

        .student-tour-card {
            position: fixed;
            z-index: 2;
            width: min(390px,calc(100vw - 28px));
            overflow: hidden;
            color: #17243d;
            background: #fff;
            border: 1px solid rgba(126,153,195,.25);
            border-radius: 18px;
            box-shadow: 0 28px 85px rgba(3,17,42,.36);
            transition: top .22s ease,left .22s ease,transform .2s ease;
        }

        .student-tour-overlay.is-centered .student-tour-card {
            left: 50% !important;
            top: 50% !important;
            transform: translate(-50%,-50%);
        }

        .student-tour-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            padding: .82rem .9rem;
            background: radial-gradient(circle at 92% 0%,rgba(69,173,238,.16),transparent 36%), linear-gradient(135deg,#0b2b60,#1d58aa);
        }

