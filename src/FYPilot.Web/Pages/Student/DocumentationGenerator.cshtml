</section>

<div class="doc-loading" id="docLoading" role="status" aria-live="polite">
    <div class="doc-loading-card">
        <div class="doc-loading-top">
            <div class="doc-loading-spinner" aria-hidden="true"></div>

            <div>
                <h3>Creating your documentation</h3>
                <p>
                    Keep this page open while FYPilot reads the project, generates the sections,
                    validates consistency, and reviews the final result.
                </p>
            </div>
        </div>

        <div class="doc-loading-progress" aria-hidden="true">
            <div></div>
        </div>

        <ol class="doc-loading-steps">
            <li class="is-active">
                <i class="bi bi-folder2-open"></i>
                Reading project facts
            </li>
            <li>
                <i class="bi bi-list-check"></i>
                Writing requirements
            </li>
            <li>
                <i class="bi bi-diagram-3"></i>
                Building designs
            </li>
            <li>
                <i class="bi bi-shield-check"></i>
                Reviewing quality
            </li>
        </ol>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const chapterOrder = [
                "overview",
                "fr",
                "nfr",
                "uc",
                "ec",
                "db",
                "ui",
                "diagrams",
                "extended"
            ];

            const buttons = Array.from(document.querySelectorAll("[data-doc-chapter]"));
            const panels = Array.from(document.querySelectorAll("[data-doc-panel]"));
            const previousButtons = Array.from(document.querySelectorAll("[data-doc-previous]"));
            const nextButtons = Array.from(document.querySelectorAll("[data-doc-next]"));

            function showChapter(chapterId, updateHash) {
                if (!chapterOrder.includes(chapterId)) {
                    chapterId = "overview";
                }

                buttons.forEach(function (button) {
                    const active = button.getAttribute("data-doc-chapter") === chapterId;
                    button.classList.toggle("is-active", active);
                    button.setAttribute("aria-selected", active ? "true" : "false");
                });

                panels.forEach(function (panel) {
                    const active = panel.getAttribute("data-doc-panel") === chapterId;
                    panel.classList.toggle("is-active", active);
                    panel.setAttribute("aria-hidden", active ? "false" : "true");
                });

                if (updateHash) {
                    history.replaceState(null, "", "#chapter-" + chapterId);
                }

                const readerTop = document.querySelector(".doc-reader");

                if (readerTop && updateHash) {
                    readerTop.scrollIntoView({
                        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                            ? "auto"
                            : "smooth",
                        block: "start"
                    });
                }
            }

            buttons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const chapterId = button.getAttribute("data-doc-chapter");
                    if (chapterId) {
                        showChapter(chapterId, true);
                    }
                });

                button.addEventListener("keydown", function (event) {
                    const currentIndex = buttons.indexOf(button);
                    let targetIndex = -1;

                    if (event.key === "ArrowDown" || event.key === "ArrowRight") {
                        targetIndex = (currentIndex + 1) % buttons.length;
                    } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
                        targetIndex = (currentIndex - 1 + buttons.length) % buttons.length;
                    } else if (event.key === "Home") {
                        targetIndex = 0;
                    } else if (event.key === "End") {
                        targetIndex = buttons.length - 1;
                    }

                    if (targetIndex >= 0) {
                        event.preventDefault();
                        buttons[targetIndex].focus();

                        const chapterId = buttons[targetIndex].getAttribute("data-doc-chapter");
                        if (chapterId) {
                            showChapter(chapterId, false);
                        }
                    }
                });
            });

            previousButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const current = button.getAttribute("data-doc-previous");
                    const index = chapterOrder.indexOf(current);

                    if (index > 0) {
                        showChapter(chapterOrder[index - 1], true);
                    }
                });
            });

            nextButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const current = button.getAttribute("data-doc-next");
                    const index = chapterOrder.indexOf(current);

                    if (index >= 0 && index < chapterOrder.length - 1) {
                        showChapter(chapterOrder[index + 1], true);
                    }
                });
            });

            const requestedChapter = window.location.hash.replace("#chapter-", "");
            if (chapterOrder.includes(requestedChapter)) {
                showChapter(requestedChapter, false);
            }
        })();

        (function () {
            const form = document.getElementById("docGenerateForm");
            const loading = document.getElementById("docLoading");
            const generateButton = document.getElementById("docGenerateBtn");
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const steps = loading
                ? Array.from(loading.querySelectorAll(".doc-loading-steps li"))
                : [];

            let timerId = null;

            if (form) {
                form.addEventListener("submit", function () {
                    if (loading) {
                        loading.classList.add("show");
                    }

                    if (generateButton) {
                        generateButton.disabled = true;
                        generateButton.innerHTML = `
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            Generating...
                        `;
                    }

                    if (!reduceMotion && steps.length > 0) {
                        let activeIndex = 0;

                        timerId = window.setInterval(function () {
                            steps.forEach(function (step, index) {
                                step.classList.toggle("is-active", index === activeIndex);
                            });

                            activeIndex = (activeIndex + 1) % steps.length;
                        }, 1450);
                    }
                });
            }

            window.addEventListener("pageshow", function () {
                if (loading) {
                    loading.classList.remove("show");
                }

                if (timerId) {
                    window.clearInterval(timerId);
                    timerId = null;
                }
            });
        })();

        (function () {
            const copyButtons = Array.from(document.querySelectorAll("[data-copy-target]"));

            copyButtons.forEach(function (button) {
                button.addEventListener("click", async function () {
                    const targetId = button.getAttribute("data-copy-target");
                    const target = targetId ? document.getElementById(targetId) : null;

                    if (!target) {
                        return;
                    }

                    try {
                        await navigator.clipboard.writeText(target.textContent || "");
                        const original = button.innerHTML;

                        button.innerHTML = `
                            <i class="bi bi-check2"></i>
                            Copied
                        `;

                        window.setTimeout(function () {
                            button.innerHTML = original;
                        }, 1400);
                    } catch {
                        button.textContent = "Copy failed";
                    }
                });
            });
        })();
    </script>
}

@functions {
    private static readonly string[] ChapterOrder =
    {
        "overview",
        "fr",
        "nfr",
        "uc",
        "ec",
        "db",
        "ui",
        "diagrams",
        "extended"
    };

    private IHtmlContent RenderNavButton(
        string chapterId,
        string number,
        string title,
        string subtitle,
        string icon,
        string count,
        bool isActive)
    {
        var builder = new System.Text.StringBuilder();

        builder.AppendLine(
            $"<button type=\"button\" class=\"doc-chapter-btn{(isActive ? " is-active" : "")}\" " +
            $"data-doc-chapter=\"{System.Net.WebUtility.HtmlEncode(chapterId)}\" " +
            $"role=\"tab\" aria-selected=\"{(isActive ? "true" : "false")}\">");

        builder.AppendLine(
            $"<span class=\"doc-chapter-btn-number\">{System.Net.WebUtility.HtmlEncode(number)}</span>");

        builder.AppendLine("<span class=\"doc-chapter-btn-copy\">");
        builder.AppendLine($"<strong>{System.Net.WebUtility.HtmlEncode(title)}</strong>");
        builder.AppendLine($"<small>{System.Net.WebUtility.HtmlEncode(subtitle)}</small>");
        builder.AppendLine("</span>");

        builder.AppendLine(
            $"<span class=\"doc-chapter-btn-count\">{System.Net.WebUtility.HtmlEncode(count)}</span>");

        builder.AppendLine("</button>");

        return new HtmlString(builder.ToString());
    }

    private IHtmlContent RenderListChapter(
        string chapterId,
        string chapterNumber,
        string title,
        string subtitle,
        string simpleExplanation,
        string icon,
        string prefix,
        IEnumerable<string> items)
    {
        var list = items.ToList();
        var builder = new System.Text.StringBuilder();

        builder.AppendLine(
            $"<section class=\"doc-chapter\" id=\"panel-{System.Net.WebUtility.HtmlEncode(chapterId)}\" " +
            $"data-doc-panel=\"{System.Net.WebUtility.HtmlEncode(chapterId)}\" " +
            "role=\"tabpanel\" aria-hidden=\"true\">");

        builder.AppendLine("<div class=\"doc-chapter-head\">");
        builder.AppendLine(
            $"<div class=\"doc-chapter-number\">{System.Net.WebUtility.HtmlEncode(chapterNumber)}</div>");

        builder.AppendLine("<div>");
        builder.AppendLine($"<h2>{System.Net.WebUtility.HtmlEncode(title)}</h2>");
        builder.AppendLine($"<p>{System.Net.WebUtility.HtmlEncode(subtitle)}</p>");
        builder.AppendLine("</div>");
        builder.AppendLine("</div>");

        builder.AppendLine("<div class=\"doc-simple-box\">");
        builder.AppendLine(
            $"<div class=\"doc-simple-box-icon\" aria-hidden=\"true\"><i class=\"bi {System.Net.WebUtility.HtmlEncode(icon)}\"></i></div>");

        builder.AppendLine("<div>");
        builder.AppendLine("<strong>In simple words</strong>");
        builder.AppendLine($"<p>{System.Net.WebUtility.HtmlEncode(simpleExplanation)}</p>");
        builder.AppendLine("</div>");
        builder.AppendLine("</div>");

        builder.AppendLine("<div class=\"doc-chapter-body\">");

        if (list.Any())
        {
            builder.AppendLine("<div class=\"doc-readable-list\">");

            for (var i = 0; i < list.Count; i++)
            {
                builder.AppendLine("<article class=\"doc-readable-card\">");
                builder.AppendLine(
                    $"<div class=\"doc-readable-label\">{System.Net.WebUtility.HtmlEncode(prefix)}{i + 1}</div>");

                builder.AppendLine(
                    $"<div class=\"doc-readable-content\">{System.Net.WebUtility.HtmlEncode(list[i])}</div>");

                builder.AppendLine("</article>");
            }

            builder.AppendLine("</div>");
        }
        else
        {
            builder.AppendLine(
                $"<div class=\"doc-empty-section\">No {System.Net.WebUtility.HtmlEncode(title.ToLowerInvariant())} were returned.</div>");
        }

        builder.AppendLine("</div>");
        builder.AppendLine(RenderBottomNavigationHtml(chapterId));
        builder.AppendLine("</section>");

        return new HtmlString(builder.ToString());
    }

    private IHtmlContent RenderBottomNavigation(string currentChapter)
    {
        return new HtmlString(RenderBottomNavigationHtml(currentChapter));
    }

    private string RenderBottomNavigationHtml(string currentChapter)
    {
        var currentIndex = Array.IndexOf(ChapterOrder, currentChapter);
        var previousDisabled = currentIndex <= 0;
        var nextDisabled = currentIndex < 0 || currentIndex >= ChapterOrder.Length - 1;

        var builder = new System.Text.StringBuilder();

        builder.AppendLine("<div class=\"doc-bottom-nav no-print\">");

        builder.AppendLine(
            $"<button type=\"button\" data-doc-previous=\"{System.Net.WebUtility.HtmlEncode(currentChapter)}\"" +
            $"{(previousDisabled ? " disabled" : "")}>");

        builder.AppendLine("<i class=\"bi bi-arrow-left\"></i> Previous");
        builder.AppendLine("</button>");

        builder.AppendLine(
            $"<span>Chapter {Math.Max(0, currentIndex)} of {ChapterOrder.Length - 1}</span>");

        builder.AppendLine(
            $"<button type=\"button\" data-doc-next=\"{System.Net.WebUtility.HtmlEncode(currentChapter)}\"" +
            $"{(nextDisabled ? " disabled" : "")}>");

        builder.AppendLine("Next <i class=\"bi bi-arrow-right\"></i>");
        builder.AppendLine("</button>");

        builder.AppendLine("</div>");

        return builder.ToString();
    }
}
