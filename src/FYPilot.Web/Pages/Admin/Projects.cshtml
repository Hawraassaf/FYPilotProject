                font-size: .66rem;
            }

        @@keyframes apdReveal {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1100px) {
            .apd-stats {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .apd-toolbar {
                grid-template-columns: 1fr 1fr;
            }

            .apd-search {
                grid-column: 1 / -1;
            }

            .apd-people-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 760px) {
            .apd-hero {
                grid-template-columns: 1fr;
                padding: .95rem;
            }

            .apd-directory-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .apd-toolbar,
            .apd-stats {
                grid-template-columns: 1fr;
            }

            .apd-search {
                grid-column: auto;
            }

            .apd-list {
                max-height: none;
                overflow: visible;
            }

            .apd-project-toggle {
                grid-template-columns: auto minmax(0,1fr) auto;
            }

            .apd-project-summary {
                grid-column: 2 / -1;
                justify-self: start;
            }

            .apd-idea {
                flex-direction: column;
            }

                .apd-idea small {
                    max-width: none;
                }

            .apd-manage-link span {
                display: none;
            }

            .apd-manage-link {
                width: 30px;
                height: 30px;
                padding: 0;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const list =
                document.getElementById(
                    "apdProjectList");

            if (!list) {
                return;
            }

            const searchInput =
                document.getElementById(
                    "apdSearch");

            const statusFilter =
                document.getElementById(
                    "apdStatusFilter");

            const supervisorFilter =
                document.getElementById(
                    "apdSupervisorFilter");

            const resultCount =
                document.getElementById(
                    "apdResultCount");

            const emptyState =
                document.getElementById(
                    "apdFilterEmpty");

            const cards = Array.from(
                list.querySelectorAll(
                    "[data-project-card]"));

            function setCardOpen(
                card,
                open) {

                const button =
                    card.querySelector(
                        "[data-project-toggle]");

                const details =
                    card.querySelector(
                        "[data-project-details]");

                if (!button || !details) {
                    return;
                }

                button.setAttribute(
                    "aria-expanded",
                    open ? "true" : "false");

                details.hidden = !open;

                card.classList.toggle(
                    "is-open",
                    open);
            }

            cards.forEach(card => {
                const button =
                    card.querySelector(
                        "[data-project-toggle]");

                button?.addEventListener(
                    "click",
                    () => {
                        const shouldOpen =
                            button.getAttribute(
                                "aria-expanded") !==
                            "true";

                        cards.forEach(otherCard => {
                            if (otherCard !== card) {
                                setCardOpen(
                                    otherCard,
                                    false);
                            }
                        });

                        setCardOpen(
                            card,
                            shouldOpen);
                    });
            });

            function applyFilters() {
                const query =
                    (searchInput?.value ?? "")
                        .trim()
                        .toLowerCase();

                const selectedStatus =
                    statusFilter?.value ?? "all";

                const selectedSupervisor =
                    supervisorFilter?.value ?? "all";

                let visibleCount = 0;

                cards.forEach(card => {
                    const searchable =
                        (card.dataset.search ?? "")
                            .toLowerCase();

                    const matchesSearch =
                        query.length === 0 ||
                        searchable.includes(query);

                    const matchesStatus =
                        selectedStatus === "all" ||
                        card.dataset.status ===
                            selectedStatus;

                    const matchesSupervisor =
                        selectedSupervisor === "all" ||
                        card.dataset
                            .supervisorStatus ===
                            selectedSupervisor;

                    const visible =
                        matchesSearch &&
                        matchesStatus &&
                        matchesSupervisor;

                    card.hidden = !visible;

                    if (!visible) {
                        setCardOpen(
                            card,
                            false);
                    }
                    else {
                        visibleCount++;
                    }
                });

                if (resultCount) {
                    resultCount.textContent =
                        `${visibleCount} ${
                            visibleCount === 1
                                ? "project"
                                : "projects"
                        }`;
                }

                if (emptyState) {
                    emptyState.style.display =
                        visibleCount === 0
                            ? "grid"
                            : "none";
                }
            }

            searchInput?.addEventListener(
                "input",
                applyFilters);

            statusFilter?.addEventListener(
                "change",
                applyFilters);

            supervisorFilter?.addEventListener(
                "change",
                applyFilters);

            applyFilters();
        })();
    </script>
}
