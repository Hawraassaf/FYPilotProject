@page
@model FYPilot.Web.Pages.Student.MarketDemandModel
@using System.Text.Json

@{
    ViewData["Title"] = "Market Demand Analysis";
    ViewData["Subtitle"] = "Evidence-backed validation for your official project idea";

    var analysis = Model.Analysis;
    var sourceCount = analysis?.Sources.Count ?? 0;

    var demandLabel = "Not analyzed";
    var confidenceLabel = "No evidence";
    var competitionLabel = "Not measured";
    var coverageLabel = "No sources";

    var decisionLabel = "Awaiting analysis";
    var decisionTitle = "Build an evidence-backed market case";
    var decisionDescription =
        "Run the analysis to evaluate demand, market fit, competition, evidence quality, risks, and academic value.";

    var decisionTone = "neutral";
    var weakestFactor = string.Empty;
    var weakestScore = 0;

    if (analysis != null)
    {
        demandLabel =
            analysis.DemandScore >= 75 ? "Strong demand" :
            analysis.DemandScore >= 55 ? "Developing demand" :
            "Weak demand";

        confidenceLabel =
            analysis.ConfidenceScore >= 75 ? "Strong confidence" :
            analysis.ConfidenceScore >= 50 ? "Moderate confidence" :
            "Low confidence";

        competitionLabel =
            analysis.CompetitionOpportunityScore >= 75 ? "Open opportunity" :
            analysis.CompetitionOpportunityScore >= 55 ? "Competitive opportunity" :
            "Crowded opportunity";

        coverageLabel =
            sourceCount >= 6 && analysis.ConfidenceScore >= 70 ? "Strong coverage" :
            sourceCount >= 3 ? "Moderate coverage" :
            sourceCount > 0 ? "Limited coverage" :
            "No coverage";

        if (analysis.DemandScore >= 75 && analysis.ConfidenceScore >= 65 && sourceCount >= 3)
        {
            decisionTone = "strong";
            decisionLabel = "Proceed";
            decisionTitle = "The market case is strong enough to continue";
            decisionDescription =
                "The idea shows a convincing demand signal with usable supporting evidence. Continue development while addressing the listed risks and differentiators.";
        }
        else if (analysis.DemandScore >= 70)
        {
            decisionTone = "developing";
            decisionLabel = "Validate first";
            decisionTitle = "The opportunity is promising, but the evidence is not complete";
            decisionDescription =
                $"Demand is {analysis.DemandScore}/100, while confidence is {analysis.ConfidenceScore}/100 with {sourceCount} source(s). Strengthen the evidence before presenting the result as final.";
        }
        else if (analysis.DemandScore >= 55)
        {
            decisionTone = "developing";
            decisionLabel = "Refine";
            decisionTitle = "The idea has potential but needs sharper positioning";
            decisionDescription =
                "Improve the value proposition, target audience, differentiation, or supporting evidence before committing to the full implementation scope.";
        }
        else
        {
            decisionTone = "weak";
            decisionLabel = "Reconsider";
            decisionTitle = "The current market signal is not yet convincing";
            decisionDescription =
                "Revisit the problem definition, target users, value proposition, or market scope before relying on this idea as the final project direction.";
        }

        var factors = new Dictionary<string, int>
        {
            ["Problem evidence"] = analysis.ProblemEvidenceScore,
            ["Market fit"] = analysis.MarketFitScore,
            ["University value"] = analysis.UniversityValueScore,
            ["Competition opportunity"] = analysis.CompetitionOpportunityScore,
            ["Technology momentum"] = analysis.TechnologyMomentumScore
        };

        var weakest = factors.OrderBy(item => item.Value).First();
        weakestFactor = weakest.Key;
        weakestScore = weakest.Value;
    }
}

