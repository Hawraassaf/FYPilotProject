        @@keyframes novaPulse {
            from {
                opacity: .8;
                transform: scale(.7);
            }

            to {
                opacity: 0;
                transform: scale(1.6);
            }
        }

        @@keyframes novaRotate {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes novaFade {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes novaDrift {
            0%, 100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-14px, 16px) scale(1.05);
            }
        }

        @@keyframes novaGlowPulse {
            0%, 100% {
                filter: brightness(1);
            }

            50% {
                filter: brightness(1.14);
            }
        }

        @@keyframes novaGrow {
            from {
                width: 0;
            }
