@page
@model FYPilot.Web.Pages.Student.ArchivedProjectsModel

@{
    ViewData["Title"] = "Archived Projects";
    ViewData["Subtitle"] =
        "View, restore, or remove projects from your personal Archive.";

    var ownedArchivedProjects =
        Model.Projects.Count(project => project.IsOwner);

    var collaboratingArchivedProjects =
        Model.Projects.Count(project => !project.IsOwner);
}

<section class="archived-projects-page">


    <header class="archive-hero">
        <div class="archive-hero-copy">
            <span class="archive-eyebrow">
                Personal project archive
            </span>

            <h1>Archived Projects</h1>

            <p>
                Projects placed here are hidden from My Projects.
                Restore a project whenever you are ready to continue working on it.
            </p>

            <div class="archive-hero-badges">
                <span>
                    <i class="bi bi-eye"></i>
                    Read-only access
                </span>

                <span>
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Restore anytime
                </span>

                <span>
                    <i class="bi bi-people"></i>
                    Personal archive only
                </span>
            </div>
        </div>

        <a asp-page="/Student/MyProjects"
           class="back-projects-button">
            <span class="back-projects-icon">
                <i class="bi bi-arrow-left"></i>
            </span>

            <span>
                <strong>Back to My Projects</strong>
                <small>Return to active workspaces</small>
            </span>
        </a>
    </header>

    <section class="archive-statistics">
        <article class="archive-stat-card">
            <div class="archive-stat-icon archive-stat-icon-blue">
                <i class="bi bi-archive-fill"></i>
            </div>

            <div>
                <span>Total Archived</span>
                <strong>@Model.TotalArchivedProjects</strong>
                <small>Your personal Archive</small>
            </div>
        </article>

        <article class="archive-stat-card">
            <div class="archive-stat-icon archive-stat-icon-green">
                <i class="bi bi-crown-fill"></i>
            </div>

            <div>
                <span>Owned Projects</span>
                <strong>@ownedArchivedProjects</strong>
                <small>You remain the project owner</small>
            </div>
        </article>

        <article class="archive-stat-card">
            <div class="archive-stat-icon archive-stat-icon-purple">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <span>Collaborating On</span>
                <strong>@collaboratingArchivedProjects</strong>
                <small>Shared projects you archived</small>
            </div>
        </article>
    </section>

    <section class="archive-library">
        <header class="archive-library-header">
            <div>
                <span class="archive-eyebrow">
                    Archived workspaces
                </span>

                <h2>Your archived projects</h2>

                <p>
                    Search your Archive, review project information, restore a project,
                    or remove it from your account.
                </p>
            </div>

            <span class="archive-count-pill">
                @Model.TotalArchivedProjects
                @(Model.TotalArchivedProjects == 1
                    ? "project"
                    : "projects")
            </span>
        </header>

        <div class="archive-toolbar">
            <label class="archive-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="archiveSearch"
                       placeholder="Search by project, idea, domain, or owner..."
                       autocomplete="off" />
            </label>

            <label class="archive-filter">
                <span class="visually-hidden">
                    Filter archived projects by role
                </span>

                <select id="archiveRoleFilter">
                    <option value="all">All Roles</option>
                    <option value="owner">Owner</option>
                    <option value="collaborator">Collaborator</option>
                </select>

                <i class="bi bi-chevron-down"></i>
            </label>

            <label class="archive-filter">
                <span class="visually-hidden">
                    Sort archived projects
                </span>

                <select id="archiveSort">
                    <option value="recent">
                        Recently Archived
                    </option>
                    <option value="oldest">
                        Oldest Archived
                    </option>
                    <option value="name">
                        Project Name
                    </option>
                    <option value="progress">
                        Highest Progress
                    </option>
                </select>

                <i class="bi bi-filter-left"></i>
            </label>
        </div>

        @if (Model.Projects.Count == 0)
        {
            <section class="archive-empty-state">
                <div class="archive-empty-icon">
                    <i class="bi bi-archive"></i>
                </div>

                <span class="archive-eyebrow">
                    Archive is empty
                </span>

                <h2>No archived projects</h2>

                <p>
                    Projects you archive from My Projects will appear here.
                </p>

                <a asp-page="/Student/MyProjects"
                   class="archive-primary-link">
                    <i class="bi bi-folder2-open"></i>
                    Open My Projects
                </a>
            </section>
        }
        else
        {
            <div class="archive-grid"
                 id="archiveGrid">

                @foreach (var project in Model.Projects)
                {
                    var archivedSortValue =
                        new DateTimeOffset(
                            DateTime.SpecifyKind(
                                project.ArchivedAtUtc
                                    ?? project.UpdatedAt,
                                DateTimeKind.Utc))
                            .ToUnixTimeMilliseconds();

                    <article class="archive-card"
                             data-archive-card
                             data-project-id="@project.Id"
                             data-project-title="@project.Title"
                             data-name="@project.Title.ToLowerInvariant()"
                             data-idea="@project.SelectedIdeaTitle.ToLowerInvariant()"
                             data-domain="@project.Domain.ToLowerInvariant()"
                             data-owner="@project.OwnerName.ToLowerInvariant()"
                             data-role="@project.Role"
                             data-archived="@archivedSortValue"
                             data-progress="@project.ProgressPercentage">

                        <div class="archive-card-ribbon">
                            <i class="bi bi-lock-fill"></i>
                            Read Only
                        </div>

                        <header class="archive-card-header">
                            <div class="archive-project-icon">
                                <i class="bi bi-archive-fill"></i>
                            </div>

                            <div class="archive-card-title">
                                <h3 title="@project.Title">
                                    @project.Title
                                </h3>

                                <span title="@project.Domain">
                                    @project.Domain
                                </span>
                            </div>
                        </header>

                        <div class="archive-card-badges">
                            <span class="archive-role-badge
                                @(project.IsOwner
                                        ? "archive-owner-badge"
                                        : "archive-collaborator-badge")">

                                <i class="bi
                                @(project.IsOwner
                                          ? "bi-crown-fill"
                                          : "bi-people-fill")"></i>

                                @project.RoleLabel
                            </span>

                            <span class="archive-status-badge">
                                <i class="bi bi-clock"></i>
                                @project.StatusLabel
                            </span>
                        </div>

                        <div class="archive-idea-panel
                            @(project.HasSelectedIdea
                                  ? "archive-idea-selected"
                                  : "archive-idea-missing")">

                            <div class="archive-idea-icon">
                                <i class="bi
                                @(project.HasSelectedIdea
                                          ? "bi-lightbulb-fill"
                                          : "bi-lightbulb")"></i>
                            </div>

                            <div>
                                <span>Selected Project Idea</span>

                                <strong title="@project.SelectedIdeaTitle">
                                    @project.SelectedIdeaTitle
                                </strong>
                            </div>
                        </div>

                        <p class="archive-description">
                            @project.Description
                        </p>

                        <div class="archive-people-grid">
                            <div class="archive-person">
                                <span>Project owner</span>
                                <strong>@project.OwnerName</strong>
                            </div>

                            <div class="archive-person">
                                <span>Supervisor</span>
                                <strong>@project.SupervisorName</strong>
                            </div>
                        </div>

                        <div class="archive-members-row">
                            <div class="archive-member-count">
                                <i class="bi bi-people"></i>

                                <span>
                                    @project.ActiveMembersCount
                                    of
                                    @project.MaximumMembers
                                    members
                                </span>
                            </div>

                            <div class="archive-member-avatars"
                                 aria-label="Active project members">

                                @foreach (var member in project.Members.Take(4))
                                {
                                    <div class="archive-member-avatar"
                                         title="@member.FullName — @member.Role">
                                        @member.Initials
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="archive-progress-row">
                            <div class="archive-progress-heading">
                                <span>Project progress</span>
                                <strong>@project.ProgressPercentage%</strong>
                            </div>

                            <div class="archive-progress-track">
                                <div class="archive-progress-value"
                                     style="width:@project.ProgressPercentage%">
                                </div>
                            </div>
                        </div>

                        <div class="archive-card-metadata">
                            <span>
                                <i class="bi bi-archive"></i>

                                Archived
                                @(project.ArchivedAtUtc.HasValue
                                    ? project.ArchivedAtUtc.Value
                                        .ToLocalTime()
                                        .ToString("MMM d, yyyy")
                                    : "Recently")
                            </span>

                            <span>
                                <i class="bi bi-arrow-clockwise"></i>

                                Updated
                                @project.UpdatedAt
                                .ToLocalTime()
                                .ToString("MMM d")
                            </span>
                        </div>

                        <footer class="archive-card-actions">
                            <a asp-page="/Student/Dashboard"
                               asp-route-projectId="@project.Id"
                               class="view-archived-button">
                                <i class="bi bi-eye"></i>
                                View Read Only
                            </a>

                            <form method="post"
                                  asp-page-handler="Restore"
                                  class="restore-project-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="projectId"
                                       value="@project.Id" />

                                <button type="submit"
                                        class="restore-project-button">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    Restore Project
                                </button>
                            </form>

                            <button type="button"
                                    class="remove-archived-button"
                                    data-open-remove
                                    data-project-id="@project.Id"
                                    data-project-title="@project.Title">
                                <i class="bi bi-trash3"></i>
                                Delete
                            </button>
                        </footer>
                    </article>
                }
            </div>

            <section class="archive-filter-empty"
                     id="archiveFilterEmpty">
                <div class="archive-empty-icon">
                    <i class="bi bi-search"></i>
                </div>

                <h2>No matching projects</h2>

                <p>
                    Change the search term or selected role filter.
                </p>
            </section>
        }
    </section>
</section>

<div class="archive-modal"
     id="removeArchivedModal"
     aria-hidden="true">

    <div class="archive-modal-backdrop"
         data-close-remove>
    </div>

    <section class="archive-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="removeArchivedTitle">

        <header class="archive-modal-header">
            <div class="archive-modal-icon archive-modal-danger-icon">
                <i class="bi bi-trash3-fill"></i>
            </div>

            <div>
                <span class="archive-eyebrow">
                    Project action
                </span>

                <h2 id="removeArchivedTitle">
                    Delete Project
                </h2>
            </div>

            <button type="button"
                    class="archive-modal-close"
                    data-close-remove
                    aria-label="Close delete window">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <p class="archive-modal-description">
            Remove
            <strong id="removeArchivedProjectName">
                this project
            </strong>
            from your projects?
        </p>

        <div class="archive-preview-loading"
             id="removeArchivedLoading">
            <span class="spinner-border spinner-border-sm"
                  aria-hidden="true">
            </span>

            Checking project members...
        </div>

        <div class="archive-preview-panel"
             id="removeArchivedPreview"
             hidden>
            <i class="bi bi-info-circle"></i>

            <span id="removeArchivedMessage"></span>
        </div>

        <div class="archive-owner-selection"
             id="removeArchivedOwnerSelection"
             hidden>

            <span class="archive-owner-label">
                Select the new project owner
            </span>

            <div class="archive-owner-candidates"
                 id="removeArchivedCandidates">
            </div>
        </div>

        <div class="archive-preview-error"
             id="removeArchivedError"
             role="alert"
             hidden>
        </div>

        <form method="post"
              asp-page-handler="Remove"
              id="removeArchivedForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="projectId"
                   id="removeArchivedProjectId" />

            <div class="archive-modal-actions">
                <button type="button"
                        class="archive-secondary-button"
                        data-close-remove>
                    Cancel
                </button>

                <button type="submit"
                        class="archive-danger-button"
                        id="removeArchivedSubmit"
                        disabled>
                    <i class="bi bi-trash3"></i>
                    Delete Project
                </button>
            </div>
        </form>
    </section>
</div>

@section Head {
    <style>
        :root {
            --archive-deep: #17233f;
            --archive-primary: #28385e;
            --archive-steel: #516c8d;
            --archive-border: #e1e7ef;
            --archive-muted: #64748b;
        }

        .archived-projects-page {
            max-width: 1500px;
            margin: 0 auto;
            padding-bottom: 2.5rem;
            color: #111827;
        }

        .archive-alert {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: .75rem;
            align-items: center;
            margin-bottom: 1rem;
            padding: .9rem 1rem;
            border-radius: 13px;
            font-size: .76rem;
            font-weight: 700;
        }

        .archive-alert-success {
            border: 1px solid #a7e7cc;
            color: #066746;
            background: #ecfbf5;
        }

        .archive-alert-error {
            border: 1px solid #fecaca;
            color: #b42318;
            background: #fff1f2;
        }

        .archive-alert-close {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border: 0;
            border-radius: 8px;
            color: inherit;
            background: transparent;
        }

        .archive-hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1rem;
            padding: 1.1rem 1.25rem;
            border-radius: 20px;
            color: #fff;
            background: radial-gradient( circle at 88% 12%, rgba(255, 255, 255, .08), transparent 28%), linear-gradient( 128deg, #17233f 0%, #28385e 60%, #405577 100%);
            box-shadow: 0 16px 38px rgba(23, 35, 63, .17);
        }

        .archive-eyebrow {
            display: block;
            margin-bottom: .25rem;
            color: var(--archive-steel);
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .archive-hero .archive-eyebrow {
            color: rgba(255, 255, 255, .66);
        }

        .archive-hero h1 {
            margin: 0;
            font-size: clamp(1.65rem, 3vw, 2.35rem);
            font-weight: 850;
            letter-spacing: -.04em;
            line-height: 1.05;
        }

        .archive-hero p {
            max-width: 780px;
            margin: .5rem 0 0;
            color: rgba(255, 255, 255, .72);
            font-size: .78rem;
            line-height: 1.55;
        }

        .archive-hero-badges {
            display: flex;
            flex-wrap: wrap;
            gap: .42rem;
            margin-top: .72rem;
        }

            .archive-hero-badges span {
                display: inline-flex;
                align-items: center;
                gap: .32rem;
                padding: .34rem .56rem;
                border: 1px solid rgba(255, 255, 255, .13);
                border-radius: 999px;
                color: rgba(255, 255, 255, .86);
                background: rgba(255, 255, 255, .06);
                font-size: .58rem;
                font-weight: 700;
            }

        .back-projects-button {
            min-width: 225px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .65rem;
            align-items: center;
            padding: .7rem .8rem;
            border: 1px solid rgba(255, 255, 255, .25);
            border-radius: 14px;
            color: var(--archive-primary);
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 11px 25px rgba(7, 18, 38, .17);
            text-decoration: none;
        }

        .back-projects-icon {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            color: #fff;
            background: linear-gradient( 135deg, var(--archive-primary), var(--archive-steel));
        }

        .back-projects-button strong,
        .back-projects-button small {
            display: block;
        }

        .back-projects-button strong {
            font-size: .72rem;
        }

        .back-projects-button small {
            margin-top: .14rem;
            color: #748197;
            font-size: .56rem;
            font-weight: 600;
        }

        .archive-statistics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .archive-stat-card {
            min-height: 110px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .9rem;
            align-items: center;
            padding: 1rem;
            border: 1px solid var(--archive-border);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .055);
        }

        .archive-stat-icon {
            width: 55px;
            height: 55px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            font-size: 1.25rem;
        }

        .archive-stat-icon-blue {
            color: var(--archive-primary);
            background: #eaf0fa;
        }

        .archive-stat-icon-green {
            color: #047857;
            background: #e7f8f0;
        }

        .archive-stat-icon-purple {
            color: #6d28d9;
            background: #f0e9ff;
        }

        .archive-stat-card span,
        .archive-stat-card small {
            display: block;
        }

        .archive-stat-card span {
            color: var(--archive-muted);
            font-size: .7rem;
            font-weight: 700;
        }

        .archive-stat-card strong {
            display: block;
            margin-top: .14rem;
            font-size: 1.65rem;
            line-height: 1;
        }

        .archive-stat-card small {
            margin-top: .28rem;
            color: #94a3b8;
            font-size: .58rem;
        }

        .archive-library {
            padding: 1.25rem;
            border: 1px solid #e5eaf1;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(15, 23, 42, .045);
        }

        .archive-library-header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: flex-end;
            margin-bottom: 1rem;
        }

            .archive-library-header h2 {
                margin: 0;
                font-size: 1.2rem;
                font-weight: 800;
            }

            .archive-library-header p {
                margin: .3rem 0 0;
                color: var(--archive-muted);
                font-size: .71rem;
            }

        .archive-count-pill {
            padding: .42rem .7rem;
            border-radius: 999px;
            color: #405577;
            background: #eef2f8;
            font-size: .64rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .archive-toolbar {
            display: grid;
            grid-template-columns: minmax(280px, 1.5fr) minmax(145px, .5fr) minmax(170px, .6fr);
            gap: .7rem;
            margin-bottom: 1rem;
        }

        .archive-search,
        .archive-filter {
            min-height: 46px;
            display: grid;
            align-items: center;
            border: 1px solid #d9e1ec;
            border-radius: 11px;
            background: #fbfcfe;
        }

        .archive-search {
            grid-template-columns: auto minmax(0, 1fr);
            gap: .65rem;
            padding: 0 .9rem;
        }

            .archive-search i,
            .archive-filter i {
                color: #8793a5;
            }

            .archive-search input,
            .archive-filter select {
                width: 100%;
                height: 44px;
                border: 0;
                outline: 0;
                color: #334155;
                background: transparent;
                font-size: .71rem;
            }

        .archive-filter {
            grid-template-columns: minmax(0, 1fr) auto;
            padding: 0 .7rem;
        }

            .archive-filter select {
                appearance: none;
                cursor: pointer;
            }

        .archive-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .archive-card {
            min-width: 0;
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 1rem;
            overflow: hidden;
            border: 1px solid var(--archive-border);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 9px 25px rgba(15, 23, 42, .055);
            transition: transform .17s ease, box-shadow .17s ease, border-color .17s ease;
        }

            .archive-card:hover {
                transform: translateY(-3px);
                border-color: #b8c6d9;
                box-shadow: 0 16px 35px rgba(15, 23, 42, .1);
            }

        .archive-card-ribbon {
            position: absolute;
            top: 0;
            right: 0;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .4rem .62rem;
            border-bottom-left-radius: 11px;
            color: #fff;
            background: linear-gradient( 135deg, var(--archive-primary), var(--archive-steel));
            font-size: .55rem;
            font-weight: 800;
        }

        .archive-card-header {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .7rem;
            align-items: center;
            padding-top: 1.1rem;
        }

        .archive-project-icon {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: #fff;
            background: linear-gradient( 145deg, var(--archive-primary), var(--archive-steel));
            font-size: 1.3rem;
        }

        .archive-card-title {
            min-width: 0;
        }

            .archive-card-title h3 {
                margin: 0;
                overflow: hidden;
                font-size: .88rem;
                font-weight: 820;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .archive-card-title span {
                display: block;
                margin-top: .23rem;
                overflow: hidden;
                color: var(--archive-primary);
                font-size: .63rem;
                font-weight: 700;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .archive-card-badges {
            display: flex;
            gap: .4rem;
            flex-wrap: wrap;
            margin-top: .85rem;
        }

        .archive-role-badge,
        .archive-status-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .28rem .55rem;
            border-radius: 8px;
            font-size: .58rem;
            font-weight: 800;
        }

        .archive-owner-badge {
            color: #047857;
            background: #e7f8f0;
        }

        .archive-collaborator-badge {
            color: #6d28d9;
            background: #f0e9ff;
        }

        .archive-status-badge {
            color: #475569;
            background: #eef2f6;
        }

        .archive-idea-panel {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .58rem;
            align-items: center;
            margin-top: .82rem;
            padding: .7rem;
            border-radius: 12px;
        }

        .archive-idea-selected {
            border: 1px solid #d0dbe9;
            background: #f5f8fc;
        }

        .archive-idea-missing {
            border: 1px dashed #cbd5e1;
            background: #f8fafc;
        }

        .archive-idea-icon {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            color: var(--archive-primary);
            background: #e7edf7;
        }

        .archive-idea-panel span,
        .archive-idea-panel strong {
            display: block;
        }

        .archive-idea-panel span {
            color: #8490a3;
            font-size: .53rem;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .archive-idea-panel strong {
            margin-top: .15rem;
            overflow: hidden;
            color: #26344d;
            font-size: .66rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .archive-description {
            min-height: 56px;
            margin: .75rem 0;
            color: #566477;
            font-size: .66rem;
            line-height: 1.55;
        }

        .archive-people-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }

        .archive-person {
            min-width: 0;
            padding: .58rem;
            border: 1px solid #e5eaf1;
            border-radius: 10px;
            background: #fbfcfe;
        }

            .archive-person span,
            .archive-person strong {
                display: block;
            }

            .archive-person span {
                color: #94a3b8;
                font-size: .52rem;
                font-weight: 800;
                text-transform: uppercase;
            }

            .archive-person strong {
                margin-top: .16rem;
                overflow: hidden;
                color: #40516b;
                font-size: .62rem;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .archive-members-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .6rem;
            margin-top: .72rem;
        }

        .archive-member-count {
            display: flex;
            align-items: center;
            gap: .34rem;
            color: #526075;
            font-size: .63rem;
        }

        .archive-member-avatars {
            display: flex;
            justify-content: flex-end;
        }

        .archive-member-avatar {
            width: 29px;
            height: 29px;
            margin-left: -6px;
            display: grid;
            place-items: center;
            border: 2px solid #fff;
            border-radius: 50%;
            color: #fff;
            background: linear-gradient( 135deg, var(--archive-primary), var(--archive-steel));
            box-shadow: 0 2px 7px rgba(15, 23, 42, .16);
            font-size: .53rem;
            font-weight: 800;
        }

        .archive-progress-row {
            margin-top: .75rem;
        }

        .archive-progress-heading {
            display: flex;
            justify-content: space-between;
            gap: .5rem;
            margin-bottom: .36rem;
            color: #64748b;
            font-size: .58rem;
        }

            .archive-progress-heading strong {
                color: var(--archive-primary);
            }

        .archive-progress-track {
            height: 5px;
            overflow: hidden;
            border-radius: 999px;
            background: #e5eaf1;
        }

        .archive-progress-value {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient( 90deg, var(--archive-primary), var(--archive-steel));
        }

        .archive-card-metadata {
            display: flex;
            justify-content: space-between;
            gap: .5rem;
            flex-wrap: wrap;
            margin-top: .78rem;
            padding-top: .72rem;
            border-top: 1px solid #edf1f5;
            color: #7b8798;
            font-size: .56rem;
        }

            .archive-card-metadata span {
                display: inline-flex;
                align-items: center;
                gap: .28rem;
            }

        .archive-card-actions {
            display: grid;
            grid-template-columns: minmax(0, .9fr) minmax(0, 1fr) auto;
            gap: .5rem;
            margin-top: auto;
            padding-top: .9rem;
        }

        .restore-project-form {
            display: flex;
        }

        .view-archived-button,
        .restore-project-button,
        .remove-archived-button {
            min-height: 41px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .38rem;
            border-radius: 9px;
            font-size: .62rem;
            font-weight: 800;
        }

        .view-archived-button {
            width: 100%;
            border: 1px solid #cfd9e7;
            color: var(--archive-primary);
            background: #f7f9fc;
            text-decoration: none;
        }

            .view-archived-button:hover {
                color: #fff;
                border-color: var(--archive-primary);
                background: var(--archive-primary);
            }

        .restore-project-button {
            width: 100%;
            border: 0;
            color: #fff;
            background: linear-gradient( 135deg, var(--archive-primary), var(--archive-steel));
        }

        .remove-archived-button {
            padding: 0 .78rem;
            border: 1px solid #efb7b7;
            color: #b42318;
            background: #fff;
        }

        .archive-empty-state,
        .archive-filter-empty {
            min-height: 370px;
            display: grid;
            place-items: center;
            align-content: center;
            padding: 2rem;
            border: 1px dashed #cad4e2;
            border-radius: 18px;
            background: linear-gradient( 180deg, #fbfcfe, #f7f9fc);
            text-align: center;
        }

        .archive-filter-empty {
            display: none;
        }

        .archive-empty-icon {
            width: 72px;
            height: 72px;
            display: grid;
            place-items: center;
            margin-bottom: .9rem;
            border-radius: 22px;
            color: var(--archive-primary);
            background: #eaf0fa;
            font-size: 1.8rem;
        }

        .archive-empty-state h2,
        .archive-filter-empty h2 {
            margin: 0;
            font-size: 1.12rem;
        }

        .archive-empty-state p,
        .archive-filter-empty p {
            max-width: 460px;
            margin: .5rem 0 1.1rem;
            color: var(--archive-muted);
            font-size: .72rem;
            line-height: 1.55;
        }

        .archive-primary-link {
            min-height: 43px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            padding: 0 .95rem;
            border-radius: 10px;
            color: #fff;
            background: var(--archive-primary);
            font-size: .68rem;
            font-weight: 800;
            text-decoration: none;
        }

        .archive-modal {
            position: fixed;
            inset: 0;
            z-index: 1100;
            display: none;
            place-items: center;
            padding: 1rem;
        }

            .archive-modal.is-open {
                display: grid;
            }

        .archive-modal-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(5, 17, 42, .65);
            backdrop-filter: blur(5px);
        }

        .archive-modal-dialog {
            width: min(100%, 510px);
            position: relative;
            z-index: 2;
            padding: 1.25rem;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 30px 70px rgba(5, 17, 42, .3);
        }

        .archive-modal-header {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: .75rem;
            align-items: center;
        }

        .archive-modal-icon {
            width: 45px;
            height: 45px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: #fff;
        }

        .archive-modal-danger-icon {
            background: linear-gradient( 135deg, #b42318, #d64545);
        }

        .archive-modal-header h2 {
            margin: 0;
            font-size: 1.08rem;
        }

        .archive-modal-close {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 0;
            border-radius: 9px;
            color: #64748b;
            background: #f3f6fa;
        }

        .archive-modal-description {
            margin: 1rem 0;
            color: var(--archive-muted);
            font-size: .71rem;
            line-height: 1.6;
        }

        .archive-preview-loading,
        .archive-preview-panel {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: flex-start;
            gap: .58rem;
            padding: .75rem;
            border: 1px solid #d7e1ef;
            border-radius: 11px;
            color: #4a5e7b;
            background: #f5f8fc;
            font-size: .65rem;
            line-height: 1.5;
        }

        .archive-preview-loading {
            display: flex;
            align-items: center;
        }

            .archive-preview-loading[hidden],
            .archive-preview-panel[hidden],
            .archive-owner-selection[hidden],
            .archive-preview-error[hidden] {
                display: none;
            }

        .archive-owner-selection {
            margin-top: .82rem;
        }

        .archive-owner-label {
            display: block;
            margin-bottom: .46rem;
            color: #334155;
            font-size: .67rem;
            font-weight: 850;
        }

        .archive-owner-candidates {
            display: grid;
            gap: .44rem;
        }

        .archive-owner-option {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: .58rem;
            align-items: center;
            padding: .66rem;
            border: 1px solid #dce3ed;
            border-radius: 11px;
            background: #fff;
            cursor: pointer;
        }

            .archive-owner-option:has(input:checked) {
                border-color: var(--archive-steel);
                background: #eef3fa;
            }

            .archive-owner-option input {
                accent-color: var(--archive-primary);
            }

        .archive-owner-copy {
            min-width: 0;
        }

            .archive-owner-copy strong,
            .archive-owner-copy small {
                display: block;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .archive-owner-copy strong {
                color: var(--archive-primary);
                font-size: .67rem;
            }

            .archive-owner-copy small {
                margin-top: .14rem;
                color: #8792a3;
                font-size: .56rem;
            }

        .archive-owner-archived {
            padding: .24rem .4rem;
            border-radius: 999px;
            color: #986300;
            background: #fff1ce;
            font-size: .52rem;
            font-weight: 800;
        }

        .archive-preview-error {
            margin-top: .72rem;
            padding: .67rem .73rem;
            border: 1px solid #fecaca;
            border-radius: 10px;
            color: #b42318;
            background: #fff1f2;
            font-size: .63rem;
            font-weight: 700;
        }

        .archive-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: .58rem;
            margin-top: 1rem;
        }

        .archive-secondary-button,
        .archive-danger-button {
            min-height: 41px;
            padding: 0 .88rem;
            border-radius: 9px;
            font-size: .67rem;
            font-weight: 800;
        }

        .archive-secondary-button {
            border: 1px solid #d6dee9;
            color: #526075;
            background: #fff;
        }

        .archive-danger-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .38rem;
            border: 0;
            color: #fff;
            background: #b42318;
        }

            .archive-danger-button:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

        @@media (max-width: 1250px) {
            .archive-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 980px) {
            .archive-hero {
                grid-template-columns: 1fr;
            }

            .back-projects-button {
                width: 100%;
            }

            .archive-toolbar {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .archive-search {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 760px) {
            .archive-statistics,
            .archive-grid,
            .archive-toolbar {
                grid-template-columns: 1fr;
            }

            .archive-search {
                grid-column: auto;
            }

            .archive-library-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 480px) {
            .archive-people-grid {
                grid-template-columns: 1fr;
            }

            .archive-card-actions {
                grid-template-columns: 1fr;
            }

            .view-archived-button,
            .restore-project-button,
            .remove-archived-button {
                width: 100%;
            }

            .archive-modal-actions {
                flex-direction: column-reverse;
            }

            .archive-secondary-button,
            .archive-danger-button {
                width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const grid =
                document.getElementById("archiveGrid");

            const searchInput =
                document.getElementById("archiveSearch");

            const roleFilter =
                document.getElementById(
                    "archiveRoleFilter");

            const sortSelect =
                document.getElementById("archiveSort");

            const emptyState =
                document.getElementById(
                    "archiveFilterEmpty");

            const cards = grid
                ? Array.from(
                    grid.querySelectorAll(
                        "[data-archive-card]"))
                : [];

            function applyArchiveFilters() {
                if (!grid) {
                    return;
                }

                const searchValue =
                    (searchInput?.value ?? "")
                        .trim()
                        .toLowerCase();

                const selectedRole =
                    roleFilter?.value ?? "all";

                const selectedSort =
                    sortSelect?.value ?? "recent";

                const sortedCards =
                    [...cards].sort((left, right) => {
                        if (selectedSort === "oldest") {
                            return Number(
                                left.dataset.archived) -
                                Number(
                                    right.dataset.archived);
                        }

                        if (selectedSort === "name") {
                            return (
                                left.dataset.name ?? "")
                                .localeCompare(
                                    right.dataset.name ?? "");
                        }

                        if (selectedSort === "progress") {
                            return Number(
                                right.dataset.progress) -
                                Number(
                                    left.dataset.progress);
                        }

                        return Number(
                            right.dataset.archived) -
                            Number(
                                left.dataset.archived);
                    });

                let visibleCount = 0;

                sortedCards.forEach(card => {
                    grid.appendChild(card);

                    const searchableText =
                        `${card.dataset.name ?? ""} ` +
                        `${card.dataset.idea ?? ""} ` +
                        `${card.dataset.domain ?? ""} ` +
                        `${card.dataset.owner ?? ""}`;

                    const matchesSearch =
                        !searchValue ||
                        searchableText.includes(
                            searchValue);

                    const matchesRole =
                        selectedRole === "all" ||
                        card.dataset.role ===
                            selectedRole;

                    const visible =
                        matchesSearch &&
                        matchesRole;

                    card.style.display =
                        visible ? "flex" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                if (emptyState) {
                    emptyState.style.display =
                        visibleCount === 0
                            ? "grid"
                            : "none";
                }
            }

            searchInput?.addEventListener(
                "input",
                applyArchiveFilters);

            roleFilter?.addEventListener(
                "change",
                applyArchiveFilters);

            sortSelect?.addEventListener(
                "change",
                applyArchiveFilters);

            applyArchiveFilters();

            document
                .querySelectorAll(
                    ".archive-alert-close")
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        () => {
                            button
                                .closest(".archive-alert")
                                ?.remove();
                        });
                });

            document
                .querySelectorAll(
                    ".restore-project-form")
                .forEach(form => {
                    form.addEventListener(
                        "submit",
                        () => {
                            const button =
                                form.querySelector(
                                    "button[type='submit']");

                            if (!button) {
                                return;
                            }

                            button.disabled = true;

                            button.innerHTML =
                                `
                                <span class="spinner-border
                                             spinner-border-sm"
                                      aria-hidden="true">
                                </span>
                                Restoring...
                                `;
                        });
                });

            const modal =
                document.getElementById(
                    "removeArchivedModal");

            const projectIdInput =
                document.getElementById(
                    "removeArchivedProjectId");

            const projectName =
                document.getElementById(
                    "removeArchivedProjectName");

            const loading =
                document.getElementById(
                    "removeArchivedLoading");

            const preview =
                document.getElementById(
                    "removeArchivedPreview");

            const previewMessage =
                document.getElementById(
                    "removeArchivedMessage");

            const errorBox =
                document.getElementById(
                    "removeArchivedError");

            const ownerSelection =
                document.getElementById(
                    "removeArchivedOwnerSelection");

            const ownerCandidates =
                document.getElementById(
                    "removeArchivedCandidates");

            const form =
                document.getElementById(
                    "removeArchivedForm");

            const submitButton =
                document.getElementById(
                    "removeArchivedSubmit");

            function openModal() {
                if (!modal) {
                    return;
                }

                modal.classList.add("is-open");

                modal.setAttribute(
                    "aria-hidden",
                    "false");

                document.body.style.overflow =
                    "hidden";
            }

            function closeModal() {
                if (!modal) {
                    return;
                }

                modal.classList.remove("is-open");

                modal.setAttribute(
                    "aria-hidden",
                    "true");

                document.body.style.overflow =
                    "";
            }

            function resetPreview() {
                if (loading) {
                    loading.hidden = false;
                }

                if (preview) {
                    preview.hidden = true;
                }

                if (errorBox) {
                    errorBox.hidden = true;
                    errorBox.textContent = "";
                }

                if (ownerSelection) {
                    ownerSelection.hidden = true;
                }

                if (ownerCandidates) {
                    ownerCandidates.innerHTML = "";
                }

                if (submitButton) {
                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        `
                        <i class="bi bi-trash3"></i>
                        Delete Project
                        `;
                }
            }

            function showError(message) {
                if (loading) {
                    loading.hidden = true;
                }

                if (preview) {
                    preview.hidden = true;
                }

                if (ownerSelection) {
                    ownerSelection.hidden = true;
                }

                if (errorBox) {
                    errorBox.textContent = message;
                    errorBox.hidden = false;
                }

                if (submitButton) {
                    submitButton.disabled = true;
                }
            }

            function renderCandidates(candidates) {
                if (!ownerCandidates ||
                    !ownerSelection) {
                    return;
                }

                ownerCandidates.innerHTML = "";

                candidates.forEach(candidate => {
                    const option =
                        document.createElement("label");

                    option.className =
                        "archive-owner-option";

                    const radio =
                        document.createElement("input");

                    radio.type = "radio";
                    radio.name = "newOwnerUserId";
                    radio.value =
                        String(candidate.userId);
                    radio.required = true;
                    radio.setAttribute(
                        "form",
                        "removeArchivedForm");

                    const copy =
                        document.createElement("span");

                    copy.className =
                        "archive-owner-copy";

                    const name =
                        document.createElement("strong");

                    name.textContent =
                        candidate.fullName;

                    const email =
                        document.createElement("small");

                    email.textContent =
                        candidate.email || "";

                    copy.append(name, email);
                    option.append(radio, copy);

                    if (candidate.isArchived) {
                        const badge =
                            document.createElement("span");

                        badge.className =
                            "archive-owner-archived";

                        badge.textContent =
                            "Archived";

                        option.appendChild(badge);
                    }

                    ownerCandidates.appendChild(option);
                });

                ownerSelection.hidden = false;
            }

            async function openRemove(
                projectId,
                title) {

                if (!projectIdInput ||
                    !projectName) {
                    return;
                }

                projectIdInput.value = projectId;

                projectName.textContent =
                    title || "this project";

                resetPreview();
                openModal();

                try {
                    const url =
                        new URL(window.location.href);

                    url.search = "";

                    url.searchParams.set(
                        "handler",
                        "RemovalPreview");

                    url.searchParams.set(
                        "projectId",
                        projectId);

                    const response =
                        await fetch(
                            url.toString(),
                            {
                                method: "GET",
                                credentials: "same-origin",
                                headers: {
                                    "Accept":
                                        "application/json"
                                }
                            });

                    if (!response.ok) {
                        throw new Error(
                            "The project details "
                            + "could not be loaded.");
                    }

                    const result =
                        await response.json();

                    if (!result.succeeded) {
                        showError(
                            result.message ??
                            "The project cannot "
                            + "be removed.");

                        return;
                    }

                    if (loading) {
                        loading.hidden = true;
                    }

                    if (previewMessage) {
                        previewMessage.textContent =
                            result.message;
                    }

                    if (preview) {
                        preview.hidden = false;
                    }

                    if (result.isOwner &&
                        result.activeCollaboratorCount > 1) {

                        renderCandidates(
                            result.ownerCandidates ?? []);
                    }

                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                }
                catch (error) {
                    showError(
                        error instanceof Error
                            ? error.message
                            : "The project details "
                              + "could not be loaded.");
                }
            }

            document
                .querySelectorAll(
                    "[data-open-remove]")
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        () => {
                            openRemove(
                                button.dataset.projectId ?? "",
                                button.dataset.projectTitle ?? "");
                        });
                });

            document
                .querySelectorAll(
                    "[data-close-remove]")
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        closeModal);
                });

            modal?.addEventListener(
                "click",
                event => {
                    if (event.target === modal) {
                        closeModal();
                    }
                });

            document.addEventListener(
                "keydown",
                event => {
                    if (event.key === "Escape") {
                        closeModal();
                    }
                });

            form?.addEventListener(
                "submit",
                event => {
                    const selectionVisible =
                        ownerSelection &&
                        !ownerSelection.hidden;

                    if (selectionVisible) {
                        const selectedOwner =
                            document.querySelector(
                                "input[name='newOwnerUserId']" +
                                "[form='removeArchivedForm']:checked");

                        if (!selectedOwner) {
                            event.preventDefault();

                            if (errorBox) {
                                errorBox.textContent =
                                    "Choose the new project owner.";

                                errorBox.hidden = false;
                            }

                            return;
                        }
                    }

                    if (!submitButton) {
                        return;
                    }

                    submitButton.disabled = true;

                    submitButton.innerHTML =
                        `
                        <span class="spinner-border
                                     spinner-border-sm"
                              aria-hidden="true">
                        </span>
                        Deleting...
                        `;
                });
        })();
    </script>
}
