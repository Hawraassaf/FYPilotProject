                }

            .apd-manage-link span {
                display: none;
            }

            .apd-manage-link {
                width: 30px;
                height: 30px;
                padding: 0;
            }

            .apd-lifecycle-notice,
            .apd-history-list article {
                grid-template-columns: 1fr;
            }

            .apd-lifecycle-notice-icon {
                display: none;
            }

            .apd-lifecycle-notice-tags {
                justify-content: flex-start;
            }

            .apd-history-list time {
                white-space: normal;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const list =
                document.getElementById(
                    "apdProjectList");

            if (!list) {
                return;
            }

            const searchInput =
                document.getElementById(
                    "apdSearch");

            const statusFilter =
                document.getElementById(
                    "apdStatusFilter");

            const lifecycleFilter =
                document.getElementById(
                    "apdLifecycleFilter");

            const supervisorFilter =
                document.getElementById(
                    "apdSupervisorFilter");

            const resultCount =
                document.getElementById(
                    "apdResultCount");

            const emptyState =
                document.getElementById(
                    "apdFilterEmpty");

            const cards = Array.from(
                list.querySelectorAll(
                    "[data-project-card]"));

            function setCardOpen(
                card,
                open) {

                const button =
                    card.querySelector(
                        "[data-project-toggle]");

                const details =
                    card.querySelector(
                        "[data-project-details]");

                if (!button || !details) {
                    return;
                }

                button.setAttribute(
                    "aria-expanded",
                    open ? "true" : "false");

                details.hidden = !open;

                card.classList.toggle(
                    "is-open",
                    open);
            }

            cards.forEach(card => {
                const button =
                    card.querySelector(
                        "[data-project-toggle]");

                button?.addEventListener(
                    "click",
                    () => {
                        const shouldOpen =
                            button.getAttribute(
                                "aria-expanded") !==
                            "true";

                        cards.forEach(otherCard => {
                            if (otherCard !== card) {
                                setCardOpen(
                                    otherCard,
                                    false);
                            }
                        });

                        setCardOpen(
                            card,
                            shouldOpen);
                    });
            });

            function applyFilters() {
                const query =
                    (searchInput?.value ?? "")
                        .trim()
                        .toLowerCase();

                const selectedStatus =
                    statusFilter?.value ?? "all";

                const selectedLifecycle =
                    lifecycleFilter?.value ?? "all";

                const selectedSupervisor =
                    supervisorFilter?.value ?? "all";

                let visibleCount = 0;

                cards.forEach(card => {
                    const searchable =
                        (card.dataset.search ?? "")
                            .toLowerCase();

                    const matchesSearch =
                        query.length === 0 ||
                        searchable.includes(query);

                    const matchesStatus =
                        selectedStatus === "all" ||
                        card.dataset.status ===
                            selectedStatus;

                    const lifecycleStates =
                        (card.dataset.lifecycle ?? "")
                            .split(" ")
                            .filter(Boolean);

                    const matchesLifecycle =
                        selectedLifecycle === "all" ||
                        lifecycleStates.includes(
                            selectedLifecycle);

                    const matchesSupervisor =
                        selectedSupervisor === "all" ||
                        card.dataset
                            .supervisorStatus ===
                            selectedSupervisor;

                    const visible =
                        matchesSearch &&
                        matchesStatus &&
                        matchesLifecycle &&
                        matchesSupervisor;

                    card.hidden = !visible;

                    if (!visible) {
                        setCardOpen(
                            card,
                            false);
                    }
                    else {
                        visibleCount++;
                    }
                });

                if (resultCount) {
                    resultCount.textContent =
                        `${visibleCount} ${
                            visibleCount === 1
                                ? "project"
                                : "projects"
                        }`;
                }

                if (emptyState) {
                    emptyState.style.display =
                        visibleCount === 0
                            ? "grid"
                            : "none";
                }
            }

            searchInput?.addEventListener(
                "input",
                applyFilters);

            statusFilter?.addEventListener(
                "change",
                applyFilters);

            lifecycleFilter?.addEventListener(
                "change",
                applyFilters);

            supervisorFilter?.addEventListener(
                "change",
                applyFilters);

            applyFilters();
        })();
    </script>
}
