        }

        .apd-collaborator {
            min-width: 0;
            display: grid;
            grid-template-columns: auto minmax(0,1fr);
            gap: .4rem;
            align-items: center;
            padding: .32rem;
            background: #F8FAFC;
            border-radius: 8px;
        }

            .apd-collaborator > span {
                width: 27px;
                height: 27px;
                font-size: .48rem;
            }

            .apd-collaborator strong {
                font-size: .6rem;
            }

            .apd-collaborator small {
                margin-top: .06rem;
                color: var(--apd-muted);
                font-size: .51rem;
            }

        .apd-person-empty {
            display: flex;
            align-items: center;
            gap: .32rem;
            margin-top: .55rem;
            padding: .45rem;
            color: var(--apd-muted);
            background: #F8FAFC;
            border-radius: 8px;
            font-size: .58rem;
        }

        .apd-supervisor-state {
            display: grid;
            gap: .22rem;
            margin-top: .52rem;
        }

        .apd-supervisor-badge {
            width: fit-content;
        }

            .apd-supervisor-badge.is-assigned {
                color: #087154;
                background: #E8F7F1;
            }

            .apd-supervisor-badge.is-pending {
                color: #9A6508;
                background: #FFF5DC;
            }

            .apd-supervisor-badge.is-unassigned {
                color: #64748B;
                background: #F1F4F7;
            }

        .apd-supervisor-state > strong {
            font-size: .64rem;
        }

        .apd-supervisor-state > small {
            overflow: hidden;
            color: var(--apd-muted);
            font-size: .55rem;
            text-overflow: ellipsis;
        }

        .apd-supervisor-head {
            grid-template-columns: auto minmax(0,1fr) auto !important;
        }

        .apd-manage-link {
            width: fit-content;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .28rem;
            margin: 0;
            padding: .34rem .46rem;
            color: var(--apd-navy);
            background: #EEF2F6;
            border-radius: 8px;
            font-size: .54rem;
            font-weight: 800;
            line-height: 1;
            text-decoration: none;
            white-space: nowrap;
        }

            .apd-manage-link:hover {
                color: var(--apd-deep);
                background: #E4EAF1;
            }

        .apd-empty,
        .apd-filter-empty {
            min-height: 280px;
            display: grid;
            place-items: center;
            align-content: center;
            text-align: center;
        }

        .apd-filter-empty {
            display: none;
        }

            .apd-empty > div,
            .apd-filter-empty > div {
                width: 64px;
                height: 64px;
                display: grid;
                place-items: center;
                color: var(--apd-navy);
                background: #EEF2F6;
                border-radius: 19px;
                font-size: 1.35rem;
            }

            .apd-empty h2,
            .apd-filter-empty h2 {
                margin: .65rem 0 0;
                font-size: .96rem;
                font-weight: 900;
            }

            .apd-empty p,
            .apd-filter-empty p {
                max-width: 440px;
                margin: .25rem 0 0;
