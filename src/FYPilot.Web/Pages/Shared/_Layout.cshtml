@using System.Collections.Generic
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using FYPilot.Application.Interfaces
@using FYPilot.Infrastructure.Data
@using FYPilot.Domain.Entities
@inject ApplicationDbContext Db
@inject IActiveProjectService ActiveProjectService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — FYPilot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/student-onboarding-tour.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/ai-agent-progress.css"
          asp-append-version="true" />


    <style>
        /* Student active-project switcher — scoped to the top navigation. */
        .app-topbar {
            position: relative;
        }

        .topbar-project-switcher {
            position: absolute;
            left: 50%;
            z-index: 1060;
            width: min(390px, 34vw);
            transform: translateX(-50%);
        }

        .topbar-project-trigger {
            width: 100%;
            min-height: 52px;
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr) auto 18px;
            align-items: center;
            gap: 10px;
            padding: 7px 12px 7px 8px;
            color: #1f2d4d;
            text-align: left;
            background:
                linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
            border: 1px solid #dce5f2;
            border-radius: 15px;
            box-shadow:
                0 9px 24px rgba(30, 52, 91, .08),
                inset 0 1px 0 rgba(255, 255, 255, .9);
            transition:
                border-color .18s ease,
                box-shadow .18s ease,
                transform .18s ease;
        }

        .topbar-project-trigger:hover,
        .topbar-project-trigger[aria-expanded="true"] {
            border-color: #9fb4d5;
            box-shadow:
                0 13px 30px rgba(30, 52, 91, .13),
                0 0 0 3px rgba(81, 108, 141, .08);
            transform: translateY(-1px);
        }

        .topbar-project-trigger:focus-visible {
            outline: 3px solid rgba(81, 108, 141, .22);
            outline-offset: 2px;
        }

        .topbar-project-trigger-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #ffffff;
            background:
                linear-gradient(145deg, #28385e, #516c8d);
            border-radius: 12px;
            box-shadow: 0 7px 16px rgba(40, 56, 94, .2);
        }

        .topbar-project-trigger-copy {
            min-width: 0;
        }

        .topbar-project-trigger-copy small,
        .topbar-project-trigger-copy strong {
            display: block;
        }

        .topbar-project-trigger-copy small {
            margin-bottom: 1px;
            color: #8290a5;
            font-size: .61rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .topbar-project-trigger-copy strong {
            overflow: hidden;
            color: #18233e;
            font-size: .79rem;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-project-count {
            min-width: 27px;
            height: 27px;
            display: grid;
            place-items: center;
            padding: 0 7px;
            color: #405577;
            background: #edf2f8;
            border: 1px solid #dde6f1;
            border-radius: 999px;
            font-size: .65rem;
            font-weight: 850;
        }

        .topbar-project-chevron {
            color: #8190a5;
            font-size: .72rem;
            transition: transform .18s ease;
        }

        .topbar-project-trigger[aria-expanded="true"]
        .topbar-project-chevron {
            transform: rotate(180deg);
        }

        .topbar-project-menu {
            width: min(430px, calc(100vw - 24px));
            max-height: min(570px, calc(100vh - 110px));
            margin-top: 10px !important;
            padding: 0;
            overflow: hidden;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #dfe6f0;
            border-radius: 18px;
            box-shadow: 0 24px 58px rgba(24, 37, 66, .18);
            backdrop-filter: blur(16px);
        }

        .topbar-project-menu-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            padding: 15px 16px 13px;
            background:
                radial-gradient(
                    circle at 88% 8%,
                    rgba(255, 255, 255, .17),
                    transparent 27%),
                linear-gradient(135deg, #28385e, #405577 72%, #516c8d);
        }

        .topbar-project-menu-head span,
        .topbar-project-menu-head strong,
        .topbar-project-menu-head small {
            display: block;
        }

        .topbar-project-menu-head span {
            color: rgba(255, 255, 255, .62);
            font-size: .59rem;
            font-weight: 850;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .topbar-project-menu-head strong {
            margin-top: 2px;
            color: #ffffff;
            font-size: .91rem;
            font-weight: 820;
        }

        .topbar-project-menu-head small {
            max-width: 270px;
            margin-top: 3px;
            color: rgba(255, 255, 255, .68);
            font-size: .67rem;
            line-height: 1.45;
        }

        .topbar-project-menu-total {
            flex: 0 0 auto;
            min-width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #28385e;
            background: #ffffff;
            border-radius: 12px;
            font-size: .72rem;
            font-weight: 850;
        }

        .topbar-project-options {
            max-height: 370px;
            padding: 8px;
            overflow-y: auto;
        }

        .topbar-project-option-form {
            margin: 0;
        }

        .topbar-project-option {
            width: 100%;
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr) auto;
            align-items: center;
            gap: 10px;
            margin: 0;
            padding: 10px;
            color: #273650;
            text-align: left;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 13px;
            transition:
                background .16s ease,
                border-color .16s ease,
                transform .16s ease;
        }

        .topbar-project-option:hover {
            background: #f4f7fb;
            border-color: #e1e7f0;
            transform: translateX(2px);
        }

        .topbar-project-option.is-active {
            background:
                linear-gradient(135deg, #eef3fa, #f8faff);
            border-color: #cbd8e9;
            box-shadow: inset 3px 0 0 #516c8d;
        }

        .topbar-project-option-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #516c8d;
            background: #edf2f7;
            border-radius: 12px;
        }

        .topbar-project-option.is-active
        .topbar-project-option-icon {
            color: #ffffff;
            background: linear-gradient(145deg, #28385e, #516c8d);
        }

        .topbar-project-option-copy {
            min-width: 0;
        }

        .topbar-project-option-copy strong,
        .topbar-project-option-copy small {
            display: block;
        }

        .topbar-project-option-copy strong {
            overflow: hidden;
            color: #17223d;
            font-size: .76rem;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-project-option-copy small {
            overflow: hidden;
            margin-top: 2px;
            color: #7b889c;
            font-size: .63rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-project-option-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }

        .topbar-project-role,
        .topbar-project-active-label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 7px;
            border-radius: 999px;
            font-size: .55rem;
            font-weight: 850;
            white-space: nowrap;
        }

        .topbar-project-role {
            color: #53657e;
            background: #edf1f6;
        }

        .topbar-project-active-label {
            color: #137957;
            background: #e9f8f1;
        }

        .topbar-project-menu-footer {
            padding: 9px;
            background: #f8fafc;
            border-top: 1px solid #e6ebf2;
        }

        .topbar-project-manage-link {
            min-height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            color: #405577;
            text-decoration: none;
            border: 1px solid #dfe6ef;
            border-radius: 11px;
            background: #ffffff;
            font-size: .68rem;
            font-weight: 800;
        }

        .topbar-project-manage-link:hover {
            color: #28385e;
            background: #eef2f7;
            border-color: #cfd9e7;
        }

        @@media (max-width: 1199.98px) {
            .topbar-project-switcher {
                position: static;
                width: 265px;
                margin-left: auto;
                transform: none;
            }
        }

        @@media (max-width: 899.98px) {
            .topbar-project-switcher {
                width: 205px;
            }

            .topbar-project-trigger {
                grid-template-columns: 34px minmax(0, 1fr) 16px;
            }

            .topbar-project-trigger-icon {
                width: 34px;
                height: 34px;
            }

            .topbar-project-count {
                display: none;
            }
        }

        @@media (max-width: 639.98px) {
            .topbar-project-switcher {
                display: none;
            }
        }

        /* =========================================================
           SIMPLE SIDEBAR SCROLLBAR
           Keeps the sidebar scrollable when browser zoom makes the
           navigation taller, but removes the heavy default scrollbar.
           ========================================================= */

        .sidebar-scroll {
            overflow-y: auto;
            overscroll-behavior: contain;
            scroll-behavior: smooth;
            scrollbar-width: thin;
            scrollbar-color:
                rgba(255, 255, 255, .26)
                transparent;
        }

        .sidebar-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-scroll::-webkit-scrollbar-thumb {
            min-height: 42px;
            background: rgba(255, 255, 255, .24);
            border: 1px solid transparent;
            border-radius: 999px;
            background-clip: padding-box;
        }

        .sidebar-scroll:hover::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, .40);
            background-clip: padding-box;
        }

        .sidebar-scroll::-webkit-scrollbar-corner {
            background: transparent;
        }
        /* =========================================================
           TOPBAR PROJECT SWITCHER — OVERFLOW FIX
           Scoped only to student topbars that have a project switcher.
           ========================================================= */

        .app-topbar.has-project-switcher {
            display: grid !important;
            grid-template-columns:
                minmax(180px, 1fr)
                minmax(280px, 520px)
                auto;
            align-items: center;
            gap: 14px;
        }

        .app-topbar.has-project-switcher
        > .d-flex:first-child {
            min-width: 0;
            overflow: hidden;
        }

        .app-topbar.has-project-switcher
        .page-heading {
            min-width: 0;
            max-width: 100%;
            overflow: hidden;
        }

        .app-topbar.has-project-switcher
        .page-heading h6,
        .app-topbar.has-project-switcher
        .page-subtitle {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .app-topbar.has-project-switcher
        .topbar-project-switcher {
            position: relative;
            left: auto;
            width: 100%;
            min-width: 0;
            max-width: 520px;
            margin: 0;
            transform: none;
            justify-self: center;
        }

        .app-topbar.has-project-switcher
        .topbar-project-trigger {
            min-width: 0;
        }

        .app-topbar.has-project-switcher
        .topbar-project-trigger-copy,
        .app-topbar.has-project-switcher
        .topbar-project-trigger-copy strong {
            min-width: 0;
            max-width: 100%;
        }

        .app-topbar.has-project-switcher
        .topbar-actions {
            min-width: 0;
            flex: 0 0 auto;
            justify-self: end;
        }

        @@media (max-width: 1500px) {
            .app-topbar.has-project-switcher {
                grid-template-columns:
                    minmax(150px, .78fr)
                    minmax(250px, 420px)
                    auto;
                gap: 10px;
            }

            .app-topbar.has-project-switcher
            .topbar-project-switcher {
                max-width: 420px;
            }

            .app-topbar.has-project-switcher
            .dashboard-top-heading h6 {
                font-size: 1rem;
            }
        }

        @@media (max-width: 1280px) {
            .app-topbar.has-project-switcher {
                grid-template-columns:
                    minmax(110px, .55fr)
                    minmax(225px, 340px)
                    auto;
                gap: 8px;
            }

            .app-topbar.has-project-switcher
            .topbar-project-switcher {
                width: 100%;
                max-width: 340px;
                margin-left: 0;
            }

            .app-topbar.has-project-switcher
            .topbar-project-trigger {
                grid-template-columns:
                    34px minmax(0, 1fr) 16px;
                gap: 8px;
                min-height: 48px;
                padding-right: 10px;
            }

            .app-topbar.has-project-switcher
            .topbar-project-trigger-icon {
                width: 34px;
                height: 34px;
            }

            .app-topbar.has-project-switcher
            .topbar-project-count {
                display: none;
            }
        }

        @@media (max-width: 1080px) {
            .app-topbar.has-project-switcher {
                display: flex !important;
                align-items: center;
                gap: 10px;
            }

            .app-topbar.has-project-switcher
            > .d-flex:first-child {
                flex: 1 1 auto;
            }

            .app-topbar.has-project-switcher
            .topbar-project-switcher {
                flex: 0 1 300px;
                width: min(300px, 34vw);
                max-width: 300px;
                margin-left: auto;
            }
        }

        @@media (max-width: 899.98px) {
            .app-topbar.has-project-switcher
            .topbar-project-switcher {
                flex-basis: 220px;
                width: 220px;
                max-width: 220px;
            }
        }

        @@media (max-width: 639.98px) {
            .app-topbar.has-project-switcher
            .topbar-project-switcher {
                display: none;
            }
        }


        /* =========================================================
           LIVE NOTIFICATION CENTER
           ========================================================= */

        .topbar-notification {
            position: relative;
        }

        .topbar-notification-trigger {
            position: relative;
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            color: #405577;
            background: #ffffff;
            border: 1px solid #dce4ee;
            border-radius: 13px;
            box-shadow: 0 8px 20px rgba(28, 45, 77, .06);
            transition: transform .16s ease, border-color .16s ease, color .16s ease;
        }

        .topbar-notification-trigger:hover,
        .topbar-notification-trigger[aria-expanded="true"] {
            color: #28385e;
            border-color: #afc0d6;
            transform: translateY(-1px);
        }

        .topbar-notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 20px;
            height: 20px;
            display: grid;
            place-items: center;
            padding: 0 5px;
            color: #ffffff;
            background: #d64550;
            border: 2px solid #ffffff;
            border-radius: 999px;
            font-size: .56rem;
            font-weight: 850;
            line-height: 1;
        }

        .topbar-notification-badge.is-empty {
            display: none;
        }

        .topbar-notification-menu {
            width: min(390px, calc(100vw - 24px));
            margin-top: 10px !important;
            padding: 0;
            overflow: hidden;
            background: rgba(255, 255, 255, .99);
            border: 1px solid #dfe6f0;
            border-radius: 18px;
            box-shadow: 0 24px 58px rgba(24, 37, 66, .18);
        }

        .topbar-notification-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 15px;
            color: #ffffff;
            background: linear-gradient(135deg, #28385e, #516c8d);
        }

        .topbar-notification-head strong,
        .topbar-notification-head small {
            display: block;
        }

        .topbar-notification-head strong {
            font-size: .84rem;
            font-weight: 850;
        }

        .topbar-notification-head small {
            margin-top: 2px;
            color: rgba(255, 255, 255, .68);
            font-size: .62rem;
        }

        .topbar-notification-head-count {
            min-width: 31px;
            height: 31px;
            display: grid;
            place-items: center;
            color: #28385e;
            background: #ffffff;
            border-radius: 10px;
            font-size: .66rem;
            font-weight: 850;
        }

        .topbar-notification-list {
            max-height: 390px;
            overflow-y: auto;
        }

        .topbar-notification-item-form {
            margin: 0;
        }

        .topbar-notification-item {
            width: 100%;
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr) auto;
            align-items: start;
            gap: 10px;
            padding: 12px 13px;
            text-align: left;
            background: #ffffff;
            border: 0;
            border-bottom: 1px solid #edf1f5;
            transition: background .15s ease;
        }

        .topbar-notification-item:hover {
            background: #f6f9fc;
        }

        .topbar-notification-item.is-unread {
            background: linear-gradient(90deg, #eef4fb, #ffffff 58%);
        }

        .topbar-notification-item-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #516c8d;
            background: #eaf0f7;
            border-radius: 12px;
        }

        .topbar-notification-item-copy {
            min-width: 0;
        }

        .topbar-notification-item-copy strong,
        .topbar-notification-item-copy span,
        .topbar-notification-item-copy small {
            display: block;
        }

        .topbar-notification-item-copy strong {
            overflow: hidden;
            color: #1d2943;
            font-size: .71rem;
            font-weight: 830;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-notification-item-copy span {
            display: -webkit-box;
            overflow: hidden;
            margin-top: 3px;
            color: #6e7b8f;
            font-size: .63rem;
            line-height: 1.45;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .topbar-notification-item-copy small {
            margin-top: 5px;
            color: #99a3b1;
            font-size: .56rem;
            font-weight: 700;
        }

        .topbar-notification-unread-dot {
            width: 8px;
            height: 8px;
            margin-top: 5px;
            background: #516c8d;
            border-radius: 999px;
        }

        .topbar-notification-empty {
            padding: 30px 18px;
            color: #7b8799;
            text-align: center;
            font-size: .7rem;
        }

        .topbar-notification-empty i {
            display: block;
            margin-bottom: 8px;
            color: #7890ae;
            font-size: 1.5rem;
        }

        .topbar-notification-footer {
            padding: 9px;
            background: #f8fafc;
        }

        .topbar-notification-all {
            min-height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            color: #405577;
            text-decoration: none;
            background: #ffffff;
            border: 1px solid #dfe6ef;
            border-radius: 11px;
            font-size: .67rem;
            font-weight: 800;
        }

        .topbar-notification-all:hover {
            color: #ffffff;
            background: #28385e;
            border-color: #28385e;
        }

        .fypilot-notification-toast {
            position: fixed;
            top: 82px;
            right: 20px;
            z-index: 2000;
            width: min(360px, calc(100vw - 32px));
            padding: 14px;
            color: #ffffff;
            background: linear-gradient(135deg, #28385e, #516c8d);
            border-radius: 15px;
            box-shadow: 0 20px 45px rgba(24, 37, 66, .24);
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity .22s ease, transform .22s ease;
        }

        .fypilot-notification-toast.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .fypilot-notification-toast strong,
        .fypilot-notification-toast span {
            display: block;
        }

        .fypilot-notification-toast strong {
            font-size: .77rem;
            font-weight: 850;
        }

        .fypilot-notification-toast span {
            margin-top: 4px;
            color: rgba(255, 255, 255, .75);
            font-size: .66rem;
            line-height: 1.45;
        }

        /* =========================================================
           ARCHIVED PROJECT — READ-ONLY BANNER
           ========================================================= */

        .archived-project-readonly-banner {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1rem;
            padding: .78rem .9rem;
            border: 1px solid #d7c992;
            border-radius: 13px;
            color: #654f12;
            background: linear-gradient(135deg, #fffaf0, #fff6d9);
            box-shadow: 0 8px 22px rgba(101, 79, 18, .08);
        }

        .archived-project-readonly-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            color: #ffffff;
            background: linear-gradient(135deg, #8b6d1f, #b18b2d);
        }

        .archived-project-readonly-copy strong,
        .archived-project-readonly-copy span {
            display: block;
        }

        .archived-project-readonly-copy strong {
            font-size: .72rem;
            font-weight: 850;
        }

        .archived-project-readonly-copy span {
            margin-top: .16rem;
            color: #806a2d;
            font-size: .62rem;
            line-height: 1.45;
        }

        .archived-project-readonly-link {
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            padding: 0 .7rem;
            border: 1px solid #d4c27c;
            border-radius: 9px;
            color: #654f12;
            background: #ffffff;
            font-size: .61rem;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

        .archived-project-readonly-link:hover {
            color: #4f3d0e;
            background: #fffdf7;
        }

        @@media (max-width: 640px) {
            .archived-project-readonly-banner {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .archived-project-readonly-link {
                grid-column: 1 / -1;
                width: 100%;
            }
        }

    </style>

    @RenderSection("Head", required: false)
</head>

<body>
    @{
        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
        var isAuth = User.Identity?.IsAuthenticated == true;

        var userEmail =
            User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

        var isMainAdmin = string.Equals(
            userEmail,
            "admin@fyp.com",
            StringComparison.OrdinalIgnoreCase);

        var path = Context.Request.Path.Value ?? "";
        var projectSwitcherDestination =
    ActiveProjectService.IsAllowedProjectPage(path)
        ? path
        : "/Student/Dashboard";
        string? navProfileImagePath = null;
        string? topbarProfileHref = null;
        int? currentUserIdForOnboarding = null;
        int? activeProjectId = null;
        int? archivedProjectContextId = null;
        var isArchivedProjectContext = false;

        var studentProjectSwitcherItems =
            new List<(
                int Id,
                string Title,
                string Role,
                string IdeaTitle)>();


        var topbarNotifications =
            new List<Notification>();

        var unreadNotificationCount = 0;

        if (isAuth)
        {
            var userIdValue = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(userIdValue, out var navUserId))
            {
                currentUserIdForOnboarding = navUserId;

                var currentUserName = await Db.Users
                    .AsNoTracking()
                    .Where(u => u.Id == navUserId)
                    .Select(u => u.FullName)
                    .FirstOrDefaultAsync();

                if (!string.IsNullOrWhiteSpace(currentUserName))
                {
                    userName = currentUserName;
                }

                unreadNotificationCount =
                    await Db.Notifications
                        .AsNoTracking()
                        .CountAsync(notification =>
                            notification.RecipientUserId == navUserId &&
                            !notification.IsRead);

                topbarNotifications =
                    await Db.Notifications
                        .AsNoTracking()
                        .Where(notification =>
                            notification.RecipientUserId == navUserId)
                        .OrderByDescending(notification =>
                            notification.CreatedAt)
                        .ThenByDescending(notification =>
                            notification.Id)
                        .Take(6)
                        .ToListAsync();

                if (role == "student")
                {
                    topbarProfileHref = "/Student/Profile";

                    navProfileImagePath = await Db.StudentProfiles
                        .AsNoTracking()
                        .Where(p => p.UserId == navUserId)
                        .Select(p => p.ProfileImagePath)
                        .FirstOrDefaultAsync();

                    activeProjectId =
                        await ActiveProjectService
                            .GetActiveProjectIdAsync(
                                navUserId);

                    var requestedProjectIdValue =
                        Context.Request.Query["projectId"]
                            .FirstOrDefault();

                    if (int.TryParse(
                            requestedProjectIdValue,
                            out var requestedProjectId) &&
                        requestedProjectId > 0)
                    {
                        archivedProjectContextId =
                            requestedProjectId;

                        isArchivedProjectContext =
                            await Db.ProjectMembers
                                .AsNoTracking()
                                .AnyAsync(member =>
                                    member.ProjectId ==
                                        requestedProjectId &&
                                    member.UserId ==
                                        navUserId &&
                                    member.Status ==
                                        "active" &&
                                    member.IsArchived &&
                                    member.Project != null &&
                                    !member.Project.IsDeleted);
                    }

                    /*
                     * Load only projects where the logged-in
                     * student still has an active membership.
                     * This is the same access scope used by
                     * My Projects and Continue Project.
                     */
                    var accessibleProjects =
                        await Db.Projects
                            .AsNoTracking()
                            .Where(project =>
                                !project.IsDeleted &&
                                project.Members.Any(member =>
                                    member.UserId == navUserId &&
                                    member.Status == "active" &&
                                    !member.IsArchived))
                            .Select(project => new
                            {
                                project.Id,
                                project.Title,
                                Role = project.Members
                                    .Where(member =>
                                        member.UserId == navUserId &&
                                        member.Status == "active")
                                    .Select(member => member.Role)
                                    .FirstOrDefault(),

                                IdeaTitle = project.ProjectIdea != null
                                    ? project.ProjectIdea.Title
                                    : null,

                                project.UpdatedAt
                            })
                            .OrderByDescending(project =>
                                project.UpdatedAt)
                            .ThenByDescending(project =>
                                project.Id)
                            .ToListAsync();

                    studentProjectSwitcherItems =
                        accessibleProjects
                            .OrderByDescending(project =>
                                activeProjectId.HasValue &&
                                project.Id ==
                                    activeProjectId.Value)
                            .ThenByDescending(project =>
                                project.UpdatedAt)
                            .ThenByDescending(project =>
                                project.Id)
                            .Select(project =>
                                (
                                    project.Id,
                                    string.IsNullOrWhiteSpace(
                                        project.Title)
                                        ? "Untitled Project"
                                        : project.Title.Trim(),
                                    string.IsNullOrWhiteSpace(
                                        project.Role)
                                        ? "collaborator"
                                        : project.Role.Trim(),
                                    string.IsNullOrWhiteSpace(
                                        project.IdeaTitle)
                                        ? "No official idea selected"
                                        : project.IdeaTitle.Trim()
                                ))
                            .ToList();
                }
                else if (role == "supervisor")
                {
                    topbarProfileHref = "/Supervisor/Profile";

                    navProfileImagePath = await Db.SupervisorProfiles
                        .AsNoTracking()
                        .Where(p => p.UserId == navUserId)
                        .Select(p => p.ProfileImagePath)
                        .FirstOrDefaultAsync();
                }
            }
        }

        string NavLink(
            string href,
            string icon,
            string label,
            string? tourKey = null,
            int? projectId = null)
        {
            var active =
                path.Equals(
                    href,
                    StringComparison.OrdinalIgnoreCase)
                || (href != "/"
                    && path.StartsWith(
                        href,
                        StringComparison.OrdinalIgnoreCase));

            var targetHref =
                projectId.HasValue
                    ? $"{href}?projectId={projectId.Value}"
                    : href;

            var tourAttribute =
                string.IsNullOrWhiteSpace(tourKey)
                    ? string.Empty
                    : $" data-tour=\"{tourKey}\"";

            return
                $"<a href=\"{targetHref}\" " +
                $"class=\"side-nav-link{(active ? " active" : "")}\"" +
                $"{tourAttribute}>" +
                $"<i class=\"bi bi-{icon}\"></i>" +
                $"<span>{label}</span></a>";
        }

        var initials = "U";

        if (!string.IsNullOrWhiteSpace(userName))
        {
            var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            if (parts.Length >= 2)
            {
                initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
            }
            else
            {
                initials = userName[0].ToString().ToUpper();
            }
        }
    }

    @if (isAuth)
    {
        <div class="app-shell d-flex"
             data-student-onboarding
             data-onboarding-role="@role"
             data-onboarding-user-id="@(currentUserIdForOnboarding?.ToString() ?? "anonymous")"
