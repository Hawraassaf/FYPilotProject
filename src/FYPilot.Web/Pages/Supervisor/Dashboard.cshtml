@page
@using System
@using System.Linq
@using System.Collections.Generic
@model FYPilot.Web.Pages.Supervisor.DashboardModel
@{
    ViewData["Title"] = "Supervisor Dashboard";
    ViewData["Subtitle"] = "Review assigned projects, guide teams, and manage project meetings.";

    var totalProjects = Model.AllProjects.Count;

    var pendingProjects = Model.AllProjects.Count(
        project => NormalizeStatus(project.Status) == "pending");

    var revisionProjects = Model.AllProjects.Count(
        project => NormalizeStatus(project.Status) == "needs_revision");

    var approvedProjects = Model.AllProjects.Count(
        project => NormalizeStatus(project.Status) == "approved");

    var rejectedProjects = Model.AllProjects.Count(
        project => NormalizeStatus(project.Status) == "rejected");

    var actionNeeded = pendingProjects + revisionProjects;
    var atRiskProjects = revisionProjects + rejectedProjects;

    var priorityProjects = Model.AllProjects
        .Where(project =>
            NormalizeStatus(project.Status) == "pending" ||
            NormalizeStatus(project.Status) == "needs_revision")
        .OrderByDescending(project =>
            NormalizeStatus(project.Status) == "needs_revision")
        .ThenBy(project => project.CreatedAt)
        .Take(4)
        .ToList();

    var projectRows = Model.AllProjects
        .OrderByDescending(project =>
            NormalizeStatus(project.Status) == "rejected")
        .ThenByDescending(project =>
            NormalizeStatus(project.Status) == "needs_revision")
        .ThenByDescending(project =>
            NormalizeStatus(project.Status) == "pending")
        .ThenByDescending(project => project.LastActivityAt)
        .Take(5)
        .ToList();

    var upcomingMeetings = Model.UpcomingMeetings
        .Take(3)
        .ToList();
}

<section class="sd-page">

    <header class="sd-hero">
        <div>
            <span class="sd-eyebrow">Supervisor Dashboard</span>
            <h1>Review, guide, and follow up with your assigned projects.</h1>
            <p>
                A focused workspace for project reviews, team follow-up,
                meetings, and shared academic supervision decisions.
            </p>

            <div class="sd-hero-actions">
                <a href="/Supervisor/IdeaReview" class="sd-hero-btn primary">
                    <i class="bi bi-journal-check"></i>
                    Review workspace
                </a>

                <a href="/Supervisor/Meetings" class="sd-hero-btn light">
                    <i class="bi bi-calendar-plus"></i>
                    Schedule project meeting
                </a>
            </div>
        </div>

        <div class="sd-hero-focus">
            <span>@actionNeeded</span>
            <small>projects need attention</small>
        </div>
    </header>

    @if (!Model.AllProjects.Any())
    {
        <section class="sd-empty">
            <div class="sd-empty-icon">
                <i class="bi bi-inbox"></i>
            </div>

            <h2>No assigned projects yet</h2>
            <p>
                Once an administrator assigns a project to you,
                its official idea, active collaborators, evaluation,
                and meetings will appear here.
            </p>

            <a href="/Supervisor/IdeaReview" class="sd-hero-btn primary">
                Open review workspace
            </a>
        </section>
    }
    else
    {
        <section class="sd-stats">
            <article class="sd-stat-card">
                <div class="sd-stat-icon orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <small>Pending Reviews</small>
                    <strong>@pendingProjects</strong>
                    <span>Needs your decision</span>
                </div>

                <i class="bi bi-chevron-right sd-stat-arrow"></i>
            </article>

            <article class="sd-stat-card">
                <div class="sd-stat-icon blue">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <div>
                    <small>Active Projects</small>
                    <strong>@totalProjects</strong>
                    <span>Under your supervision</span>
                </div>

                <i class="bi bi-chevron-right sd-stat-arrow"></i>
            </article>

            <article class="sd-stat-card">
                <div class="sd-stat-icon green">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <div>
                    <small>Approved Projects</small>
                    <strong>@approvedProjects</strong>
                    <span>Ready to progress</span>
                </div>

                <i class="bi bi-chevron-right sd-stat-arrow"></i>
            </article>

            <article class="sd-stat-card">
                <div class="sd-stat-icon red">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <div>
                    <small>At-Risk Projects</small>
                    <strong>@atRiskProjects</strong>
                    <span>Requires follow-up</span>
                </div>

                <i class="bi bi-chevron-right sd-stat-arrow"></i>
            </article>
        </section>

        <section class="sd-grid-top">

            <article class="sd-panel">
                <div class="sd-panel-head">
                    <div>
                        <span class="sd-eyebrow">Priority</span>
                        <h2>Priority Project Queue</h2>
                    </div>

                    <a href="/Supervisor/IdeaReview">View all (@actionNeeded)</a>
                </div>

                @if (!priorityProjects.Any())
                {
                    <div class="sd-soft-empty">
                        <i class="bi bi-check2-circle"></i>
                        <p>No pending project reviews right now.</p>
                    </div>
                }
                else
                {
                    <div class="sd-review-list">
                        @foreach (var project in priorityProjects)
                        {
                            var status = StatusMeta(project.Status);

                            <a href="/Supervisor/IdeaReview?projectId=@project.ProjectId&ideaId=@project.IdeaId"
                               class="sd-review-card">

                                <div class="sd-avatar">
                                    @Initials(project.ProjectTitle)
                                </div>

                                <div class="sd-review-main">
                                    <div class="sd-review-top">
                                        <span>
                                            @project.ProjectTitle ·
                                            @project.MemberCount
                                            @(project.MemberCount == 1 ? "member" : "members")
                                        </span>

                                        <small>
                                            Updated @TimeAgo(project.LastActivityAt)
                                        </small>
                                    </div>

                                    <h3>@project.IdeaTitle</h3>

                                    <div class="sd-chip-row">
                                        <b class="@status.ClassName">@status.Label</b>
                                        <span>@ValueOrDash(project.Domain)</span>
                                        <span>@ValueOrDash(project.DifficultyLevel)</span>
                                    </div>
                                </div>

                                <i class="bi bi-chevron-right sd-card-arrow"></i>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="sd-panel">
                <div class="sd-panel-head">
                    <div>
                        <span class="sd-eyebrow">Quick Actions</span>
                        <h2>Supervision Tools</h2>
                    </div>
                </div>

                <div class="sd-action-grid">
                    <a href="/Supervisor/IdeaReview" class="sd-action-tile">
                        <i class="bi bi-journal-check"></i>
                        <div>
                            <strong>Review Workspace</strong>
                            <small>Evaluate the official idea shared by each project team.</small>
                        </div>
                    </a>

                    <a href="/Supervisor/Meetings" class="sd-action-tile">
                        <i class="bi bi-calendar-plus"></i>
                        <div>
                            <strong>Schedule Project Meeting</strong>
                            <small>Invite every active collaborator through Google Calendar.</small>
                        </div>
                    </a>

                    <a href="/Supervisor/IdeaReview" class="sd-action-tile">
                        <i class="bi bi-chat-dots"></i>
                        <div>
                            <strong>Message Project Teams</strong>
                            <small>Send shared academic guidance and feedback.</small>
                        </div>
                    </a>

                    <a href="/Supervisor/ProgressTracking" class="sd-action-tile">
                        <i class="bi bi-bar-chart-line"></i>
                        <div>
                            <strong>Track Project Progress</strong>
                            <small>Check roadmap phases, risks, and next steps.</small>
                        </div>
                    </a>
                </div>
            </article>

        </section>

        <section class="sd-grid-bottom">

            <article class="sd-panel">
                <div class="sd-panel-head">
                    <div>
                        <span class="sd-eyebrow">Projects</span>
                        <h2>Project Follow-up Overview</h2>
                    </div>

                    <a href="/Supervisor/ProgressTracking">View progress</a>
                </div>

                @if (!projectRows.Any())
                {
                    <div class="sd-soft-empty">
                        <p>No project activity yet.</p>
                    </div>
                }
                else
                {
                    <div class="sd-student-list">
                        @foreach (var project in projectRows)
                        {
                            var projectStatus = ProjectStatus(project.Status);

                            <a href="/Supervisor/IdeaReview?projectId=@project.ProjectId&ideaId=@project.IdeaId"
                               class="sd-student-row">

                                <div class="sd-avatar small">
                                    @Initials(project.ProjectTitle)
                                </div>

                                <div class="sd-student-info">
                                    <strong>@project.ProjectTitle</strong>
                                    <small>
                                        @project.MemberCount
                                        @(project.MemberCount == 1 ? "member" : "members")
                                        · @project.MemberNames
                                    </small>
                                </div>

                                <div class="sd-student-status">
                                    <span class="@projectStatus.ClassName">
                                        @projectStatus.Label
                                    </span>
                                </div>

                                <div class="sd-next-action">
                                    <i class="@projectStatus.Icon"></i>
                                    <div>
                                        <strong>@NextActionLabel(project.Status)</strong>
                                        <small>@TimeAgo(project.LastActivityAt)</small>
                                    </div>
                                </div>

                                <i class="bi bi-chevron-right sd-card-arrow"></i>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="sd-panel">
                <div class="sd-panel-head">
                    <div>
                        <span class="sd-eyebrow">Calendar</span>
                        <h2>Upcoming Project Meetings</h2>
                    </div>

                    <a href="/Supervisor/Meetings">View calendar</a>
                </div>

                <div class="sd-meeting-list">
                    @if (!upcomingMeetings.Any())
                    {
                        <div class="sd-soft-empty compact">
                            <i class="bi bi-calendar-check"></i>
                            <p>No upcoming project meetings.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var meeting in upcomingMeetings)
                        {
                            var localMeeting = meeting.ScheduledAt.ToLocalTime();

                            <a href="/Supervisor/Meetings?meetingId=@meeting.MeetingId"
                               class="sd-meeting-row">

                                <div class="sd-date-box">
                                    <span>@localMeeting.ToString("MMM")</span>
                                    <strong>@localMeeting.Day.ToString("00")</strong>
                                </div>

                                <div class="sd-meeting-main">
                                    <strong>@meeting.ProjectTitle</strong>
                                    <small>
                                        @meeting.MeetingTitle ·
                                        @localMeeting.ToString("hh:mm tt")
                                    </small>
                                    <p>
                                        @meeting.MemberCount
                                        @(meeting.MemberCount == 1 ? "member" : "members")
                                        · @meeting.DurationMinutes min
                                    </p>
                                </div>

                                <span class="sd-status ontrack">Scheduled</span>

                                <i class="bi bi-chevron-right sd-dots"></i>
                            </a>
                        }
                    }
                </div>
            </article>

        </section>
    }
</section>

@section Head {
    <style>
        :root {
            --sd-navy: #28385E;
            --sd-blue: #304163;
            --sd-steel: #516C8D;
            --sd-bg: #F7F8FA;
            --sd-border: #E8ECF2;
            --sd-text: #111827;
            --sd-muted: #64748B;
            --sd-soft: #F1F4F8;
            --sd-orange: #C2410C;
            --sd-yellow: #92400E;
            --sd-green: #047857;
            --sd-red: #B91C1C;
            --sd-purple: #4F46E5;
        }

        .sd-page {
            max-width: 1480px;
            margin: 0 auto;
            color: var(--sd-text);
            padding-bottom: 1.5rem;
        }

        .sd-hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 220px;
            gap: 1rem;
            align-items: center;
            margin-bottom: .95rem;
            padding: 1.35rem;
            border-radius: 28px;
            color: #fff;
            background: radial-gradient(circle at 18% 16%, rgba(255,255,255,.18), transparent 22%), radial-gradient(circle at 82% 10%, rgba(255,255,255,.10), transparent 20%), linear-gradient(135deg, #061C49 0%, var(--sd-navy) 58%, var(--sd-steel) 135%);
            box-shadow: 0 18px 44px rgba(40,56,94,.16);
        }

        .sd-eyebrow {
            display: block;
            margin-bottom: .25rem;
            color: var(--sd-steel);
            font-size: .68rem;
            font-weight: 500;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .sd-hero .sd-eyebrow {
            color: rgba(255,255,255,.75);
        }

        .sd-hero h1 {
            max-width: 780px;
            margin: 0;
            font-size: clamp(1.7rem, 2.7vw, 2.45rem);
            line-height: 1.05;
            font-weight: 500;
            letter-spacing: -.045em;
        }

        .sd-hero p {
            max-width: 760px;
            margin: .55rem 0 0;
            color: rgba(255,255,255,.78);
            line-height: 1.55;
            font-size: .9rem;
        }

        .sd-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .55rem;
            margin-top: .9rem;
        }

        .sd-hero-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .42rem;
            border-radius: 13px;
            padding: .64rem .86rem;
            text-decoration: none;
            font-size: .78rem;
            font-weight: 500;
            transition: .15s ease;
            border: 1px solid transparent;
        }

            .sd-hero-btn.primary {
                color: #fff;
                background: rgba(6,28,73,.62);
                border-color: rgba(255,255,255,.10);
            }

            .sd-hero-btn.light {
                color: var(--sd-blue);
                background: #fff;
            }

            .sd-hero-btn:hover {
                transform: translateY(-1px);
            }

            .sd-hero-btn.primary:hover {
                color: #fff;
                background: rgba(6,28,73,.78);
            }

            .sd-hero-btn.light:hover {
                color: var(--sd-blue);
            }

        .sd-hero-focus {
            min-height: 130px;
            display: grid;
            place-items: center;
            align-content: center;
            text-align: center;
            padding: 1rem;
            border-radius: 24px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.18);
            backdrop-filter: blur(8px);
        }

            .sd-hero-focus span {
                display: block;
                font-size: 2.55rem;
                line-height: 1;
                font-weight: 500;
            }

            .sd-hero-focus small {
                margin-top: .45rem;
                color: rgba(255,255,255,.76);
                font-size: .78rem;
            }

        .sd-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .85rem;
            margin-bottom: .85rem;
        }

        .sd-stat-card,
        .sd-panel,
        .sd-empty {
            background: #fff;
            border: 1px solid var(--sd-border);
            box-shadow: 0 14px 34px rgba(15,23,42,.05);
        }

        .sd-stat-card {
            min-height: 116px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: .85rem;
            align-items: center;
            padding: .95rem;
            border-radius: 22px;
        }

        .sd-stat-icon {
            width: 54px;
            height: 54px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            font-size: 1.28rem;
            flex: none;
        }

            .sd-stat-icon.orange {
                color: #C2410C;
                background: #FFF7ED;
            }

            .sd-stat-icon.blue {
                color: #2563EB;
                background: #EFF6FF;
            }

            .sd-stat-icon.green {
                color: var(--sd-green);
                background: #ECFDF5;
            }

            .sd-stat-icon.red {
                color: var(--sd-red);
                background: #FEF2F2;
            }

        .sd-stat-card small {
            display: block;
            color: #52627A;
            font-size: .75rem;
            font-weight: 500;
        }

        .sd-stat-card strong {
            display: block;
            margin-top: .15rem;
            color: var(--sd-text);
            font-size: 1.7rem;
            line-height: 1;
            font-weight: 500;
        }

        .sd-stat-card span {
            display: block;
            margin-top: .42rem;
            color: var(--sd-muted);
            font-size: .72rem;
        }

        .sd-stat-arrow {
            color: #94A3B8;
            font-size: .9rem;
        }

        .sd-grid-top,
        .sd-grid-bottom {
            display: grid;
            gap: .85rem;
            margin-bottom: .85rem;
        }

        .sd-grid-top {
            grid-template-columns: minmax(0, 1.25fr) minmax(350px, .85fr);
        }

        .sd-grid-bottom {
            grid-template-columns: minmax(0, 1.1fr) minmax(390px, .9fr);
        }

        .sd-panel,
        .sd-empty {
            border-radius: 24px;
            overflow: hidden;
        }

        .sd-panel-head {
            min-height: 66px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .9rem;
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--sd-border);
        }

            .sd-panel-head h2 {
                margin: 0;
                color: var(--sd-text);
                font-size: 1rem;
                font-weight: 500;
                letter-spacing: -.02em;
            }

            .sd-panel-head a {
                color: #3156B7;
                font-size: .76rem;
                font-weight: 500;
                text-decoration: none;
            }

        .sd-review-list,
        .sd-student-list,
        .sd-meeting-list {
            display: grid;
            gap: .65rem;
            padding: .85rem;
        }

        .sd-review-card,
        .sd-student-row,
        .sd-meeting-row {
            color: inherit;
            text-decoration: none;
            border: 1px solid var(--sd-border);
            border-radius: 18px;
            background: #fff;
            transition: .15s ease;
        }

            .sd-review-card:hover,
            .sd-student-row:hover,
            .sd-meeting-row:hover {
                color: inherit;
                border-color: #B8C8DD;
                box-shadow: 0 10px 22px rgba(40,56,94,.07);
                transform: translateY(-1px);
            }

        .sd-review-card {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .75rem;
            padding: .82rem;
        }

        .sd-avatar {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            color: var(--sd-blue);
            background: #EEF2F6;
            font-size: .76rem;
            font-weight: 500;
        }

            .sd-avatar.small {
                width: 38px;
                height: 38px;
                border-radius: 14px;
                font-size: .7rem;
            }

        .sd-review-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

            .sd-review-top span {
                color: #334155;
                font-size: .78rem;
                font-weight: 500;
            }

            .sd-review-top small {
                color: var(--sd-muted);
                font-size: .68rem;
                white-space: nowrap;
            }

        .sd-review-card h3 {
            margin: .24rem 0 .45rem;
            color: var(--sd-text);
            font-size: .93rem;
            line-height: 1.35;
            font-weight: 500;
        }

        .sd-chip-row {
            display: flex;
            flex-wrap: wrap;
            gap: .35rem;
            align-items: center;
        }

            .sd-chip-row span {
                display: inline-flex;
                width: fit-content;
                border-radius: 999px;
                padding: .24rem .5rem;
                color: #475569;
                background: var(--sd-soft);
                font-size: .67rem;
                font-weight: 500;
            }

        .sd-status {
            display: inline-flex;
            width: fit-content;
            border-radius: 999px;
            padding: .24rem .5rem;
            font-size: .67rem;
            font-weight: 500;
            white-space: nowrap;
        }

            .sd-status.pending {
                color: #9A3412;
                background: #FFF7ED;
            }

            .sd-status.awaiting {
                color: var(--sd-blue);
                background: #EEF2F6;
            }

            .sd-status.revision {
                color: #92400E;
                background: #FEF3C7;
            }

            .sd-status.approved,
            .sd-status.ontrack {
                color: var(--sd-green);
                background: #ECFDF5;
            }

            .sd-status.rejected,
            .sd-status.risk {
                color: var(--sd-red);
                background: #FEF2F2;
            }

        .sd-card-arrow,
        .sd-dots {
            color: #94A3B8;
        }

        .sd-action-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .7rem;
            padding: .85rem;
        }

        .sd-action-tile {
            min-height: 115px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .75rem;
            align-items: start;
            padding: .85rem;
            border: 1px solid var(--sd-border);
            border-radius: 18px;
            color: inherit;
            text-decoration: none;
            background: #fff;
            transition: .15s ease;
        }

            .sd-action-tile:hover {
                color: inherit;
                border-color: #B8C8DD;
                box-shadow: 0 10px 22px rgba(40,56,94,.07);
                transform: translateY(-1px);
            }

            .sd-action-tile i {
                width: 38px;
                height: 38px;
                display: grid;
                place-items: center;
                border-radius: 14px;
                color: #3156B7;
                background: #EEF2FF;
                font-size: 1rem;
            }

            .sd-action-tile strong {
                display: block;
                color: var(--sd-text);
                font-size: .82rem;
                font-weight: 500;
            }

            .sd-action-tile small {
                display: block;
                margin-top: .22rem;
                color: var(--sd-muted);
                font-size: .7rem;
                line-height: 1.42;
            }

        .sd-student-row {
            display: grid;
            grid-template-columns: auto minmax(0, 1.25fr) .8fr 1.15fr auto;
            gap: .75rem;
            align-items: center;
            padding: .78rem;
        }

        .sd-student-info strong {
            display: block;
            color: var(--sd-text);
            font-size: .82rem;
            font-weight: 500;
        }

        .sd-student-info small {
            display: block;
            margin-top: .15rem;
            color: var(--sd-muted);
            font-size: .72rem;
        }

        .sd-next-action {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .48rem;
            align-items: center;
        }

            .sd-next-action i {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                color: #3156B7;
                background: #EEF2FF;
                border-radius: 13px;
                font-size: .88rem;
            }

            .sd-next-action strong {
                display: block;
                color: #334155;
                font-size: .75rem;
                font-weight: 500;
            }

            .sd-next-action small {
                color: var(--sd-muted);
                font-size: .68rem;
            }

        .sd-meeting-row {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto auto;
            gap: .75rem;
            align-items: center;
            padding: .82rem;
        }

        .sd-date-box {
            width: 54px;
            height: 58px;
            display: grid;
            place-items: center;
            align-content: center;
            border-radius: 16px;
            color: var(--sd-blue);
            background: #F3F6FB;
        }

            .sd-date-box span {
                color: var(--sd-steel);
                font-size: .62rem;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: .06em;
            }

            .sd-date-box strong {
                color: var(--sd-blue);
                font-size: 1.28rem;
                line-height: 1;
                font-weight: 500;
            }

        .sd-meeting-main strong {
            display: block;
            color: var(--sd-text);
            font-size: .84rem;
            font-weight: 500;
        }

        .sd-meeting-main small {
            display: block;
            margin-top: .12rem;
            color: var(--sd-muted);
            font-size: .72rem;
        }

        .sd-meeting-main p {
            margin: .18rem 0 0;
            color: #475569;
            font-size: .7rem;
        }

        .sd-soft-empty {
            min-height: 150px;
            margin: .85rem;
            display: grid;
            place-items: center;
            align-content: center;
            text-align: center;
            gap: .35rem;
            padding: 1rem;
            border: 1px dashed var(--sd-border);
            border-radius: 18px;
            color: var(--sd-muted);
        }

            .sd-soft-empty.compact {
                min-height: 190px;
            }

            .sd-soft-empty i {
                color: var(--sd-green);
                font-size: 1.35rem;
            }

            .sd-soft-empty p {
                margin: 0;
                font-size: .82rem;
            }

        .sd-empty {
            min-height: 460px;
            display: grid;
            place-items: center;
            align-content: center;
            text-align: center;
            gap: .65rem;
            padding: 2rem;
        }

        .sd-empty-icon {
            width: 76px;
            height: 76px;
            display: grid;
            place-items: center;
            color: var(--sd-steel);
            background: #EEF2F6;
            border-radius: 26px;
            font-size: 1.95rem;
        }

        .sd-empty h2 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 500;
        }

        .sd-empty p {
            max-width: 560px;
            margin: 0;
            color: var(--sd-muted);
            line-height: 1.6;
        }

        @@media (max-width: 1280px) {
            .sd-hero,
            .sd-grid-top,
            .sd-grid-bottom {
                grid-template-columns: 1fr;
            }

            .sd-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767px) {
            .sd-stats,
            .sd-action-grid {
                grid-template-columns: 1fr;
            }

            .sd-hero {
                padding: 1rem;
            }

            .sd-hero-focus {
                min-height: 105px;
            }

            .sd-review-card,
            .sd-student-row,
            .sd-meeting-row {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .sd-card-arrow,
            .sd-dots,
            .sd-student-status {
                display: none;
            }
        }
    </style>
}

@functions {
    private static string NormalizeStatus(string? status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "pending"
            : status.Trim().ToLowerInvariant();
    }

    private static (string Label, string ClassName) StatusMeta(string? status)
    {
        return NormalizeStatus(status) switch
        {
            "approved" => ("Approved", "sd-status approved"),
            "needs_revision" => ("Needs Revision", "sd-status revision"),
            "rejected" => ("Rejected", "sd-status rejected"),
            "awaiting_idea" => (
                "Awaiting Idea",
                "sd-status awaiting"),
            _ => ("Pending", "sd-status pending")
        };
    }

    private static (string Label, string ClassName, string Icon)
        ProjectStatus(string? status)
    {
        return NormalizeStatus(status) switch
        {
            "rejected" => (
                "At Risk",
                "sd-status risk",
                "bi bi-exclamation-triangle"),

            "needs_revision" => (
                "Needs Revision",
                "sd-status revision",
                "bi bi-pencil-square"),

            "pending" => (
                "Pending",
                "sd-status pending",
                "bi bi-hourglass-split"),

            "awaiting_idea" => (
                "Awaiting Idea",
                "sd-status awaiting",
                "bi bi-lightbulb"),

            _ => (
                "On Track",
                "sd-status ontrack",
                "bi bi-check2-circle")
        };
    }

    private static string NextActionLabel(string? status)
    {
        return NormalizeStatus(status) switch
        {
            "rejected" => "Review direction",
            "needs_revision" => "Review revisions",
            "pending" => "Evaluate idea",
            "awaiting_idea" => "Awaiting official idea",
            _ => "Progress check"
        };
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "PR";
        }

        var parts = name
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .ToList();

        return parts.Count == 0
            ? "PR"
            : string.Join(
                    "",
                    parts.Select(part => part[0]))
                .ToUpperInvariant();
    }

    private static string ValueOrDash(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Uncategorized"
            : value;
    }

    private static string TimeAgo(DateTime date)
    {
        var value = date.Kind == DateTimeKind.Utc
            ? date
            : DateTime.SpecifyKind(
                date,
                DateTimeKind.Utc);

        var span = DateTime.UtcNow - value;

        if (span.TotalDays >= 7)
        {
            return value
                .ToLocalTime()
                .ToString("MMM d");
        }

        if (span.TotalDays >= 1)
        {
            var days =
                (int)Math.Floor(
                    span.TotalDays);

            return days == 1
                ? "1 day ago"
                : $"{days} days ago";
        }

        if (span.TotalHours >= 1)
        {
            var hours =
                (int)Math.Floor(
                    span.TotalHours);

            return hours == 1
                ? "1 hour ago"
                : $"{hours} hours ago";
        }

        if (span.TotalMinutes >= 1)
        {
            var minutes =
                (int)Math.Floor(
                    span.TotalMinutes);

            return minutes == 1
                ? "1 min ago"
                : $"{minutes} mins ago";
        }

        return "Just now";
    }
}
