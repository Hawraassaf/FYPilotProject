            padding: .9rem 1rem .72rem;
        }

        .comparison-identity {
            min-width: 0;
            display: flex;
            align-items: flex-start;
            gap: .7rem;
        }

        .comparison-index {
            width: 31px;
            height: 31px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            color: #28385E;
            font-size: .67rem;
            font-weight: 850;
            border-radius: 9px;
            background: #EEF2F6;
        }

        .comparison-identity-copy {
            min-width: 0;
        }

        .comparison-title-line {
            display: flex;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: .38rem .5rem;
        }

        .comparison-title-line h3 {
            min-width: 0;
            margin: 0;
            color: #111827;
            font-size: .78rem;
            line-height: 1.35;
            font-weight: 800;
        }

        .comparison-badges {
            display: inline-flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .28rem;
        }

        .best-match-pill {
            display: none;
            align-items: center;
            gap: .25rem;
            padding: .18rem .42rem;
            color: #28385E;
            font-size: .52rem;
            font-weight: 850;
            border: 1px solid #CFDAE6;
            border-radius: 999px;
            background: #FFFFFF;
        }

        .comparison-idea-row.best-match .best-match-pill {
            display: inline-flex;
        }

        .comparison-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .35rem .65rem;
            margin-top: .35rem;
            color: #718096;
            font-size: .59rem;
        }

        .comparison-meta span {
            display: inline-flex;
            align-items: center;
            gap: .25rem;
        }

        .compact-score-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .55rem;
        }

        .compact-score {
            min-width: 0;
            padding: .52rem .58rem;
            border: 1px solid #E2E8EF;
            border-radius: 11px;
            background: #FFFFFF;
        }

        .compact-score-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .45rem;
        }

        .compact-score-top > span {
            min-width: 0;
            display: inline-flex;
            align-items: center;
            gap: .28rem;
            overflow: hidden;
            color: #637287;
            font-size: .57rem;
            font-weight: 760;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .compact-score-top > span i {
            color: #516C8D;
        }

        .compact-score-top strong {
            flex: 0 0 auto;
            color: #28385E;
            font-size: .78rem;
            font-weight: 850;
        }

        .compact-score-track {
            height: 4px;
            margin: .36rem 0 .28rem;
            overflow: hidden;
            border-radius: 999px;
            background: #EAF0F5;
        }

        .compact-score-track span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: #8FA5BE;
        }

        .compact-score small {
            display: block;
            overflow: hidden;
            color: #8995A5;
            font-size: .5rem;
            font-weight: 700;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .overall-score-box {
            min-height: 58px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: .45rem;
            text-align: center;
            border: 1px solid #D9E2EB;
            border-radius: 12px;
            background: #F8FAFC;
        }

        .overall-score-box span {
            color: #758297;
            font-size: .5rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .overall-score-box strong {
            margin-top: .08rem;
            color: #28385E;
            font-size: 1rem;
            line-height: 1;
            font-weight: 900;
        }

        .overall-score-box small {
            margin-top: .1rem;
            color: #9AA5B3;
            font-size: .46rem;
            font-weight: 700;
        }

        .comparison-decision {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .comparison-decision .decision-btn {
            width: 100%;
            min-width: 0;
        }

        .idea-score-details {
            margin: 0 .95rem .8rem 3.95rem;
            border-top: 1px dashed #DCE4EC;
        }

        .idea-score-details summary {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .58rem 0 .15rem;
            color: #516C8D;
            font-size: .6rem;
            font-weight: 800;
            cursor: pointer;
            list-style: none;
        }

        .idea-score-details summary::-webkit-details-marker {
            display: none;
        }

        .idea-score-details summary > span {
            display: inline-flex;
            align-items: center;
            gap: .32rem;
        }

        .idea-score-details .details-chevron {
            transition: transform .16s ease;
        }

        .idea-score-details[open] .details-chevron {
            transform: rotate(180deg);
        }

        .score-reason-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .55rem;
            padding: .65rem 0 .15rem;
        }

        .score-reason-card {
            padding: .72rem;
            border: 1px solid #E2E8EF;
            border-radius: 12px;
            background: #FFFFFF;
        }

        .score-reason-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .55rem;
        }

        .score-reason-heading span {
            display: inline-flex;
            align-items: center;
            gap: .32rem;
            color: #28385E;
            font-size: .64rem;
            font-weight: 820;
        }

        .score-reason-heading span i {
            color: #516C8D;
        }

        .score-reason-heading strong {
            color: #28385E;
            font-size: .72rem;
        }

        .score-reason-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .3rem;
            margin-top: .35rem;
        }

        .score-reason-meta span {
            padding: .17rem .38rem;
            color: #6E7D90;
            font-size: .48rem;
            font-weight: 760;
            border-radius: 999px;
            background: #F1F4F7;
        }

        .score-reason-card p {
            margin: .45rem 0 0;
            color: #5F6E82;
            font-size: .58rem;
            line-height: 1.48;
        }

        @@media (max-width: 1180px) {
            .comparison-list-header {
                display: none;
            }

            .comparison-row-main {
                grid-template-columns: minmax(250px, 1.1fr) minmax(360px, 1.5fr) 80px;
            }

            .comparison-decision {
                grid-column: 1 / -1;
                justify-content: flex-end;
            }

            .comparison-decision .decision-btn {
                width: auto;
                min-width: 110px;
            }
        }

        @@media (max-width: 900px) {
            .priority-panel {
                grid-template-columns: 1fr;
            }

            .priority-controls {
                justify-content: flex-start;
            }

            .priority-pills {
                justify-content: flex-start;
            }

            .priority-summary {
                grid-column: auto;
            }

            .quick-match-banner {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .quick-match-action {
                grid-column: 1 / -1;
            }

            .quick-match-action .ui-btn {
                width: 100%;
            }

            .comparison-row-main {
                grid-template-columns: 1fr;
                gap: .7rem;
            }

            .compact-score-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .overall-score-box {
                min-height: 48px;
                flex-direction: row;
                gap: .35rem;
            }

            .overall-score-box strong {
                margin: 0;
            }

            .overall-score-box small {
                margin: 0;
            }

            .comparison-decision {
                grid-column: auto;
                justify-content: stretch;
            }

            .comparison-decision .decision-btn {
                width: 100%;
            }

            .idea-score-details {
                margin-left: 1rem;
            }
        }

        @@media (max-width: 620px) {
            .priority-controls {
                align-items: stretch;
                flex-direction: column;
            }

            .priority-pills {
                display: grid;
                grid-template-columns: 1fr;
            }

            .priority-pill {
                justify-content: flex-start;
            }

            .priority-reset {
                align-self: flex-start;
            }

            .quick-match-banner {
                grid-template-columns: 1fr;
            }

            .quick-match-icon {
                width: 38px;
                height: 38px;
            }

            .compact-score-grid {
                grid-template-columns: 1fr;
            }

            .comparison-row-main {
                padding: .85rem;
            }

            .idea-score-details {
                margin: 0 .85rem .75rem;
            }

            .score-reason-grid {
                grid-template-columns: 1fr;
            }
        }

    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll("[data-details-toggle]").forEach(button => {
            button.addEventListener("click", () => {
                const panel = document.getElementById(
                    button.getAttribute("aria-controls"));

                if (!panel) {
                    return;
                }

                const isOpen =
                    button.getAttribute("aria-expanded") === "true";

                button.setAttribute(
                    "aria-expanded",
                    String(!isOpen));

                button
                    .querySelector(".bi-chevron-down")
                    ?.classList.toggle("rotate-180", !isOpen);

                if (isOpen) {
                    panel.setAttribute("hidden", "");
                } else {
                    panel.removeAttribute("hidden");
                }
            });
        });

        const compareForm = document.getElementById("ic3CompareForm");
        const compareBtn = document.getElementById("ic3CompareBtn");

        const MIN_IDEAS =
            @FYPilot.Web.Pages.Student.IdeaComparisonModel.MinimumIdeasToCompare;

        const RECOMMENDED_MAX_IDEAS =
            @FYPilot.Web.Pages.Student.IdeaComparisonModel.RecommendedMaximumIdeasToCompare;

        const HARD_MAX_IDEAS =
            @FYPilot.Web.Pages.Student.IdeaComparisonModel.HardMaximumIdeasToCompare;

        const selectCheckboxes =
            document.querySelectorAll('input[name="SelectedIdeaIds"]');

        const selectCount = document.getElementById("ic3SelectCount");
        const selectHint = document.getElementById("ic3SelectHint");

        function updateSelectionState(changedBox = null) {
            let checked = Array.from(selectCheckboxes)
                .filter(box => box.checked);

            if (checked.length > HARD_MAX_IDEAS && changedBox) {
                changedBox.checked = false;
                checked = Array.from(selectCheckboxes)
                    .filter(box => box.checked);
            }

            const count = checked.length;
            const isValid =
                count >= MIN_IDEAS &&
                count <= HARD_MAX_IDEAS;

            if (selectCount) {
                selectCount.textContent = `${count} selected`;

                selectCount.classList.toggle(
                    "is-invalid",
                    !isValid);

                selectCount.classList.toggle(
                    "is-caution",
                    count > RECOMMENDED_MAX_IDEAS &&
                    count <= HARD_MAX_IDEAS);
            }

            let hint;

            if (count < MIN_IDEAS) {
                hint =
                    `Select at least ${MIN_IDEAS} ideas to continue.`;
            } else if (count > RECOMMENDED_MAX_IDEAS) {
                hint =
                    `${count} ideas selected. ${RECOMMENDED_MAX_IDEAS} or fewer usually returns faster.`;
            } else {
                hint =
                    `${count} ideas selected and ready to compare.`;
            }

            if (selectHint) {
                selectHint.textContent = hint;
            }

            if (compareBtn && !compareBtn.dataset.submitting) {
                compareBtn.disabled = !isValid;
            }
        }

        selectCheckboxes.forEach(box => {
            box.addEventListener("change", () => {
                updateSelectionState(box);
            });
        });

        updateSelectionState();

        // ── Centralized AI Agent Loading System ─────────────────────────
        const ic3ProjectId = compareForm ? Number(compareForm.dataset.projectId) : null;
        const ic3StartError = document.getElementById("ic3StartError");
        const ic3OriginalBtnHtml = compareBtn ? compareBtn.innerHTML : "";

        const ic3Stages = [
            { key: "prepare_context", label: "Preparing context" },
            { key: "generate", label: "Generating recommendation" },
            { key: "review", label: "Reviewing quality" },
            { key: "rewrite", label: "Refining based on feedback" },
            { key: "final_checks", label: "Final quality checks" },
            { key: "save", label: "Saving recommendation" },
        ];

        function ic3ShowStartError(message) {
            if (ic3StartError) {
                ic3StartError.textContent = message;
                ic3StartError.hidden = false;
            }
        }

        function ic3ResetCompareButton() {
            if (!compareBtn) {
                return;
            }
            delete compareBtn.dataset.submitting;
            compareBtn.disabled = false;
            compareBtn.innerHTML = ic3OriginalBtnHtml;
        }

        function ic3SetCompareButtonBusy() {
            if (!compareBtn) {
                return;
            }
            compareBtn.dataset.submitting = "true";
            compareBtn.disabled = true;
            compareBtn.innerHTML =
                '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>' +
                '<span><strong>Analyzing your shortlist…</strong><small>Watch live progress below</small></span>';
        }

        compareForm?.addEventListener("submit", (event) => {
            event.preventDefault();

            if (!compareBtn || compareBtn.disabled) {
                return;
            }

            if (ic3StartError) {
                ic3StartError.hidden = true;
            }

            ic3SetCompareButtonBusy();

            const selectedIdeaIds = Array.from(selectCheckboxes)
                .filter(box => box.checked)
                .map(box => Number(box.value));

            window.AiAgentProgress
                .start({
                    agentName: "Idea Comparison",
                    storageKey: "aip:idea-comparison:" + ic3ProjectId,
                    stages: ic3Stages,
                    startUrl: "?handler=StartCompareJob&projectId=" + ic3ProjectId,
                    startBody: { selectedIdeaIds: selectedIdeaIds },
                })
                .catch((error) => {
                    ic3ResetCompareButton();
                    ic3ShowStartError(
                        error && error.message
                            ? error.message
                            : "Could not start the comparison. Please try again.");
                });
        });

        // Reconnect to an already-running job (e.g. after a refresh) using
        // the server-rendered hint -- never sessionStorage alone.
        if (compareForm && compareForm.dataset.activeJobId) {
            ic3SetCompareButtonBusy();
            window.AiAgentProgress.attach(compareForm.dataset.activeJobId, {
                agentName: "Idea Comparison",
                storageKey: "aip:idea-comparison:" + ic3ProjectId,
                stages: ic3Stages,
            });
        }

        document
            .getElementById("aiRecommendationResult")
            ?.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
    </script>
}
