                            <li>@Html.Raw(NavLink("/Student/IdeaComparison", "columns-gap", "Idea Comparison", "idea-comparison", activeProjectId))</li>
                             <li>@Html.Raw(NavLink("/Student/MarketDemand", "graph-up-arrow", "Market Demand", "market-demand", activeProjectId))</li>
                            <li>@Html.Raw(NavLink("/Student/ProjectDNA", "diagram-3", "Project DNA", "project-dna", activeProjectId))</li>
                            <li>@Html.Raw(NavLink("/Student/Roadmap", "map", "Roadmap", "roadmap", activeProjectId))</li>
                            <li>@Html.Raw(NavLink("/Student/DocumentationGenerator", "journal-code", "SE Documentation", "se-documentation", activeProjectId))</li>

                            <li><span class="side-nav-label">Project Support</span></li>
                            <li>@Html.Raw(NavLink("/Student/MentorChat", "chat-dots", "Mentor Chat", "mentor-chat", activeProjectId))</li>
                            <li>@Html.Raw(NavLink("/Student/Feedback", "chat-square-text", "Supervisor Feedback", "supervisor-feedback", activeProjectId))</li>
                            <li>@Html.Raw(NavLink("/Student/DefenseSimulator", "shield-check", "Defense Simulator", "defense-simulator", activeProjectId))</li>
                        }

                        @if (role == "supervisor")
                        {
                            <li><span class="side-nav-label">Supervisor</span></li>
                            <li>@Html.Raw(NavLink("/Supervisor/Dashboard", "speedometer2", "Dashboard"))</li>
                            <li>@Html.Raw(NavLink("/Supervisor/IdeaReview", "card-checklist", "Feedback Workspace"))</li>
                            <li>@Html.Raw(NavLink("/Supervisor/Meetings", "calendar-event", "Meetings"))</li>
                            <li>@Html.Raw(NavLink("/Supervisor/Evaluations", "star-half", "Evaluations"))</li>
                            <li>@Html.Raw(NavLink("/Supervisor/ProgressTracking", "graph-up-arrow", "Progress Tracking"))</li>

                        }
                        @if (role == "admin")
                        {
                            <li><span class="side-nav-label">Administration</span></li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/Dashboard",
                                        "speedometer2",
                                        "Dashboard"))
                            </li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/Users",
                                        "people",
                                        "Users"))
                            </li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/Projects",
                                        "folder2-open",
                                        "Projects"))
                            </li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/Analytics",
                                        "bar-chart",
                                        "Analytics"))
                            </li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/SupervisorAssignments",
                                        "person-check",
                                        "Supervisor Assignments"))
                            </li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/Admin/IdeaGenerationKnowledgeBase",
                                        "lightbulb",
                                        "Idea Generation Context"))
                            </li>

                            @if (isMainAdmin)
                            {
                                <li>
                                    @Html.Raw(
                                        NavLink(
                                            "/Admin/AdminAccounts",
                                            "person-gear",
                                            "Manage Administrators"))
                                </li>
                            }

                            <li><span class="side-nav-label">System</span></li>

                            <li>
                                @Html.Raw(
                                    NavLink(
                                        "/SystemTest",
                                        "pc-display",
                                        "System Status"))
                            </li>
                        }
                    </ul>
                </div>
            </aside>

            <div class="app-main flex-grow-1 d-flex flex-column min-w-0">

                <header class="app-topbar
                    @(role == "student" &&
                      studentProjectSwitcherItems.Count > 0
                        ? "has-project-switcher"
                        : "")">
                    <div class="d-flex align-items-center gap-3 min-w-0">

                        <button class="btn mobile-menu-btn d-lg-none"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#appSidebar"
                                aria-controls="appSidebar"
                                aria-label="Open menu">
                            <i class="bi bi-list"></i>
                        </button>

                        @if (role == "student" && path.Equals("/Student/Dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="page-heading dashboard-top-heading">
                                <h6 class="mb-0">
                                    Welcome, @userName!
                                </h6>
                            </div>
                        }
                        else
                        {
                            <div class="page-heading">
                                <h6 class="mb-0">@ViewData["Title"]</h6>

                                @if (ViewData["Subtitle"] is string sub)
                                {
                                    <div class="page-subtitle">@sub</div>
                                }
                            </div>
                        }
                    </div>


                    @if (role == "student" &&
                         studentProjectSwitcherItems.Count > 0)
                    {
                        var activeProjectItem =
                            activeProjectId.HasValue
                                ? studentProjectSwitcherItems
                                    .FirstOrDefault(project =>
                                        project.Id ==
                                            activeProjectId.Value)
                                : default;

                        var activeProjectTitle =
                            activeProjectItem.Id > 0
                                ? activeProjectItem.Title
                                : "Choose a project";

                        <div class="dropdown topbar-project-switcher">
                            <button type="button"
                                    class="topbar-project-trigger"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                    aria-label="Switch active project">

                                <span class="topbar-project-trigger-icon">
                                    <i class="bi bi-folder2-open"></i>
                                </span>

                                <span class="topbar-project-trigger-copy">
                                    <small>Active project</small>
                                    <strong title="@activeProjectTitle">
                                        @activeProjectTitle
                                    </strong>
                                </span>

                                <span class="topbar-project-count"
                                      title="Accessible projects">
                                    @studentProjectSwitcherItems.Count
                                </span>

                                <i class="bi bi-chevron-down topbar-project-chevron"></i>
                            </button>

                            <div class="dropdown-menu topbar-project-menu">
                                <div class="topbar-project-menu-head">
                                    <div>
                                        <span>Project switcher</span>
                                        <strong>Enter another workspace</strong>
                                        <small>
                                            Selecting a project uses the same secure
                                            flow as Continue Project.
                                        </small>
                                    </div>

                                    <div class="topbar-project-menu-total">
                                        @studentProjectSwitcherItems.Count
                                    </div>
                                </div>

                                <div class="topbar-project-options">
                                    @foreach (var project
                                        in studentProjectSwitcherItems)
                                    {
                                        var isActiveProject =
                                            activeProjectId.HasValue &&
                                            project.Id ==
                                                activeProjectId.Value;

                                        var roleLabel =
                                            string.Equals(
                                                project.Role,
                                                "owner",
                                                StringComparison.OrdinalIgnoreCase)
                                                ? "Owner"
                                                : "Collaborator";

                                        <form method="post"
                                              asp-page="/Student/MyProjects"
                                              asp-page-handler="OpenProject"
                                              class="topbar-project-option-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="projectId"
                                                   value="@project.Id" />

                                            <input type="hidden"
                                                   name="requestedPage"
                                                   value="@projectSwitcherDestination" />

                                            <button type="submit"
                                                    class="topbar-project-option @(isActiveProject ? "is-active" : "")"
                                                    title="Open @project.Title">

                                                <span class="topbar-project-option-icon">
                                                    <i class="bi @(isActiveProject ? "bi-lightning-charge-fill" : "bi-folder2")"></i>
                                                </span>

                                                <span class="topbar-project-option-copy">
                                                    <strong>@project.Title</strong>
                                                    <small title="@project.IdeaTitle">
                                                        @project.IdeaTitle
                                                    </small>
                                                </span>

                                                <span class="topbar-project-option-meta">
                                                    @if (isActiveProject)
                                                    {
                                                        <span class="topbar-project-active-label">
                                                            <i class="bi bi-circle-fill"></i>
                                                            Active
                                                        </span>
                                                    }

                                                    <span class="topbar-project-role">
                                                        @roleLabel
                                                    </span>
                                                </span>
                                            </button>
                                        </form>
                                    }
                                </div>

                                <div class="topbar-project-menu-footer">
                                    <a asp-page="/Student/MyProjects"
                                       class="topbar-project-manage-link">
                                        <i class="bi bi-grid"></i>
                                        Manage all projects
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="topbar-actions">
                        <div class="dropdown topbar-notification">
                            <button type="button"
                                    class="topbar-notification-trigger"
                                    id="notificationBellButton"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                    aria-label="Open notifications">
                                <i class="bi bi-bell"></i>

                                <span class="topbar-notification-badge @(unreadNotificationCount == 0 ? "is-empty" : "")"
                                      id="notificationUnreadBadge">
                                    @(unreadNotificationCount > 99
                                        ? "99+"
                                        : unreadNotificationCount.ToString())
                                </span>
                            </button>

                            <div class="dropdown-menu dropdown-menu-end topbar-notification-menu">
                                <div class="topbar-notification-head">
                                    <div>
                                        <strong>Notifications</strong>
                                        <small>Latest project and account updates</small>
                                    </div>

                                    <span class="topbar-notification-head-count"
                                          id="notificationUnreadHeaderCount">
                                        @unreadNotificationCount
                                    </span>
                                </div>

                                <div class="topbar-notification-list"
                                     id="topbarNotificationList">
                                    @if (topbarNotifications.Count == 0)
                                    {
                                        <div class="topbar-notification-empty"
                                             id="topbarNotificationEmpty">
                                            <i class="bi bi-bell-slash"></i>
                                            No notifications yet.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var notification in topbarNotifications)
                                        {
                                            <form method="post"
                                                  asp-page="/Notifications/Index"
                                                  asp-page-handler="Open"
                                                  class="topbar-notification-item-form">
                                                <input type="hidden"
                                                       name="notificationId"
                                                       value="@notification.Id" />

                                                <button type="submit"
                                                        class="topbar-notification-item @(!notification.IsRead ? "is-unread" : "")">
                                                    <span class="topbar-notification-item-icon">
                                                        <i class="bi bi-bell"></i>
                                                    </span>

                                                    <span class="topbar-notification-item-copy">
                                                        <strong>@notification.Title</strong>
                                                        <span>@notification.Message</span>
                                                        <small class="topbar-notification-time"
                                                               data-created-at="@notification.CreatedAt.ToString("O")">
                                                            @notification.CreatedAt.ToString("dd MMM, HH:mm") UTC
                                                        </small>
                                                    </span>

                                                    @if (!notification.IsRead)
                                                    {
                                                        <span class="topbar-notification-unread-dot"
                                                              aria-label="Unread"></span>
                                                    }
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>

                                <div class="topbar-notification-footer">
                                    <a asp-page="/Notifications/Index"
                                       class="topbar-notification-all">
                                        <i class="bi bi-list-check"></i>
                                        View all notifications
                                    </a>
                                </div>
                            </div>
                        </div>

                        @if (role == "student")
                        {
                            <button type="button"
                                    class="topbar-tour-launch"
                                    id="startStudentTourButton"
                                    title="Open the FYPilot guided journey">
                                <i class="bi bi-compass"></i>
                                <span class="d-none d-md-inline">Guided Tour</span>
                            </button>
                        }

                        <form method="post" asp-page="/Account/Logout" class="d-none d-sm-block">
                            <button type="submit" class="topbar-logout">
                                <i class="bi bi-box-arrow-right me-1"></i>
                                Logout
                            </button>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(topbarProfileHref))
                        {
                            <a href="@topbarProfileHref" class="topbar-user topbar-user-link" title="Open Profile">
                                @if (!string.IsNullOrWhiteSpace(navProfileImagePath))
                                {
                                    <img src="@navProfileImagePath"
                                         alt="@userName"
                                         class="topbar-avatar-img" />
                                }
                                else
                                {
                                    <div class="topbar-avatar">@initials</div>
                                }

                                <div class="d-none d-xl-block">
                                    <div class="topbar-user-name">@userName</div>
                                    <div class="topbar-user-meta text-capitalize">@role</div>
                                </div>

                                <i class="bi bi-chevron-down topbar-user-arrow d-none d-xl-inline"></i>
                            </a>
                        }
                        else
                        {
                            <div class="topbar-user">
                                <div class="topbar-avatar">@initials</div>

                                <div class="d-none d-xl-block">
                                    <div class="topbar-user-name">@userName</div>
                                    <div class="topbar-user-meta text-capitalize">@role</div>
                                </div>
                            </div>
                        }
                    </div>
                </header>
                <main class="app-content flex-grow-1 overflow-auto">
                    <partial name="_FlashMessages" />

                    @if (role == "student" &&
                         isArchivedProjectContext &&
                         archivedProjectContextId.HasValue)
                    {
                        <section class="archived-project-readonly-banner"
                                 role="status"
                                 aria-label="Archived project read-only notice">

                            <div class="archived-project-readonly-icon">
                                <i class="bi bi-lock-fill"></i>
                            </div>

                            <div class="archived-project-readonly-copy">
                                <strong>
                                    Archived Project — Read Only
                                </strong>

                                <span>
                                    You can review this project, but changes are disabled
                                    until you restore it from Archived Projects.
                                </span>
                            </div>

                            <a asp-page="/Student/ArchivedProjects"
                               class="archived-project-readonly-link">
                                <i class="bi bi-archive"></i>
                                Open Archive
                            </a>
                        </section>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    @if (isAuth && role == "student")
    {
        <partial name="_StudentOnboardingTour" />
        <partial name="_AiAgentProgress" />
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/student-onboarding-tour.js"
            asp-append-version="true"></script>
    <script src="~/js/ai-agent-progress.js"
            asp-append-version="true"></script>

  


    @if (isAuth)
    {
        <script>
            (function () {
                "use strict";

                const badge =
                    document.getElementById("notificationUnreadBadge");
                const headerCount =
                    document.getElementById("notificationUnreadHeaderCount");
                const list =
                    document.getElementById("topbarNotificationList");

                function updateCount(nextCount) {
                    const safeCount = Math.max(0, Number(nextCount) || 0);

                    if (badge) {
                        badge.textContent = safeCount > 99
                            ? "99+"
                            : String(safeCount);
                        badge.classList.toggle("is-empty", safeCount === 0);
                    }

                    if (headerCount) {
                        headerCount.textContent = String(safeCount);
                    }
                }

                function currentCount() {
                    if (!headerCount) {
                        return 0;
                    }

                    return Number(headerCount.textContent) || 0;
                }

                function escapeHtml(value) {
                    const element = document.createElement("div");
                    element.textContent = value || "";
                    return element.innerHTML;
                }

                function localTime(value) {
                    const date = new Date(value);

                    if (Number.isNaN(date.getTime())) {
                        return "Just now";
                    }

                    return date.toLocaleString([], {
                        dateStyle: "medium",
                        timeStyle: "short"
                    });
                }

                document
                    .querySelectorAll(".topbar-notification-time")
                    .forEach(function (element) {
                        element.textContent = localTime(
                            element.dataset.createdAt);
                    });

                function showToast(notification) {
                    const toast = document.createElement("div");
                    toast.className = "fypilot-notification-toast";
                    toast.innerHTML =
                        "<strong>" + escapeHtml(notification.title) + "</strong>" +
                        "<span>" + escapeHtml(notification.message) + "</span>";

                    document.body.appendChild(toast);

                    window.requestAnimationFrame(function () {
                        toast.classList.add("is-visible");
                    });

                    window.setTimeout(function () {
                        toast.classList.remove("is-visible");

                        window.setTimeout(function () {
                            toast.remove();
                        }, 240);
                    }, 3000);
                }

                function prependNotification(notification) {
                    if (!list) {
                        return;
                    }

                    document
                        .getElementById("topbarNotificationEmpty")
                        ?.remove();

                    const wrapper = document.createElement("div");
                    wrapper.innerHTML =
                        "<a class=\"topbar-notification-item is-unread text-decoration-none\" " +
                        "href=\"/Notifications\">" +
                        "<span class=\"topbar-notification-item-icon\">" +
                        "<i class=\"bi bi-bell\"></i></span>" +
                        "<span class=\"topbar-notification-item-copy\">" +
                        "<strong>" + escapeHtml(notification.title) + "</strong>" +
                        "<span>" + escapeHtml(notification.message) + "</span>" +
                        "<small>" + localTime(notification.createdAt) + "</small>" +
                        "</span>" +
                        "<span class=\"topbar-notification-unread-dot\"></span>" +
                        "</a>";

                    list.prepend(wrapper.firstElementChild);

                    while (list.children.length > 6) {
                        list.lastElementChild?.remove();
                    }
                }

                if (!window.signalR) {
                    return;
                }

                const connection =
                    new signalR.HubConnectionBuilder()
                        .withUrl("/hubs/notifications")
                        .withAutomaticReconnect()
                        .build();

                connection.on(
                    "ReceiveNotification",
                    function (notification) {
                        updateCount(currentCount() + 1);
                        prependNotification(notification);
                        showToast(notification);
                    });

                connection.start().catch(function (error) {
                    console.warn(
                        "Notification connection could not start.",
                        error);
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>