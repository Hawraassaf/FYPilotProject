@page
@model FYPilot.Web.Pages.Account.VerifySupervisorApplicationModel
@{
    Layout = null;
    ViewData["Title"] = "Verify Supervisor Application";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Verify Supervisor Application — FYPilot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
            :root {
                --navy: #0f172a;
                --navy-medium: #17345f;
                --navy-light: #245a9b;
                --surface: #f8fafc;
                --muted: #64748b;
                --border: #d8dee8;
                --page-background: linear-gradient( 135deg, #0f172a 0%, #17345f 55%, #245a9b 100%);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            }

            .verification-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
                background: var(--page-background);
            }

            .verification-card {
                width: 100%;
                max-width: 520px;
                padding: 2.75rem 3rem;
                border: 1px solid rgba(255, 255, 255, 0.22);
                border-radius: 26px;
                background: var(--surface);
                box-shadow: 0 30px 85px rgba(2, 6, 23, 0.36);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
            }

            .brand-logo {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                flex-shrink: 0;
                border-radius: 17px;
                background: var(--page-background);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
            }

                .brand-logo img {
                    width: 44px;
                    height: 44px;
                    object-fit: contain;
                }

            .brand-name {
                color: var(--navy);
                font-size: 1.8rem;
                font-weight: 850;
                line-height: 1;
            }

            .verification-icon {
                width: 76px;
                height: 76px;
                display: grid;
                place-items: center;
                margin: 1.5rem auto 1.25rem;
                color: #ffffff;
                border-radius: 24px;
                background: var(--page-background);
                box-shadow: 0 16px 34px rgba(23, 52, 95, 0.24);
            }

                .verification-icon i {
                    font-size: 2rem;
                }

            .page-title {
                color: var(--navy);
                font-size: 1.65rem;
                font-weight: 800;
            }

            .page-description {
                max-width: 390px;
                margin: 0 auto;
                color: var(--muted);
                line-height: 1.65;
            }

            .email-chip {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                margin-top: 0.65rem;
                padding: 0.48rem 0.8rem;
                color: var(--navy-medium);
                border: 1px solid #cbd5e1;
                border-radius: 999px;
                background: #ffffff;
                font-size: 0.85rem;
                font-weight: 750;
            }

            .code-label {
                color: var(--navy);
            }

            .code-input {
                min-height: 62px;
                padding-left: 1.1rem;
                color: var(--navy);
                border: 1px solid var(--border);
                border-radius: 16px;
                background: #ffffff;
                font-size: 1.65rem;
                font-weight: 800;
                letter-spacing: 0.55rem;
                text-align: center;
            }

                .code-input::placeholder {
                    color: #a8b1bf;
                    letter-spacing: 0.35rem;
                }

                .code-input:focus {
                    border-color: var(--navy-medium);
                    box-shadow: 0 0 0 0.22rem rgba(23, 52, 95, 0.14);
                }

            .code-help {
                color: var(--muted);
                font-size: 0.78rem;
            }

            .btn-verify {
                min-height: 51px;
                color: #ffffff;
                border: 0;
                border-radius: 14px;
                background: var(--page-background);
                box-shadow: 0 14px 30px rgba(23, 52, 95, 0.22);
                transition: transform 0.18s ease, box-shadow 0.18s ease;
            }

                .btn-verify:hover,
                .btn-verify:focus {
                    color: #ffffff;
                    transform: translateY(-1px);
                    box-shadow: 0 18px 36px rgba(23, 52, 95, 0.28);
                }

            .btn-resend {
                min-height: 48px;
                color: var(--navy-medium);
                border: 1px solid #cbd5e1;
                border-radius: 14px;
                background: #ffffff;
                font-weight: 750;
            }

                .btn-resend:hover,
                .btn-resend:focus {
                    color: var(--navy);
                    border-color: #94a3b8;
                    background: #f1f5f9;
                }

            .security-note {
                display: flex;
                align-items: flex-start;
                gap: 0.65rem;
                margin-top: 1.35rem;
                padding: 0.85rem 0.95rem;
                color: #475569;
                border: 1px solid #dbe3ec;
                border-radius: 14px;
                background: #f1f5f9;
                font-size: 0.78rem;
                line-height: 1.55;
            }

                .security-note i {
                    margin-top: 0.08rem;
                    color: var(--navy-medium);
                }

            .auth-link {
                color: var(--navy-medium);
                text-decoration: none;
                font-weight: 700;
            }

                .auth-link:hover {
                    color: var(--navy);
                    text-decoration: underline;
                }

            .alert {
                border-radius: 14px;
                font-size: 0.86rem;
            }

            @@media (max-width: 575px) {
                .verification-card {
                    padding: 1.55rem;
                    border-radius: 20px;
                }

                .brand-logo {
                    width: 48px;
                    height: 48px;
                }

                    .brand-logo img {
                        width: 39px;
                        height: 39px;
                    }

                .brand-name {
                    font-size: 1.55rem;
                }

                .verification-icon {
                    width: 68px;
                    height: 68px;
                    border-radius: 21px;
                }

                .page-title {
                    font-size: 1.45rem;
                }

                .code-input {
                    font-size: 1.4rem;
                    letter-spacing: 0.42rem;
                }
            }
    </style>
</head>

<body>
    <main class="verification-wrapper">
        <section class="verification-card"
                 aria-labelledby="verification-title">

            <header class="text-center">
                <div class="brand">
                    <div class="brand-logo">
                        <img src="/image/FYPilot_logo.png"
                             alt="FYPilot Logo" />
                    </div>

                    <div class="brand-name">FYPilot</div>
                </div>

                <div class="verification-icon"
                     aria-hidden="true">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>

                <h1 id="verification-title"
                    class="page-title mb-2">
                    Verify your Supervisor application
                </h1>

                <p class="page-description">
                    Enter the six-digit code we sent to
                    <span class="d-block">
                        <span class="email-chip">
                            <i class="bi bi-envelope"></i>
                            @Model.MaskedEmail
                        </span>
                    </span>
                </p>
            </header>

            <div class="mt-4">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success"
                         role="status">
                        <i class="bi bi-check-circle me-1"></i>
                        @successMessage
                    </div>
                }

                @if (TempData["Info"] is string infoMessage)
                {
                    <div class="alert alert-info"
                         role="status">
                        <i class="bi bi-info-circle me-1"></i>
                        @infoMessage
                    </div>
                }

                @if (TempData["Error"] is string temporaryError)
                {
                    <div class="alert alert-danger"
                         role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @temporaryError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger"
                         role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @Model.ErrorMessage
                    </div>
                }
            </div>

            <form method="post"
                  class="mt-4"
                  novalidate>
                <input type="hidden"
                       asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Code"
                           class="form-label code-label fw-semibold">
                        Verification code
                    </label>

                    <input asp-for="Code"
                           class="form-control code-input"
                           type="text"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           placeholder="000000"
                           aria-describedby="code-help"
                           autofocus />

                    <div id="code-help"
                         class="code-help mt-2 text-center">
                        The code expires after 10 minutes and can be
                        used only once.
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit"
                            asp-page-handler="Verify"
                            class="btn btn-verify fw-semibold">
                        <i class="bi bi-shield-check me-2"></i>
                        Verify Email
                    </button>
                </div>

                <div class="text-center my-3 text-muted small">
                    Did not receive the code?
                </div>

                <div class="d-grid">
                    <button type="submit"
                            asp-page-handler="Resend"
                            class="btn btn-resend"
                            formnovalidate>
                        <i class="bi bi-arrow-clockwise me-2"></i>
                        Resend Code
                    </button>
                </div>
            </form>

            <div class="security-note">
                <i class="bi bi-lock-fill"></i>

                <span>
                    Never share this code. FYPilot will not ask for
                    your verification code outside this page.
                </span>
            </div>

            <div class="text-center small text-muted mt-4">
                Return to

                <a asp-page="/Account/Login"
                   class="auth-link">
                    Sign in
                </a>
            </div>
        </section>
    </main>

    <script>
            (() => {
                const codeInput =
                    document.getElementById("Code");

                if (!codeInput) {
                    return;
                }

                codeInput.addEventListener("input", () => {
                    codeInput.value =
                        codeInput.value
                            .replace(/\D/g, "")
                            .slice(0, 6);
                });

                codeInput.addEventListener("paste", event => {
                    const pastedText =
                        event.clipboardData
                            ?.getData("text") ?? "";

                    const digits =
                        pastedText
                            .replace(/\D/g, "")
                            .slice(0, 6);

                    if (digits.length > 0) {
                        event.preventDefault();
                        codeInput.value = digits;
                        codeInput.dispatchEvent(
                            new Event("input"));
                    }
                });
            })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
