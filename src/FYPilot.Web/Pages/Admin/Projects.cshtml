@page
@model FYPilot.Web.Pages.Admin.ProjectsModel
@{
    ViewData["Title"] = "Project Directory";
    ViewData["Subtitle"] =
        "Review active and historical projects, memberships, and supervision";
}

<section class="apd-page">
    <header class="apd-hero">
        <div>
            <span class="apd-kicker">
                Administration · Project oversight
            </span>

            <h1>All Project Workspaces</h1>

            <p>
                Review every project created in FYPilot. Open a
                project row to see its official idea, current team,
                lifecycle history, and supervisor assignment.
            </p>
        </div>

        <div class="apd-hero-summary">
            <span>Active workspaces</span>
            <strong>@Model.Stats.ActiveProjects</strong>
            <small>
                @Model.Stats.TotalProjects total records
                · @Model.Stats.SoftDeletedProjects soft-deleted
            </small>
        </div>
    </header>

    <section class="apd-stats"
             aria-label="Project directory statistics">
        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div>
                <span>Total Projects</span>
                <strong>@Model.Stats.TotalProjects</strong>
                <small>Active and historical records</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-lightbulb"></i>
            </div>

            <div>
                <span>Official Ideas</span>
                <strong>@Model.Stats.WithSelectedIdea</strong>
                <small>Projects with a selected idea</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Collaborative</span>
                <strong>@Model.Stats.CollaborativeProjects</strong>
                <small>Projects with collaborators</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-person-check"></i>
            </div>

            <div>
                <span>Supervised</span>
                <strong>@Model.Stats.WithAssignedSupervisor</strong>
                <small>Active supervisor assignments</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-archive"></i>
            </div>

            <div>
                <span>Personal Archives</span>
                <strong>@Model.Stats.ArchivedMemberships</strong>
                <small>Active members with read-only workspaces</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-person-x"></i>
            </div>

            <div>
                <span>Removed Memberships</span>
                <strong>@Model.Stats.RemovedMemberships</strong>
                <small>Former access retained as history</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <div>
                <span>Soft Deleted</span>
                <strong>@Model.Stats.SoftDeletedProjects</strong>
                <small>Preserved projects outside active work</small>
            </div>
        </article>

        <article>
            <div class="apd-stat-icon">
                <i class="bi bi-arrow-left-right"></i>
            </div>

            <div>
                <span>Ownership Transfers</span>
                <strong>@Model.Stats.OwnershipTransferProjects</strong>
                <small>Projects with retained transfer history</small>
            </div>
        </article>
    </section>

    <section class="apd-directory">
        <header class="apd-directory-head">
            <div>
                <span class="apd-kicker">
                    Project directory
                </span>

                <h2>Ownership, team, and lifecycle structure</h2>

                <p>
                    Projects are numbered in creation order.
                    Select the arrow to open the full information.
                </p>
            </div>

            <span class="apd-result-count"
                  id="apdResultCount">
                @Model.Projects.Count
                @(Model.Projects.Count == 1
                    ? "project"
                    : "projects")
            </span>
        </header>

        <div class="apd-toolbar">
            <label class="apd-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="apdSearch"
                       placeholder="Search project, owner, collaborator, supervisor..."
                       autocomplete="off" />
            </label>

            <label class="apd-filter">
                <span class="visually-hidden">
                    Filter by project status
                </span>

                <select id="apdStatusFilter">
                    <option value="all">
                        All project statuses
                    </option>

                    @foreach (var status
                        in Model.AvailableStatuses)
                    {
                        <option value="@status.Value">
                            @status.Label
                        </option>
                    }
                </select>

                <i class="bi bi-chevron-down"></i>
            </label>

            <label class="apd-filter">
                <span class="visually-hidden">
                    Filter by lifecycle state
                </span>

                <select id="apdLifecycleFilter">
                    <option value="all">
                        All lifecycle states
                    </option>
                    <option value="active">
                        Active workspaces
                    </option>
                    <option value="archived">
                        Personal archives present
                    </option>
                    <option value="removed">
                        Removed membership history
                    </option>
                    <option value="transferred">
                        Ownership transferred
                    </option>
                    <option value="soft_deleted">
                        Soft-deleted projects
                    </option>
                </select>

                <i class="bi bi-chevron-down"></i>
            </label>

            <label class="apd-filter">
                <span class="visually-hidden">
                    Filter by supervisor status
                </span>

                <select id="apdSupervisorFilter">
                    <option value="all">
                        All supervisor statuses
                    </option>
                    <option value="assigned">
                        Assigned
                    </option>
                    <option value="pending">
                        Pending approval
                    </option>
                    <option value="unassigned">
                        Not assigned
                    </option>
                </select>

                <i class="bi bi-chevron-down"></i>
            </label>
        </div>

        @if (!Model.Projects.Any())
        {
            <div class="apd-empty">
                <div>
                    <i class="bi bi-folder-x"></i>
                </div>

                <h2>No projects have been created yet</h2>

                <p>
                    Projects will appear here immediately after
                    students create their workspaces.
                </p>
            </div>
        }
        else
        {
            <div class="apd-list"
                 id="apdProjectList">

                @foreach (var project
                    in Model.Projects)
                {
                    var supervisorFilter =
                        project.HasActiveSupervisor
                            ? "assigned"
                            : project.SupervisorStatus
                                is "pending_admin"
                                or "requested"
                                    ? "pending"
                                    : "unassigned";

                    var detailsId =
                        $"apd-project-details-{project.ProjectId}";

                    <article class="apd-project-card
                        @(project.IsDeleted
                                 ? "is-soft-deleted"
                                 : "")"
                             data-project-card
                             data-status="@project.Status"
                             data-lifecycle="@project.LifecycleFilterValue"
                             data-supervisor-status="@supervisorFilter"
                             data-search="@project.SearchText">

                        <button type="button"
                                class="apd-project-toggle"
                                data-project-toggle
                                aria-expanded="false"
                                aria-controls="@detailsId">

                            <span class="apd-project-number">
                                @project.DisplayNumber
                            </span>

                            <span class="apd-project-heading">
                                <small>
                                    Project #@project.DisplayNumber
                                </small>

                                <strong title="@project.Title">
                                    @project.Title
                                </strong>

                                <span>
                                    <i class="bi bi-tag"></i>
                                    @project.Domain
                                </span>
                            </span>

                            <span class="apd-project-summary">
                                @if (project.IsDeleted)
                                {
                                    <span class="apd-lifecycle-badge
                                        is-deleted">
                                        <i class="bi bi-trash3"></i>
                                        Soft Deleted
                                    </span>
                                }
                                else
                                {
                                    <span class="apd-status
                                        @project.StatusCssClass">
                                        @project.StatusLabel
                                    </span>
                                }

                                @if (!project.IsDeleted &&
                                     project.ArchivedMembers.Any())
                                {
                                    <span class="apd-lifecycle-badge
                                        is-archived">
                                        <i class="bi bi-archive"></i>
                                        @project.ArchivedMembers.Count archived
                                    </span>
                                }

                                <span>
                                    <i class="bi bi-people"></i>
                                    @project.ActiveMemberCount
                                    /@project.MaximumMembers
                                </span>
                            </span>

                            <i class="bi bi-chevron-down
                                apd-chevron">
                            </i>
                        </button>

                        <div class="apd-project-details"
                             id="@detailsId"
                             data-project-details
                             hidden>

                            @if (project.IsDeleted ||
                                 project.ArchivedMembers.Any() ||
                                 project.RemovedMembers.Any() ||
                                 project.HasOwnershipTransfer)
                            {
                                <section class="apd-lifecycle-notice
                                    @(project.IsDeleted
                                             ? "is-deleted"
                                             : "")">
                                    <div class="apd-lifecycle-notice-icon">
                                        <i class="bi
                                            @(project.IsDeleted
                                               ? "bi-shield-lock"
                                               : "bi-clock-history")">
                                        </i>
                                    </div>

                                    <div>
                                        <strong>
                                            @(project.IsDeleted
                                                ? "Read-only historical project"
                                                : "Lifecycle oversight")
                                        </strong>

                                        @if (project.IsDeleted)
                                        {
                                            <p>
                                                Soft-deleted by
                                                <b>@project.DeletedByName</b>
                                                @(project.DeletedAtUtc.HasValue
                                                    ? $"on {project.DeletedAtUtc.Value.ToLocalTime():dd MMM yyyy, h:mm tt}"
                                                    : ""). All project records remain preserved.
                                            </p>
                                        }
                                        else
                                        {
                                            <p>
                                                The shared project remains active.
                                                Personal archives are read-only only
                                                for the members who archived them.
                                            </p>
                                        }
                                    </div>

                                    <div class="apd-lifecycle-notice-tags">
                                        @if (project.ArchivedMembers.Any())
                                        {
                                            <span class="is-archived">
                                                @project.ArchivedMembers.Count
                                                archived
                                            </span>
                                        }

                                        @if (project.RemovedMembers.Any())
                                        {
                                            <span class="is-removed">
                                                @project.RemovedMembers.Count
                                                removed
                                            </span>
                                        }

                                        @if (project.HasOwnershipTransfer)
                                        {
                                            <span class="is-transfer">
                                                Ownership changed
                                            </span>
                                        }
                                    </div>
                                </section>
                            }

                            <section class="apd-idea">
                                <div>
                                    <span>
                                        Official selected idea
                                    </span>

                                    <strong>
                                        @project.SelectedIdeaTitle
                                    </strong>
                                </div>

                                @if (!project.HasSelectedIdea)
                                {
                                    <small>
                                        The project does not have an
                                        official selected idea yet.
                                    </small>
                                }
                                else
                                {
                                    <small>
                                        @project.Description
                                    </small>
                                }
                            </section>

                            <div class="apd-people-grid">
                                <section class="apd-person-panel">
                                    <header>
                                        <span class="apd-panel-icon">
                                            <i class="bi bi-crown"></i>
                                        </span>

                                        <div>
                                            <small>Project owner</small>
                                        </div>
                                    </header>

                                    <div class="apd-contact">
                                        <span class="apd-avatar">
                                            @project.OwnerInitials
                                        </span>

                                        <div>
                                            <strong>
                                                @project.OwnerName
                                            </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(
                                                    project.OwnerEmail)
                                                    ? "Email unavailable"
                                                    : project.OwnerEmail)
                                            </span>
                                        </div>
                                    </div>

                                    @if (project.OwnerIsArchived)
                                    {
                                        <div class="apd-member-state
                                            is-archived">
                                            <i class="bi bi-archive"></i>
                                            Owner workspace archived
                                            @(project.OwnerArchivedAtUtc.HasValue
                                                ? $"· {project.OwnerArchivedAtUtc.Value.ToLocalTime():dd MMM yyyy}"
                                                : "")
                                        </div>
                                    }
                                    else if (!project.OwnerMembershipIsActive)
                                    {
                                        <div class="apd-member-state
                                            is-removed">
                                            <i class="bi bi-person-x"></i>
                                            Owner membership is no longer active
                                            @(project.OwnerRemovedAtUtc.HasValue
                                                ? $"· {project.OwnerRemovedAtUtc.Value.ToLocalTime():dd MMM yyyy}"
                                                : "")
                                        </div>
                                    }
                                </section>

                                <section class="apd-person-panel">
                                    <header>
                                        <span class="apd-panel-icon">
                                            <i class="bi bi-people"></i>
                                        </span>

                                        <div>
                                            <small>
                                                Active collaborators
                                            </small>

                                            <strong>
                                                @project.Collaborators.Count
                                                @(project.Collaborators.Count == 1
                                                    ? "member"
                                                    : "members")
                                            </strong>
                                        </div>
                                    </header>

                                    @if (!project.Collaborators.Any())
                                    {
                                        <div class="apd-person-empty">
                                            <i class="bi bi-person-dash"></i>
                                            Owner-only project
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="apd-collaborators">
                                            @foreach (var member
                                                in project.Collaborators)
                                            {
                                                <div class="apd-collaborator"
                                                     title="@member.Email">
                                                    <span>
                                                        @member.Initials
                                                    </span>

                                                    <div>
                                                        <strong>
                                                            @member.FullName
                                                        </strong>

                                                        <small>
                                                            @member.Email
                                                        </small>

                                                        @if (member.IsArchived)
                                                        {
                                                            <em class="apd-inline-state
                                                                is-archived">
                                                                <i class="bi bi-archive"></i>
                                                                Personal workspace archived
                                                            </em>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>

                                <section class="apd-person-panel
                                    apd-supervisor-panel">
                                    <header class="apd-supervisor-head">
                                        <span class="apd-panel-icon">
                                            <i class="bi bi-person-check"></i>
                                        </span>

                                        <div>
                                            <small>
                                                Assigned supervisor
                                            </small>
                                        </div>

                                        @if (!project.IsDeleted)
                                        {
                                            <a asp-page="/Admin/SupervisorAssignments"
                                               class="apd-manage-link"
                                               title="Manage supervisor assignment">
                                                <i class="bi bi-person-gear"></i>
                                                <span>Manage</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="apd-readonly-label">
                                                <i class="bi bi-lock"></i>
                                                Read-only
                                            </span>
                                        }
                                    </header>

                                    <div class="apd-supervisor-state">
                                        <span class="apd-supervisor-badge
                                            @project.SupervisorStatusCssClass">
                                            <i class="bi
                                                @(project.HasActiveSupervisor
                                                  ? "bi-check-circle"
                                                  : project.SupervisorStatus
                                                      is "pending_admin"
                                                      or "requested"
                                                      ? "bi-hourglass-split"
                                                      : "bi-dash-circle")">
                                            </i>

                                            @project.SupervisorStatusLabel
                                        </span>

                                        <strong>
                                            @project.SupervisorName
                                        </strong>

                                        @if (project.HasActiveSupervisor &&
                                             !string.IsNullOrWhiteSpace(
                                                 project.SupervisorEmail))
                                        {
                                            <small>
                                                @project.SupervisorEmail
                                            </small>
                                        }
                                    </div>
                                </section>
                            </div>

                            @if (project.ArchivedMembers.Any() ||
                                 project.RemovedMembers.Any())
                            {
                                <div class="apd-lifecycle-grid">
                                    <section class="apd-lifecycle-panel">
                                        <header>
                                            <span>
                                                <i class="bi bi-archive"></i>
                                            </span>

                                            <div>
                                                <small>Personal archives</small>
                                                <strong>
                                                    @project.ArchivedMembers.Count
                                                    active membership@(project.ArchivedMembers.Count == 1 ? "" : "s")
                                                </strong>
                                            </div>
                                        </header>

                                        @if (!project.ArchivedMembers.Any())
                                        {
                                            <p class="apd-lifecycle-empty">
                                                No active member has archived this project.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="apd-lifecycle-members">
                                                @foreach (var member
                                                    in project.ArchivedMembers)
                                                {
                                                    <div>
                                                        <span class="apd-mini-avatar">
                                                            @member.Initials
                                                        </span>

                                                        <p>
                                                            <strong>@member.FullName</strong>
                                                            <small>
                                                                @member.RoleLabel
                                                                @(member.ArchivedAtUtc.HasValue
                                                                    ? $"· archived {member.ArchivedAtUtc.Value.ToLocalTime():dd MMM yyyy}"
                                                                    : "· archived")
                                                            </small>
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </section>

                                    <section class="apd-lifecycle-panel">
                                        <header>
                                            <span>
                                                <i class="bi bi-person-x"></i>
                                            </span>

                                            <div>
                                                <small>Removed membership history</small>
                                                <strong>
                                                    @project.RemovedMembers.Count
                                                    former member@(project.RemovedMembers.Count == 1 ? "" : "s")
                                                </strong>
                                            </div>
                                        </header>

                                        @if (!project.RemovedMembers.Any())
                                        {
                                            <p class="apd-lifecycle-empty">
                                                No removed membership history.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="apd-lifecycle-members">
                                                @foreach (var member
                                                    in project.RemovedMembers)
                                                {
                                                    <div>
                                                        <span class="apd-mini-avatar">
                                                            @member.Initials
                                                        </span>

                                                        <p>
                                                            <strong>@member.FullName</strong>
                                                            <small>
                                                                Access removed
                                                                @(member.RemovedAtUtc.HasValue
                                                                    ? $"· {member.RemovedAtUtc.Value.ToLocalTime():dd MMM yyyy}"
                                                                    : "")
                                                            </small>
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </section>
                                </div>
                            }

                            @if (project.LifecycleActivities.Any())
                            {
                                <section class="apd-history">
                                    <header>
                                        <div>
                                            <span class="apd-panel-icon">
                                                <i class="bi bi-clock-history"></i>
                                            </span>

                                            <div>
                                                <small>Lifecycle history</small>
                                                <strong>
                                                    Archive, restore, removal, and ownership events
                                                </strong>
                                            </div>
                                        </div>

                                        <span>
                                            Latest @project.LifecycleActivities.Count
                                        </span>
                                    </header>

                                    <div class="apd-history-list">
                                        @foreach (var activity
                                            in project.LifecycleActivities)
                                        {
                                            <article>
                                                <span class="apd-history-icon
                                                    @activity.CssClass">
                                                    <i class="bi @activity.IconCssClass"></i>
                                                </span>

                                                <div>
                                                    <strong>@activity.Label</strong>
                                                    <p>@activity.Description</p>
                                                </div>

                                                <time datetime="@activity.CreatedAtUtc.ToString("O")">
                                                    @activity.CreatedAtUtc.ToLocalTime().ToDisplayDateTime()
                                                </time>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="apd-filter-empty"
                 id="apdFilterEmpty">
                <div>
                    <i class="bi bi-search"></i>
                </div>

                <h2>No matching projects</h2>

                <p>
                    Change the search phrase or one of the filters.
                </p>
            </div>
        }
    </section>
</section>

@section Head {
    <style>
        :root {
            --apd-deep: #17233F;
            --apd-navy: #28385E;
            --apd-steel: #516C8D;
            --apd-text: #14213A;
            --apd-muted: #6F7D94;
            --apd-border: #E1E7EF;
            --apd-soft: #F5F7FA;
            --apd-green: #168A68;
            --apd-shadow: 0 14px 36px rgba(30, 45, 75, .07);
        }

        .apd-page {
            max-width: 1500px;
            margin: 0 auto;
            padding-bottom: 2rem;
            color: var(--apd-text);
        }

        .apd-hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(230px, .3fr);
            gap: 1rem;
            align-items: center;
            padding: 1.1rem 1.25rem;
            color: #FFFFFF;
            background: radial-gradient( circle at 92% 4%, rgba(255,255,255,.07), transparent 29%), linear-gradient( 128deg, var(--apd-deep), var(--apd-navy) 58%, #405577);
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 21px;
            box-shadow: 0 17px 40px rgba(23,35,63,.17);
        }

        .apd-kicker {
            display: block;
            color: var(--apd-steel);
            font-size: .65rem;
            font-weight: 850;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .apd-hero .apd-kicker {
            color: rgba(255,255,255,.64);
        }

        .apd-hero h1 {
            margin: .23rem 0 0;
            font-size: clamp(1.6rem,3vw,2.25rem);
            font-weight: 900;
            letter-spacing: -.045em;
        }

        .apd-hero p {
            max-width: 800px;
            margin: .42rem 0 0;
            color: rgba(255,255,255,.70);
            font-size: .78rem;
            line-height: 1.5;
        }

        .apd-hero-summary {
            padding: .8rem;
            background: rgba(255,255,255,.065);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 15px;
        }

            .apd-hero-summary span,
            .apd-hero-summary strong,
            .apd-hero-summary small {
                display: block;
            }

            .apd-hero-summary span {
                color: rgba(255,255,255,.60);
                font-size: .6rem;
                font-weight: 800;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .apd-hero-summary strong {
                margin-top: .14rem;
                font-size: 1.65rem;
                font-weight: 900;
                line-height: 1;
            }

            .apd-hero-summary small {
                margin-top: .28rem;
                color: rgba(255,255,255,.66);
                font-size: .63rem;
                line-height: 1.4;
            }

        .apd-stats {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: .75rem;
            margin-top: .8rem;
        }

            .apd-stats article {
                display: grid;
                grid-template-columns: auto minmax(0,1fr);
                gap: .65rem;
                align-items: center;
                min-height: 82px;
                padding: .8rem;
                background: #FFFFFF;
                border: 1px solid var(--apd-border);
                border-radius: 15px;
                box-shadow: var(--apd-shadow);
            }

        .apd-stat-icon,
        .apd-panel-icon {
            display: grid;
            place-items: center;
            color: var(--apd-navy);
            background: #EEF2F6;
        }

        .apd-stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
        }

        .apd-stats span,
        .apd-stats strong,
        .apd-stats small {
            display: block;
        }

        .apd-stats span {
            color: var(--apd-muted);
            font-size: .61rem;
            font-weight: 800;
            text-transform: uppercase;
        }

