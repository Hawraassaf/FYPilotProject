@page
@model FYPilot.Web.Pages.Supervisor.ProgressTrackingModel
@{
    ViewData["Title"] = "Progress Tracking";
    ViewData["Subtitle"] = "Monitor shared project progress, milestones, risks, and team updates.";

    var project = Model.SelectedProject;

    var milestonePercent =
        project is not null && project.MilestonesTotal > 0
            ? project.MilestonesCompleted * 100 / project.MilestonesTotal
            : 0;

    var deliverablePercent =
        project is not null && project.DeliverablesTotal > 0
            ? project.DeliverablesSubmitted * 100 / project.DeliverablesTotal
            : 0;

    var elapsedPercent =
        project is not null && project.TotalDays > 0
            ? Math.Min(100, (project.DaysElapsed * 100) / project.TotalDays)
            : 0;
}

<section class="pt-page">

    <header class="pt-page-head">
        <div>
            <span class="pt-eyebrow">Supervisor workspace</span>
            <h1>Progress Tracking</h1>
            <p>Track one project at a time with a clear view of progress, milestones, deadlines, and risks.</p>
        </div>

        <div class="pt-head-actions">
            <form method="get" class="pt-project-switcher">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <select name="projectId"
                        aria-label="Select supervised project"
                        onchange="this.form.submit()">
                    @if (!Model.Projects.Any())
                    {
                        <option>No projects available</option>
                    }
                    else
                    {
                        @foreach (var item in Model.Projects)
                        {
                            <option value="@item.ProjectId"
                                    selected="@(project?.ProjectId == item.ProjectId)">
                                @item.ProjectTitle — @item.OfficialIdeaTitle
                            </option>
                        }
                    }
                </select>
                <i class="bi bi-chevron-down pt-switcher-arrow" aria-hidden="true"></i>
            </form>

            <button type="button"
                    class="pt-btn pt-btn-primary"
                    onclick="window.print()">
                <i class="bi bi-file-earmark-arrow-down"></i>
                Export Report
            </button>
        </div>
    </header>

    @if (project == null)
    {
        <section class="pt-empty">
            <div class="pt-empty-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <span class="pt-eyebrow">Progress tracking</span>
            <h2>No projects to track yet</h2>
            <p>When a supervised project has an official idea, its shared progress view will appear here.</p>

            <a href="/Supervisor/IdeaReview" class="pt-btn pt-btn-primary">
                <i class="bi bi-arrow-right"></i>
                Open Feedback Workspace
            </a>
        </section>
    }
    else
    {
        <section class="pt-project-card">
            <div class="pt-avatar" aria-hidden="true">
                @project.ProjectInitials
            </div>

            <div class="pt-project-copy">
                <div class="pt-title-row">
                    <h2>@project.ProjectName</h2>
                    <span class="pt-domain-chip">@project.Domain</span>
                </div>

                <p class="pt-project-idea">@project.OfficialIdeaTitle</p>

                <div class="pt-meta-row">
                    <span><i class="bi bi-fingerprint"></i>@project.ProjectCode</span>
                    <span><i class="bi bi-calendar3"></i>@project.StartDate.ToString("MMM d, yyyy") – @project.EndDate.ToString("MMM d, yyyy")</span>
                    <span><i class="bi bi-speedometer2"></i>@project.DifficultyLevel</span>
                    <span><i class="bi bi-people"></i>@project.ProjectMemberCount @(project.ProjectMemberCount == 1 ? "member" : "members") · @project.ProjectMembers</span>
                </div>
            </div>

            <div class="pt-project-side">
                <div class="pt-side-block">
                    <span>Supervisor</span>
                    <strong><i class="bi bi-person"></i>@project.SupervisorName</strong>
                </div>

                <div class="pt-side-block">
                    <span>Project Team</span>
                    <strong>
                        <i class="bi bi-people"></i>
                        @project.ProjectMemberCount @(project.ProjectMemberCount == 1 ? "active member" : "active members")
                    </strong>
                </div>

                <div class="pt-side-block">
                    <span>Status</span>
                    <b class="pt-status @project.StatusClass">
                        <i class="bi bi-check-circle"></i>
                        @project.StatusLabel
                    </b>
                </div>
            </div>
        </section>

        <section class="pt-kpi-grid" aria-label="Project progress summary">

            <article class="pt-kpi-card">
                <div class="pt-kpi-top">
                    <span class="pt-kpi-icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <div>
                        <span class="pt-kpi-label">Overall Progress</span>
                        <strong class="pt-kpi-value">@project.OverallProgress%</strong>
                    </div>
                </div>

                <div class="pt-progress">
                    <span style="width:@project.OverallProgress%"></span>
                </div>

                <small class="pt-kpi-foot @project.StatusClass">
                    <i class="bi bi-circle-fill"></i>
                    @project.StatusLabel
                </small>
            </article>

            <article class="pt-kpi-card">
                <div class="pt-kpi-top">
                    <span class="pt-kpi-icon"><i class="bi bi-flag"></i></span>
                    <div>
                        <span class="pt-kpi-label">Milestones Completed</span>
                        <strong class="pt-kpi-value">@project.MilestonesCompleted / @project.MilestonesTotal</strong>
                    </div>
                </div>

                <div class="pt-progress">
                    <span style="width:@milestonePercent%"></span>
                </div>

                <small class="pt-kpi-foot">@milestonePercent% completed</small>
            </article>

            <article class="pt-kpi-card">
                <div class="pt-kpi-top">
                    <span class="pt-kpi-icon"><i class="bi bi-calendar-check"></i></span>
                    <div>
                        <span class="pt-kpi-label">Days Elapsed</span>
                        <strong class="pt-kpi-value">@project.DaysElapsed / @project.TotalDays</strong>
                    </div>
                </div>

                <div class="pt-progress">
                    <span style="width:@elapsedPercent%"></span>
                </div>

                <small class="pt-kpi-foot">@project.DaysRemaining days remaining</small>
            </article>

            <article class="pt-kpi-card">
                <div class="pt-kpi-top">
                    <span class="pt-kpi-icon"><i class="bi bi-file-earmark-text"></i></span>
                    <div>
                        <span class="pt-kpi-label">Deliverables Submitted</span>
                        <strong class="pt-kpi-value">@project.DeliverablesSubmitted / @project.DeliverablesTotal</strong>
                    </div>
                </div>

                <div class="pt-progress">
                    <span style="width:@deliverablePercent%"></span>
                </div>

                <small class="pt-kpi-foot pt-next-due">
                    Next due: @project.NextDue (@project.NextDueDate.ToString("MMM d"))
                </small>
            </article>
        </section>

        <section class="pt-panel pt-roadmap-panel">
            <div class="pt-panel-head">
                <div>
                    <span class="pt-eyebrow">Execution plan</span>
                    <h2><i class="bi bi-map"></i>Project Roadmap</h2>
                </div>

                <a href="/Supervisor/IdeaReview?projectId=@project.ProjectId&ideaId=@project.IdeaId"
                   class="pt-link-btn">
                    View Review Details
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
            </div>

            <div class="pt-roadmap-wrap">
                <div class="pt-roadmap">
                    @foreach (var step in project.Roadmap)
                    {
                        <article class="pt-roadmap-step @step.State">
                            <div class="pt-roadmap-marker">
                                @if (step.State == "completed")
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <span>@step.Number</span>
                                }
                            </div>

                            <div class="pt-step-card">
                                <strong>@step.Title</strong>

                                <div class="pt-step-date">
                                    <i class="bi bi-calendar3"></i>
                                    @step.Date.ToString("MMM d, yyyy")
                                </div>

                                <span class="pt-step-state">@StepLabel(step.State)</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <section class="pt-bottom-grid">

            <article class="pt-panel">
                <div class="pt-panel-head">
                    <div>
                        <span class="pt-eyebrow">Attention required</span>
                        <h2><i class="bi bi-exclamation-triangle"></i>Risks &amp; Blockers</h2>
                    </div>

                    <a href="/Supervisor/IdeaReview?projectId=@project.ProjectId&ideaId=@project.IdeaId"
                       class="pt-link-btn">
                        View All
                    </a>
                </div>

                <div class="pt-risk-list">
                    @if (project.Risks.Any())
                    {
                        @foreach (var risk in project.Risks)
                        {
                            <div class="pt-risk-item">
                                <span class="pt-risk-dot @RiskClass(risk.Severity)"></span>

                                <div class="pt-risk-main">
                                    <div class="pt-risk-title-row">
                                        <h3>@risk.Title</h3>
                                        <span class="pt-severity @RiskClass(risk.Severity)">@risk.Severity</span>
                                    </div>

                                    <p>@risk.Description</p>

                                    <div class="pt-risk-meta">
                                        <span>Identified @risk.IdentifiedOn.ToString("MMM d, yyyy")</span>
                                        <span>Impact: @risk.Impact</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pt-clean-state">
                            <i class="bi bi-check2-circle"></i>
                            <span>No active risks or blockers.</span>
                        </div>
                    }
                </div>

                <div class="pt-panel-footer">
                    <a href="/Supervisor/IdeaReview?projectId=@project.ProjectId&ideaId=@project.IdeaId">
                        <i class="bi bi-plus-lg"></i>
                        Add Guidance
                    </a>
                </div>
            </article>

            <article class="pt-panel">
                <div class="pt-panel-head">
                    <div>
                        <span class="pt-eyebrow">Latest activity</span>
                        <h2><i class="bi bi-chat-square-text"></i>Shared Project Updates</h2>
                    </div>

                    <a href="/Supervisor/IdeaDiscussion?projectId=@project.ProjectId&ideaId=@project.IdeaId"
                       class="pt-link-btn">
                        Open Discussion
                    </a>
                </div>

                <div class="pt-update-list">
                    @if (project.Updates.Any())
                    {
                        @foreach (var update in project.Updates)
                        {
                            <div class="pt-update-item">
                                <span class="pt-update-icon">
                                    <i class="@update.Icon"></i>
                                </span>

                                <div class="pt-update-copy">
                                    <h3>@update.Title</h3>
                                    <p>@update.Date.ToString("MMM d, yyyy") · @update.Type</p>
                                    <small>@update.Subtitle</small>
                                </div>

                                <span class="pt-update-by">by @update.By</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pt-clean-state">
                            <i class="bi bi-chat-square-dots"></i>
                            <span>No shared updates yet.</span>
                        </div>
                    }
                </div>

                <div class="pt-panel-footer">
                    <a href="/Supervisor/IdeaDiscussion?projectId=@project.ProjectId&ideaId=@project.IdeaId">
                        <i class="bi bi-plus-lg"></i>
                        Add Update
                    </a>
                </div>
            </article>

        </section>
    }
</section>

@section Head {
<style>
    :root {
        --pt-navy-950: #081a36;
        --pt-navy-900: #0b2854;
        --pt-navy-800: #173d72;
        --pt-navy-700: #28568f;
        --pt-blue-500: #4a79b7;
        --pt-blue-100: #eaf2fb;
        --pt-blue-050: #f6f9fd;
        --pt-bg: #f5f8fc;
        --pt-surface: #ffffff;
        --pt-text: #10213a;
        --pt-muted: #6b7a90;
        --pt-border: #e2e9f2;
        --pt-border-strong: #d4deea;
        --pt-green: #1f7a61;
        --pt-green-bg: #e8f6f1;
        --pt-amber: #a76a15;
        --pt-amber-bg: #fbf5e9;
        --pt-red: #a84646;
        --pt-red-bg: #fbefef;
        --pt-shadow: 0 10px 28px rgba(12, 37, 73, .045);
        --pt-shadow-hover: 0 16px 34px rgba(12, 37, 73, .08);
        --pt-radius: 18px;
    }

    .pt-page {
        max-width: 1540px;
        margin: 0 auto;
        padding: .2rem 0 2rem;
        color: var(--pt-text);
    }

    .pt-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.2rem;
        margin-bottom: 1rem;
    }

    .pt-page-head h1 {
        margin: .15rem 0 0;
        color: var(--pt-navy-950);
        font-size: clamp(1.55rem, 2.4vw, 2rem);
        font-weight: 820;
        letter-spacing: -.04em;
    }

    .pt-page-head p {
        margin: .25rem 0 0;
        color: var(--pt-muted);
        font-size: .86rem;
        line-height: 1.5;
    }

    .pt-eyebrow {
        color: var(--pt-blue-500);
        font-size: .62rem;
        font-weight: 850;
        letter-spacing: .11em;
        text-transform: uppercase;
    }

    .pt-head-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .65rem;
        flex-wrap: wrap;
    }

    .pt-project-switcher {
        position: relative;
        min-width: 330px;
        height: 42px;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: .5rem;
        padding: 0 .72rem;
        background: #fff;
        border: 1px solid var(--pt-border-strong);
        border-radius: 11px;
    }

    .pt-project-switcher > i:first-child {
        color: var(--pt-blue-500);
    }

    .pt-project-switcher select {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        appearance: none;
        color: #475a74;
        background: transparent;
        font-size: .78rem;
        font-weight: 650;
    }

    .pt-switcher-arrow {
        color: #91a0b3;
        font-size: .72rem;
        pointer-events: none;
    }

    .pt-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .62rem .92rem;
        border-radius: 10px;
        border: 1px solid transparent;
        text-decoration: none;
        font-size: .76rem;
        font-weight: 760;
        transition: .18s ease;
    }

    .pt-btn-primary {
        color: #fff;
        background: linear-gradient(135deg, var(--pt-navy-900), var(--pt-navy-800));
        border-color: var(--pt-navy-900);
    }

    .pt-btn-primary:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 9px 22px rgba(11, 40, 84, .14);
    }

    .pt-project-card,
    .pt-kpi-card,
    .pt-panel,
    .pt-empty {
        background: var(--pt-surface);
        border: 1px solid var(--pt-border);
        border-radius: var(--pt-radius);
        box-shadow: var(--pt-shadow);
    }

    .pt-project-card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) minmax(410px, .78fr);
        gap: 1.1rem;
        align-items: center;
        padding: 1.15rem 1.25rem;
        margin-bottom: .9rem;
    }

    .pt-avatar {
        width: 82px;
        height: 82px;
        display: grid;
        place-items: center;
        color: #fff;
        background: linear-gradient(145deg, var(--pt-navy-900), var(--pt-navy-700));
        border-radius: 50%;
        font-size: 1.4rem;
        font-weight: 820;
        box-shadow: 0 12px 26px rgba(11, 40, 84, .16);
    }

    .pt-project-copy {
        min-width: 0;
    }

    .pt-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .55rem;
    }

    .pt-title-row h2 {
        margin: 0;
        color: var(--pt-navy-950);
        font-size: clamp(1.2rem, 1.7vw, 1.55rem);
        font-weight: 820;
        letter-spacing: -.035em;
    }

    .pt-domain-chip {
        display: inline-flex;
        align-items: center;
        padding: .28rem .55rem;
        color: var(--pt-navy-800);
        background: var(--pt-blue-100);
        border: 1px solid #d7e5f5;
        border-radius: 999px;
        font-size: .67rem;
        font-weight: 740;
    }

    .pt-project-idea {
        margin: .36rem 0 0;
        color: #354a65;
        font-size: .94rem;
        font-weight: 650;
    }

    .pt-meta-row {
        margin-top: .72rem;
        display: flex;
        flex-wrap: wrap;
        gap: .55rem 1rem;
    }

    .pt-meta-row span {
        display: inline-flex;
        align-items: center;
        gap: .34rem;
        color: var(--pt-muted);
        font-size: .72rem;
    }

    .pt-meta-row i {
        color: var(--pt-blue-500);
    }

    .pt-project-side {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: stretch;
    }

    .pt-side-block {
        min-width: 0;
        padding: .15rem .95rem;
        border-left: 1px solid var(--pt-border);
    }

    .pt-side-block > span {
        display: block;
        margin-bottom: .38rem;
        color: var(--pt-muted);
        font-size: .68rem;
    }

    .pt-side-block strong {
        display: flex;
        align-items: center;
        gap: .4rem;
        min-width: 0;
        color: var(--pt-navy-950);
        font-size: .78rem;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .pt-side-block strong i {
        color: var(--pt-blue-500);
    }

    .pt-status {
        display: inline-flex;
        align-items: center;
        gap: .32rem;
        width: fit-content;
        max-width: 100%;
        padding: .32rem .55rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 780;
    }

    .pt-status.on-track,
    .pt-kpi-foot.on-track,
    .on-track {
        color: var(--pt-green);
        background: var(--pt-green-bg);
    }

    .pt-status.attention,
    .pt-kpi-foot.attention,
    .attention {
        color: var(--pt-amber);
        background: var(--pt-amber-bg);
    }

    .pt-status.blocked,
    .pt-kpi-foot.blocked,
    .blocked {
        color: var(--pt-red);
        background: var(--pt-red-bg);
    }

    .pt-status.review,
    .pt-kpi-foot.review,
    .review {
        color: var(--pt-navy-700);
        background: var(--pt-blue-100);
    }

    .pt-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: .9rem;
    }

    .pt-kpi-card {
        min-width: 0;
        min-height: 132px;
        padding: .9rem 1rem;
        transition: .18s ease;
    }

    .pt-kpi-card:hover {
        transform: translateY(-2px);
        border-color: #cad8e7;
        box-shadow: var(--pt-shadow-hover);
    }

    .pt-kpi-top {
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .pt-kpi-icon {
        flex: 0 0 auto;
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        color: var(--pt-navy-800);
        background: var(--pt-blue-050);
        border: 1px solid var(--pt-border);
        border-radius: 50%;
        font-size: 1rem;
    }

    .pt-kpi-label {
        display: block;
        color: #455a75;
        font-size: .72rem;
        font-weight: 700;
    }

    .pt-kpi-value {
        display: block;
        margin-top: .18rem;
        color: var(--pt-navy-950);
        font-size: 1.45rem;
        font-weight: 830;
        line-height: 1;
        letter-spacing: -.035em;
    }

    .pt-progress {
        height: 5px;
        margin: .72rem 0 .5rem;
        overflow: hidden;
        background: #e9eef4;
        border-radius: 999px;
    }

    .pt-progress span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--pt-navy-800), var(--pt-blue-500));
        border-radius: inherit;
    }

    .pt-kpi-foot {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        max-width: 100%;
        color: var(--pt-muted);
        font-size: .66rem;
        line-height: 1.35;
    }

    .pt-kpi-foot i {
        font-size: .43rem;
    }

    .pt-next-due {
        display: block;
        overflow-wrap: anywhere;
    }

    .pt-panel {
        overflow: hidden;
        margin-bottom: .9rem;
    }

    .pt-panel-head {
        min-height: 62px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        padding: .82rem 1rem;
        border-bottom: 1px solid var(--pt-border);
    }

    .pt-panel-head h2 {
        margin: .12rem 0 0;
        display: flex;
        align-items: center;
        gap: .5rem;
        color: var(--pt-navy-950);
        font-size: .97rem;
        font-weight: 800;
    }

    .pt-panel-head h2 i {
        color: var(--pt-blue-500);
    }

    .pt-link-btn {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: .36rem;
        padding: .5rem .68rem;
        color: var(--pt-navy-800);
        background: #fff;
        border: 1px solid var(--pt-border-strong);
        border-radius: 9px;
        text-decoration: none;
        font-size: .67rem;
        font-weight: 750;
        transition: .18s ease;
    }

    .pt-link-btn:hover {
        color: var(--pt-navy-950);
        background: var(--pt-blue-050);
        border-color: #c9d8e8;
    }

    .pt-roadmap-wrap {
        overflow-x: auto;
        padding: 1.15rem 1rem 1.25rem;
    }

    .pt-roadmap-wrap::-webkit-scrollbar {
        height: 7px;
    }

    .pt-roadmap-wrap::-webkit-scrollbar-thumb {
        background: #c3cfdd;
        border-radius: 999px;
    }

    .pt-roadmap {
        position: relative;
        min-width: 1040px;
        display: grid;
        grid-template-columns: repeat(7, minmax(130px, 1fr));
        gap: 1rem .75rem;
        padding-top: .55rem;
    }

    .pt-roadmap::before {
        content: "";
        position: absolute;
        top: 20px;
        left: 6.5%;
        right: 6.5%;
        height: 2px;
        background: #d8e0ea;
    }

    .pt-roadmap-step {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .pt-roadmap-marker {
        position: relative;
        z-index: 2;
        width: 30px;
        height: 30px;
        margin: 0 auto -10px;
        display: grid;
        place-items: center;
        color: var(--pt-navy-700);
        background: #fff;
        border: 2px solid #b8c5d5;
        border-radius: 50%;
        font-size: .65rem;
        font-weight: 820;
    }

    .pt-roadmap-step.current .pt-roadmap-marker {
        color: #fff;
        background: var(--pt-navy-800);
        border-color: var(--pt-navy-800);
        box-shadow: 0 0 0 5px #edf3fa;
    }

    .pt-roadmap-step.completed .pt-roadmap-marker {
        color: #fff;
        background: var(--pt-blue-500);
        border-color: var(--pt-blue-500);
    }

    .pt-step-card {
        min-height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 1.25rem .72rem .75rem;
        text-align: center;
        background: #fff;
        border: 1px solid var(--pt-border);
        border-radius: 13px;
        box-shadow: 0 6px 18px rgba(12, 37, 73, .035);
        transition: .18s ease;
    }

    .pt-roadmap-step:hover .pt-step-card {
        transform: translateY(-2px);
        border-color: #c8d6e6;
        box-shadow: 0 10px 24px rgba(12, 37, 73, .07);
    }

    .pt-roadmap-step.current .pt-step-card {
        background: linear-gradient(180deg, #fbfdff, #f3f8fe);
        border-color: #9ec2ec;
    }

    .pt-step-card strong {
        min-width: 0;
        color: var(--pt-navy-950);
        font-size: .71rem;
        font-weight: 760;
        line-height: 1.38;
        overflow-wrap: anywhere;
    }

    .pt-step-date {
        margin-top: auto;
        padding-top: .55rem;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        color: var(--pt-muted);
        font-size: .63rem;
    }

    .pt-step-date i {
        color: var(--pt-blue-500);
    }

    .pt-step-state {
        margin-top: .5rem;
        display: inline-flex;
        padding: .28rem .5rem;
        color: #526379;
        background: #eef2f6;
        border-radius: 999px;
        font-size: .59rem;
        font-weight: 740;
    }

    .pt-roadmap-step.current .pt-step-state {
        color: var(--pt-navy-800);
        background: #dfebfa;
    }

    .pt-roadmap-step.completed .pt-step-state {
        color: var(--pt-green);
        background: var(--pt-green-bg);
    }

    .pt-bottom-grid {
        display: grid;
        grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
        gap: .9rem;
    }

    .pt-risk-list,
    .pt-update-list {
        display: grid;
        gap: .55rem;
        padding: .8rem;
    }

    .pt-risk-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: .65rem;
        padding: .72rem;
        background: #fbfcfe;
        border: 1px solid var(--pt-border);
        border-radius: 11px;
    }

    .pt-risk-dot {
        width: 10px;
        height: 10px;
        margin-top: .28rem;
        border-radius: 50%;
        background: currentColor;
    }

    .pt-risk-main {
        min-width: 0;
    }

    .pt-risk-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .65rem;
    }

    .pt-risk-title-row h3 {
        margin: 0;
        color: var(--pt-navy-950);
        font-size: .76rem;
        font-weight: 760;
    }

    .pt-severity {
        flex: 0 0 auto;
        padding: .22rem .45rem;
        border-radius: 999px;
        font-size: .56rem;
        font-weight: 780;
    }

    .pt-risk-item p {
        margin: .26rem 0 0;
        color: var(--pt-muted);
        font-size: .67rem;
        line-height: 1.45;
    }

    .pt-risk-meta {
        margin-top: .42rem;
        display: flex;
        flex-wrap: wrap;
        gap: .4rem .8rem;
        color: #78869a;
        font-size: .6rem;
    }

    .low {
        color: var(--pt-navy-700);
        background: var(--pt-blue-100);
    }

    .medium {
        color: var(--pt-amber);
        background: var(--pt-amber-bg);
    }

    .high {
        color: var(--pt-red);
        background: var(--pt-red-bg);
    }

    .pt-update-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: .7rem;
        align-items: center;
        padding: .65rem 0;
        border-bottom: 1px solid #edf1f6;
    }

    .pt-update-item:first-child {
        padding-top: .15rem;
    }

    .pt-update-item:last-child {
        border-bottom: 0;
    }

    .pt-update-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        color: var(--pt-navy-700);
        background: var(--pt-blue-050);
        border: 1px solid var(--pt-border);
        border-radius: 50%;
    }

    .pt-update-copy {
        min-width: 0;
    }

    .pt-update-copy h3 {
        margin: 0;
        color: var(--pt-navy-950);
        font-size: .75rem;
        font-weight: 750;
    }

    .pt-update-copy p {
        margin: .16rem 0 0;
        color: #5d6d83;
        font-size: .63rem;
    }

    .pt-update-copy small {
        display: block;
        margin-top: .2rem;
        color: var(--pt-muted);
        font-size: .64rem;
        line-height: 1.35;
    }

    .pt-update-by {
        color: #7a8798;
        font-size: .6rem;
        white-space: nowrap;
    }

    .pt-panel-footer {
        padding: .65rem .9rem;
        border-top: 1px solid var(--pt-border);
    }

    .pt-panel-footer a {
        display: inline-flex;
        align-items: center;
        gap: .36rem;
        color: var(--pt-navy-800);
        text-decoration: none;
        font-size: .67rem;
        font-weight: 750;
    }

    .pt-clean-state {
        min-height: 84px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        color: var(--pt-muted);
        font-size: .7rem;
    }

    .pt-clean-state i {
        color: var(--pt-green);
        font-size: 1rem;
    }

    .pt-empty {
        min-height: 500px;
        display: grid;
        place-items: center;
        align-content: center;
        gap: .55rem;
        padding: 2rem;
        text-align: center;
    }

    .pt-empty-icon {
        width: 66px;
        height: 66px;
        display: grid;
        place-items: center;
        color: var(--pt-navy-700);
        background: var(--pt-blue-050);
        border: 1px solid var(--pt-border);
        border-radius: 18px;
        font-size: 1.6rem;
    }

    .pt-empty h2 {
        margin: .15rem 0 0;
        color: var(--pt-navy-950);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .pt-empty p {
        max-width: 520px;
        margin: 0;
        color: var(--pt-muted);
        font-size: .78rem;
        line-height: 1.55;
    }

    @@media (max-width: 1220px) {
        .pt-project-card {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .pt-project-side {
            grid-column: 1 / -1;
        }

        .pt-side-block:first-child {
            border-left: 0;
            padding-left: 0;
        }

        .pt-kpi-grid,
        .pt-bottom-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .pt-page-head {
            align-items: stretch;
            flex-direction: column;
        }

        .pt-head-actions,
        .pt-project-switcher,
        .pt-btn {
            width: 100%;
        }

        .pt-project-card {
            grid-template-columns: 1fr;
        }

        .pt-avatar {
            width: 68px;
            height: 68px;
        }

        .pt-project-side,
        .pt-kpi-grid,
        .pt-bottom-grid {
            grid-template-columns: 1fr;
        }

        .pt-side-block {
            padding: .6rem 0;
            border-left: 0;
            border-top: 1px solid var(--pt-border);
        }

        .pt-panel-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .pt-link-btn {
            width: 100%;
            justify-content: center;
        }

        .pt-update-item {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .pt-update-by {
            grid-column: 2;
        }
    }

    @@media print {
        .pt-page-head,
        .pt-head-actions,
        .pt-panel-footer {
            display: none !important;
        }

        .pt-page {
            max-width: none;
            padding: 0;
        }

        .pt-project-card,
        .pt-kpi-card,
        .pt-panel {
            box-shadow: none !important;
            break-inside: avoid;
        }

        .pt-roadmap-wrap {
            overflow: visible;
        }

        .pt-roadmap {
            min-width: 0;
        }
    }
</style>
}

@functions {
    private static string StepLabel(string state)
    {
        return state switch
        {
            "completed" => "Completed",
            "current" => "In Progress",
            _ => "Upcoming"
        };
    }

    private static string RiskClass(string severity)
    {
        return severity.Trim().ToLowerInvariant() switch
        {
            "high" => "high",
            "medium" => "medium",
            _ => "low"
        };
    }
}
