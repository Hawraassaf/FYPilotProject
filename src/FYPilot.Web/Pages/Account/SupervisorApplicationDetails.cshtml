@page
@model FYPilot.Web.Pages.Account.SupervisorApplicationDetailsModel
@{
    Layout = null;
    ViewData["Title"] = "Supervisor Application Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Supervisor Application Details — FYPilot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
            :root {
                --navy: #0f172a;
                --navy-medium: #17345f;
                --navy-light: #245a9b;
                --surface: #f8fafc;
                --muted: #64748b;
                --border: #d8dee8;
                --page-background: linear-gradient( 135deg, #0f172a 0%, #17345f 55%, #245a9b 100%);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            }

            .application-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
                background: var(--page-background);
            }

            .application-card {
                width: 100%;
                max-width: 620px;
                padding: 2.5rem 2.75rem;
                border: 1px solid rgba(255, 255, 255, 0.22);
                border-radius: 26px;
                background: var(--surface);
                box-shadow: 0 30px 85px rgba(2, 6, 23, 0.36);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
            }

            .brand-logo {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                flex-shrink: 0;
                border-radius: 17px;
                background: var(--page-background);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
            }

                .brand-logo img {
                    width: 44px;
                    height: 44px;
                    object-fit: contain;
                }

            .brand-name {
                color: var(--navy);
                font-size: 1.8rem;
                font-weight: 850;
                line-height: 1;
            }

            .page-title {
                color: var(--navy);
                font-size: 1.5rem;
                font-weight: 800;
            }

            .page-description {
                max-width: 460px;
                margin: 0 auto;
                color: var(--muted);
                line-height: 1.6;
            }

            .form-label {
                color: var(--navy);
                font-weight: 700;
                font-size: 0.88rem;
            }

            .form-control,
            .form-select {
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 0.6rem 0.85rem;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: var(--navy-medium);
                    box-shadow: 0 0 0 0.2rem rgba(23, 52, 95, 0.14);
                }

            .field-hint {
                color: var(--muted);
                font-size: 0.76rem;
            }

            .btn-submit {
                min-height: 51px;
                color: #ffffff;
                border: 0;
                border-radius: 14px;
                background: var(--page-background);
                box-shadow: 0 14px 30px rgba(23, 52, 95, 0.22);
            }

                .btn-submit:hover,
                .btn-submit:focus {
                    color: #ffffff;
                }

            .alert {
                border-radius: 14px;
                font-size: 0.86rem;
            }

            .auth-link {
                color: var(--navy-medium);
                text-decoration: none;
                font-weight: 700;
            }
    </style>
</head>

<body>
    <main class="application-wrapper">
        <section class="application-card">

            <header class="text-center mb-3">
                <div class="brand">
                    <div class="brand-logo">
                        <img src="/image/FYPilot_logo.png"
                             alt="FYPilot Logo" />
                    </div>

                    <div class="brand-name">FYPilot</div>
                </div>

                <h1 class="page-title mt-3 mb-2">
                    Supervisor Application Details
                </h1>

                <p class="page-description">
                    Your email is verified. A few academic details
                    and your application will be sent for
                    administrator review.
                </p>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" novalidate>
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Input.AcademicTitle"
                           class="form-label">
                        Academic Title
                    </label>

                    <select asp-for="Input.AcademicTitle"
                            class="form-select">
                        <option value="">Select an academic title</option>
                        <option value="Professor">Professor</option>
                        <option value="Associate Professor">Associate Professor</option>
                        <option value="Assistant Professor">Assistant Professor</option>
                        <option value="Lecturer">Lecturer</option>
                        <option value="Instructor">Instructor</option>
                        <option value="Other">Other</option>
                    </select>

                    <span asp-validation-for="Input.AcademicTitle"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.University"
                           class="form-label">
                        University / Institution
                    </label>

                    <input asp-for="Input.University"
                           class="form-control"
                           maxlength="150"
                           placeholder="e.g. American University of Beirut" />

                    <span asp-validation-for="Input.University"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Department"
                           class="form-label">
                        Department / Faculty
                    </label>

                    <input asp-for="Input.Department"
                           class="form-control"
                           maxlength="150"
                           placeholder="e.g. Faculty of Computer Science" />

                    <span asp-validation-for="Input.Department"
                          class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Specialization"
                           class="form-label">
                        Main Specialization / Expertise
                    </label>

                    <input asp-for="Input.Specialization"
                           class="form-control"
                           maxlength="200"
                           placeholder="e.g. Artificial Intelligence and Data Science" />

                    <span asp-validation-for="Input.Specialization"
                          class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ProfessionalProfileUrl"
                           class="form-label">
                        Professional / University Profile URL
                        <span class="field-hint">(optional)</span>
                    </label>

                    <input asp-for="Input.ProfessionalProfileUrl"
                           class="form-control"
                           maxlength="300"
                           placeholder="https://" />

                    <span asp-validation-for="Input.ProfessionalProfileUrl"
                          class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-submit fw-semibold">
                        <i class="bi bi-send-check me-2"></i>
                        Submit Application
                    </button>
                </div>
            </form>

            <div class="text-center small text-muted mt-4">
                Return to

                <a asp-page="/Account/Login" class="auth-link">
                    Sign in
                </a>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
