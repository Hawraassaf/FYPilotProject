        /* =========================================================
           STEP 2 REDESIGN — compact decision list
           Replaces the dense score-card matrix visually.
           ========================================================= */

        .comparison-redesign-panel {
            overflow: hidden;
        }

        .comparison-redesign-panel .matrix-heading {
            margin-bottom: 1rem;
        }

        .priority-panel {
            display: grid;
            grid-template-columns: minmax(250px, .9fr) minmax(420px, 1.35fr);
            gap: .8rem 1.25rem;
            align-items: center;
            padding: 1rem;
            border: 1px solid #DEE5ED;
            border-radius: 16px;
            background: #F8FAFC;
        }

        .priority-copy h3 {
            margin: 0;
            color: #111827;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -.02em;
        }

        .priority-copy p {
            max-width: 560px;
            margin: .3rem 0 0;
            color: #64748B;
            font-size: .7rem;
            line-height: 1.5;
        }

        .priority-controls {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: .55rem;
        }

        .priority-pills {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: .45rem;
        }

        .priority-pill {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .5rem .7rem;
            color: #5F6F84;
            font-size: .67rem;
            font-weight: 800;
            border: 1px solid #D8E0E9;
            border-radius: 11px;
            background: #FFFFFF;
            transition: border-color .15s ease, background .15s ease, color .15s ease, transform .15s ease;
        }

        .priority-pill:hover {
            transform: translateY(-1px);
            color: #28385E;
            border-color: #B9C7D6;
        }

        .priority-pill.active {
            color: #FFFFFF;
            border-color: #28385E;
            background: #28385E;
        }

        .priority-pill .priority-check {
            display: none;
        }

        .priority-pill.active .priority-check {
            display: inline-block;
        }

        .priority-reset {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            flex: 0 0 auto;
            padding: .5rem .65rem;
            color: #516C8D;
            font-size: .64rem;
            font-weight: 800;
            border: 0;
            background: transparent;
        }

        .priority-reset:hover {
            color: #28385E;
        }

        .priority-summary {
            grid-column: 1 / -1;
            padding-top: .7rem;
            color: #748196;
            font-size: .64rem;
            border-top: 1px solid #E5EAF0;
        }

        .priority-summary strong {
            color: #28385E;
        }

        .quick-match-banner {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .85rem;
            margin: .85rem 0;
            padding: .9rem 1rem;
            border: 1px solid #D7E0E9;
            border-radius: 16px;
            background:
                radial-gradient(circle at 92% 10%, rgba(81, 108, 141, .10), transparent 30%),
                linear-gradient(135deg, #F4F7FA 0%, #FFFFFF 76%);
        }

        .quick-match-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            color: #FFFFFF;
            border-radius: 12px;
            background: #28385E;
            box-shadow: 0 8px 18px rgba(40, 56, 94, .15);
        }

        .quick-match-copy .ui-eyebrow {
            margin-bottom: .15rem;
        }

        .quick-match-copy h3 {
            margin: 0;
            color: #111827;
            font-size: .98rem;
            font-weight: 820;
            letter-spacing: -.02em;
        }

        .quick-match-copy p {
            margin: .2rem 0 0;
            color: #64748B;
            font-size: .66rem;
            line-height: 1.45;
        }

        .comparison-list-shell {
            overflow: hidden;
            border: 1px solid #DEE5ED;
            border-radius: 17px;
            background: #FFFFFF;
            box-shadow: 0 8px 22px rgba(40, 56, 94, .04);
        }

        .comparison-list-header {
            display: grid;
            grid-template-columns: minmax(280px, 1.35fr) minmax(430px, 1.55fr) 92px 110px;
            gap: .85rem;
            align-items: center;
            padding: .72rem 1rem;
            color: #6D7A8E;
            font-size: .58rem;
            font-weight: 850;
            letter-spacing: .06em;
            text-transform: uppercase;
            border-bottom: 1px solid #E6EBF1;
            background: #F7F9FC;
        }

        .comparison-list-header span:nth-child(3),
        .comparison-list-header span:nth-child(4) {
            text-align: center;
        }

        .comparison-list {
            display: flex;
            flex-direction: column;
        }

        .comparison-idea-row {
            position: relative;
            border-bottom: 1px solid #E8EDF2;
            background: #FFFFFF;
            transition: background .15s ease, box-shadow .15s ease;
        }

        .comparison-idea-row:last-child {
            border-bottom: 0;
        }

        .comparison-idea-row:hover {
            background: #FBFCFE;
        }

        .comparison-idea-row.best-match {
            background: #F4F7FA;
            box-shadow: inset 4px 0 0 #516C8D;
        }

        .comparison-idea-row.selected {
            background: #F1F4F8;
            box-shadow: inset 4px 0 0 #28385E;
        }

        .comparison-idea-row.selected.best-match {
            background: #EEF2F6;
            box-shadow:
                inset 4px 0 0 #28385E,
                inset 7px 0 0 #A9B8C8;
        }

        .comparison-row-main {
            display: grid;
            grid-template-columns: minmax(280px, 1.35fr) minmax(430px, 1.55fr) 92px 110px;
            gap: .85rem;
