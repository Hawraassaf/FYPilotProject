@page
@model FYPilot.Web.Pages.Student.TeamManagementModel
@{
    ViewData["Title"] = "Project Team";
    ViewData["Subtitle"] =
        "Manage project capacity, members and invitations.";
}

<div class="team-page">

    @if (!string.IsNullOrWhiteSpace(
        Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(
        Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Model.ErrorMessage
        </div>
    }

    <section class="team-project-header">
        <div>
            <span>Project Team</span>
            <h1>@Model.ProjectTitle</h1>

            <p>
                @(Model.IsReadOnly
                    ? "Review project members and invitations in read-only mode."
                    : Model.IsOwner
                        ? "Manage the project capacity and invite registered students."
                        : "View the owner and active project collaborators.")
            </p>
        </div>

        <div class="team-header-actions">
            <a asp-page="/Student/Dashboard"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-primary">

                <i class="bi bi-grid me-1"></i>
                Dashboard
            </a>

            <a asp-page="/Student/MyProjects"
               class="btn btn-outline-primary">

                <i class="bi bi-arrow-left me-1"></i>
                My Projects
            </a>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-md-4">
            <article class="team-stat-card">
                <i class="bi bi-people"></i>

                <div>
                    <span>Active Members</span>

                    <strong>
                        @Model.ActiveMembersCount
                        of
                        @Model.MaximumMembers
                    </strong>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="team-stat-card">
                <i class="bi bi-envelope"></i>

                <div>
                    <span>Pending Invitations</span>
                    <strong>
                        @Model.PendingInvitationsCount
                    </strong>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="team-stat-card">
                <i class="bi bi-person-plus"></i>

                <div>
                    <span>Available Positions</span>
                    <strong>
                        @Model.AvailablePositions
                    </strong>
                </div>
            </article>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-xl-7">
            <section class="team-card">
                <header class="team-card-header">
                    <div>
                        <h2>
                            <i class="bi bi-people-fill"></i>
                            Active Members
                        </h2>

                        <p>
                            Students who currently have access
                            to this project.
                        </p>
                    </div>
                </header>

                <div class="member-list">
                    @foreach (var member
                        in Model.ActiveMembers)
                    {
                        <article class="member-row">
                            <div class="member-avatar">
                                @member.Initials
                            </div>

                            <div class="member-copy">
                                <strong>@member.FullName</strong>
                                <span>@member.Email</span>
                            </div>

                            <div class="member-actions">
                                <div class="member-meta">
                                    <span class="member-role">
                                        @member.Role
                                    </span>

                                    <small>
                                        Joined
                                        @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")
                                    </small>
                                </div>

                                @if (Model.CanManageTeam &&
                                     !string.Equals(
                                         member.Role,
                                         "Owner",
                                         StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post"
                                          asp-page-handler="RemoveCollaborator"
                                          class="remove-member-form"
                                          data-remove-member-form
                                          data-member-name="@member.FullName">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="projectId"
                                               value="@Model.ProjectId" />

                                        <input type="hidden"
                                               name="memberUserId"
                                               value="@member.UserId" />

                                        <button type="submit"
                                                class="remove-member-button">
                                            <i class="bi bi-person-x"></i>
                                            Remove
                                        </button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            @if (Model.IsOwner)
            {
                <section class="team-card mt-4">
                    <header class="team-card-header">
                        <div>
                            <h2>
                                <i class="bi bi-clock-history"></i>
                                Pending Invitations
                            </h2>

                            <p>
                                Pending invitations reserve team
                                positions until accepted, cancelled,
                                rejected or expired.
                            </p>
                        </div>
                    </header>

                    @if (Model.PendingInvitations.Count == 0)
                    {
                        <div class="team-empty">
                            <i class="bi bi-envelope-open"></i>

                            <div>
                                <strong>
                                    No pending invitations
                                </strong>

                                <span>
                                    New invitations will appear here.
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="member-list">
                            @foreach (var invitation
                                in Model.PendingInvitations)
                            {
                                <article class="member-row">
                                    <div class="member-avatar
                                        pending-avatar">
                                        <i class="bi bi-envelope"></i>
                                    </div>

                                    <div class="member-copy">
                                        <strong>
                                            @invitation.InvitedUserName
                                        </strong>

                                        <span>
                                            @invitation.InvitedEmail
                                        </span>
                                    </div>

                                    <div class="invitation-actions">
                                        <small>
                                            Expires
                                            @invitation.ExpiresAt.ToLocalTime().ToString("MMM d")
                                        </small>

                                        @if (Model.CanManageTeam)
                                        {
                                            <form method="post"
                                                  asp-page-handler="CancelInvitation">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="projectId"
                                                       value="@Model.ProjectId" />

                                                <input type="hidden"
                                                       name="invitationId"
                                                       value="@invitation.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm
                                                    btn-outline-danger">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="team-readonly-label">
                                                <i class="bi bi-lock-fill"></i>
                                                Read only
                                            </span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        </div>

        <div class="col-xl-5">
            @if (Model.CanManageTeam)
            {
                <section class="team-card">
                    <header class="team-card-header">
                        <div>
                            <h2>
                                <i class="bi bi-sliders"></i>
                                Collaborator Capacity
                            </h2>

                            <p>
                                The project owner is always included.
                                Choose how many collaborator positions
                                this project needs.
                            </p>
                        </div>
                    </header>

                    <form method="post"
                          asp-page-handler="UpdateCapacity"
                          class="team-form"
                          data-capacity-form>

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="projectId"
                               value="@Model.ProjectId" />

                        <label for="collaboratorCapacity">
                            Number of collaborators needed
                        </label>

                        <div class="capacity-picker">
                            <button type="button"
                                    class="capacity-step"
                                    data-capacity-step="-1"
                                    aria-label="Decrease collaborator capacity">
                                <i class="bi bi-dash-lg"></i>
                            </button>

                            <input id="collaboratorCapacity"
                                   name="collaboratorCapacity"
                                   type="number"
                                   min="0"
                                   max="@Model.MaximumCollaboratorsAllowed"
                                   value="@Model.CollaboratorCapacity"
                                   class="form-control capacity-value"
                                   inputmode="numeric"
                                   required />

                            <button type="button"
                                    class="capacity-step"
                                    data-capacity-step="1"
                                    aria-label="Increase collaborator capacity">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>

                        <div class="capacity-preview">
                            <span>
                                <i class="bi bi-person-fill"></i>
                                1 owner
                            </span>

                            <i class="bi bi-plus"></i>

                            <span>
                                <i class="bi bi-people-fill"></i>
                                <strong data-collaborator-preview>
                                    @Model.CollaboratorCapacity
                                </strong>
                                collaborator(s)
                            </span>

                            <i class="bi bi-arrow-right"></i>

                            <span class="capacity-total">
                                <strong data-total-preview>
                                    @Model.MaximumMembers
                                </strong>
                                total member(s)
                            </span>
                        </div>

                        <small>
                            Choose from 0 to
                            @Model.MaximumCollaboratorsAllowed
                            collaborators. Pending invitations continue
                            to reserve positions.
                        </small>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Save Collaborator Capacity
                        </button>
                    </form>
                </section>

                <section class="team-card mt-4">
                    <header class="team-card-header">
                        <div>
                            <h2>
                                <i class="bi bi-person-plus"></i>
                                Invite Collaborator
                            </h2>

                            <p>
                                Invite an existing registered student
                                account.
                            </p>
                        </div>
                    </header>

                    @if (Model.IsIndividualProject)
                    {
                        <div class="team-info">
                            <i class="bi bi-person"></i>

                            <p>
                                This project currently has no
                                collaborator positions. Increase the
                                collaborator capacity before sending
                                invitations.
                            </p>
                        </div>
                    }
                    else if (Model.AvailablePositions == 0)
                    {
                        <div class="team-info">
                            <i class="bi bi-people-fill"></i>

                            <p>
                                All project positions are currently
                                occupied or reserved by pending
                                invitations.
                            </p>
                        </div>
                    }
                    else
                    {
                        <form method="post"
                              asp-page-handler="Invite"
                              class="team-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="projectId"
                                   value="@Model.ProjectId" />

                            <label for="invitedEmail">
                                Student email
                            </label>

                            <input id="invitedEmail"
                                   name="invitedEmail"
                                   type="email"
                                   class="form-control"
                                   placeholder="student@example.com"
                                   required />

                            <small>
                                @Model.AvailablePositions
                                collaborator position(s) available.
                            </small>

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                <i class="bi bi-send me-1"></i>
                                Send Invitation
                            </button>
                        </form>
                    }
                </section>
            }
            else if (Model.IsReadOnly)
            {
                <section class="team-card">
                    <header class="team-card-header">
                        <div>
                            <h2>
                                <i class="bi bi-lock-fill"></i>
                                Archived Project
                            </h2>

                            <p>
                                Team information remains available
                                in read-only mode.
                            </p>
                        </div>
                    </header>

                    <div class="team-info">
                        <i class="bi bi-archive"></i>

                        <p>
                            Restore this project from Archived Projects
                            before changing capacity, invitations, or members.
                        </p>
                    </div>
                </section>
            }
            else
            {
                <section class="team-card">
                    <header class="team-card-header">
                        <div>
                            <h2>
                                <i class="bi bi-shield-check"></i>
                                Collaborator Access
                            </h2>

                            <p>
                                Your project membership is active.
                            </p>
                        </div>
                    </header>

                    <div class="team-info">
                        <i class="bi bi-info-circle"></i>

                        <p>
                            Only the project owner can change the
                            team capacity or invite other students.
                        </p>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@section Head {
    <style>
        .team-page {
            --team-deep: #071D49;
            --team-navy: #28385E;
            --team-navy-soft: #304163;
            --team-steel: #516C8D;
            --team-border: #E5EAF1;
            --team-muted: #6D7A8D;
            --team-surface: #FFFFFF;
            --team-soft: #F7F8FA;
            --team-green: #047857;
            --team-green-soft: #E9F8F1;
            --team-amber: #B4690E;
            --team-amber-soft: #FFF6E8;
            --team-red: #A33B44;
            position: relative;
            max-width: 1480px;
            margin: 0 auto;
            padding-bottom: 2rem;
            color: #111827;
        }

            .team-page::before {
                content: "";
                position: absolute;
                inset: 90px -20px auto;
                height: 330px;
                z-index: -1;
                pointer-events: none;
                background: radial-gradient( circle at 12% 20%, rgba(81, 108, 141, .10), transparent 27%), radial-gradient( circle at 86% 15%, rgba(4, 120, 87, .07), transparent 22%);
            }

            .team-page .alert {
                display: flex;
                align-items: center;
                margin-bottom: 1rem;
                padding: .9rem 1rem;
                border-radius: 15px;
                border-width: 1px;
                font-size: .76rem;
                font-weight: 700;
                box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
            }

            .team-page .alert-success {
                border-color: #B9E7D1;
                color: #086747;
                background: #ECFAF4;
            }

            .team-page .alert-danger {
                border-color: #F2C5CA;
                color: #9A303A;
                background: #FFF3F4;
            }

        .team-project-header {
            min-height: 190px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1rem;
            padding: 1.7rem 1.8rem;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 25px;
            color: #FFFFFF;
            background: radial-gradient( circle at 80% 8%, rgba(255,255,255,.14), transparent 27%), linear-gradient( 135deg, var(--team-deep) 0%, var(--team-navy) 58%, var(--team-steel) 132%);
            box-shadow: 0 20px 44px rgba(40, 56, 94, .17);
        }

            .team-project-header::before {
                content: "";
                position: absolute;
                width: 190px;
                height: 190px;
                right: 18%;
                bottom: -120px;
                border-radius: 50%;
                background: rgba(255,255,255,.08);
            }

            .team-project-header::after {
                content: "";
                position: absolute;
                width: 105px;
                height: 105px;
                right: -24px;
                top: -34px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,.12);
                background: rgba(255,255,255,.05);
            }

            .team-project-header > div {
                position: relative;
                z-index: 2;
            }

                .team-project-header > div:first-child {
                    max-width: 760px;
                }

            .team-project-header span {
                width: fit-content;
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                padding: .34rem .58rem;
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 999px;
                color: rgba(255,255,255,.78);
                background: rgba(255,255,255,.08);
                font-size: .63rem;
                font-weight: 800;
                letter-spacing: .09em;
                text-transform: uppercase;
                backdrop-filter: blur(8px);
            }

            .team-project-header h1 {
                margin: .65rem 0 .38rem;
                font-size: clamp(1.65rem, 3vw, 2.35rem);
                line-height: 1.08;
                font-weight: 850;
                letter-spacing: -.045em;
            }

            .team-project-header p {
                max-width: 670px;
                margin: 0;
                color: rgba(255,255,255,.72);
                font-size: .78rem;
                line-height: 1.65;
            }

        .team-header-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: .6rem;
        }

            .team-header-actions .btn {
                min-height: 43px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: .62rem .86rem;
                border-radius: 12px;
                font-size: .7rem;
                font-weight: 800;
                transition: transform .16s ease, background .16s ease, border-color .16s ease;
            }

                .team-header-actions .btn:hover {
                    transform: translateY(-1px);
                }

            .team-header-actions .btn-primary {
                border-color: rgba(255,255,255,.16);
                color: var(--team-navy);
                background: #FFFFFF;
                box-shadow: 0 9px 20px rgba(7,29,73,.14);
            }

                .team-header-actions .btn-primary:hover,
                .team-header-actions .btn-primary:focus {
                    border-color: #FFFFFF;
                    color: var(--team-deep);
                    background: #F7F8FA;
                }

            .team-header-actions .btn-outline-primary {
                border-color: rgba(255,255,255,.24);
                color: #FFFFFF;
                background: rgba(255,255,255,.08);
            }

                .team-header-actions .btn-outline-primary:hover,
                .team-header-actions .btn-outline-primary:focus {
                    border-color: rgba(255,255,255,.42);
                    color: #FFFFFF;
                    background: rgba(255,255,255,.15);
                }

        .team-page > .row.g-3 {
            margin-bottom: 1rem !important;
        }

        .team-stat-card {
            min-height: 105px;
            position: relative;
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: 1rem;
            overflow: hidden;
            border: 1px solid var(--team-border);
            border-radius: 18px;
            background: var(--team-surface);
            box-shadow: 0 10px 26px rgba(15,23,42,.05);
            transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
        }

            .team-stat-card::after {
                content: "";
                position: absolute;
                width: 76px;
                height: 76px;
                right: -31px;
                top: -31px;
                border-radius: 50%;
                background: rgba(81,108,141,.06);
            }

            .team-stat-card:hover {
                transform: translateY(-2px);
                border-color: #C8D3E0;
                box-shadow: 0 15px 32px rgba(40,56,94,.08);
            }

            .team-stat-card > i {
                width: 48px;
                height: 48px;
                display: grid;
                flex: 0 0 auto;
                place-items: center;
                border-radius: 15px;
                font-size: 1.08rem;
            }

        .row.g-3 > div:nth-child(1) .team-stat-card > i {
            color: var(--team-navy);
            background: #EEF2F6;
        }

        .row.g-3 > div:nth-child(2) .team-stat-card > i {
            color: var(--team-amber);
            background: var(--team-amber-soft);
        }

        .row.g-3 > div:nth-child(3) .team-stat-card > i {
            color: var(--team-green);
            background: var(--team-green-soft);
        }

        .team-stat-card span,
        .team-stat-card strong {
            display: block;
        }

        .team-stat-card span {
            color: var(--team-muted);
            font-size: .68rem;
            font-weight: 740;
        }

        .team-stat-card strong {
            margin-top: .18rem;
            color: var(--team-navy);
            font-size: 1.18rem;
            line-height: 1.1;
            font-weight: 850;
        }

        .team-card {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--team-border);
            border-radius: 20px;
            background: var(--team-surface);
            box-shadow: 0 12px 30px rgba(15,23,42,.05);
            transition: border-color .16s ease, box-shadow .16s ease;
        }

            .team-card:hover {
                border-color: #CBD5E1;
                box-shadow: 0 16px 36px rgba(40,56,94,.075);
            }

        .team-card-header {
            position: relative;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid #E9EDF3;
            background: radial-gradient( circle at 100% 0%, rgba(81,108,141,.08), transparent 32%), linear-gradient(180deg, #FFFFFF, #FAFBFD);
        }

            .team-card-header::before {
                content: "";
                position: absolute;
                left: 0;
                top: 1rem;
                bottom: 1rem;
                width: 3px;
                border-radius: 999px;
                background: linear-gradient( 180deg, var(--team-navy), var(--team-steel));
            }

            .team-card-header h2 {
                margin: 0;
                color: #1F2F4A;
                font-size: .92rem;
                font-weight: 820;
            }

                .team-card-header h2 i {
                    width: 31px;
                    height: 31px;
                    display: inline-grid;
                    place-items: center;
                    margin-right: .42rem;
                    border-radius: 10px;
                    color: var(--team-navy);
                    background: #EEF2F6;
                    vertical-align: middle;
                }

            .team-card-header p {
                margin: .32rem 0 0 2.72rem;
                color: #7B8798;
                font-size: .65rem;
                line-height: 1.5;
            }

        .member-list {
            display: grid;
        }

        .member-row {
            min-height: 82px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: .8rem;
            padding: .9rem 1rem;
            border-bottom: 1px solid #EDF0F4;
            background: #FFFFFF;
            transition: background .14s ease;
        }

            .member-row:hover {
                background: #FAFBFD;
            }

            .member-row:last-child {
                border-bottom: 0;
            }

        .member-avatar {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border: 3px solid #FFFFFF;
            border-radius: 16px;
            color: #FFFFFF;
            background: linear-gradient( 135deg, var(--team-navy), var(--team-steel));
            box-shadow: 0 7px 16px rgba(40,56,94,.16);
            font-size: .7rem;
            font-weight: 850;
        }

        .pending-avatar {
            color: var(--team-amber);
            background: var(--team-amber-soft);
            box-shadow: none;
        }

        .member-copy {
            min-width: 0;
        }

            .member-copy strong,
            .member-copy span {
                display: block;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .member-copy strong {
                color: #26364F;
                font-size: .76rem;
                font-weight: 800;
            }

            .member-copy span {
                margin-top: .17rem;
                color: #8792A2;
                font-size: .62rem;
            }

        .member-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: .7rem;
        }

        .member-meta,
        .invitation-actions {
            display: grid;
            justify-items: end;
            gap: .32rem;
        }

        .member-role {
            padding: .27rem .52rem;
            border: 1px solid #DCE4ED;
            border-radius: 999px;
            color: var(--team-navy);
            background: #F1F4F8;
            font-size: .58rem;
            font-weight: 800;
            text-transform: capitalize;
        }

        .member-meta small,
        .invitation-actions small {
            color: #929CAB;
            font-size: .57rem;
        }

        .remove-member-form {
            margin: 0;
        }

        .remove-member-button {
            min-height: 35px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .32rem;
            padding: .46rem .66rem;
            border: 1px solid #E4B7BB;
            border-radius: 10px;
            color: var(--team-red);
            background: #FFFFFF;
            font-size: .61rem;
            font-weight: 780;
            white-space: nowrap;
            transition: background .16s ease, border-color .16s ease, transform .16s ease;
        }

            .remove-member-button:hover {
                border-color: #D99CA2;
                color: #8F3038;
                background: #FFF5F5;
                transform: translateY(-1px);
            }

            .remove-member-button:disabled {
                cursor: wait;
                opacity: .7;
                transform: none;
            }

        .team-form {
            display: grid;
            gap: .78rem;
            padding: 1rem;
        }

            .team-form label {
                color: #374B68;
                font-size: .67rem;
                font-weight: 800;
            }

            .team-form small {
                color: #7F8998;
                font-size: .61rem;
            }

            .team-form .form-select,
            .team-form .form-control {
                min-height: 45px;
                border: 1px solid #D9E1EA;
                border-radius: 11px;
                color: #26364F;
                background-color: #FBFCFE;
                font-size: .7rem;
                box-shadow: none;
            }

                .team-form .form-select:focus,
                .team-form .form-control:focus {
                    border-color: var(--team-steel);
                    box-shadow: 0 0 0 3px rgba(81,108,141,.12);
                    background-color: #FFFFFF;
                }

            .team-form .btn-primary {
                min-height: 43px;
                border: 0;
                border-radius: 11px;
                color: #FFFFFF;
                background: linear-gradient( 135deg, var(--team-navy), var(--team-steel));
                box-shadow: 0 8px 18px rgba(40,56,94,.15);
                font-size: .67rem;
                font-weight: 800;
                transition: transform .16s ease, box-shadow .16s ease;
            }

                .team-form .btn-primary:hover,
                .team-form .btn-primary:focus {
                    color: #FFFFFF;
                    background: linear-gradient( 135deg, var(--team-deep), var(--team-navy));
                    transform: translateY(-1px);
                    box-shadow: 0 11px 22px rgba(40,56,94,.20);
                }

        .capacity-picker {
            display: grid;
            grid-template-columns: 45px minmax(0, 1fr) 45px;
            align-items: center;
            gap: .55rem;
        }

        .capacity-step {
            width: 45px;
            height: 45px;
            display: grid;
            place-items: center;
            border: 1px solid #D9E1EA;
            border-radius: 11px;
            color: var(--team-navy);
            background: #F7F9FC;
            font-size: .9rem;
            transition: border-color .16s ease, background .16s ease, transform .16s ease;
        }

            .capacity-step:hover {
                border-color: var(--team-steel);
                background: #EEF2F6;
                transform: translateY(-1px);
            }

        .capacity-value {
            min-height: 52px !important;
            text-align: center;
            font-size: 1rem !important;
            font-weight: 850;
            appearance: textfield;
        }

            .capacity-value::-webkit-inner-spin-button,
            .capacity-value::-webkit-outer-spin-button {
                margin: 0;
                appearance: none;
            }

        .capacity-preview {
            min-height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: .42rem;
            padding: .7rem;
            border: 1px solid #E1E7EF;
            border-radius: 12px;
            color: #66758A;
            background: #F8FAFC;
            font-size: .64rem;
            line-height: 1.4;
        }

            .capacity-preview span {
                display: inline-flex;
                align-items: center;
                gap: .28rem;
            }

            .capacity-preview strong {
                color: var(--team-navy);
                font-weight: 850;
            }

            .capacity-preview > i {
                color: #9AA4B2;
            }

            .capacity-preview .capacity-total {
                padding: .28rem .48rem;
                border-radius: 8px;
                color: #FFFFFF;
                background: linear-gradient( 135deg, var(--team-navy), var(--team-steel));
                font-weight: 750;
            }

                .capacity-preview .capacity-total strong {
                    color: #FFFFFF;
                }

        .team-readonly-label {
            display: inline-flex;
            align-items: center;
            gap: .28rem;
            padding: .3rem .5rem;
            border: 1px solid #d7dee8;
            border-radius: 999px;
            color: #66758a;
            background: #f5f7fa;
            font-size: .55rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .invitation-actions .btn-outline-danger {
            min-height: 34px;
            padding: .42rem .65rem;
            border-radius: 9px;
            font-size: .6rem;
            font-weight: 780;
        }

        .team-empty,
        .team-info {
            min-height: 132px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .75rem;
            margin: .9rem;
            padding: 1rem;
            border: 1px dashed #D7DEE7;
            border-radius: 14px;
            color: #78869A;
            background: #FAFBFD;
        }

            .team-empty > i,
            .team-info > i {
                width: 42px;
                height: 42px;
                display: grid;
                flex: 0 0 auto;
                place-items: center;
                border-radius: 13px;
                color: var(--team-steel);
                background: #EEF2F6;
                font-size: 1.08rem;
            }

            .team-empty strong,
            .team-empty span {
                display: block;
            }

            .team-empty strong {
                color: #3A4B64;
                font-size: .73rem;
            }

            .team-empty span {
                margin-top: .17rem;
                font-size: .62rem;
            }

            .team-info p {
                max-width: 340px;
                margin: 0;
                font-size: .68rem;
                line-height: 1.55;
            }

        @@media (max-width: 767px) {
            .team-project-header {
                min-height: auto;
                align-items: flex-start;
                flex-direction: column;
                padding: 1.3rem;
            }

            .team-header-actions {
                width: 100%;
                justify-content: stretch;
            }

                .team-header-actions .btn {
                    flex: 1;
                }

            .member-row {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .member-actions,
            .invitation-actions {
                grid-column: 2;
            }

            .member-actions {
                align-items: flex-start;
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .member-meta,
            .invitation-actions {
                justify-items: start;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const capacityForm =
                document.querySelector("[data-capacity-form]");

            const capacityInput =
                document.getElementById(
                    "collaboratorCapacity");

            const collaboratorPreview =
                document.querySelector(
                    "[data-collaborator-preview]");

            const totalPreview =
                document.querySelector(
                    "[data-total-preview]");

            function updateCapacityPreview() {
                if (!capacityInput) {
                    return;
                }

                const minimum =
                    Number(capacityInput.min || 0);

                const maximum =
                    Number(capacityInput.max || 20);

                let value =
                    Number.parseInt(
                        capacityInput.value,
                        10);

                if (Number.isNaN(value)) {
                    value = minimum;
                }

                value = Math.min(
                    maximum,
                    Math.max(minimum, value));

                capacityInput.value =
                    value.toString();

                if (collaboratorPreview) {
                    collaboratorPreview.textContent =
                        value.toString();
                }

                if (totalPreview) {
                    totalPreview.textContent =
                        (value + 1).toString();
                }
            }

            document
                .querySelectorAll(
                    "[data-capacity-step]")
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        () => {
                            if (!capacityInput) {
                                return;
                            }

                            const step =
                                Number.parseInt(
                                    button.dataset
                                        .capacityStep ?? "0",
                                    10);

                            const current =
                                Number.parseInt(
                                    capacityInput.value || "0",
                                    10);

                            capacityInput.value =
                                (current + step).toString();

                            updateCapacityPreview();
                        });
                });

            capacityInput?.addEventListener(
                "input",
                updateCapacityPreview);

            capacityForm?.addEventListener(
                "submit",
                updateCapacityPreview);

            updateCapacityPreview();

            document
                .querySelectorAll(
                    "[data-remove-member-form]")
                .forEach(form => {
                    form.addEventListener(
                        "submit",
                        () => {
                            const button =
                                form.querySelector(
                                    "button[type='submit']");

                            if (!button) {
                                return;
                            }

                            button.disabled = true;

                            button.innerHTML = `
                                <span class="spinner-border
                                             spinner-border-sm"
                                      aria-hidden="true">
                                </span>
                                Removing...
                            `;
                        });
                });
        })();
    </script>
}