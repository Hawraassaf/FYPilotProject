@page
@model FYPilot.Web.Pages.Account.SupervisorApplicationPendingModel
@{
    Layout = null;
    ViewData["Title"] = "Application Submitted";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Supervisor Application Submitted — FYPilot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
            :root {
                --navy: #0f172a;
                --navy-medium: #17345f;
                --surface: #f8fafc;
                --muted: #64748b;
                --page-background: linear-gradient( 135deg, #0f172a 0%, #17345f 55%, #245a9b 100%);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            }

            .pending-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
                background: var(--page-background);
            }

            .pending-card {
                width: 100%;
                max-width: 520px;
                padding: 2.75rem 3rem;
                text-align: center;
                border: 1px solid rgba(255, 255, 255, 0.22);
                border-radius: 26px;
                background: var(--surface);
                box-shadow: 0 30px 85px rgba(2, 6, 23, 0.36);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
            }

            .brand-logo {
                width: 54px;
                height: 54px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                flex-shrink: 0;
                border-radius: 17px;
                background: var(--page-background);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
            }

                .brand-logo img {
                    width: 44px;
                    height: 44px;
                    object-fit: contain;
                }

            .brand-name {
                color: var(--navy);
                font-size: 1.8rem;
                font-weight: 850;
                line-height: 1;
            }

            .pending-icon {
                width: 76px;
                height: 76px;
                display: grid;
                place-items: center;
                margin: 1.5rem auto 1.25rem;
                color: #ffffff;
                border-radius: 24px;
                background: var(--page-background);
                box-shadow: 0 16px 34px rgba(23, 52, 95, 0.24);
            }

                .pending-icon i {
                    font-size: 2rem;
                }

            .page-title {
                color: var(--navy);
                font-size: 1.55rem;
                font-weight: 800;
            }

            .page-description {
                margin: 0 auto;
                color: var(--muted);
                line-height: 1.7;
            }

            .auth-link {
                color: var(--navy-medium);
                text-decoration: none;
                font-weight: 700;
            }

                .auth-link:hover {
                    color: var(--navy);
                    text-decoration: underline;
                }
    </style>
</head>

<body>
    <main class="pending-wrapper">
        <section class="pending-card">
            <div class="brand">
                <div class="brand-logo">
                    <img src="/image/FYPilot_logo.png"
                         alt="FYPilot Logo" />
                </div>

                <div class="brand-name">FYPilot</div>
            </div>

            <div class="pending-icon" aria-hidden="true">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <h1 class="page-title mb-3">
                Supervisor Application Submitted
            </h1>

            <p class="page-description">
                Your email has been verified and your Supervisor
                application has been submitted successfully.
            </p>

            <p class="page-description">
                Your application is waiting for administrator review.
            </p>

            <p class="page-description">
                You will receive an email when the application is
                approved or rejected.
            </p>

            <div class="mt-4">
                <a asp-page="/Account/Login" class="auth-link">
                    Return to sign in
                </a>
            </div>
        </section>
    </main>
</body>
</html>
