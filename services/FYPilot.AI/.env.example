DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fyp_platform
SESSION_SECRET=your_jwt_secret_minimum_32_characters_long
OPENAI_API_KEY=sk-your-openai-key-here
PORT=8000

# ── Web search (primary: Brave, fallback: Groq Compound) ─────
# Brave is used ONLY for retrieving live web evidence, never for answer
# generation. If BRAVE_SEARCH_API_KEY is missing or Brave is disabled,
# search falls back to Groq Compound automatically.
BRAVE_SEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_SECONDS=30
BRAVE_SEARCH_MAX_URLS=8
BRAVE_SEARCH_MAX_TOKENS=4096
BRAVE_SEARCH_COUNTRY=
BRAVE_SEARCH_LANGUAGE=en
