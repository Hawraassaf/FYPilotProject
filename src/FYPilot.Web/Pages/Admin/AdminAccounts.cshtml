@page
@model FYPilot.Web.Pages.Admin.AdminAccountsModel
@{
    ViewData["Title"] = "Manage Administrators";
    ViewData["Subtitle"] = "Create, review, and securely remove secondary administrator accounts.";
}

<section class="admin-accounts-page">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success admin-alert" role="alert" data-auto-dismiss="true">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger admin-alert" role="alert" data-auto-dismiss="true">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <header class="admin-accounts-hero">
        <div>
            <span class="admin-eyebrow">Main administrator control</span>
            <h1>Administrator Accounts</h1>
            <p>
                Create secure administrator accounts without changing PostgreSQL manually.
                Every administrator receives a separate identity and the same operational admin role.
            </p>
        </div>

        <div class="admin-hero-stats">
            <div>
                <span>Total administrators</span>
                <strong>@Model.Admins.Count</strong>
            </div>
            <div>
                <span>Next account</span>
                <strong class="next-email">@Model.NextAdminEmail</strong>
            </div>
        </div>
    </header>

    <div class="admin-accounts-grid">
        <article class="admin-create-card">
            <div class="card-heading">
                <div class="heading-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <span>Create account</span>
                    <h2>New Administrator</h2>
                </div>
            </div>

            <form method="post"
                  asp-page-handler="Create"
                  id="createAdminForm"
                  class="admin-create-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary"></div>

                <div class="form-field">
                    <label>Generated email</label>
                    <div class="readonly-email">
                        <i class="bi bi-envelope"></i>
                        <input value="@Model.NextAdminEmail"
                               readonly
                               aria-label="Generated administrator email" />
                    </div>
                    <small>The system generates the next available admin number automatically.</small>
                </div>

                <div class="form-field">
                    <label asp-for="Input.FullName">Display name</label>
                    <input asp-for="Input.FullName"
                           class="form-control"
                           autocomplete="name" />
                    <span asp-validation-for="Input.FullName"
                          class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Input.Password">Temporary password</label>
                    <div class="password-wrap">
                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="new-password" />
                        <button type="button"
                                class="password-toggle"
                                data-target="Input_Password"
                                aria-label="Show or hide password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                    <small>At least 8 characters with uppercase, lowercase, and a number.</small>
                </div>

                <div class="form-field">
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <div class="password-wrap">
                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />
                        <button type="button"
                                class="password-toggle"
                                data-target="Input_ConfirmPassword"
                                aria-label="Show or hide password confirmation">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <div class="security-note">
                    <i class="bi bi-shield-lock-fill"></i>
                    <p>
                        The password is hashed before storage. It cannot be displayed later,
                        so share it securely with the new administrator.
                    </p>
                </div>

                <button type="submit"
                        class="create-admin-button"
                        id="createAdminButton">
                    <i class="bi bi-person-plus"></i>
                    <span>Create Administrator</span>
                </button>
            </form>
        </article>

        <article class="admin-directory-card">
            <div class="directory-heading">
                <div>
                    <span class="admin-eyebrow">Account directory</span>
                    <h2>Current Administrators</h2>
                </div>

                <label class="admin-search">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           id="adminSearch"
                           placeholder="Search name or email..."
                           autocomplete="off" />
                </label>
            </div>

            <div class="admin-list" id="adminList">
                @foreach (var admin in Model.Admins)
                {
                    var searchText = $"{admin.FullName} {admin.Email}".ToLowerInvariant();

                    <div class="admin-row" data-search="@searchText">
                        <div class="admin-avatar">
                            @Initials(admin.FullName)
                        </div>

                        <div class="admin-identity">
                            <div class="admin-name-line">
                                <strong>@admin.FullName</strong>

                                @if (admin.IsMainAdmin)
                                {
                                    <span class="main-admin-badge">
                                        <i class="bi bi-star-fill"></i>
                                        Main Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="regular-admin-badge">Administrator</span>
                                }
                            </div>

                            <span>@admin.Email</span>
                            <small>
                                Created @admin.CreatedAt.ToLocalTime().ToString("MMM d, yyyy • hh:mm tt")
                            </small>
                        </div>

                        <div class="admin-status">
                            <i class="bi bi-check-circle-fill"></i>
                            Active
                        </div>

                        <div class="admin-row-actions">
                            @if (admin.IsMainAdmin)
                            {
                                <span class="protected-admin-state"
                                      title="The main administrator cannot be deleted.">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    Protected
                                </span>
                            }
                            else if (!Model.PermanentDeletionReady)
                            {
                                <span class="deletion-pending"
                                      title="Complete the final database safety stage before enabling permanent deletion.">
                                    <i class="bi bi-database-lock"></i>
                                    DB step pending
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        class="delete-admin-button"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteAdminModal"
                                        data-admin-id="@admin.Id"
                                        data-admin-name="@admin.FullName"
                                        data-admin-email="@admin.Email">
                                    <i class="bi bi-trash3"></i>
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="admin-empty" id="adminSearchEmpty">
                    <i class="bi bi-search"></i>
                    <p>No administrator matches your search.</p>
                </div>
            </div>

            <footer class="directory-footer">
                <i class="bi bi-info-circle"></i>
                <span>
                    The list stays inside a fixed-height scroll area, even when many accounts are created.
                </span>
            </footer>
        </article>
    </div>
</section>

<div class="modal fade"
     id="deleteAdminModal"
     tabindex="-1"
     aria-labelledby="deleteAdminModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-delete-modal">

            <div class="modal-header">
                <div>
                    <span class="admin-eyebrow">Permanent account removal</span>
                    <h2 class="modal-title"
                        id="deleteAdminModalLabel">
                        Delete Administrator
                    </h2>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form method="post"
                  asp-page-handler="Delete"
                  id="deleteAdminForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="DeleteInput.AdminId"
                       id="deleteAdminId" />

                <div class="modal-body">
                    <div class="delete-warning">
                        <i class="bi bi-exclamation-octagon-fill"></i>

                        <div>
                            <strong>
                                This permanently removes login access.
                            </strong>

                            <p>
                                The account for
                                <b id="deleteAdminName">this administrator</b>
                                will be deleted. Historical administrative
                                work must remain in the system.
                            </p>
                        </div>
                    </div>

                    <div class="delete-target-card">
                        <span>Selected administrator</span>
                        <strong id="deleteAdminEmailText"></strong>
                    </div>

                    <div class="form-field">
                        <label asp-for="DeleteInput.ConfirmationEmail">
                            Type the administrator email
                        </label>

                        <input asp-for="DeleteInput.ConfirmationEmail"
                               class="form-control"
                               id="deleteConfirmationEmail"
                               autocomplete="off"
                               placeholder="Enter the exact email shown above" />

                        <small>
                            The email must match exactly before deletion
                            can continue.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="DeleteInput.CurrentPassword">
                            Main administrator password
                        </label>

                        <div class="password-wrap">
                            <input asp-for="DeleteInput.CurrentPassword"
                                   class="form-control"
                                   id="deleteCurrentPassword"
                                   autocomplete="current-password"
                                   placeholder="Confirm your current password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="deleteCurrentPassword"
                                    aria-label="Show or hide current password">

                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <label class="delete-confirm-check">
                        <input asp-for="DeleteInput.ConfirmPermanentDeletion"
                               id="deletePermanentCheck" />

                        <span>
                            I understand that this administrator will lose
                            access permanently and cannot sign in again.
                        </span>
                    </label>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="delete-cancel-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="delete-confirm-button"
                            id="confirmDeleteAdminButton"
                            disabled>
                        <i class="bi bi-trash3-fill"></i>
                        Permanently Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Head {
    <style>
        :root {
            --admin-navy: #28385E;
            --admin-deep: #071D49;
            --admin-steel: #516C8D;
            --admin-border: #E5EAF1;
            --admin-muted: #64748B;
            --admin-soft: #F4F6F9;
            --admin-green: #047857;
            --admin-red: #B42318;
            --admin-red-soft: #FFF1F0;
        }

        .admin-accounts-page {
            max-width: 1450px;
            margin: 0 auto;
            padding-bottom: 1.5rem;
            color: #111827;
        }

        .admin-alert {
            display: flex;
            align-items: center;
            gap: .6rem;
            border: 0;
            border-radius: 16px;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .08);
            transition: opacity .3s ease, transform .3s ease, margin .3s ease, padding .3s ease, max-height .3s ease;
            overflow: hidden;
            max-height: 120px;
        }

            .admin-alert.admin-alert-hiding {
                opacity: 0;
                transform: translateY(-8px);
                margin-top: 0 !important;
                margin-bottom: 0 !important;
                padding-top: 0;
                padding-bottom: 0;
                max-height: 0;
            }

        .admin-accounts-hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(330px, 430px);
            gap: 1.25rem;
            align-items: center;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-radius: 26px;
            color: #fff;
            background: radial-gradient(circle at 88% 18%, rgba(255,255,255,.14), transparent 24%), linear-gradient(135deg, var(--admin-deep), var(--admin-navy) 58%, var(--admin-steel));
            box-shadow: 0 22px 48px rgba(40, 56, 94, .16);
        }

        .admin-eyebrow {
            display: block;
            margin-bottom: .25rem;
            color: var(--admin-steel);
            font-size: .68rem;
            font-weight: 750;
            letter-spacing: .11em;
            text-transform: uppercase;
        }

        .admin-accounts-hero .admin-eyebrow {
            color: rgba(255,255,255,.7);
        }

        .admin-accounts-hero h1 {
            margin: 0;
            font-size: clamp(1.65rem, 3vw, 2.45rem);
            font-weight: 700;
            letter-spacing: -.04em;
        }

        .admin-accounts-hero p {
            max-width: 780px;
            margin: .55rem 0 0;
            color: rgba(255,255,255,.76);
            line-height: 1.65;
            font-size: .9rem;
        }

        .admin-hero-stats {
            display: grid;
            grid-template-columns: .75fr 1.25fr;
            gap: .7rem;
        }

            .admin-hero-stats > div {
                min-height: 88px;
                display: grid;
                align-content: center;
                padding: .85rem;
                border-radius: 18px;
                border: 1px solid rgba(255,255,255,.16);
                background: rgba(255,255,255,.11);
            }

            .admin-hero-stats span {
                color: rgba(255,255,255,.72);
                font-size: .7rem;
            }

            .admin-hero-stats strong {
                margin-top: .22rem;
                color: #fff;
                font-size: 1.45rem;
            }

            .admin-hero-stats .next-email {
                font-size: .94rem;
                overflow-wrap: anywhere;
            }

        .admin-accounts-grid {
            display: grid;
            grid-template-columns: minmax(330px, .72fr) minmax(0, 1.28fr);
            gap: 1rem;
            align-items: stretch;
        }

        .admin-create-card,
        .admin-directory-card {
            background: #fff;
            border: 1px solid var(--admin-border);
            border-radius: 24px;
            box-shadow: 0 14px 34px rgba(15,23,42,.05);
            overflow: hidden;
        }

        .card-heading,
        .directory-heading {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-bottom: 1px solid var(--admin-border);
        }

        .card-heading {
            justify-content: flex-start;
        }

        .heading-icon {
            width: 44px;
            height: 44px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            color: #fff;
            background: var(--admin-navy);
        }

        .card-heading span {
            display: block;
            color: var(--admin-muted);
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            font-weight: 700;
        }

        .card-heading h2,
        .directory-heading h2 {
            margin: .1rem 0 0;
            font-size: 1.05rem;
            font-weight: 750;
        }

        .admin-create-form {
            padding: 1.1rem 1.15rem 1.2rem;
            display: grid;
            gap: .9rem;
        }

        .validation-summary:empty {
            display: none;
        }

        .form-field label {
            display: block;
            margin-bottom: .32rem;
            color: #334155;
            font-size: .76rem;
            font-weight: 700;
        }

        .form-field small {
            display: block;
            margin-top: .28rem;
            color: var(--admin-muted);
            font-size: .68rem;
            line-height: 1.45;
        }

        .form-field .form-control,
        .readonly-email input {
            min-height: 44px;
            border-radius: 12px;
            border-color: #DCE3ED;
            font-size: .84rem;
        }

            .form-field .form-control:focus {
                border-color: var(--admin-steel);
                box-shadow: 0 0 0 .2rem rgba(81,108,141,.14);
            }

        .readonly-email {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: .55rem;
            min-height: 44px;
            padding: 0 .75rem;
            border: 1px solid #DCE3ED;
            border-radius: 12px;
            background: var(--admin-soft);
        }

            .readonly-email i {
                color: var(--admin-steel);
            }

            .readonly-email input {
                width: 100%;
                min-height: 42px;
                padding: 0;
                border: 0;
                outline: 0;
                color: var(--admin-navy);
                background: transparent;
                font-weight: 700;
            }

        .password-wrap {
            position: relative;
        }

            .password-wrap .form-control {
                padding-right: 2.8rem;
            }

        .password-toggle {
            position: absolute;
            right: .45rem;
            top: 50%;
            width: 34px;
            height: 34px;
            transform: translateY(-50%);
            border: 0;
            border-radius: 9px;
            color: var(--admin-steel);
            background: transparent;
        }

        .security-note {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .6rem;
            padding: .75rem;
            border: 1px solid #DCE5F2;
            border-radius: 14px;
            background: #F7F9FC;
        }

            .security-note i {
                color: var(--admin-navy);
            }

            .security-note p {
                margin: 0;
                color: var(--admin-muted);
                font-size: .72rem;
                line-height: 1.55;
            }

        .create-admin-button {
            min-height: 45px;
            border: 0;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            color: #fff;
            background: var(--admin-navy);
            font-size: .82rem;
            font-weight: 750;
            transition: .15s ease;
        }

            .create-admin-button:hover:not(:disabled) {
                background: #344A76;
                transform: translateY(-1px);
            }

            .create-admin-button:disabled {
                opacity: .7;
                cursor: wait;
            }

        .admin-search {
            width: min(300px, 100%);
            min-height: 40px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: .45rem;
            padding: 0 .7rem;
            border: 1px solid #DCE3ED;
            border-radius: 12px;
            background: #F8FAFC;
        }

            .admin-search i {
                color: var(--admin-muted);
            }

            .admin-search input {
                width: 100%;
                border: 0;
                outline: 0;
                background: transparent;
                font-size: .78rem;
            }

        .admin-list {
            height: 455px;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
        }

        .admin-row {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto auto;
            gap: .75rem;
            align-items: center;
            padding: .9rem 1.1rem;
            border-bottom: 1px solid #EDF1F5;
        }

            .admin-row:last-of-type {
                border-bottom: 0;
            }

        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, var(--admin-navy), var(--admin-steel));
            font-size: .74rem;
            font-weight: 800;
        }

        .admin-identity {
            min-width: 0;
        }

        .admin-name-line {
            display: flex;
            align-items: center;
            gap: .45rem;
            flex-wrap: wrap;
        }

            .admin-name-line strong {
                font-size: .87rem;
            }

        .admin-identity > span {
            display: block;
            margin-top: .1rem;
            color: #475569;
            font-size: .76rem;
            overflow-wrap: anywhere;
        }

        .admin-identity small {
            display: block;
            margin-top: .12rem;
            color: #94A3B8;
            font-size: .67rem;
        }

        .main-admin-badge,
        .regular-admin-badge {
            display: inline-flex;
            align-items: center;
            gap: .25rem;
            padding: .24rem .45rem;
            border-radius: 999px;
            font-size: .61rem;
            font-weight: 800;
        }

        .main-admin-badge {
            color: #854D0E;
            background: #FEF3C7;
        }

        .regular-admin-badge {
            color: var(--admin-navy);
            background: #E9EEF6;
        }

        .admin-status {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            color: var(--admin-green);
            font-size: .7rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .admin-row-actions {
            display: flex;
            justify-content: flex-end;
            min-width: 118px;
        }

        .delete-admin-button,
        .protected-admin-state,
        .deletion-pending {
            min-height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            padding: .4rem .62rem;
            border-radius: 10px;
            font-size: .67rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .delete-admin-button {
            color: var(--admin-red);
            background: var(--admin-red-soft);
            border: 1px solid #FFD0CC;
            transition: .15s ease;
        }

            .delete-admin-button:hover {
                color: #fff;
                background: var(--admin-red);
                border-color: var(--admin-red);
                transform: translateY(-1px);
            }

        .protected-admin-state {
            color: var(--admin-navy);
            background: #E9EEF6;
            border: 1px solid #DCE5F2;
        }

        .deletion-pending {
            color: #7C5A10;
            background: #FFF8E7;
            border: 1px solid #F4DF9A;
        }

        .admin-delete-modal {
            overflow: hidden;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 28px 70px rgba(15,23,42,.24);
        }

            .admin-delete-modal .modal-header,
            .admin-delete-modal .modal-footer {
                padding: 1rem 1.1rem;
                border-color: var(--admin-border);
            }

            .admin-delete-modal .modal-title {
                margin: 0;
                color: var(--admin-navy);
                font-size: 1.18rem;
                font-weight: 800;
            }

            .admin-delete-modal .modal-body {
                display: grid;
                gap: .9rem;
                padding: 1.05rem 1.1rem;
            }

        .delete-warning {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .7rem;
            padding: .85rem;
            color: #7A271A;
            background: var(--admin-red-soft);
            border: 1px solid #FFD0CC;
            border-radius: 15px;
        }

            .delete-warning > i {
                margin-top: .1rem;
                color: var(--admin-red);
                font-size: 1.15rem;
            }

            .delete-warning strong,
            .delete-warning p {
                display: block;
            }

            .delete-warning strong {
                font-size: .8rem;
            }

            .delete-warning p {
                margin: .2rem 0 0;
                font-size: .72rem;
                line-height: 1.5;
            }

        .delete-target-card {
            padding: .75rem .8rem;
            border: 1px solid var(--admin-border);
            border-radius: 13px;
            background: #F8FAFC;
        }

            .delete-target-card span,
            .delete-target-card strong {
                display: block;
            }

            .delete-target-card span {
                color: var(--admin-muted);
                font-size: .65rem;
                font-weight: 750;
                text-transform: uppercase;
                letter-spacing: .07em;
            }

            .delete-target-card strong {
                margin-top: .2rem;
                color: var(--admin-navy);
                font-size: .82rem;
                overflow-wrap: anywhere;
            }

        .delete-confirm-check {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
