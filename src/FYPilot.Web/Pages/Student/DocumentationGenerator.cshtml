@page
@using System.Linq
@using Microsoft.AspNetCore.Html
@model FYPilot.Web.Pages.Student.DocumentationGeneratorModel

@{
    ViewData["Title"] = "Software Documentation";

    var docs = Model.GeneratedDocumentation;

    var hasSelectedIdea =
        Model.SelectedProjectIdeaId > 0 &&
        !string.IsNullOrWhiteSpace(Model.Request.ProjectTitle);

    var functionalRequirements = docs?.FunctionalRequirements ?? Enumerable.Empty<string>();
    var nonFunctionalRequirements = docs?.NonFunctionalRequirements ?? Enumerable.Empty<string>();
    var useCases = docs?.UseCases ?? Enumerable.Empty<string>();
    var edgeCases = docs?.EdgeCases ?? Enumerable.Empty<string>();
    var databaseDesign = docs?.DatabaseDesign ?? Enumerable.Empty<string>();
    var uiDesign = docs?.UiDesign ?? Enumerable.Empty<string>();

    var functionalCount = functionalRequirements.Count();
    var nonFunctionalCount = nonFunctionalRequirements.Count();
    var useCaseCount = useCases.Count();
    var edgeCaseCount = edgeCases.Count();
    var databaseCount = databaseDesign.Count();
    var uiCount = uiDesign.Count();

    var totalGeneratedItems =
        functionalCount +
        nonFunctionalCount +
        useCaseCount +
        edgeCaseCount +
        databaseCount +
        uiCount;

    var quality = Model.QualityPanel;
    var provenance = Model.Provenance;

    var semanticReviewCompleted =
        quality?.SemanticReviewCompleted == true;

    var qualityScoreLabel =
        quality?.OverallScore.HasValue == true
            ? $"{quality.OverallScore}/100"
            : "Not available";

    var validationTone =
        quality == null
            ? "neutral"
            : semanticReviewCompleted
                ? "success"
                : "warning";

    var validationLabel =
        quality == null
            ? "No recorded review"
            : semanticReviewCompleted
                ? "Semantic review completed"
                : "Structural validation only";

    var generatedAt =
        quality?.LastGeneratedAt ??
        provenance?.GeneratedAt ??
        docs?.CreatedAt;
}

@section Head {
    <style>
        :root {
            --doc-bg: #f4f7fb;
            --doc-surface: #ffffff;
            --doc-ink: #172033;
            --doc-muted: #697386;
            --doc-line: #e3e9f1;
            --doc-line-strong: #d4dce7;
            --doc-blue: #28385E;
            --doc-blue-2: #516C8D;
            --doc-blue-soft: #EEF2F6;
            --doc-violet-soft: #f3efff;
            --doc-green: #1f8a5b;
            --doc-green-soft: #eaf7f0;
            --doc-amber: #ad7418;
            --doc-amber-soft: #fff7e8;
            --doc-red: #bb4545;
            --doc-red-soft: #fff0f0;
            --doc-radius-xl: 24px;
            --doc-radius-lg: 18px;
            --doc-radius-md: 13px;
            --doc-shadow: 0 14px 40px rgba(23, 32, 51, .065);
        }

        html {
            scroll-behavior: smooth;
        }

        .doc-page {
            max-width: 1540px;
            margin: 0 auto;
            color: var(--doc-ink);
        }

        /* ---------- Top cover ---------- */

        .doc-cover-header {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 1.5rem;
            align-items: center;
            padding: 1.45rem;
            color: #fff;
            background: radial-gradient(circle at 12% 18%, rgba(255,255,255,.18), transparent 28%), radial-gradient(circle at 90% 20%, rgba(255,255,255,.10), transparent 24%), linear-gradient(135deg, #172F59 0%, #28385E 55%, #516C8D 100%);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: var(--doc-radius-xl);
            box-shadow: 0 18px 48px rgba(40, 56, 94, .20);
        }

            .doc-cover-header::after {
                content: "";
                position: absolute;
                right: -80px;
                bottom: -100px;
                width: 300px;
                height: 300px;
                border: 1px solid rgba(255,255,255,.14);
                border-radius: 50%;
                box-shadow: 0 0 0 34px rgba(255,255,255,.045), 0 0 0 74px rgba(255,255,255,.025);
            }

        .doc-cover-copy,
        .doc-cover-badges {
            position: relative;
            z-index: 1;
        }

        .doc-cover-kicker {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            margin-bottom: .45rem;
            color: rgba(255,255,255,.74);
            font-size: .69rem;
            font-weight: 850;
            letter-spacing: .11em;
            text-transform: uppercase;
        }

        .doc-cover-title {
            margin: 0;
            color: #fff;
            font-size: clamp(1.65rem, 3vw, 2.45rem);
            font-weight: 850;
            letter-spacing: -.045em;
        }

        .doc-cover-subtitle {
            max-width: 870px;
            margin: .55rem 0 0;
            color: rgba(255,255,255,.76);
            font-size: .88rem;
            line-height: 1.62;
        }

        .doc-cover-badges {
            display: grid;
            grid-template-columns: repeat(2, minmax(130px, 1fr));
            gap: .65rem;
        }

        .doc-cover-badge {
            padding: .8rem .9rem;
            background: rgba(255,255,255,.11);
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 15px;
        }

            .doc-cover-badge span,
            .doc-cover-badge strong {
                display: block;
            }

            .doc-cover-badge span {
                margin-bottom: .2rem;
                color: rgba(255,255,255,.60);
                font-size: .61rem;
                font-weight: 850;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .doc-cover-badge strong {
                color: #fff;
                font-size: .79rem;
                line-height: 1.35;
            }

        /* ---------- Alerts ---------- */

        .doc-alert {
            display: flex;
            align-items: flex-start;
            gap: .6rem;
            margin-top: .8rem;
            padding: .8rem .95rem;
            border: 1px solid transparent;
            border-radius: var(--doc-radius-md);
            font-size: .82rem;
        }

        .doc-alert-success {
            color: #176844;
            background: var(--doc-green-soft);
            border-color: #cce9da;
        }

        .doc-alert-danger {
            color: #9e3737;
            background: var(--doc-red-soft);
            border-color: #efcccc;
        }

        .doc-alert-info {
            color: #1c4f8c;
            background: #eaf2fd;
            border-color: #cfe1f7;
        }

        .doc-provenance-panel {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem;
            margin-top: .8rem;
            padding: .72rem .9rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-md);
            box-shadow: 0 8px 24px rgba(23, 32, 51, .035);
            font-size: .78rem;
        }

        .doc-provenance-item {
            display: flex;
            flex-direction: column;
            gap: .15rem;
            min-width: 0;
        }

            .doc-provenance-item span {
                color: var(--doc-muted);
                font-size: .68rem;
                text-transform: uppercase;
                letter-spacing: .03em;
            }

            .doc-provenance-item strong {
                color: var(--doc-ink, #172033);
                font-weight: 600;
                overflow-wrap: anywhere;
            }

        .doc-provenance-warning {
            display: flex;
            align-items: center;
            gap: .5rem;
            color: #8a5b12;
            background: #fff6e6;
            border: 1px solid #f4dfad;
            border-radius: var(--doc-radius-sm, 8px);
            padding: .4rem .6rem;
            flex-basis: 100%;
        }

        .doc-review-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            margin-top: .8rem;
            padding: .72rem .9rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-md);
            box-shadow: 0 8px 24px rgba(23, 32, 51, .035);
        }

        .doc-review-copy {
            display: flex;
            align-items: center;
            gap: .55rem;
            min-width: 0;
            color: var(--doc-muted);
            font-size: .74rem;
        }

            .doc-review-copy i {
                color: var(--doc-blue);
                font-size: 1rem;
            }

        /* ---------- Project source bar ---------- */

        .doc-source-bar {
            display: grid;
            grid-template-columns: minmax(250px, .8fr) minmax(0, 1.5fr) auto;
            gap: .85rem;
            align-items: center;
            margin-top: 1rem;
            padding: .9rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-lg);
            box-shadow: var(--doc-shadow);
        }

        .doc-source-control label {
            display: block;
            margin-bottom: .32rem;
            color: var(--doc-ink);
            font-size: .69rem;
            font-weight: 850;
        }

        .doc-source-select {
            min-height: 44px;
            color: var(--doc-ink);
            background-color: #fff;
            border: 1px solid var(--doc-line-strong);
            border-radius: 11px;
            font-size: .79rem;
        }

            .doc-source-select:focus {
                border-color: var(--doc-blue);
                box-shadow: 0 0 0 .2rem rgba(81,108,141,.13);
            }

        .doc-source-project {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: .7rem;
            padding: .68rem .75rem;
            background: #f8faff;
            border: 1px solid #e2e8f8;
            border-radius: 12px;
        }

        .doc-source-icon {
            flex: 0 0 auto;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: var(--doc-blue);
            background: var(--doc-blue-soft);
            border-radius: 11px;
        }

        .doc-source-project h2 {
            margin: 0;
            color: var(--doc-ink);
            font-size: .83rem;
            font-weight: 820;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .doc-source-project p {
            margin: .16rem 0 0;
            color: var(--doc-muted);
            font-size: .64rem;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .doc-generate-btn,
        .doc-print-btn {
            min-height: 43px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: .58rem .85rem;
            border-radius: 11px;
            font-size: .73rem;
            font-weight: 820;
        }

        .doc-generate-btn {
            color: #fff !important;
            background: linear-gradient(135deg, var(--doc-blue), var(--doc-blue-2));
            border: 0;
            box-shadow: 0 10px 20px rgba(40,56,94,.16);
        }

            .doc-generate-btn:hover {
                background: linear-gradient(135deg, #172F59, #405577);
            }

            .doc-generate-btn:disabled {
                opacity: .7;
                cursor: wait;
            }

        .doc-print-btn {
            color: var(--doc-blue);
            background: #fff;
            border: 1px solid var(--doc-line-strong);
        }

            .doc-print-btn:hover {
                color: #2747ad;
                background: var(--doc-blue-soft);
                border-color: #b9c8ef;
            }

        /* ---------- Empty state ---------- */

        .doc-empty {
            min-height: 600px;
            display: grid;
            place-items: center;
            margin-top: 1rem;
            padding: 2rem;
            text-align: center;
            background: radial-gradient(circle at 50% 18%, rgba(49,87,200,.08), transparent 30%), #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-xl);
            box-shadow: var(--doc-shadow);
        }

        .doc-empty-inner {
            max-width: 620px;
        }

        .doc-empty-icon {
            width: 76px;
            height: 76px;
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
            color: var(--doc-blue);
            background: var(--doc-blue-soft);
            border: 1px solid #dae4ff;
            border-radius: 22px;
            font-size: 1.8rem;
        }

        .doc-empty h2 {
            margin: 0;
            color: var(--doc-ink);
            font-size: 1.45rem;
            font-weight: 850;
            letter-spacing: -.035em;
        }

        .doc-empty p {
            margin: .55rem auto 0;
            color: var(--doc-muted);
            font-size: .84rem;
            line-height: 1.65;
        }

        .doc-empty-steps {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .65rem;
            margin-top: 1.2rem;
        }

        .doc-empty-step {
            padding: .8rem;
            text-align: left;
            background: #f8faff;
            border: 1px solid #e4e9f6;
            border-radius: 13px;
        }

            .doc-empty-step span {
                width: 28px;
                height: 28px;
                display: grid;
                place-items: center;
                margin-bottom: .45rem;
                color: #fff;
                background: var(--doc-blue);
                border-radius: 8px;
                font-size: .68rem;
                font-weight: 850;
            }

            .doc-empty-step strong {
                display: block;
                color: var(--doc-ink);
                font-size: .72rem;
            }

            .doc-empty-step p {
                margin: .22rem 0 0;
                font-size: .64rem;
                line-height: 1.45;
            }

        /* ---------- Reader shell ---------- */

        .doc-reader {
            display: grid;
            grid-template-columns: 250px minmax(0, 1fr);
            gap: 1rem;
            align-items: start;
            margin-top: 1rem;
        }

        .doc-reader-sidebar {
            position: sticky;
            top: 92px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-lg);
            box-shadow: var(--doc-shadow);
        }

        .doc-reader-sidebar-head {
            padding: .85rem;
            background: linear-gradient(180deg, #fff, #f8faff);
            border-bottom: 1px solid var(--doc-line);
        }

            .doc-reader-sidebar-head span {
                display: block;
                color: var(--doc-blue);
                font-size: .58rem;
                font-weight: 850;
                letter-spacing: .09em;
                text-transform: uppercase;
            }

            .doc-reader-sidebar-head strong {
                display: block;
                margin-top: .14rem;
                color: var(--doc-ink);
                font-size: .78rem;
            }

        .doc-chapter-nav {
            display: grid;
            gap: .22rem;
            padding: .45rem;
        }

        .doc-chapter-btn {
            width: 100%;
            display: grid;
            grid-template-columns: 30px minmax(0, 1fr) auto;
            align-items: center;
            gap: .5rem;
            padding: .5rem;
            color: var(--doc-muted);
            text-align: left;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 10px;
            cursor: pointer;
        }

            .doc-chapter-btn:hover,
            .doc-chapter-btn.is-active {
                color: var(--doc-blue);
                background: var(--doc-blue-soft);
                border-color: #dae4ff;
            }

        .doc-chapter-btn-number {
            width: 28px;
            height: 28px;
            display: grid;
            place-items: center;
            color: var(--doc-blue);
            background: #f1f4fb;
            border-radius: 8px;
            font-size: .62rem;
            font-weight: 850;
        }

        .doc-chapter-btn.is-active .doc-chapter-btn-number {
            color: #fff;
            background: var(--doc-blue);
        }

        .doc-chapter-btn-copy {
            min-width: 0;
        }

            .doc-chapter-btn-copy strong,
            .doc-chapter-btn-copy small {
                display: block;
            }

            .doc-chapter-btn-copy strong {
                font-size: .68rem;
                line-height: 1.28;
            }

            .doc-chapter-btn-copy small {
                margin-top: .12rem;
                color: var(--doc-muted);
                font-size: .56rem;
            }

        .doc-chapter-btn-count {
            min-width: 24px;
            padding: .15rem .28rem;
            color: var(--doc-blue);
            background: #fff;
            border-radius: 999px;
            text-align: center;
            font-size: .54rem;
            font-weight: 850;
        }

        .doc-reader-main {
            min-width: 0;
        }

        .doc-reader-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            margin-bottom: .7rem;
            padding: .72rem .8rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: 13px;
            box-shadow: 0 8px 24px rgba(23,32,51,.035);
        }

        .doc-reader-toolbar-copy {
            min-width: 0;
        }

            .doc-reader-toolbar-copy span {
                display: block;
                color: var(--doc-blue);
                font-size: .57rem;
                font-weight: 850;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .doc-reader-toolbar-copy h2 {
                margin: .12rem 0 0;
                color: var(--doc-ink);
                font-size: .88rem;
                font-weight: 820;
                overflow-wrap: anywhere;
            }

        .doc-reader-toolbar-actions {
            display: flex;
            align-items: center;
            gap: .45rem;
        }

        .doc-status-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .42rem .62rem;
            color: #176844;
            background: var(--doc-green-soft);
            border: 1px solid #cce9da;
            border-radius: 999px;
            font-size: .65rem;
            font-weight: 820;
        }

        /* ---------- Chapters ---------- */

        .doc-chapter {
            display: none;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: var(--doc-radius-xl);
            box-shadow: var(--doc-shadow);
        }

            .doc-chapter.is-active {
                display: block;
            }

        .doc-chapter-head {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: .8rem;
            align-items: center;
            padding: 1rem;
            color: #fff;
            background: radial-gradient(circle at 88% 15%, rgba(255,255,255,.12), transparent 28%), linear-gradient(135deg, var(--doc-blue), var(--doc-blue-2));
        }

        .doc-chapter-number {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            color: var(--doc-blue);
            background: #fff;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 900;
        }

        .doc-chapter-head h2 {
            margin: 0;
            color: #fff;
            font-size: 1.2rem;
            font-weight: 850;
            letter-spacing: -.03em;
        }

        .doc-chapter-head p {
            margin: .25rem 0 0;
            color: rgba(255,255,255,.73);
            font-size: .72rem;
            line-height: 1.48;
        }

        .doc-simple-box {
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            margin: .9rem;
            padding: .8rem;
            color: #264074;
            background: var(--doc-blue-soft);
            border: 1px solid #dbe4ff;
            border-radius: 13px;
        }

        .doc-simple-box-icon {
            flex: 0 0 auto;
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            color: var(--doc-blue);
            background: #fff;
            border-radius: 9px;
        }

        .doc-simple-box strong {
            display: block;
            margin-bottom: .12rem;
            font-size: .7rem;
        }

        .doc-simple-box p {
            margin: 0;
            color: #52617a;
            font-size: .65rem;
            line-height: 1.45;
        }

        .doc-chapter-body {
            padding: 0 .9rem .9rem;
        }

        .doc-overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(250px, .6fr);
            gap: .75rem;
        }

        .doc-overview-card {
            padding: .85rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: 13px;
        }

            .doc-overview-card span {
                display: block;
                margin-bottom: .25rem;
                color: var(--doc-muted);
                font-size: .58rem;
                font-weight: 850;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .doc-overview-card h3 {
                margin: 0;
                color: var(--doc-ink);
                font-size: .9rem;
                font-weight: 820;
            }

            .doc-overview-card p {
                margin: .3rem 0 0;
                color: var(--doc-muted);
                font-size: .67rem;
                line-height: 1.5;
            }

        .doc-overview-meta {
            display: grid;
            gap: .45rem;
        }

        .doc-meta-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: .6rem;
            padding-bottom: .42rem;
            border-bottom: 1px solid var(--doc-line);
            font-size: .65rem;
        }

            .doc-meta-row:last-child {
                padding-bottom: 0;
                border-bottom: 0;
            }

            .doc-meta-row span {
                color: var(--doc-muted);
            }

            .doc-meta-row strong {
                color: var(--doc-ink);
                text-align: right;
                overflow-wrap: anywhere;
            }

        .doc-stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .55rem;
            margin-top: .75rem;
        }

        .doc-stat-card {
            display: flex;
            align-items: center;
            gap: .55rem;
            padding: .68rem;
            background: #f8faff;
            border: 1px solid #e4e9f6;
            border-radius: 11px;
        }

        .doc-stat-icon {
            flex: 0 0 auto;
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            color: var(--doc-blue);
            background: #fff;
            border-radius: 9px;
        }

        .doc-stat-card strong,
        .doc-stat-card span {
            display: block;
        }

        .doc-stat-card strong {
            color: var(--doc-blue);
            font-size: 1rem;
            font-weight: 900;
            line-height: 1;
        }

        .doc-stat-card span {
            margin-top: .12rem;
            color: var(--doc-muted);
            font-size: .56rem;
            line-height: 1.25;
        }

        .doc-readable-list {
            display: grid;
            gap: .58rem;
        }

        .doc-readable-card {
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr);
            gap: .7rem;
            padding: .78rem;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: 13px;
            transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
        }

            .doc-readable-card:hover {
                transform: translateY(-1px);
                border-color: #cfd9ee;
                box-shadow: 0 8px 22px rgba(23,32,51,.045);
            }

        .doc-readable-label {
            width: 42px;
            min-height: 42px;
            display: grid;
            place-items: center;
            align-self: start;
            color: #fff;
            background: linear-gradient(135deg, var(--doc-blue), var(--doc-blue-2));
            border-radius: 11px;
            font-size: .61rem;
            font-weight: 900;
        }

        .doc-readable-content {
            min-width: 0;
            color: var(--doc-ink);
            font-size: .73rem;
            line-height: 1.62;
            overflow-wrap: anywhere;
        }

            .doc-readable-content::first-line {
                font-weight: 780;
            }

        .doc-code-wrap {
            position: relative;
        }

        .doc-code-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .7rem;
            margin-bottom: .5rem;
        }

            .doc-code-toolbar span {
                color: var(--doc-muted);
                font-size: .64rem;
                font-weight: 750;
            }

        .doc-copy-btn {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .35rem .5rem;
            color: var(--doc-blue);
            background: var(--doc-blue-soft);
            border: 1px solid #dbe4ff;
            border-radius: 8px;
            font-size: .61rem;
            font-weight: 820;
        }

        .doc-code {
            margin: 0;
            padding: .9rem;
            overflow-x: auto;
            color: #e8edff;
            background: #1d2a45;
            border: 1px solid #304164;
            border-radius: 13px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            font-family: "Consolas", "Courier New", monospace;
            font-size: .68rem;
            line-height: 1.62;
        }

        .doc-empty-section {
            padding: .85rem;
            color: var(--doc-muted);
            background: #f8faff;
            border: 1px dashed #cfd8e8;
            border-radius: 12px;
            font-size: .7rem;
        }

        .doc-bottom-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .7rem;
            padding: .8rem .9rem;
            background: #f8faff;
            border-top: 1px solid var(--doc-line);
        }

            .doc-bottom-nav button {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                padding: .42rem .6rem;
                color: var(--doc-blue);
                background: #fff;
                border: 1px solid #d8e0ef;
                border-radius: 9px;
                font-size: .64rem;
                font-weight: 820;
            }

                .doc-bottom-nav button:disabled {
                    opacity: .45;
                    cursor: not-allowed;
                }

            .doc-bottom-nav span {
                color: var(--doc-muted);
                font-size: .61rem;
                font-weight: 760;
            }

        /* ---------- Print cover ---------- */

        .doc-print-cover,
        .doc-print-toc,
        .doc-print-status {
            display: none;
        }

        /* ---------- Loading ---------- */

        .doc-loading {
            position: fixed;
            inset: 0;
            z-index: 2500;
            display: none;
            place-items: center;
            padding: 1rem;
            background: rgba(19, 29, 47, .55);
            backdrop-filter: blur(6px);
        }

            .doc-loading.show {
                display: grid;
            }

        .doc-loading-card {
            width: min(640px, 100%);
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--doc-line);
            border-radius: 19px;
            box-shadow: 0 30px 85px rgba(19,29,47,.28);
        }

        .doc-loading-top {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            padding: 1rem;
        }

        .doc-loading-spinner {
            flex: 0 0 auto;
            width: 40px;
            height: 40px;
            border: 4px solid #e6ebf3;
            border-top-color: var(--doc-blue);
            border-radius: 50%;
            animation: docSpin .8s linear infinite;
        }

        .doc-loading-card h3 {
            margin: 0;
            color: var(--doc-ink);
            font-size: .95rem;
            font-weight: 840;
        }

        .doc-loading-card p {
            margin: .25rem 0 0;
            color: var(--doc-muted);
            font-size: .69rem;
            line-height: 1.45;
        }

        .doc-loading-progress {
            height: 5px;
            overflow: hidden;
            background: #edf1f6;
        }

            .doc-loading-progress div {
                width: 35%;
                height: 100%;
                background: linear-gradient(90deg, var(--doc-blue), var(--doc-blue-2));
                animation: docProgress 1.45s ease-in-out infinite;
            }

        .doc-loading-steps {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .4rem;
            margin: 0;
            padding: .8rem;
            list-style: none;
            background: #f8faff;
            border-top: 1px solid var(--doc-line);
        }

            .doc-loading-steps li {
                display: flex;
                align-items: flex-start;
                gap: .35rem;
                padding: .5rem;
                color: var(--doc-muted);
                background: #fff;
                border: 1px solid var(--doc-line);
                border-radius: 9px;
                font-size: .59rem;
                line-height: 1.35;
            }

                .doc-loading-steps li.is-active {
                    color: var(--doc-blue);
                    background: var(--doc-blue-soft);
                    border-color: #dbe4ff;
                    font-weight: 820;
                }

        @@keyframes docSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes docProgress {
            0% {
                transform: translateX(-110%);
            }

            100% {
                transform: translateX(290%);
            }
        }

        /* ---------- Responsive ---------- */

        @@media (max-width: 1180px) {
            .doc-source-bar {
                grid-template-columns: minmax(250px, .8fr) minmax(0, 1.2fr);
            }

                .doc-source-bar form {
                    grid-column: 1 / -1;
                }

                .doc-source-bar .doc-generate-btn {
                    width: 100%;
                }
        }

        @@media (max-width: 980px) {
            .doc-cover-header {
                grid-template-columns: 1fr;
            }

            .doc-cover-badges {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .doc-source-bar {
                grid-template-columns: 1fr;
            }

                .doc-source-bar form {
                    grid-column: auto;
                }

            .doc-reader {
                grid-template-columns: 1fr;
            }

            .doc-reader-sidebar {
                position: static;
            }

            .doc-chapter-nav {
                grid-auto-flow: column;
                grid-auto-columns: minmax(190px, 1fr);
                overflow-x: auto;
            }

            .doc-reader-toolbar {
                position: sticky;
                top: 0;
                z-index: 10;
            }
        }

        @@media (max-width: 760px) {
            .doc-overview-grid {
                grid-template-columns: 1fr;
            }

            .doc-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .doc-empty-steps {
                grid-template-columns: 1fr;
            }

            .doc-loading-steps {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 560px) {
            .doc-cover-header {
                padding: 1rem;
            }

            .doc-cover-badges {
                grid-template-columns: 1fr;
            }

            .doc-source-bar {
                padding: .75rem;
            }

            .doc-reader-toolbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .doc-reader-toolbar-actions {
                width: 100%;
                flex-wrap: wrap;
            }

            .doc-print-btn {
                flex: 1;
            }

            .doc-chapter-head {
                grid-template-columns: 1fr;
            }

            .doc-readable-card {
                grid-template-columns: 1fr;
            }

            .doc-readable-label {
                width: fit-content;
                min-width: 45px;
                height: 30px;
                min-height: 30px;
                padding: 0 .45rem;
            }

            .doc-stat-grid {
                grid-template-columns: 1fr;
            }

            .doc-loading-steps {
                grid-template-columns: 1fr;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto !important;
            }

            .doc-loading-spinner,
            .doc-loading-progress div {
                animation: none !important;
            }

            .doc-readable-card {
                transition: none !important;
            }
        }

        /* ---------- Print ---------- */

        @@media print {
            @@page {
                size: A4;
                margin: 15mm;
            }

            html,
            body {
                height: auto !important;
                min-height: 0 !important;
            }

                body * {
                    visibility: hidden;
                }

            #se-report,
            #se-report * {
                visibility: visible;
            }

            #se-report {
                position: absolute;
                inset: 0 auto auto 0;
                width: 100%;
                height: auto !important;
                min-height: 0 !important;
                background: #fff;
            }

            .no-print,
            .doc-cover-header,
            .doc-source-bar,
            .doc-reader-sidebar,
            .doc-reader-toolbar,
            .doc-loading,
            .doc-bottom-nav {
                display: none !important;
            }

            .doc-reader {
                display: block;
                margin: 0;
            }

            .doc-reader-main {
                width: 100%;
            }

            .doc-print-cover {
                display: block;
                min-height: 245mm;
                position: relative;
                padding-top: 20mm;
                page-break-after: always;
            }

            .doc-print-cover-kicker {
                color: #28385E;
                font-size: 9pt;
                font-weight: 800;
                letter-spacing: .12em;
                text-transform: uppercase;
            }

            .doc-print-cover h1 {
                max-width: 165mm;
                margin: 8mm 0 4mm;
                color: #172033;
                font-size: 26pt;
                font-weight: 850;
                line-height: 1.15;
            }

            .doc-print-cover h2 {
                margin: 0;
                color: #516C8D;
                font-size: 14pt;
            }

            .doc-print-meta {
                margin-top: 18mm;
                padding-top: 6mm;
                border-top: 1px solid #cfd6df;
            }

                .doc-print-meta div {
                    margin-bottom: 3mm;
                    font-size: 10pt;
                }

            .doc-print-footer {
                position: absolute;
                bottom: 10mm;
                color: #697386;
                font-size: 9pt;
            }

            /* Print/PDF honesty fix: the authoritative review/provenance
               summary -- must survive print even though the interactive
               on-screen .doc-passport panel does not (see the explicit
               ".doc-passport { display: none !important; }" rule further
               below, and the razor comment at this section's markup).
               No background color (browsers may disable background
               printing) -- readable in pure grayscale via the border and
               bold text alone. break-inside/page-break-inside: avoid so it
               is never split across a page boundary. */
            .doc-print-status {
                display: block !important;
                margin-bottom: 10mm;
                padding: 5mm 6mm;
                border: 2px solid #172033;
                break-inside: avoid;
                page-break-inside: avoid;
            }

                .doc-print-status h2 {
                    margin: 0 0 3mm;
                    color: #172033;
                    font-size: 13pt;
                }

                .doc-print-status-headline {
                    margin: 0 0 4mm;
                    color: #172033;
                    font-size: 11pt;
                    font-weight: 800;
                }

                .doc-print-status-meta {
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 2mm 8mm;
                    margin: 0 0 3mm;
                }

                    .doc-print-status-meta dt {
                        color: #41536b;
                        font-size: 8pt;
                        font-weight: 700;
                        text-transform: uppercase;
                    }

                    .doc-print-status-meta dd {
                        margin: 0;
                        color: #172033;
                        font-size: 10pt;
                    }

                .doc-print-status-note {
                    margin: 2mm 0 0;
                    padding-top: 2mm;
                    border-top: 1px solid #cfd6df;
                    color: #172033;
                    font-size: 9.5pt;
                    font-style: italic;
                }

            .doc-print-toc {
                display: block;
                page-break-after: always;
            }

                .doc-print-toc h2 {
                    color: #172033;
                    font-size: 18pt;
                }

                .doc-print-toc ol {
                    padding-left: 8mm;
                    font-size: 10pt;
                    line-height: 2;
                }

            .doc-chapter {
                display: block !important;
                margin-bottom: 7mm;
                overflow: visible;
                border-radius: 8px;
                box-shadow: none;
                page-break-inside: auto;
                break-inside: auto;
            }

            .doc-chapter-head {
                break-after: avoid;
                page-break-after: avoid;
                background: #edf2ff !important;
                border-bottom: 1px solid #ccd7ee;
            }

            .doc-chapter-number {
                color: #28385E !important;
                border: 1px solid #ccd7ee;
            }

            .doc-chapter-head h2 {
                color: #172033 !important;
            }

            .doc-chapter-head p {
                color: #5c687a !important;
            }

            .doc-simple-box {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .doc-readable-card {
                break-inside: avoid;
                page-break-inside: avoid;
                box-shadow: none !important;
            }

            .doc-code {
                color: #111 !important;
                background: #fff !important;
                border: 1px solid #d6dce5;
                font-size: 8.5pt;
            }

            .doc-code-toolbar,
            .doc-copy-btn {
                display: none !important;
            }
        }

        /* ================================================================
           Professional documentation workspace redesign
           ================================================================ */

        .doc-page {
            --pro-navy-950: #13203a;
            --pro-navy-900: #172f59;
            --pro-navy-800: #28385e;
            --pro-navy-700: #405577;
            --pro-blue: #4f78c7;
            --pro-cyan: #55b8c8;
            --pro-bg: #f4f7fb;
            --pro-card: #ffffff;
            --pro-text: #41536b;
            --pro-muted: #718198;
            --pro-line: #dfe7f1;
            --pro-green: #16866a;
            --pro-green-soft: #e8f6f1;
            --pro-amber: #b8750d;
            --pro-amber-soft: #fff5df;
            --pro-red: #c44d58;
            --pro-red-soft: #fdecef;
            max-width: 1560px;
            padding-bottom: 1.5rem;
        }

        .doc-pro-hero {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 1.5rem;
            align-items: center;
            min-height: 164px;
            padding: 1.45rem 1.65rem;
            color: #fff;
            background:
                radial-gradient(circle at 88% 16%, rgba(255,255,255,.12), transparent 25%),
                linear-gradient(125deg, var(--pro-navy-950), var(--pro-navy-800) 62%, #5c7493);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 24px;
            box-shadow: 0 22px 56px rgba(23,47,89,.19);
        }

        .doc-pro-hero::after {
            content: "";
            position: absolute;
            right: -115px;
            top: -170px;
            width: 360px;
            height: 360px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 50%;
            box-shadow:
                0 0 0 40px rgba(255,255,255,.035),
                0 0 0 86px rgba(255,255,255,.018);
            pointer-events: none;
        }

        .doc-pro-hero-copy,
        .doc-pro-hero-score {
            position: relative;
            z-index: 1;
        }

        .doc-pro-kicker {
            display: inline-flex;
            align-items: center;
            gap: .42rem;
            margin-bottom: .45rem;
            color: rgba(255,255,255,.72);
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .doc-pro-hero h1 {
            margin: 0;
            color: #fff;
            font-size: clamp(1.7rem, 3vw, 2.35rem);
            font-weight: 900;
            letter-spacing: -.045em;
            line-height: 1.08;
        }

        .doc-pro-hero p {
            max-width: 880px;
            margin: .52rem 0 0;
            color: rgba(255,255,255,.76);
            font-size: .86rem;
            line-height: 1.62;
        }

        .doc-pro-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .46rem;
            margin-top: .8rem;
        }

        .doc-pro-chip {
            display: inline-flex;
            align-items: center;
            gap: .36rem;
            padding: .4rem .58rem;
            color: rgba(255,255,255,.88);
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 999px;
            font-size: .65rem;
            font-weight: 780;
            backdrop-filter: blur(4px);
        }

        .doc-pro-hero-score {
            min-width: 178px;
            padding: .95rem 1rem;
            text-align: center;
            background: rgba(255,255,255,.09);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 18px;
            backdrop-filter: blur(8px);
        }

        .doc-pro-hero-score strong {
            display: block;
            color: #fff;
            font-size: 1.95rem;
            font-weight: 900;
            line-height: 1;
        }

        .doc-pro-hero-score span {
            display: block;
            margin-top: .25rem;
            color: rgba(255,255,255,.63);
            font-size: .6rem;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .doc-pro-hero-score small {
            display: block;
            margin-top: .48rem;
            color: rgba(255,255,255,.84);
            font-size: .65rem;
            font-weight: 760;
            line-height: 1.42;
        }

        .doc-pro-controls {
            display: grid;
            grid-template-columns: minmax(230px,.72fr) minmax(0,1.35fr) auto;
            gap: .78rem;
            align-items: center;
            margin-top: .82rem;
            padding: .8rem;
            background: #fff;
            border: 1px solid var(--pro-line);
            border-radius: 17px;
            box-shadow: 0 14px 38px rgba(29,52,88,.07);
        }

        .doc-pro-field label {
            display: block;
            margin-bottom: .28rem;
            color: var(--pro-muted);
            font-size: .61rem;
            font-weight: 900;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .doc-pro-select {
            min-height: 42px;
            color: var(--pro-navy-950);
            background: #fff;
            border: 1px solid #cfd9e6;
            border-radius: 10px;
            font-size: .76rem;
            font-weight: 650;
        }

        .doc-pro-select:focus {
            border-color: var(--pro-blue);
            box-shadow: 0 0 0 .2rem rgba(79,120,199,.12);
        }

        .doc-pro-project {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: .66rem;
            padding: .61rem .68rem;
            background: #f8faff;
            border: 1px solid #e2e9f3;
            border-radius: 11px;
        }

        .doc-pro-project-icon {
            flex: 0 0 auto;
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            color: var(--pro-navy-800);
            background: #edf3fb;
            border-radius: 10px;
        }

        .doc-pro-project h2 {
            margin: 0;
            color: var(--pro-navy-950);
            font-size: .79rem;
            font-weight: 850;
            line-height: 1.34;
            overflow-wrap: anywhere;
        }

        .doc-pro-project p {
            margin: .13rem 0 0;
            color: var(--pro-muted);
            font-size: .61rem;
            line-height: 1.38;
            overflow-wrap: anywhere;
        }

        .doc-pro-primary,
        .doc-pro-secondary {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: .55rem .8rem;
            border-radius: 10px;
            font-size: .7rem;
            font-weight: 850;
            white-space: nowrap;
        }

        .doc-pro-primary {
            color: #fff !important;
            background: linear-gradient(135deg, var(--pro-navy-800), var(--pro-navy-700));
            border: 0;
            box-shadow: 0 10px 21px rgba(40,56,94,.15);
        }

        .doc-pro-primary:hover {
            background: linear-gradient(135deg, var(--pro-navy-900), var(--pro-navy-700));
        }

        .doc-pro-primary:disabled {
            cursor: wait;
            opacity: .68;
        }

        .doc-pro-secondary {
            color: var(--pro-navy-800);
            background: #fff;
            border: 1px solid #cfd9e6;
        }

        .doc-pro-secondary:hover {
            color: var(--pro-navy-900);
            background: #edf3fb;
        }

        .doc-passport {
            margin-top: .82rem;
            background: #fff;
            border: 1px solid var(--pro-line);
            border-radius: 17px;
            box-shadow: 0 8px 24px rgba(29,52,88,.045);
        }

        .doc-passport-main {
            display: grid;
            grid-template-columns: minmax(210px,1.15fr) repeat(4,minmax(115px,.55fr));
            gap: .65rem;
            align-items: stretch;
            padding: .8rem;
        }

        .doc-passport-intro {
            display: flex;
            align-items: flex-start;
            gap: .62rem;
            padding: .68rem;
            background: #f8faff;
            border-radius: 12px;
        }

        .doc-passport-icon {
            flex: 0 0 auto;
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            color: var(--pro-navy-800);
            background: #edf3fb;
            border-radius: 10px;
        }

        .doc-passport-intro h3 {
            margin: 0;
            color: var(--pro-navy-950);
            font-size: .8rem;
            font-weight: 900;
        }

        .doc-passport-intro p {
            margin: .18rem 0 0;
            color: var(--pro-muted);
            font-size: .61rem;
            line-height: 1.42;
        }

        .doc-passport-stat {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
            padding: .66rem;
            background: #fff;
            border: 1px solid #e3eaf3;
            border-radius: 12px;
        }

        .doc-passport-stat > span {
            color: var(--pro-muted);
            font-size: .54rem;
            font-weight: 900;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .doc-passport-stat > strong {
            margin-top: .2rem;
            color: var(--pro-navy-950);
            font-size: .72rem;
            font-weight: 850;
            line-height: 1.36;
            overflow-wrap: anywhere;
        }

        .doc-passport-stat > strong.score {
            color: var(--pro-navy-800);
            font-size: 1.12rem;
            line-height: 1;
        }

        .doc-pro-status {
            display: inline-flex;
            align-items: center;
            gap: .32rem;
            width: fit-content;
            padding: .32rem .48rem;
            border-radius: 999px;
            font-size: .58rem;
            font-weight: 850;
            line-height: 1.2;
        }

        .doc-pro-status.success {
            color: #176844;
            background: var(--pro-green-soft);
        }

        .doc-pro-status.warning {
            color: #84580e;
            background: var(--pro-amber-soft);
        }

        .doc-pro-status.danger {
            color: #983a43;
            background: var(--pro-red-soft);
        }

        .doc-pro-status.neutral {
            color: #52657b;
            background: #edf2f7;
        }

        .doc-passport-note {
            display: flex;
            align-items: flex-start;
            gap: .52rem;
            margin: 0 .8rem .8rem;
            padding: .62rem .7rem;
            color: #785216;
            background: #fff9ec;
            border: 1px solid #edd9ac;
            border-radius: 11px;
            font-size: .65rem;
            line-height: 1.48;
        }

        .doc-passport-details {
            border-top: 1px solid var(--pro-line);
        }

        .doc-passport-details summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .7rem;
            padding: .7rem .85rem;
            color: var(--pro-navy-800);
            cursor: pointer;
            list-style: none;
            font-size: .65rem;
            font-weight: 850;
        }

        .doc-passport-details summary::-webkit-details-marker {
            display: none;
        }

        .doc-passport-grid {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: .5rem;
            padding: 0 .8rem .8rem;
        }

        .doc-passport-detail {
            padding: .62rem;
            background: #f8faff;
            border: 1px solid #e3eaf3;
            border-radius: 10px;
        }

        .doc-passport-detail span,
        .doc-passport-detail strong {
            display: block;
        }

        .doc-passport-detail span {
            color: var(--pro-muted);
            font-size: .52rem;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .doc-passport-detail strong {
            margin-top: .2rem;
            color: var(--pro-navy-950);
            font-size: .63rem;
            line-height: 1.42;
            overflow-wrap: anywhere;
        }

        /* Reading workspace: calmer, larger, and document-first. */
        .doc-reader {
            grid-template-columns: 265px minmax(0,1fr);
            gap: 1rem;
            margin-top: 1rem;
        }

        .doc-reader-sidebar {
            top: 86px;
            border-radius: 17px;
            box-shadow: 0 14px 38px rgba(29,52,88,.07);
        }

        .doc-reader-sidebar-head {
            padding: .9rem;
        }

        .doc-reader-sidebar-head span {
            font-size: .57rem;
            color: var(--pro-navy-800);
        }

        .doc-reader-sidebar-head strong {
            font-size: .77rem;
        }

        .doc-chapter-nav {
            padding: .48rem;
        }

        .doc-chapter-btn {
            grid-template-columns: 31px minmax(0,1fr) auto;
            padding: .52rem;
            border-radius: 10px;
        }

        .doc-chapter-btn:hover,
        .doc-chapter-btn.is-active {
            color: var(--pro-navy-800);
            background: #edf3fb;
            border-color: #d7e2f0;
        }

        .doc-chapter-btn-number {
            width: 29px;
            height: 29px;
            color: var(--pro-navy-800);
            border-radius: 8px;
        }

        .doc-chapter-btn.is-active .doc-chapter-btn-number {
            background: var(--pro-navy-800);
        }

        .doc-reader-toolbar {
            padding: .76rem .85rem;
            border-radius: 13px;
        }

        .doc-reader-toolbar-copy h2 {
            font-size: .87rem;
        }

        .doc-chapter {
            border-radius: 20px;
            box-shadow: 0 16px 42px rgba(29,52,88,.07);
        }

        .doc-chapter-head {
            grid-template-columns: auto minmax(0,1fr);
            padding: 1rem 1.05rem;
            color: var(--pro-navy-950);
            background: linear-gradient(135deg,#eef3fa,#f8faff);
            border-bottom: 1px solid var(--pro-line);
        }

        .doc-chapter-number {
            width: 48px;
            height: 48px;
            color: #fff;
            background: linear-gradient(135deg,var(--pro-navy-800),var(--pro-navy-700));
            box-shadow: 0 9px 20px rgba(40,56,94,.14);
        }

        .doc-chapter-head h2 {
            color: var(--pro-navy-950);
            font-size: 1.14rem;
        }

        .doc-chapter-head p {
            color: var(--pro-muted);
            font-size: .69rem;
        }

        .doc-simple-box {
            margin: .9rem;
            padding: .78rem .82rem;
            color: #31527e;
            background: #edf3fb;
            border-color: #d5e1f0;
        }

        .doc-simple-box p {
            font-size: .65rem;
            line-height: 1.5;
        }

        .doc-chapter-body {
            padding: 0 .9rem .9rem;
        }

        .doc-readable-card {
            grid-template-columns: 46px minmax(0,1fr);
            padding: .82rem;
        }

        .doc-readable-content {
            color: var(--pro-text);
            font-size: .74rem;
            line-height: 1.7;
        }

        .doc-readable-content::first-line {
            color: var(--pro-navy-950);
            font-weight: 800;
        }

        .doc-code {
            font-size: .69rem;
            line-height: 1.66;
        }

        .doc-empty {
            min-height: 480px;
        }

        @@media (max-width: 1240px) {
            .doc-passport-main {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .doc-passport-intro {
                grid-column: 1 / -1;
            }

            .doc-pro-controls {
                grid-template-columns: minmax(230px,.8fr) minmax(0,1.2fr);
            }

            .doc-pro-controls form {
                grid-column: 1 / -1;
            }

            .doc-pro-controls .doc-pro-primary {
                width: 100%;
            }
        }

        @@media (max-width: 980px) {
            .doc-pro-hero {
                grid-template-columns: 1fr;
            }

            .doc-pro-hero-score {
                min-width: 0;
                text-align: left;
            }

            .doc-pro-controls {
                grid-template-columns: 1fr;
            }

            .doc-pro-controls form {
                grid-column: auto;
            }

            .doc-passport-grid {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }
        }

        @@media (max-width: 760px) {
            .doc-passport-main {
                grid-template-columns: 1fr;
            }

            .doc-passport-intro {
                grid-column: auto;
            }
        }

        @@media (max-width: 560px) {
            .doc-pro-hero {
                padding: 1.05rem;
            }

            .doc-passport-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media print {
            .doc-pro-hero,
            .doc-pro-controls,
            .doc-passport {
                display: none !important;
            }
        }

    </style>
}

<section class="doc-page">

    <header class="doc-pro-hero no-print">
        <div class="doc-pro-hero-copy">
            <div class="doc-pro-kicker">
                <i class="bi bi-stars" aria-hidden="true"></i>
                AI-Guided Documentation
            </div>

            <h1>Software Documentation Studio</h1>

            <p>
                Review the generated SRS and software design package one chapter
                at a time. Quality status and technical provenance remain available
                without distracting from the document itself.
            </p>

            <div class="doc-pro-meta">
                <span class="doc-pro-chip">
                    <i class="bi bi-file-earmark-text"></i>
                    SRS + Software Design
                </span>

                <span class="doc-pro-chip">
                    <i class="bi bi-shield-check"></i>
                    @validationLabel
                </span>

                @if (generatedAt.HasValue)
                {
                    <span class="doc-pro-chip">
                        <i class="bi bi-clock-history"></i>
                        Generated @generatedAt.Value.ToString("dd MMM yyyy")
                    </span>
                }
            </div>
        </div>

        <div class="doc-pro-hero-score">
            <strong>@qualityScoreLabel</strong>
            <span>Quality score</span>

            <small>
                @(semanticReviewCompleted
                    ? "Semantic quality review completed"
                    : quality == null
                        ? "Generate documentation to calculate quality"
                        : "Limited confidence until semantic review completes")
            </small>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="doc-alert doc-alert-success no-print" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@Model.Message</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="doc-alert doc-alert-danger no-print" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@Model.ErrorMessage</span>
        </div>

        @if (Model.PreviousDocumentPreserved)
        {
            <div class="doc-alert doc-alert-info no-print" role="status">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Your previously generated documentation below was not changed and is still valid.</span>
            </div>
        }
    }

    @if (quality != null || provenance != null || Model.LatestReview != null)
    {
        <section class="doc-passport no-print"
                 aria-label="Documentation Quality Passport">
            <div class="doc-passport-main">
                <div class="doc-passport-intro">
                    <div class="doc-passport-icon">
                        <i class="bi bi-patch-check"></i>
                    </div>

                    <div>
                        <h3>Quality Passport</h3>
                        <p>
                            Validation, confidence, provenance, and review status
                            for the document currently displayed.
                        </p>
                    </div>
                </div>

                <div class="doc-passport-stat">
                    <span>Quality score</span>
                    <strong class="score">@qualityScoreLabel</strong>
                </div>

                <div class="doc-passport-stat">
                    <span>Validation level</span>

                    <strong>
                        <span class="doc-pro-status @validationTone">
                            <i class="bi @(semanticReviewCompleted
                                ? "bi-check2-circle"
                                : "bi-exclamation-circle")"></i>
                            @validationLabel
                        </span>
                    </strong>
                </div>

                <div class="doc-passport-stat">
                    <span>Important warnings</span>
                    <strong>@(quality?.ImportantWarningCount ?? 0)</strong>
                </div>

                <div class="doc-passport-stat">
                    <span>Output origin</span>
                    <strong>
                        @(provenance?.OutputOriginLabel ?? "Not available")
                    </strong>
                </div>
            </div>

            @if (!semanticReviewCompleted && quality != null)
            {
                <div class="doc-passport-note">
                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <span>
                        Structural validation completed, but semantic review did
                        not complete. Treat this document as a draft and review it
                        with the supervisor before final submission.
                    </span>
                </div>
            }

            <details class="doc-passport-details">
                <summary>
                    <span>
                        <i class="bi bi-sliders me-1"></i>
                        View technical provenance and review details
                    </span>

                    <i class="bi bi-chevron-down"></i>
                </summary>

                <div class="doc-passport-grid">
                    <div class="doc-passport-detail">
                        <span>Review status</span>
                        <strong>
                            @(quality?.ReviewStatusLabel ??
                              provenance?.ReviewLevelLabel ??
                              "Not available")
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Output review level</span>
                        <strong>
                            @(quality?.OutputReviewLevelLabel ??
                              provenance?.ReviewLevelLabel ??
                              "Not available")
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Provider</span>
                        <strong>
                            @(provenance?.Provider ??
                              provenance?.Source ??
                              "Unknown")
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Model</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(provenance?.Model)
                                ? "Not recorded"
                                : provenance.Model)
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Provenance</span>
                        <strong>
                            @(quality?.ProvenanceSummary ??
                              provenance?.Source ??
                              "Unknown")
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Semantic review</span>
                        <strong>
                            @(quality == null
                                ? "Not available"
                                : quality.SemanticReviewCompleted
                                    ? "Completed"
                                    : "Not completed")
                        </strong>
                    </div>

                    <div class="doc-passport-detail">
                        <span>Generated</span>
                        <strong>
                            @(generatedAt.HasValue
                                ? generatedAt.Value.ToString("u")
                                : "Not available")
                        </strong>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(provenance?.Warning))
                {
                    <div class="doc-passport-note">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>@provenance.Warning</span>
                    </div>
                }
            </details>
        </section>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mt-2 no-print"></div>

    <section class="doc-pro-controls no-print"
             aria-label="Documentation project and generation controls">
        <div class="doc-pro-field">
            <label asp-for="SelectedProjectIdeaId">Project idea</label>

            <select asp-for="SelectedProjectIdeaId"
                    asp-items="Model.ProjectIdeaOptions"
                    class="form-select doc-pro-select"
                    onchange="if(this.value){ window.location='?projectId=@Model.ProjectId&amp;projectIdeaId=' + this.value; }">
            </select>

            <span asp-validation-for="SelectedProjectIdeaId"
                  class="text-danger small"></span>
        </div>

        @if (hasSelectedIdea)
        {
            <div class="doc-pro-project">
                <div class="doc-pro-project-icon" aria-hidden="true">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <div class="min-w-0">
                    <h2>@Model.Request.ProjectTitle</h2>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Request.Domain)
                            ? "Domain not specified"
                            : Model.Request.Domain)
                        ·
                        @(string.IsNullOrWhiteSpace(Model.Request.TechStack)
                            ? "Technology stack not specified"
                            : Model.Request.TechStack)
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="doc-pro-project">
                <div class="doc-pro-project-icon" aria-hidden="true">
                    <i class="bi bi-arrow-left-right"></i>
                </div>

                <div>
                    <h2>No project idea selected</h2>
                    <p>Choose the official saved idea for the active project.</p>
                </div>
            </div>
        }

        <form method="post"
              asp-page-handler="Generate"
              id="docGenerateForm">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="projectId"
                   value="@Model.ProjectId" />

            <input type="hidden"
                   asp-for="SelectedProjectIdeaId" />

            <button type="submit"
                    class="btn doc-pro-primary"
                    id="docGenerateBtn"
                    disabled="@(!hasSelectedIdea ? "disabled" : null)">
                <i class="bi bi-stars" aria-hidden="true"></i>

                @(docs == null
                    ? "Generate Documentation"
                    : "Regenerate Documentation")
            </button>
        </form>
    </section>

    @if (docs == null)
    {
        <section class="doc-empty">
            <div class="doc-empty-inner">
                <div class="doc-empty-icon" aria-hidden="true">
                    <i class="bi bi-journal-richtext"></i>
                </div>

                @if (hasSelectedIdea)
                {
                    <h2>Your project is ready</h2>

                    <p>
                        Generate the documentation package, then read it chapter by chapter.
                        You will see a simple explanation before every technical section.
                    </p>

                    <div class="doc-empty-steps">
                        <div class="doc-empty-step">
                            <span>1</span>
                            <strong>Read the overview</strong>
                            <p>Start with the project summary and key document counts.</p>
                        </div>

                        <div class="doc-empty-step">
                            <span>2</span>
                            <strong>Open one chapter</strong>
                            <p>Only one topic is shown at a time, so the page stays calm and clear.</p>
                        </div>

                        <div class="doc-empty-step">
                            <span>3</span>
                            <strong>Download when ready</strong>
                            <p>The print version includes all chapters in a formal report.</p>
                        </div>
                    </div>
                }
                else
                {
                    <h2>Select a project idea first</h2>

                    <p>
                        Choose a saved project from the bar above. The documentation generator uses the selected
                        project as its source of truth and does not rely on static sample data.
                    </p>
                }
            </div>
        </section>
    }
    else
    {
        <article id="se-report">

            <section class="doc-print-cover">
                <div class="doc-print-cover-kicker">Generated Documentation Package</div>

                <h1>@docs.Title</h1>

                <h2>Software Requirements Specification &amp; Software Design Document</h2>

                <div class="doc-print-meta">
                    <div><strong>Project:</strong> @Model.Request.ProjectTitle</div>
                    <div><strong>Domain:</strong> @(string.IsNullOrWhiteSpace(Model.Request.Domain) ? "Not specified" : Model.Request.Domain)</div>
                    <div><strong>Technology stack:</strong> @(string.IsNullOrWhiteSpace(Model.Request.TechStack) ? "Not specified" : Model.Request.TechStack)</div>
                    <div><strong>Generated on:</strong> @docs.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</div>
                </div>

                <div class="doc-print-footer">Generated by FYPilot</div>
            </section>

            @{
                // Print/PDF honesty fix: the on-screen Quality Passport
                // (.doc-passport, further below) is deliberately kept out of
                // print output -- it's interactive (a collapsible <details>
                // panel) and unsuited to a static page. Print media instead
                // shows THIS static summary, built from the exact same
                // already-computed quality/provenance variables the
                // on-screen passport uses (see this file's top @{ } block).
                // See DocumentationGeneratorModel.IsAcceptedForPrint's
                // docstring for why acceptance requires BOTH Usable and
                // SemanticReviewCompleted, not just one.
                var reviewAccepted = FYPilot.Web.Pages.Student.DocumentationGeneratorModel.IsAcceptedForPrint(Model.LatestReview, quality);
            }

            <section class="doc-print-status" aria-label="Document Review and Provenance Status">
                <h2>Document Review and Provenance Status</h2>

                <p class="doc-print-status-headline">
                    @(reviewAccepted
                        ? "Accepted -- this document passed the configured AI quality-review process."
                        : "Manual review required -- do not treat this document as fully approved.")
                </p>

                <dl class="doc-print-status-meta">
                    <div>
                        <dt>Review status</dt>
                        <dd>@(quality?.ReviewStatusLabel ?? provenance?.ReviewLevelLabel ?? "Not available")</dd>
                    </div>
                    <div>
                        <dt>Review detail</dt>
                        <dd>@(quality?.OutputReviewLevelLabel ?? "Not available")</dd>
                    </div>
                    <div>
                        <dt>Output origin</dt>
                        <dd>@(provenance?.OutputOriginLabel ?? "Not available")</dd>
                    </div>
                    <div>
                        <dt>Important warnings</dt>
                        <dd>@(quality?.ImportantWarningCount ?? 0)</dd>
                    </div>
                    <div>
                        <dt>Generated</dt>
                        <dd>@(generatedAt.HasValue ? generatedAt.Value.ToString("u") : "Not available")</dd>
                    </div>
                </dl>

                @if (!semanticReviewCompleted && quality != null)
                {
                    <p class="doc-print-status-note">
                        Structural validation completed, but semantic review did not complete.
                        Treat this document as a draft and review it with the supervisor before final submission.
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(provenance?.Warning))
                {
                    <p class="doc-print-status-note">@provenance.Warning</p>
                }
            </section>

            <section class="doc-print-toc">
                <h2>Table of Contents</h2>
                <ol>
                    <li>Project Overview</li>
                    <li>Functional Requirements</li>
                    <li>Non-Functional Requirements</li>
                    <li>Use Cases</li>
                    <li>Edge Cases</li>
                    <li>Database Design</li>
                    <li>UI / Frontend Design</li>
                    <li>Diagram Specifications</li>
                    <li>Architecture, Security, Testing, Traceability &amp; Quality</li>
                </ol>
            </section>

            <div class="doc-reader">

                <aside class="doc-reader-sidebar no-print">
                    <div class="doc-reader-sidebar-head">
                        <span>Document Chapters</span>
                        <strong>Choose one topic to read</strong>
                    </div>

                    <div class="doc-chapter-nav" role="tablist" aria-orientation="vertical">
                        @RenderNavButton("overview", "0", "Project Overview", "Start here", "bi-house-door", "1", true)
                        @RenderNavButton("fr", "1", "Functional Requirements", "What the system does", "bi-list-check", functionalCount.ToString(), false)
                        @RenderNavButton("nfr", "2", "Quality Requirements", "How well it should work", "bi-shield-check", nonFunctionalCount.ToString(), false)
                        @RenderNavButton("uc", "3", "Use Cases", "How users interact", "bi-person-gear", useCaseCount.ToString(), false)
                        @RenderNavButton("ec", "4", "Edge Cases", "What can go wrong", "bi-exclamation-triangle", edgeCaseCount.ToString(), false)
                        @RenderNavButton("db", "5", "Database Design", "What data is stored", "bi-database", databaseCount.ToString(), false)
                        @RenderNavButton("ui", "6", "UI Screens", "What users will see", "bi-window-sidebar", uiCount.ToString(), false)
                        @RenderNavButton("diagrams", "7", "Diagrams", "Visual system flows", "bi-diagram-3", "1", false)
                        @RenderNavButton("extended", "8", "Engineering Report", "Architecture and testing", "bi-cpu", "1", false)
                    </div>
                </aside>

                <main class="doc-reader-main">
                    <div class="doc-reader-toolbar no-print">
                        <div class="doc-reader-toolbar-copy">
                            <span>Generated Documentation Package</span>
                            <h2>@docs.Title</h2>
                        </div>

                        <div class="doc-reader-toolbar-actions">
                            <button type="button"
                                    class="btn doc-print-btn"
                                    onclick="window.print()">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                Download PDF
                            </button>
                        </div>
                    </div>

                    <section class="doc-chapter is-active"
                             id="panel-overview"
                             data-doc-panel="overview"
                             role="tabpanel"
                             aria-hidden="false">
                        <div class="doc-chapter-head">
                            <div class="doc-chapter-number">0</div>

                            <div>
                                <h2>Project Overview</h2>
                                <p>Understand the project and the structure of this document before reading technical details.</p>
                            </div>
                        </div>

                        <div class="doc-simple-box">
                            <div class="doc-simple-box-icon" aria-hidden="true">
                                <i class="bi bi-lightbulb"></i>
                            </div>

                            <div>
                                <strong>In simple words</strong>
                                <p>
                                    This page explains what your project should do, how users interact with it,
                                    what data it stores, how it is designed, and how it should be tested.
                                </p>
                            </div>
                        </div>

                        <div class="doc-chapter-body">
                            <div class="doc-overview-grid">
                                <section class="doc-overview-card">
                                    <span>Project</span>
                                    <h3>@Model.Request.ProjectTitle</h3>
                                    <p>
                                        @(string.IsNullOrWhiteSpace(Model.Request.ProjectDescription)
                                            ? "No project description was provided."
                                            : Model.Request.ProjectDescription)
                                    </p>
                                </section>

                                <section class="doc-overview-card">
                                    <span>Project details</span>

                                    <div class="doc-overview-meta">
                                        <div class="doc-meta-row">
                                            <span>Domain</span>
                                            <strong>@(string.IsNullOrWhiteSpace(Model.Request.Domain) ? "Not specified" : Model.Request.Domain)</strong>
                                        </div>

                                        <div class="doc-meta-row">
                                            <span>Technology</span>
                                            <strong>@(string.IsNullOrWhiteSpace(Model.Request.TechStack) ? "Not specified" : Model.Request.TechStack)</strong>
                                        </div>

                                        <div class="doc-meta-row">
                                            <span>Generated</span>
                                            <strong>@docs.CreatedAt.ToString("dd MMM yyyy")</strong>
                                        </div>

                                    </div>
                                </section>
                            </div>

                            <div class="doc-stat-grid">
                                <div class="doc-stat-card">
